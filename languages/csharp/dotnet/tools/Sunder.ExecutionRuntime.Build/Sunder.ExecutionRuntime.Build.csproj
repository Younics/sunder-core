<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <AssemblyName>Sunder.ExecutionRuntime.Build</AssemblyName>
    <RootNamespace>Sunder.ExecutionRuntime.Build</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\libraries\Sunder.Package.Format\Sunder.Package.Format.csproj" />
    <ProjectReference Include="..\..\libraries\Sunder.Registry.Contracts\Sunder.Registry.Contracts.csproj" />
    <ProjectReference Include="..\..\packages\Sunder.Package.Build\Sunder.Package.Build.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" />
    <!-- Package.Build keeps its compiler/task dependencies private; this engineering executable needs them at runtime. -->
    <PackageReference Include="Microsoft.Build.Framework" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  </ItemGroup>

  <!-- Explicit, credential-free check of reviewed migration input; never part of an ordinary build. -->
  <Target Name="CheckSunderPlatformCatalogMigrationInput" DependsOnTargets="Build">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; check-platform-catalog-migration --descriptor &quot;$(MSBuildProjectDirectory)/../../packages/Sunder.Sdk.Stacks/Contracts/sunder.stack.contributor.rpc.json&quot;" />
  </Target>

  <!-- Core-only source validation. Acceptance/freeze/payload remain explicit CLI operations, never build hooks. -->
  <Target Name="CheckSunderPlatformContracts" DependsOnTargets="Build">
    <Exec Command="dotnet &quot;$(TargetPath)&quot; platform-contracts check --core-root &quot;$(MSBuildProjectDirectory)/../../../../..&quot;" />
  </Target>

  <Target Name="BuildCoreStackTransportProducer" DependsOnTargets="Build" Returns="$(TargetPath)" />

</Project>
