<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="Sunder.Package.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SunderPackageAggregateProject>true</SunderPackageAggregateProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="Sunder.Package.Quickstart.Worker\Sunder.Package.Quickstart.Worker.csproj"
                      ReferenceOutputAssembly="false"
                      AdditionalProperties="RuntimeIdentifier=$(NETCoreSdkRuntimeIdentifier)" />
    <ProjectReference Include="Sunder.Package.Quickstart.App\Sunder.Package.Quickstart.App.csproj"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <SunderPackageTargetLeaf Include="$(MSBuildProjectDirectory)\Sunder.Package.Quickstart.Worker\bin\$(Configuration)\$(TargetFramework)\$(NETCoreSdkRuntimeIdentifier)\sunder-dev"
                             DiscoveryRoot="$(MSBuildProjectDirectory)\Sunder.Package.Quickstart.Worker\bin\$(Configuration)\$(TargetFramework)\$(NETCoreSdkRuntimeIdentifier)" />
    <SunderPackageTargetLeaf Include="$(MSBuildProjectDirectory)\Sunder.Package.Quickstart.App\bin\$(Configuration)\$(TargetFramework)\sunder-dev"
                             DiscoveryRoot="$(MSBuildProjectDirectory)\Sunder.Package.Quickstart.App\bin\$(Configuration)\$(TargetFramework)" />
  </ItemGroup>

  <Import Project="..\..\packages\Sunder.Package.Build\build\Sunder.Package.Build.targets" />
</Project>
