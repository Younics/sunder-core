<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\Sunder.Package.props" />

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <SunderPackageProject>false</SunderPackageProject>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\packages\Sunder.Sdk\Sunder.Sdk.csproj" PrivateAssets="all" />
    <EmbeddedResource Include="Contracts\greeting.rpc.json"
                      LogicalName="Sunder.Package.Quickstart.Protocol.Contracts.greeting.rpc.json" />
    <SunderRpcBinding Include="Contracts\greeting.rpc.json"
                      Namespace="Sunder.Package.Quickstart.Protocol.Generated"
                      OutputFile="GreetingRpc.g.cs" />
  </ItemGroup>

  <Import Project="..\..\..\packages\Sunder.Package.Build\build\Sunder.Package.Build.targets" />
</Project>
