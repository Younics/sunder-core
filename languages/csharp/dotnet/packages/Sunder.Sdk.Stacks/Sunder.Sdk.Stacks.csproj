<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <CentralPackageTransitivePinningEnabled>false</CentralPackageTransitivePinningEnabled>
    <Version>$(SunderDeveloperPackageVersion)</Version>
    <AssemblyVersion>$(SunderSdkAssemblyVersion)</AssemblyVersion>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);CS1591</WarningsAsErrors>
    <Title>Sunder.Sdk.Stacks</Title>
    <Description>Public contracts for contributing package data to Sunder Stack discovery, export, preview, and import operations.</Description>
    <PackageTags>sunder;package;plugin;sdk;stacks;import;export</PackageTags>
    <Authors>Younics</Authors>
    <PackageProjectUrl>https://sunderapp.io</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/Younics/sunder-core</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseFile>LICENSE</PackageLicenseFile>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sunder.Sdk\Sunder.Sdk.csproj" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="Contracts\sunder.stack.contributor.rpc.json"
                      LogicalName="Sunder.Sdk.Stacks.Contracts.sunder.stack.contributor.rpc.json" />
    <None Include="Contracts\sunder.stack.contributor.rpc.json"
          Pack="true"
          PackagePath="contracts" />
    <None Include="buildTransitive\Sunder.Sdk.Stacks.props"
          Pack="true"
          PackagePath="buildTransitive" />
    <None Include="..\Sunder.Sdk\icon.png" Pack="true" PackagePath="" Link="icon.png" />
    <None Include="README.md" Pack="true" PackagePath="" />
    <None Include="..\Sunder.Sdk\LICENSE" Pack="true" PackagePath="" Link="LICENSE" />
  </ItemGroup>

</Project>
