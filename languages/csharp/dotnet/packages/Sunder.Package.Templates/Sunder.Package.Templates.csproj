<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <PackageType>Template</PackageType>
    <PackageId>Sunder.Package.Templates</PackageId>
    <Version>1.0.2</Version>
    <AssemblyVersion>$(SunderSdkAssemblyVersion)</AssemblyVersion>
    <Description>Create Sunder extensions with dotnet new: C# services, optional Avalonia desktop views, Stack support, and ready-to-use build and packaging configuration.</Description>
    <PackageTags>sunder;package;plugin;sdk;dotnet-new;template</PackageTags>
    <EnableDefaultItems>false</EnableDefaultItems>
    <IsPackable>true</IsPackable>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5110;NU5111</NoWarn>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <Title>Sunder.Package.Templates</Title>
    <Authors>Younics</Authors>
    <PackageProjectUrl>https://sunderapp.io</PackageProjectUrl>
    <PackageIcon>icon.png</PackageIcon>
    <RepositoryUrl>https://github.com/Younics/sunder-core</RepositoryUrl>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageLicenseExpression>GPL-3.0-only</PackageLicenseExpression>
  </PropertyGroup>
  <ItemGroup>
    <None Include="icon.png;README.md;LICENSE" Pack="true" PackagePath="" />
    <Content Include="templates\**\*" Exclude="templates\**\*.in;templates\**\bin\**;templates\**\obj\**"
             Pack="true" PackagePath="content" />
    <!-- Tokenized sources must not be compiled as a nested project or XAML. -->
    <_SunderTemplatePayload Include="templates\**\*.in" Exclude="templates\**\bin\**;templates\**\obj\**" />
  </ItemGroup>
  <Target Name="_PrepareSunderPackageTemplatePayload" BeforeTargets="_GetPackageFiles">
    <ItemGroup>
      <_SunderTemplatePayload Update="@(_SunderTemplatePayload)">
        <StagedPath>$(IntermediateOutputPath)sunder-template-payload\%(RecursiveDir)%(Filename)</StagedPath>
        <PackedPath>content\%(RecursiveDir)%(Filename)</PackedPath>
      </_SunderTemplatePayload>
    </ItemGroup>
    <Copy SourceFiles="@(_SunderTemplatePayload)" DestinationFiles="@(_SunderTemplatePayload->'%(StagedPath)')" SkipUnchangedFiles="true" />
    <ItemGroup>
      <Content Include="%(_SunderTemplatePayload.StagedPath)" Pack="true" PackagePath="%(_SunderTemplatePayload.PackedPath)" />
    </ItemGroup>
  </Target>
</Project>
