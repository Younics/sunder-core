{
  "$schema": "http://json.schemastore.org/template",
  "author": "Sunder",
  "classifications": ["Sunder", "Package", "Avalonia"],
  "identity": "Sunder.Package",
  "name": "Sunder Package",
  "description": "Creates one Sunder package project with typed services and optional Avalonia UI; Sunder generates isolated Worker/App outputs.",
  "shortName": "sunder-package",
  "sourceName": "Sunder.Package.Template",
  "preferNameDirectory": true,
  "symbols": {
    "packageId": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "The lowercase dot-separated package id written into generated package metadata.",
      "replaces": "SUNDER_PACKAGE_ID_TEXT"
    },
    "packageName": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "The package name shown in Sunder.",
      "replaces": "SUNDER_PACKAGE_NAME_TEXT"
    },
    "coordinatedPackageVersion": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "__SUNDER_COORDINATED_PACKAGE_VERSION__"
      },
      "replaces": "SUNDER_TEMPLATE_PACKAGE_VERSION"
    },
    "coordinatedPackageVersionRange": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "__SUNDER_COORDINATED_PACKAGE_VERSION_RANGE__"
      },
      "replaces": "SUNDER_TEMPLATE_PACKAGE_VERSION_RANGE"
    },
    "packageIdCSharp": {
      "type": "derived",
      "valueSource": "packageId",
      "valueTransform": "csharpString",
      "replaces": "SUNDER_PACKAGE_ID_CSHARP"
    },
    "packageNamespace": {
      "type": "generated",
      "generator": "regex",
      "replaces": "SUNDER_PACKAGE_NAMESPACE",
      "parameters": {
        "source": "packageId",
        "steps": [
          { "regex": "(^|\\.)a", "replacement": "${1}A" },
          { "regex": "(^|\\.)b", "replacement": "${1}B" },
          { "regex": "(^|\\.)c", "replacement": "${1}C" },
          { "regex": "(^|\\.)d", "replacement": "${1}D" },
          { "regex": "(^|\\.)e", "replacement": "${1}E" },
          { "regex": "(^|\\.)f", "replacement": "${1}F" },
          { "regex": "(^|\\.)g", "replacement": "${1}G" },
          { "regex": "(^|\\.)h", "replacement": "${1}H" },
          { "regex": "(^|\\.)i", "replacement": "${1}I" },
          { "regex": "(^|\\.)j", "replacement": "${1}J" },
          { "regex": "(^|\\.)k", "replacement": "${1}K" },
          { "regex": "(^|\\.)l", "replacement": "${1}L" },
          { "regex": "(^|\\.)m", "replacement": "${1}M" },
          { "regex": "(^|\\.)n", "replacement": "${1}N" },
          { "regex": "(^|\\.)o", "replacement": "${1}O" },
          { "regex": "(^|\\.)p", "replacement": "${1}P" },
          { "regex": "(^|\\.)q", "replacement": "${1}Q" },
          { "regex": "(^|\\.)r", "replacement": "${1}R" },
          { "regex": "(^|\\.)s", "replacement": "${1}S" },
          { "regex": "(^|\\.)t", "replacement": "${1}T" },
          { "regex": "(^|\\.)u", "replacement": "${1}U" },
          { "regex": "(^|\\.)v", "replacement": "${1}V" },
          { "regex": "(^|\\.)w", "replacement": "${1}W" },
          { "regex": "(^|\\.)x", "replacement": "${1}X" },
          { "regex": "(^|\\.)y", "replacement": "${1}Y" },
          { "regex": "(^|\\.)z", "replacement": "${1}Z" },
          { "regex": "^([0-9])", "replacement": "_$1" },
          { "regex": "\\.", "replacement": "_" }
        ]
      }
    },
    "packageNameCSharp": {
      "type": "derived",
      "valueSource": "packageName",
      "valueTransform": "csharpString",
      "replaces": "SUNDER_PACKAGE_NAME_CSHARP"
    },
    "packageNameXml": {
      "type": "derived",
      "valueSource": "packageName",
      "valueTransform": "xmlAttribute",
      "replaces": "SUNDER_PACKAGE_NAME_XML"
    },
    "withAvalonia": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "Add Avalonia UI support and a default package view."
    },
    "withStacks": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "Add the Stack contributor example; building requires explicit local or Registry platform-contract selection."
    },
    "withHostDependency": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "Add package dependency metadata for another Sunder package."
    },
    "hostPackageId": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": "withHostDependency == true",
      "isEnabled": "withHostDependency == true",
      "description": "The package id this package depends on.",
      "replaces": "SUNDER_HOST_PACKAGE_ID_TEXT"
    },
    "hostPackageIdCSharp": {
      "type": "derived",
      "valueSource": "hostPackageId",
      "valueTransform": "csharpString",
      "replaces": "SUNDER_HOST_PACKAGE_ID_CSHARP"
    },
    "hostPackageVersionRange": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": ">=1.1.0 <1.2.0",
      "isEnabled": "withHostDependency == true",
      "description": "The SemVer range accepted for the dependency."
    },
    "hostPackageVersionRangeCSharp": {
      "type": "derived",
      "valueSource": "hostPackageVersionRange",
      "valueTransform": "csharpString",
      "replaces": "SUNDER_HOST_PACKAGE_VERSION_RANGE_CSHARP"
    },
    "noDefaultView": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "isEnabled": "withAvalonia == true",
      "description": "With --withAvalonia, omit the default shell-visible view while retaining Avalonia SDK references."
    }
  },
  "forms": {
    "csharpBackslash": {
      "identifier": "replace",
      "pattern": "\\\\",
      "replacement": "\\\\"
    },
    "csharpQuote": {
      "identifier": "replace",
      "pattern": "\"",
      "replacement": "\\\""
    },
    "csharpCarriageReturn": {
      "identifier": "replace",
      "pattern": "\\r",
      "replacement": "\\r"
    },
    "csharpLineFeed": {
      "identifier": "replace",
      "pattern": "\\n",
      "replacement": "\\n"
    },
    "csharpTab": {
      "identifier": "replace",
      "pattern": "\\t",
      "replacement": "\\t"
    },
    "csharpString": {
      "identifier": "chain",
      "steps": [
        "csharpBackslash",
        "csharpQuote",
        "csharpCarriageReturn",
        "csharpLineFeed",
        "csharpTab"
      ]
    },
    "xml": {
      "identifier": "xmlEncode"
    },
    "xmlQuote": {
      "identifier": "replace",
      "pattern": "\"",
      "replacement": "&quot;"
    },
    "xmlAttribute": {
      "identifier": "chain",
      "steps": [
        "xml",
        "xmlQuote"
      ]
    }
  },
  "primaryOutputs": [
    {
      "path": "Sunder.Package.Template.csproj"
    }
  ],
  "sources": [
    {
      "source": "Sunder.Package.Template/",
      "target": "./",
      "exclude": [
        "**/[Bb]in/**",
        "**/[Oo]bj/**",
        ".template.config/**/*",
        "**/*.filelist",
        "**/*.user",
        "**/packages.lock.json"
      ],
      "modifiers": [
        {
          "condition": "(!withAvalonia)",
          "exclude": [
            "Views/**/*"
          ]
        },
        {
          "condition": "(!withStacks)",
          "exclude": [
            "Stacks/**/*"
          ]
        },
        {
          "condition": "(!withHostDependency)",
          "exclude": [
            "PackageMetadata.host.cs"
          ],
          "rename": {
            "PackageMetadata.no-host.cs": "PackageMetadata.cs"
          }
        },
        {
          "condition": "(withHostDependency)",
          "exclude": [
            "PackageMetadata.no-host.cs"
          ],
          "rename": {
            "PackageMetadata.host.cs": "PackageMetadata.cs"
          }
        },
        {
          "condition": "(withAvalonia && noDefaultView)",
          "exclude": [
            "Views/DefaultPackageView*"
          ]
        }
      ]
    }
  ]
}
