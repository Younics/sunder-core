{
  "$schema": "http://json.schemastore.org/template",
  "author": "Sunder",
  "classifications": ["Sunder", "Package", "Avalonia"],
  "identity": "Sunder.Package",
  "name": "Sunder Package",
  "shortName": "sunder-package",
  "sourceName": "Sunder.Package.Template",
  "preferNameDirectory": true,
  "symbols": {
    "packageId": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "The lowercase dot-separated runtime package id written into generated package metadata.",
      "replaces": "SUNDER_PACKAGE_ID_TEXT"
    },
    "packageName": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "The package name shown in Sunder.",
      "replaces": "SUNDER_PACKAGE_NAME_TEXT"
    },
    "coordinatedPackageVersion": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "__SUNDER_COORDINATED_PACKAGE_VERSION__"
      },
      "replaces": "SUNDER_TEMPLATE_PACKAGE_VERSION"
    },
    "coordinatedPackageVersionRange": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "__SUNDER_COORDINATED_PACKAGE_VERSION_RANGE__"
      },
      "replaces": "SUNDER_TEMPLATE_PACKAGE_VERSION_RANGE"
    },
    "packageIdCSharp": {
      "type": "derived",
      "valueSource": "packageId",
      "valueTransform": "csharpString",
      "replaces": "SUNDER_PACKAGE_ID_CSHARP"
    },
    "packageNameCSharp": {
      "type": "derived",
      "valueSource": "packageName",
      "valueTransform": "csharpString",
      "replaces": "SUNDER_PACKAGE_NAME_CSHARP"
    },
    "packageNameXml": {
      "type": "derived",
      "valueSource": "packageName",
      "valueTransform": "xmlAttribute",
      "replaces": "SUNDER_PACKAGE_NAME_XML"
    },
    "withAvalonia": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "Add the Avalonia SDK and a default App package view.",
      "replaces": "SUNDER_WITH_AVALONIA"
    },
    "withStacks": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "Add the Stack SDK and a runtime Stack contributor example.",
      "replaces": "SUNDER_WITH_STACKS"
    },
    "withHostDependency": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "Add runtime package dependency metadata for another Sunder package."
    },
    "hostPackageId": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": "withHostDependency == true",
      "isEnabled": "withHostDependency == true",
      "description": "The package id this package depends on.",
      "replaces": "SUNDER_HOST_PACKAGE_ID_TEXT"
    },
    "hostPackageIdCSharp": {
      "type": "derived",
      "valueSource": "hostPackageId",
      "valueTransform": "csharpString",
      "replaces": "SUNDER_HOST_PACKAGE_ID_CSHARP"
    },
    "hostPackageVersionRange": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": ">=1.1.0 <1.2.0",
      "isEnabled": "withHostDependency == true",
      "description": "The runtime SemVer range accepted for the dependency."
    },
    "hostPackageVersionRangeCSharp": {
      "type": "derived",
      "valueSource": "hostPackageVersionRange",
      "valueTransform": "csharpString",
      "replaces": "SUNDER_HOST_PACKAGE_VERSION_RANGE_CSHARP"
    },
    "noDefaultView": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "With --withAvalonia, omit the default shell-visible view while retaining Avalonia SDK references."
    }
  },
  "forms": {
    "csharpBackslash": {
      "identifier": "replace",
      "pattern": "\\\\",
      "replacement": "\\\\"
    },
    "csharpQuote": {
      "identifier": "replace",
      "pattern": "\"",
      "replacement": "\\\""
    },
    "csharpCarriageReturn": {
      "identifier": "replace",
      "pattern": "\\r",
      "replacement": "\\r"
    },
    "csharpLineFeed": {
      "identifier": "replace",
      "pattern": "\\n",
      "replacement": "\\n"
    },
    "csharpTab": {
      "identifier": "replace",
      "pattern": "\\t",
      "replacement": "\\t"
    },
    "csharpString": {
      "identifier": "chain",
      "steps": [
        "csharpBackslash",
        "csharpQuote",
        "csharpCarriageReturn",
        "csharpLineFeed",
        "csharpTab"
      ]
    },
    "xml": {
      "identifier": "xmlEncode"
    },
    "xmlQuote": {
      "identifier": "replace",
      "pattern": "\"",
      "replacement": "&quot;"
    },
    "xmlAttribute": {
      "identifier": "chain",
      "steps": [
        "xml",
        "xmlQuote"
      ]
    }
  },
  "primaryOutputs": [
    {
      "path": "Sunder.Package.Template.csproj"
    }
  ],
  "sources": [
    {
      "source": "Sunder.Package.Template/",
      "target": "./",
      "modifiers": [
        {
          "condition": "(!withAvalonia)",
          "exclude": [
            "Sunder.Package.Template.App/**/*"
          ]
        },
        {
          "condition": "(!withStacks)",
          "exclude": [
            "Sunder.Package.Template.Runtime/StackSupport.cs",
            "Sunder.Package.Template.Runtime/Stacks.PackageReferences.props"
          ]
        },
        {
          "condition": "(!withHostDependency)",
          "exclude": [
            "PackageMetadata.host.cs"
          ],
          "rename": {
            "PackageMetadata.no-host.cs": "PackageMetadata.cs"
          }
        },
        {
          "condition": "(withHostDependency)",
          "exclude": [
            "PackageMetadata.no-host.cs"
          ],
          "rename": {
            "PackageMetadata.host.cs": "PackageMetadata.cs"
          }
        },
        {
          "condition": "(withAvalonia && noDefaultView)",
          "exclude": [
            "Sunder.Package.Template.App/PackageViews/**/*",
            "Sunder.Package.Template.App/PackageModule.with-view.cs"
          ],
          "rename": {
            "Sunder.Package.Template.App/PackageModule.no-view.cs": "Sunder.Package.Template.App/PackageModule.cs"
          }
        },
        {
          "condition": "(withAvalonia && !noDefaultView)",
          "exclude": [
            "Sunder.Package.Template.App/PackageModule.no-view.cs"
          ],
          "rename": {
            "Sunder.Package.Template.App/PackageModule.with-view.cs": "Sunder.Package.Template.App/PackageModule.cs"
          }
        }
      ]
    }
  ]
}
