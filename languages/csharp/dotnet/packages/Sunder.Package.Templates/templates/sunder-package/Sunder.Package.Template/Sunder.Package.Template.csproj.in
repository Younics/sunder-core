<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version>1.0.0</Version>
    <IsPackable>false</IsPackable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- Needed on the first restore, before the Build package's props exist. -->
    <EnableRuntimePackDownload>false</EnableRuntimePackDownload>
    <EnableAppHostPackDownload>false</EnableAppHostPackDownload>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SunderPackageProject>true</SunderPackageProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Sunder.Sdk.Worker" Version="SUNDER_TEMPLATE_PACKAGE_VERSION_RANGE" />
    <PackageReference Include="Sunder.Package.Build" Version="SUNDER_TEMPLATE_PACKAGE_VERSION_RANGE" PrivateAssets="all" />
  </ItemGroup>

  <Import Project="Views/Avalonia.PackageReferences.props" Condition="Exists('Views/Avalonia.PackageReferences.props')" />
  <Import Project="Stacks/Stacks.PackageReferences.props" Condition="Exists('Stacks/Stacks.PackageReferences.props')" />

</Project>
