<Project>
  <PropertyGroup>
    <SunderPackageBuildTaskAssembly Condition="'$(SunderPackageBuildTaskAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)..\tasks\$(TargetFramework)\Sunder.Package.Build.dll')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\tasks\$(TargetFramework)\Sunder.Package.Build.dll'))</SunderPackageBuildTaskAssembly>
    <SunderPackageBuildTaskAssembly Condition="'$(SunderPackageBuildTaskAssembly)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net10.0\Sunder.Package.Build.dll'))</SunderPackageBuildTaskAssembly>
    <SunderPackageBuildProject Condition="'$(SunderPackageBuildProject)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Sunder.Package.Build.csproj'))</SunderPackageBuildProject>
  </PropertyGroup>

  <ItemGroup Condition="Exists('$(SunderPackageBuildTaskAssembly)')">
    <_SunderPackageBuildTaskAssembly Include="$(SunderPackageBuildTaskAssembly)" />
  </ItemGroup>

  <PropertyGroup>
    <_SunderPackageBuildTaskShadowStampSource Condition="'$(_SunderPackageBuildTaskShadowStampSource)' == ''">@(_SunderPackageBuildTaskAssembly->'%(ModifiedTime)')</_SunderPackageBuildTaskShadowStampSource>
    <SunderPackageBuildTaskShadowStamp Condition="'$(SunderPackageBuildTaskShadowStamp)' == '' and '$(_SunderPackageBuildTaskShadowStampSource)' != ''">v$([MSBuild]::StableStringHash('$(_SunderPackageBuildTaskShadowStampSource)'))</SunderPackageBuildTaskShadowStamp>
    <SunderPackageBuildTaskShadowStamp Condition="'$(SunderPackageBuildTaskShadowStamp)' == ''">bootstrap</SunderPackageBuildTaskShadowStamp>
    <SunderPackageBuildTaskShadowDirectory Condition="'$(SunderPackageBuildTaskShadowDirectory)' == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'sunder-package-build-tasks', '$(Configuration)', '$(TargetFramework)', '$(SunderPackageBuildTaskShadowStamp)'))))\</SunderPackageBuildTaskShadowDirectory>
    <SunderPackageBuildTaskShadowAssembly Condition="'$(SunderPackageBuildTaskShadowAssembly)' == ''">$(SunderPackageBuildTaskShadowDirectory)Sunder.Package.Build.dll</SunderPackageBuildTaskShadowAssembly>
    <SunderGeneratedPackageManifest Condition="'$(SunderGeneratedPackageManifest)' == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'sunder-package.json'))))</SunderGeneratedPackageManifest>
    <SunderPackageRuntimeIdentifiers Condition="'$(SunderPackageRuntimeIdentifiers)' == ''">win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</SunderPackageRuntimeIdentifiers>
    <SunderPackageAssetsDirectory Condition="'$(SunderPackageAssetsDirectory)' == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Assets'))))</SunderPackageAssetsDirectory>
    <SunderPackagePrimaryProject Condition="'$(SunderPackagePrimaryProject)' == ''">false</SunderPackagePrimaryProject>
    <SunderPackageInnerBuild Condition="'$(SunderPackageInnerBuild)' == ''">false</SunderPackageInnerBuild>
    <SunderPackageUsePrebuiltLeaves Condition="'$(SunderPackageUsePrebuiltLeaves)' == ''">false</SunderPackageUsePrebuiltLeaves>
    <SunderPackageComposeRuntimeIdentifiers Condition="'$(SunderPackageComposeRuntimeIdentifiers)' == ''">$(SunderPackageRuntimeIdentifiers)</SunderPackageComposeRuntimeIdentifiers>
    <_SunderPackageBaseOutputPath Condition="'$(BaseOutputPath)' != ''">$(BaseOutputPath)</_SunderPackageBaseOutputPath>
    <_SunderPackageBaseOutputPath Condition="'$(_SunderPackageBaseOutputPath)' == ''">bin</_SunderPackageBaseOutputPath>
    <SunderPackageComposedOutputRoot Condition="'$(SunderPackageComposedOutputRoot)' == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(_SunderPackageBaseOutputPath)', '$(Configuration)', '$(TargetFramework)'))))</SunderPackageComposedOutputRoot>
    <SunderPackageComposedOutputPath Condition="'$(SunderPackageComposedOutputPath)' == ''">$([System.IO.Path]::Combine('$(SunderPackageComposedOutputRoot)', 'sunder-dev'))</SunderPackageComposedOutputPath>
    <SunderPackagePrimaryTargetLeafRoot Condition="'$(SunderPackagePrimaryTargetLeafRoot)' == ''">$(SunderPackageComposedOutputRoot)</SunderPackagePrimaryTargetLeafRoot>
    <SunderPackageAppTargetFramework Condition="'$(SunderPackageAppTargetFramework)' == ''">$(TargetFramework)</SunderPackageAppTargetFramework>
    <_SunderPackagePreparationTarget Condition="'$(SunderPackagePrimaryProject)' == 'true'">AggregateSunderPackage</_SunderPackagePreparationTarget>
    <_SunderPackagePreparationTarget Condition="'$(_SunderPackagePreparationTarget)' == ''">Build;EmitSunderDevOutput</_SunderPackagePreparationTarget>
  </PropertyGroup>

  <ItemGroup>
    <_SunderPackageRuntimeIdentifier Include="$(SunderPackageRuntimeIdentifiers)" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(SunderPackageBuildProject)') and '$(MSBuildProjectFullPath)' != '$(SunderPackageBuildProject)'">
    <ProjectReference Include="$(SunderPackageBuildProject)"
                      ReferenceOutputAssembly="false"
                      GlobalPropertiesToRemove="Version;VersionPrefix;VersionSuffix;PackageVersion;InformationalVersion"
                      PrivateAssets="all" />
  </ItemGroup>

  <UsingTask TaskName="Sunder.Package.Build.Tasks.GenerateSunderPackageManifestTask"
             AssemblyFile="$(SunderPackageBuildTaskShadowAssembly)" />
  <UsingTask TaskName="Sunder.Package.Build.Tasks.PackSunderPackageTask"
             AssemblyFile="$(SunderPackageBuildTaskShadowAssembly)" />
  <UsingTask TaskName="Sunder.Package.Build.Tasks.ValidateSunderDevOutputPathTask"
             AssemblyFile="$(SunderPackageBuildTaskShadowAssembly)" />
  <UsingTask TaskName="Sunder.Package.Build.Tasks.EmitSunderDevOutputTask"
             AssemblyFile="$(SunderPackageBuildTaskShadowAssembly)" />
  <UsingTask TaskName="Sunder.Package.Build.Tasks.AggregateSunderPackageTask"
             AssemblyFile="$(SunderPackageBuildTaskShadowAssembly)" />
  <UsingTask TaskName="Sunder.Package.Build.Tasks.CleanSunderPackageOutputTask"
             AssemblyFile="$(SunderPackageBuildTaskShadowAssembly)" />
  <UsingTask TaskName="Sunder.Package.Build.Tasks.GenerateSunderRpcBindingsTask"
             AssemblyFile="$(SunderPackageBuildTaskShadowAssembly)" />

  <Target Name="_BuildSunderPackageBuildTasks"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and Exists('$(SunderPackageBuildProject)') and !Exists('$(SunderPackageBuildTaskAssembly)')">
    <MSBuild Projects="$(SunderPackageBuildProject)"
              Targets="Build"
              Properties="Configuration=$(Configuration);TargetFramework=net10.0" />
  </Target>

  <Target Name="_PrepareSunderPackageBuildTasks"
          DependsOnTargets="_BuildSunderPackageBuildTasks"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <PropertyGroup>
      <_SunderPackageBuildTaskSourceDirectory>$([System.IO.Path]::GetDirectoryName('$(SunderPackageBuildTaskAssembly)'))\</_SunderPackageBuildTaskSourceDirectory>
    </PropertyGroup>

    <MakeDir Directories="$(SunderPackageBuildTaskShadowDirectory)" />
    <ItemGroup>
      <_SunderPackageBuildTaskDependencyFiles Include="$(_SunderPackageBuildTaskSourceDirectory)*.dll" />
    </ItemGroup>
    <Copy SourceFiles="@(_SunderPackageBuildTaskDependencyFiles)"
          DestinationFiles="@(_SunderPackageBuildTaskDependencyFiles->'$(SunderPackageBuildTaskShadowDirectory)%(Filename)%(Extension)')" />
  </Target>

  <Target Name="GenerateSunderRpcBindings"
          BeforeTargets="CoreCompile"
          DependsOnTargets="_PrepareSunderPackageBuildTasks"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true'">
    <GenerateSunderRpcBindingsTask Bindings="@(SunderRpcBinding)"
                                   ProjectDirectory="$(MSBuildProjectDirectory)"
                                   IntermediateOutputPath="$(IntermediateOutputPath)">
      <Output TaskParameter="CompileItems" ItemName="Compile" />
      <Output TaskParameter="FileWrites" ItemName="FileWrites" />
      <Output TaskParameter="BindingSnapshots" ItemName="_SunderRpcBindingSnapshot" />
    </GenerateSunderRpcBindingsTask>
  </Target>

  <Target Name="GenerateSunderPackageManifest"
           DependsOnTargets="_PrepareSunderPackageBuildTasks;GenerateSunderRpcBindings"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackageProject)' != 'false'">
    <ItemGroup>
      <_SunderAuthoredAssembly Include="$(TargetPath)" />
      <_SunderAuthoredAssembly Include="@(ReferenceCopyLocalPaths)"
                               Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
    <GenerateSunderPackageManifestTask TargetAssemblyPath="$(TargetPath)"
                                       ManifestOutputPath="$(SunderGeneratedPackageManifest)"
                                       EntryAssembly="$(TargetFileName)"
                                       PackageVersion="$(Version)"
                                        ProjectDirectory="$(MSBuildProjectDirectory)"
                                        AssetsDirectory="$(SunderPackageAssetsDirectory)"
                                        TargetFramework="$(TargetFramework)"
                                       SdkPackageVersion="$(SunderSdkPackageVersion)"
                                       SdkCapabilities="@(SunderSdkCapability)"
                                       ReferencePaths="@(ReferencePath)"
                                        RuntimeCopyLocalPaths="@(ReferenceCopyLocalPaths)"
                                        AuthoredAssemblyPaths="@(_SunderAuthoredAssembly)"
                                        DynamicAccessAcknowledgements="@(SunderSdkDynamicAccess)"
                                         RuntimeIdentifiers="@(_SunderPackageRuntimeIdentifier)"
                                         PackageTargets="@(SunderPackageTarget)"
                                          PackageViews="@(SunderPackageView)"
                                          ContractBundles="@(SunderContractBundle)"
                                          BindingSnapshots="@(_SunderRpcBindingSnapshot)"
                                          UsesContracts="@(SunderUsesContract)"
                                         RpcProviders="@(SunderRpcProvider)"
                                         RuntimeIdentifier="$(RuntimeIdentifier)"
                                         OutputType="$(OutputType)"
                                         SelfContained="$(SelfContained)"
                                         UseAppHost="$(UseAppHost)"
                                         PublishSingleFile="$(PublishSingleFile)">
      <Output TaskParameter="ResolvedTargets" ItemName="_SunderResolvedPackageTarget" />
      <Output TaskParameter="ResolvedContractFiles" ItemName="_SunderResolvedContractFile" />
      <Output TaskParameter="HasWorkerTarget" PropertyName="_SunderHasWorkerTarget" />
      <Output TaskParameter="WorkerEntryPointRelativePath" PropertyName="SunderPackageWorkerEntryPointRelativePath" />
    </GenerateSunderPackageManifestTask>
  </Target>

  <Target Name="_CollectSunderWorkerFiles"
          DependsOnTargets="ComputeFilesToPublish"
          Condition="'$(_SunderHasWorkerTarget)' == 'true'">
    <PropertyGroup Condition="'$(SunderPackageWorkerSigningTargets)' != ''">
      <_SunderPackageWorkerSigningDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'sunder-worker-signing'))))\</_SunderPackageWorkerSigningDirectory>
    </PropertyGroup>
    <RemoveDir Directories="$(_SunderPackageWorkerSigningDirectory)"
               Condition="'$(SunderPackageWorkerSigningTargets)' != ''" />
    <MakeDir Directories="$(_SunderPackageWorkerSigningDirectory)"
             Condition="'$(SunderPackageWorkerSigningTargets)' != ''" />
    <ItemGroup>
      <_SunderWorkerSourceFile Include="@(ResolvedFileToPublish)"
                               Condition="'$(SunderPackageWorkerSigningTargets)' != ''" />
      <_SunderWorkerFile Include="@(ResolvedFileToPublish)"
                         Condition="'$(SunderPackageWorkerSigningTargets)' == ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_SunderWorkerSourceFile)"
          DestinationFiles="@(_SunderWorkerSourceFile->'$(_SunderPackageWorkerSigningDirectory)%(RelativePath)')"
          Condition="'$(SunderPackageWorkerSigningTargets)' != ''" />
    <ItemGroup Condition="'$(SunderPackageWorkerSigningTargets)' != ''">
      <_SunderWorkerFile Include="@(_SunderWorkerSourceFile->'$(_SunderPackageWorkerSigningDirectory)%(RelativePath)')">
        <RelativePath>%(_SunderWorkerSourceFile.RelativePath)</RelativePath>
      </_SunderWorkerFile>
      <SunderPackageWorkerSigningFile Include="@(_SunderWorkerFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_RunSunderPackageWorkerSigning"
          DependsOnTargets="_CollectSunderWorkerFiles;$(SunderPackageWorkerSigningTargets)"
          Condition="'$(_SunderHasWorkerTarget)' == 'true'" />

  <Target Name="_ValidateSunderDevOutputPath"
            DependsOnTargets="_PrepareSunderPackageBuildTasks"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackageProject)' != 'false'">
    <PropertyGroup>
      <SunderDevOutputPath Condition="'$(SunderDevOutputPath)' == ''">$([System.IO.Path]::Combine('$(TargetDir)', 'sunder-dev'))</SunderDevOutputPath>
      <SunderDevOutputDiscoveryRoot Condition="'$(SunderDevOutputDiscoveryRoot)' == ''">$(TargetDir)</SunderDevOutputDiscoveryRoot>
    </PropertyGroup>

    <ValidateSunderDevOutputPathTask DevOutputPath="$(SunderDevOutputPath)"
                                      DiscoveryRoot="$(SunderDevOutputDiscoveryRoot)"
                                      ProjectDirectory="$(MSBuildProjectDirectory)"
                                      TargetDirectory="$(TargetDir)">
      <Output TaskParameter="NormalizedDevOutputPath" PropertyName="SunderDevOutputPath" />
      <Output TaskParameter="OwnershipMarkerPath" PropertyName="SunderDevOutputMarkerPath" />
    </ValidateSunderDevOutputPathTask>
  </Target>

  <Target Name="EmitSunderDevOutput"
            AfterTargets="Build"
            DependsOnTargets="GenerateSunderPackageManifest;_RunSunderPackageWorkerSigning;_ValidateSunderDevOutputPath"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackageProject)' != 'false'">
    <ItemGroup>
      <_SunderRuntimeFiles Include="$(TargetDir)*.dll" />
      <_SunderRuntimeFiles Include="$(TargetDir)*.pdb" />
      <_SunderRuntimeFiles Include="$(TargetDir)*.deps.json" />
      <_SunderRuntimeFiles Include="$(TargetDir)*.runtimeconfig.json" />
      <_SunderRuntimeFiles Include="$(TargetDir)**\*.resources.dll"
                           Exclude="$(TargetDir)runtimes\**\*;$(SunderDevOutputPath)**\*" />
      <_SunderNativeRuntimeFiles Include="$(TargetDir)runtimes\**\*"
                                 Condition="Exists('$(TargetDir)runtimes')" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Sunder.Sdk.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Sunder.Sdk.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Sunder.Sdk.Stacks.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Sunder.Sdk.Stacks.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Sunder.Sdk.Avalonia.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Sunder.Sdk.Avalonia.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Microsoft.Extensions.DependencyInjection.Abstractions.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Microsoft.Extensions.Logging.Abstractions.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Microsoft.Extensions.Logging.Abstractions.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Controls.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Controls.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Base.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Base.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Markup.Xaml.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Markup.Xaml.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Markup.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Markup.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Dialogs.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Dialogs.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.DesignerSupport.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.DesignerSupport.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Remote.Protocol.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Remote.Protocol.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Metal.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Metal.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.OpenGL.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.OpenGL.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Vulkan.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Vulkan.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.MicroCom.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.MicroCom.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)MicroCom.Runtime.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)MicroCom.Runtime.pdb" />
      <_SunderAssetFiles Include="$(SunderPackageAssetsDirectory)\**\*"
                         Condition="Exists('$(SunderPackageAssetsDirectory)')" />
    </ItemGroup>

    <EmitSunderDevOutputTask ManifestPath="$(SunderGeneratedPackageManifest)"
                             DevPackagePath="$(SunderDevOutputPath)"
                             DiscoveryRoot="$(SunderDevOutputDiscoveryRoot)"
                             TargetDirectory="$(TargetDir)"
                             AssetsDirectory="$(SunderPackageAssetsDirectory)"
                               ManagedFiles="@(_SunderRuntimeFiles)"
                               NativeRuntimeFiles="@(_SunderNativeRuntimeFiles)"
                               WorkerFiles="@(_SunderWorkerFile)"
                               AssetFiles="@(_SunderAssetFiles)"
                              ContractFiles="@(_SunderResolvedContractFile)" />
  </Target>

  <Target Name="_ValidateSunderPackagePrimaryProject"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true'">
    <PropertyGroup>
      <_SunderPackageAppProjectFullPath Condition="'$(SunderPackageAppProject)' != ''">$([System.IO.Path]::GetFullPath('$(SunderPackageAppProject)', '$(MSBuildProjectDirectory)'))</_SunderPackageAppProjectFullPath>
      <_SunderPackageAppProjectDirectory Condition="'$(_SunderPackageAppProjectFullPath)' != ''">$([System.IO.Path]::GetDirectoryName('$(_SunderPackageAppProjectFullPath)'))</_SunderPackageAppProjectDirectory>
      <SunderPackageAppTargetDiscoveryRoot Condition="'$(SunderPackageAppTargetDiscoveryRoot)' == '' and '$(_SunderPackageAppProjectDirectory)' != ''">$([System.IO.Path]::Combine('$(_SunderPackageAppProjectDirectory)', 'bin', '$(Configuration)', '$(SunderPackageAppTargetFramework)'))</SunderPackageAppTargetDiscoveryRoot>
      <SunderPackageAppTargetLeaf Condition="'$(SunderPackageAppTargetLeaf)' == '' and '$(SunderPackageAppTargetDiscoveryRoot)' != ''">$([System.IO.Path]::Combine('$(SunderPackageAppTargetDiscoveryRoot)', 'sunder-dev'))</SunderPackageAppTargetLeaf>
    </PropertyGroup>

    <ItemGroup>
      <_SunderPackageConfiguredRuntimeIdentifier Include="$(SunderPackageRuntimeIdentifiers)" />
      <_SunderPackageSelectedRuntimeIdentifier Include="$(SunderPackageComposeRuntimeIdentifiers)" />
      <_SunderPackageUnknownRuntimeIdentifier Include="@(_SunderPackageSelectedRuntimeIdentifier)"
                                              Exclude="@(_SunderPackageConfiguredRuntimeIdentifier)" />
    </ItemGroup>

    <Error Condition="'$(SunderPackageAppProject)' != '' and !Exists('$(_SunderPackageAppProjectFullPath)')"
           Text="SunderPackageAppProject '$(_SunderPackageAppProjectFullPath)' does not exist." />
    <Error Condition="'@(_SunderPackageSelectedRuntimeIdentifier)' == ''"
           Text="SunderPackageComposeRuntimeIdentifiers must select at least one configured RID." />
    <Error Condition="'@(_SunderPackageUnknownRuntimeIdentifier)' != ''"
           Text="SunderPackageComposeRuntimeIdentifiers contains unconfigured RID(s): @(_SunderPackageUnknownRuntimeIdentifier, ', ')." />
    <Error Condition="'$(SunderPackageUsePrebuiltLeaves)' == 'true' and '$(BuildProjectReferences)' != 'false'"
           Text="SunderPackageUsePrebuiltLeaves=true requires BuildProjectReferences=false so signed prebuilt inputs cannot trigger Worker or App builds." />
  </Target>

  <Target Name="_RejectSunderPackageBuildInPrebuiltMode"
          BeforeTargets="PrepareForBuild;Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true' and '$(SunderPackageUsePrebuiltLeaves)' == 'true'">
    <Error Text="SunderPackageUsePrebuiltLeaves=true does not permit Build. Invoke PackSunderPackage with BuildProjectReferences=false." />
  </Target>

  <Target Name="_BuildSunderPackageApp"
          DependsOnTargets="_ValidateSunderPackagePrimaryProject"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true' and '$(SunderPackageUsePrebuiltLeaves)' != 'true' and '$(SunderPackageAppProject)' != ''">
    <MSBuild Projects="$(_SunderPackageAppProjectFullPath)"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(SunderPackageAppTargetFramework)"
             RemoveProperties="RuntimeIdentifier;SunderPackagePrimaryProject;SunderPackageInnerBuild;SunderPackageUsePrebuiltLeaves;SunderPackageComposeRuntimeIdentifiers"
             BuildInParallel="false"
             StopOnFirstFailure="true" />
  </Target>

  <Target Name="_BuildSunderPackagePrimaryLeaves"
          DependsOnTargets="_ValidateSunderPackagePrimaryProject"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true' and '$(SunderPackageUsePrebuiltLeaves)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=%(_SunderPackageSelectedRuntimeIdentifier.Identity);SunderPackageInnerBuild=true;SunderPackageUsePrebuiltLeaves=false"
             BuildInParallel="false"
             StopOnFirstFailure="true" />
  </Target>

  <Target Name="ComposeSunderPackage"
          AfterTargets="Build"
          DependsOnTargets="EmitSunderDevOutput;_ValidateSunderPackagePrimaryProject;_BuildSunderPackageApp;_PrepareSunderPackageBuildTasks"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true' and '$(SunderPackageUsePrebuiltLeaves)' != 'true'">
    <ItemGroup>
      <_SunderPackageCompositionLeaf Remove="@(_SunderPackageCompositionLeaf)" />
      <_SunderPackageCompositionLeaf Include="$(SunderDevOutputPath)"
                                     DiscoveryRoot="$(SunderDevOutputDiscoveryRoot)" />
      <_SunderPackageCompositionLeaf Include="$(SunderPackageAppTargetLeaf)"
                                     DiscoveryRoot="$(SunderPackageAppTargetDiscoveryRoot)"
                                     Condition="'$(SunderPackageAppTargetLeaf)' != ''" />
      <_SunderPackageCompositionLeaf Include="@(SunderPackageTargetLeaf)" />
      <_SunderPackageCompositionLeaf Include="@(SunderNodePackageTargetLeaf)" />
    </ItemGroup>

    <AggregateSunderPackageTask TargetLeaves="@(_SunderPackageCompositionLeaf)"
                                OutputPath="$(SunderPackageComposedOutputPath)"
                                OutputDiscoveryRoot="$(SunderPackageComposedOutputRoot)"
                                ProjectDirectory="$(MSBuildProjectDirectory)"
                                TargetDirectory="$(SunderPackageComposedOutputRoot)"
                                ExpectedPackageVersion="$(Version)" />
  </Target>

  <Target Name="AggregateSunderPackage"
          DependsOnTargets="_ValidateSunderPackagePrimaryProject;_BuildSunderPackagePrimaryLeaves;_BuildSunderPackageApp;_PrepareSunderPackageBuildTasks"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true'">
    <ItemGroup>
      <_SunderPackageCompositionLeaf Remove="@(_SunderPackageCompositionLeaf)" />
      <_SunderPackageCompositionLeaf Include="$([System.IO.Path]::Combine('$(SunderPackagePrimaryTargetLeafRoot)', '%(_SunderPackageSelectedRuntimeIdentifier.Identity)', 'sunder-dev'))">
        <DiscoveryRoot>$([System.IO.Path]::Combine('$(SunderPackagePrimaryTargetLeafRoot)', '%(_SunderPackageSelectedRuntimeIdentifier.Identity)'))</DiscoveryRoot>
      </_SunderPackageCompositionLeaf>
      <_SunderPackageCompositionLeaf Include="$(SunderPackageAppTargetLeaf)"
                                     DiscoveryRoot="$(SunderPackageAppTargetDiscoveryRoot)"
                                     Condition="'$(SunderPackageAppTargetLeaf)' != ''" />
      <_SunderPackageCompositionLeaf Include="@(SunderPackageTargetLeaf)" />
      <_SunderPackageCompositionLeaf Include="@(SunderNodePackageTargetLeaf)" />
    </ItemGroup>

    <AggregateSunderPackageTask TargetLeaves="@(_SunderPackageCompositionLeaf)"
                                  OutputPath="$(SunderPackageComposedOutputPath)"
                                  OutputDiscoveryRoot="$(SunderPackageComposedOutputRoot)"
                                  ProjectDirectory="$(MSBuildProjectDirectory)"
                                  TargetDirectory="$(SunderPackageComposedOutputRoot)"
                                  ExpectedPackageVersion="$(Version)">
      <Output TaskParameter="NormalizedOutputPath" PropertyName="SunderPackageComposedOutputPath" />
    </AggregateSunderPackageTask>
  </Target>

  <Target Name="CleanSunderPackageComposedOutput"
          AfterTargets="Clean"
          DependsOnTargets="_PrepareSunderPackageBuildTasks"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true'">
    <CleanSunderPackageOutputTask OutputPath="$(SunderPackageComposedOutputPath)"
                                  OutputDiscoveryRoot="$(SunderPackageComposedOutputRoot)"
                                  ProjectDirectory="$(MSBuildProjectDirectory)"
                                  TargetDirectory="$(SunderPackageComposedOutputRoot)" />
  </Target>

  <Target Name="PackSunderPackage"
            DependsOnTargets="$(_SunderPackagePreparationTarget)"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackageProject)' != 'false'">
    <PropertyGroup>
      <_SunderPackageVersion Condition="'$(Version)' != ''">$(Version)</_SunderPackageVersion>
      <_SunderPackageVersion Condition="'$(_SunderPackageVersion)' == ''">1.1.0</_SunderPackageVersion>
      <SunderPackageFileName Condition="'$(SunderPackageFileName)' == ''">$(AssemblyName).$(_SunderPackageVersion).sunderpkg</SunderPackageFileName>
      <_SunderPackagePackOutputRoot Condition="'$(SunderPackagePrimaryProject)' == 'true'">$(SunderPackageComposedOutputRoot)</_SunderPackagePackOutputRoot>
      <_SunderPackagePackOutputRoot Condition="'$(_SunderPackagePackOutputRoot)' == ''">$(TargetDir)</_SunderPackagePackOutputRoot>
      <SunderPackageOutputPath Condition="'$(SunderPackageOutputPath)' == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(_SunderPackagePackOutputRoot)', '$(SunderPackageFileName)'))))</SunderPackageOutputPath>
      <_SunderPackagePackInputPath Condition="'$(SunderPackagePrimaryProject)' == 'true'">$(SunderPackageComposedOutputPath)</_SunderPackagePackInputPath>
      <_SunderPackagePackInputPath Condition="'$(_SunderPackagePackInputPath)' == ''">$(SunderDevOutputPath)</_SunderPackagePackInputPath>
      <_SunderPackagePackDiscoveryRoot Condition="'$(SunderPackagePrimaryProject)' == 'true'">$(SunderPackageComposedOutputRoot)</_SunderPackagePackDiscoveryRoot>
      <_SunderPackagePackDiscoveryRoot Condition="'$(_SunderPackagePackDiscoveryRoot)' == ''">$(SunderDevOutputDiscoveryRoot)</_SunderPackagePackDiscoveryRoot>
    </PropertyGroup>

    <PackSunderPackageTask DevPackagePath="$(_SunderPackagePackInputPath)"
                             DevPackageDiscoveryRoot="$(_SunderPackagePackDiscoveryRoot)"
                             PackageOutputPath="$(SunderPackageOutputPath)"
                             ProjectDirectory="$(MSBuildProjectDirectory)" />
  </Target>

  <Target Name="PackSunderPackageOnPublish"
            AfterTargets="Publish"
            DependsOnTargets="$(_SunderPackagePreparationTarget)"
           Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackageProject)' != 'false'">
    <PropertyGroup>
      <_SunderPackageVersion Condition="'$(Version)' != ''">$(Version)</_SunderPackageVersion>
      <_SunderPackageVersion Condition="'$(_SunderPackageVersion)' == ''">1.1.0</_SunderPackageVersion>
      <SunderPackageFileName Condition="'$(SunderPackageFileName)' == ''">$(AssemblyName).$(_SunderPackageVersion).sunderpkg</SunderPackageFileName>
      <SunderPublishPackageOutputPath Condition="'$(SunderPublishPackageOutputPath)' == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(PublishDir)', '$(SunderPackageFileName)'))))</SunderPublishPackageOutputPath>
      <_SunderPackagePublishInputPath Condition="'$(SunderPackagePrimaryProject)' == 'true'">$(SunderPackageComposedOutputPath)</_SunderPackagePublishInputPath>
      <_SunderPackagePublishInputPath Condition="'$(_SunderPackagePublishInputPath)' == ''">$(SunderDevOutputPath)</_SunderPackagePublishInputPath>
      <_SunderPackagePublishDiscoveryRoot Condition="'$(SunderPackagePrimaryProject)' == 'true'">$(SunderPackageComposedOutputRoot)</_SunderPackagePublishDiscoveryRoot>
      <_SunderPackagePublishDiscoveryRoot Condition="'$(_SunderPackagePublishDiscoveryRoot)' == ''">$(SunderDevOutputDiscoveryRoot)</_SunderPackagePublishDiscoveryRoot>
    </PropertyGroup>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(SunderPublishPackageOutputPath)'))" />
    <PackSunderPackageTask DevPackagePath="$(_SunderPackagePublishInputPath)"
                             DevPackageDiscoveryRoot="$(_SunderPackagePublishDiscoveryRoot)"
                             PackageOutputPath="$(SunderPublishPackageOutputPath)"
                             ProjectDirectory="$(MSBuildProjectDirectory)" />
  </Target>
</Project>
