<Project>
  <!-- Capabilities are logical IDs, not files. Keep their evaluated values available to manifest inference. -->
  <ItemDefinitionGroup>
    <SunderSdkCapability>
      <Visible>false</Visible>
    </SunderSdkCapability>
  </ItemDefinitionGroup>
  <ItemGroup>
    <AvailableItemName Include="SunderSdkCapability" Visible="false" />
  </ItemGroup>

  <PropertyGroup Condition="'$(SunderRpcProjectExportBuild)' == 'true'">
    <!-- The neutral export's intermediate directory belongs only to its package
         project. Let source SDK/helper references use their own canonical layout
         and request identity rather than writing compiler/FileList state here. -->
    <_GlobalPropertiesToRemoveFromProjectReferences>$(_GlobalPropertiesToRemoveFromProjectReferences);IntermediateOutputPath;AppendRuntimeIdentifierToOutputPath;SunderRpcProjectExportBuild;SunderRpcExpectedAppProject;SunderPackagePrimaryProject;SunderPackageInnerBuild</_GlobalPropertiesToRemoveFromProjectReferences>
    <RuntimeIdentifier></RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>

  <PropertyGroup>
    <_SunderPackageBuildTaskAssemblyWasSpecified Condition="'$(SunderPackageBuildTaskAssembly)' != ''">true</_SunderPackageBuildTaskAssemblyWasSpecified>
    <SunderPackageBuildTaskTargetFramework Condition="'$(SunderPackageBuildTaskTargetFramework)' == ''">net10.0</SunderPackageBuildTaskTargetFramework>
    <SunderPackageBuildTaskSourceIsImmutable Condition="'$(SunderPackageBuildTaskSourceIsImmutable)' == '' and '$(SunderPackageBuildTaskAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)..\tasks\$(SunderPackageBuildTaskTargetFramework)\Sunder.Package.Build.dll')">true</SunderPackageBuildTaskSourceIsImmutable>
    <SunderPackageBuildTaskAssembly Condition="'$(SunderPackageBuildTaskAssembly)' == '' and Exists('$(MSBuildThisFileDirectory)..\tasks\$(SunderPackageBuildTaskTargetFramework)\Sunder.Package.Build.dll')">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\tasks\$(SunderPackageBuildTaskTargetFramework)\Sunder.Package.Build.dll'))</SunderPackageBuildTaskAssembly>
    <SunderPackageBuildProject Condition="'$(SunderPackageBuildProject)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Sunder.Package.Build.csproj'))</SunderPackageBuildProject>
    <SunderPackageBuildTaskSourceIsImmutable Condition="'$(SunderPackageBuildTaskSourceIsImmutable)' == ''">false</SunderPackageBuildTaskSourceIsImmutable>
    <_SunderPackageBuildTaskGlobalPropertiesToRemove>Version;VersionPrefix;VersionSuffix;PackageVersion;InformationalVersion;TargetFramework;TargetFrameworks;Platform;PlatformName;PlatformTarget;Prefer32Bit;RuntimeIdentifier;RuntimeIdentifiers;SelfContained;UseAppHost;PublishSingleFile;PublishTrimmed;PackageOutputPath;BuildProjectReferences;SunderPackagePrimaryProject;SunderPackageInnerBuild;SunderPackageUsePrebuiltLeaves;SunderPackageComposeRuntimeIdentifiers;SunderRpcProjectExportBuild;SunderRpcProjectImportBuild;SunderRpcPackageProjectExportPath;SunderRpcPackageProjectExportSha256;SunderRpcPackageProjectExportProjectIdentity;SunderRpcPackageProjectExportConfiguration;SunderRpcPackageProjectExportTargetFramework;SunderRpcPackageProjectExportPackageId;SunderRpcPackageProjectExportPackageVersion;SunderRpcExpectedAppProject;SunderPackageRootProject;BaseOutputPath;OutputPath;OutDir;UseArtifactsOutput;ArtifactsPath;ArtifactsPivots;BaseIntermediateOutputPath;IntermediateOutputPath;MSBuildProjectExtensionsPath;AppendTargetFrameworkToOutputPath;AppendRuntimeIdentifierToOutputPath;AppendPlatformToOutputPath</_SunderPackageBuildTaskGlobalPropertiesToRemove>
    <_SunderPackageBuildProjectFullPath>$([System.IO.Path]::GetFullPath('$(SunderPackageBuildProject)', '$(MSBuildProjectDirectory)'))</_SunderPackageBuildProjectFullPath>
    <_SunderPackageBuildTaskProjectDirectory>$([System.IO.Path]::GetDirectoryName('$(_SunderPackageBuildProjectFullPath)'))</_SunderPackageBuildTaskProjectDirectory>
    <SunderPackageBuildTaskContractKey Condition="'$(SunderPackageBuildTaskContractKey)' == ''">source-contract-v3</SunderPackageBuildTaskContractKey>
    <SunderPackageBuildTaskHostArchitecture Condition="'$(SunderPackageBuildTaskHostArchitecture)' == '' and $([System.String]::Copy('$(NETCoreSdkRuntimeIdentifier)').EndsWith('-x86'))">x86</SunderPackageBuildTaskHostArchitecture>
    <SunderPackageBuildTaskHostArchitecture Condition="'$(SunderPackageBuildTaskHostArchitecture)' == '' and $([System.String]::Copy('$(NETCoreSdkRuntimeIdentifier)').EndsWith('-x64'))">x64</SunderPackageBuildTaskHostArchitecture>
    <SunderPackageBuildTaskHostArchitecture Condition="'$(SunderPackageBuildTaskHostArchitecture)' == '' and $([System.String]::Copy('$(NETCoreSdkRuntimeIdentifier)').EndsWith('-arm64'))">arm64</SunderPackageBuildTaskHostArchitecture>
    <SunderPackageBuildTaskHostArchitecture Condition="'$(SunderPackageBuildTaskHostArchitecture)' == ''">CurrentArchitecture</SunderPackageBuildTaskHostArchitecture>
    <SunderPackageBuildTaskBootstrapConfiguration Condition="'$(SunderPackageBuildTaskBootstrapConfiguration)' == '' and '$(_SunderPackageBuildTaskAssemblyWasSpecified)' == 'true'">$(Configuration)</SunderPackageBuildTaskBootstrapConfiguration>
    <SunderPackageBuildTaskBootstrapConfiguration Condition="'$(SunderPackageBuildTaskBootstrapConfiguration)' == '' and !Exists('$(_SunderPackageBuildProjectFullPath)')">$(Configuration)</SunderPackageBuildTaskBootstrapConfiguration>
    <SunderPackageBuildTaskBootstrapConfiguration Condition="'$(SunderPackageBuildTaskBootstrapConfiguration)' == ''">$(Configuration)-sunder-bootstrap</SunderPackageBuildTaskBootstrapConfiguration>
    <SunderPackageBuildTaskAssembly Condition="'$(SunderPackageBuildTaskAssembly)' == '' and Exists('$(_SunderPackageBuildProjectFullPath)')">$([System.IO.Path]::Combine('$(_SunderPackageBuildTaskProjectDirectory)', 'bin', '$(SunderPackageBuildTaskBootstrapConfiguration)', 'net10.0', 'Sunder.Package.Build.dll'))</SunderPackageBuildTaskAssembly>
    <SunderPackageBuildTaskAssembly Condition="'$(SunderPackageBuildTaskAssembly)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\bin\$(Configuration)\net10.0\Sunder.Package.Build.dll'))</SunderPackageBuildTaskAssembly>
    <_SunderPackageBuildTaskAssemblyFullPath>$([System.IO.Path]::GetFullPath('$(SunderPackageBuildTaskAssembly)', '$(MSBuildProjectDirectory)'))</_SunderPackageBuildTaskAssemblyFullPath>
    <SunderPackageBuildTaskShadowStamp Condition="'$(SunderPackageBuildTaskShadowStamp)' == '' and '$(SunderPackageBuildTaskSourceIsImmutable)' == 'true'">immutable-v1-$([MSBuild]::StableStringHash('$(_SunderPackageBuildTaskAssemblyFullPath)'))</SunderPackageBuildTaskShadowStamp>
    <SunderPackageBuildTaskShadowStamp Condition="'$(SunderPackageBuildTaskShadowStamp)' == ''">$(SunderPackageBuildTaskContractKey)-$([MSBuild]::StableStringHash('$(MSBuildProjectFullPath)'))</SunderPackageBuildTaskShadowStamp>
    <SunderPackageBuildTaskShadowRoot Condition="'$(SunderPackageBuildTaskShadowRoot)' == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', 'sunder-package-build-tasks', '$(Configuration)', '$(TargetFramework)'))))</SunderPackageBuildTaskShadowRoot>
    <_SunderPackageBuildTaskShadowRootFullPath>$([System.IO.Path]::GetFullPath('$(SunderPackageBuildTaskShadowRoot)', '$(MSBuildProjectDirectory)'))</_SunderPackageBuildTaskShadowRootFullPath>
    <SunderPackageBuildTaskShadowDirectory Condition="'$(SunderPackageBuildTaskShadowDirectory)' == ''">$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::Combine('$(_SunderPackageBuildTaskShadowRootFullPath)', '$(SunderPackageBuildTaskShadowStamp)'))))</SunderPackageBuildTaskShadowDirectory>
    <_SunderPackageBuildTaskShadowDirectoryFullPath>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(SunderPackageBuildTaskShadowDirectory)', '$(MSBuildProjectDirectory)'))))</_SunderPackageBuildTaskShadowDirectoryFullPath>
    <SunderPackageBuildTaskShadowAssembly Condition="'$(SunderPackageBuildTaskShadowAssembly)' == ''">$([System.IO.Path]::Combine('$(_SunderPackageBuildTaskShadowDirectoryFullPath)', 'Sunder.Package.Build.dll'))</SunderPackageBuildTaskShadowAssembly>
    <_SunderPackageBuildTaskShadowAssemblyFullPath>$([System.IO.Path]::GetFullPath('$(SunderPackageBuildTaskShadowAssembly)', '$(MSBuildProjectDirectory)'))</_SunderPackageBuildTaskShadowAssemblyFullPath>
    <SunderPackageBuildTaskSourceLockPath Condition="'$(SunderPackageBuildTaskSourceLockPath)' == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine($([System.IO.Path]::GetDirectoryName('$(_SunderPackageBuildProjectFullPath)')), 'obj', '.sunder-package-build-task-source.lock'))))</SunderPackageBuildTaskSourceLockPath>
    <SunderPackageRuntimeIdentifiers Condition="'$(SunderPackageRuntimeIdentifiers)' == ''">win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</SunderPackageRuntimeIdentifiers>
    <SunderPackageAssetsDirectory Condition="'$(SunderPackageAssetsDirectory)' == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', 'Assets'))))</SunderPackageAssetsDirectory>
    <SunderPackagePrimaryProject Condition="'$(SunderPackagePrimaryProject)' == ''">false</SunderPackagePrimaryProject>
    <SunderPackageInnerBuild Condition="'$(SunderPackageInnerBuild)' == ''">false</SunderPackageInnerBuild>
    <SunderPackageUsePrebuiltLeaves Condition="'$(SunderPackageUsePrebuiltLeaves)' == ''">false</SunderPackageUsePrebuiltLeaves>
    <_SunderPackageComposeRidsWereSpecified Condition="'$(SunderPackageComposeRuntimeIdentifiers)' != ''">true</_SunderPackageComposeRidsWereSpecified>
    <SunderPackageComposeRuntimeIdentifiers Condition="'$(SunderPackageComposeRuntimeIdentifiers)' == ''">$(SunderPackageRuntimeIdentifiers)</SunderPackageComposeRuntimeIdentifiers>
    <_SunderPackageBaseOutputPath Condition="'$(BaseOutputPath)' != ''">$(BaseOutputPath)</_SunderPackageBaseOutputPath>
    <_SunderPackageBaseOutputPath Condition="'$(_SunderPackageBaseOutputPath)' == ''">bin</_SunderPackageBaseOutputPath>
    <SunderPackageComposedOutputRoot Condition="'$(SunderPackageComposedOutputRoot)' == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(_SunderPackageBaseOutputPath)', '$(Configuration)', '$(TargetFramework)'))))</SunderPackageComposedOutputRoot>
    <SunderPackageComposedOutputPath Condition="'$(SunderPackageComposedOutputPath)' == ''">$([System.IO.Path]::Combine('$(SunderPackageComposedOutputRoot)', 'sunder-dev'))</SunderPackageComposedOutputPath>
    <SunderPackagePrimaryTargetLeafRoot Condition="'$(SunderPackagePrimaryTargetLeafRoot)' == ''">$(SunderPackageComposedOutputRoot)</SunderPackagePrimaryTargetLeafRoot>
    <SunderPackageAppTargetFramework Condition="'$(SunderPackageAppTargetFramework)' == ''">$(TargetFramework)</SunderPackageAppTargetFramework>
    <_SunderPackageAppBuildProperties>Configuration=$(Configuration)</_SunderPackageAppBuildProperties>
    <_SunderPackageAppBuildProperties Condition="'$(SunderPackageAppTargetFramework)' != '$(TargetFramework)'">$(_SunderPackageAppBuildProperties);TargetFramework=$(SunderPackageAppTargetFramework)</_SunderPackageAppBuildProperties>
    <_SunderRpcProjectImportEnabled Condition="'$(SunderRpcProjectImportBuild)' == 'true' or '$(SunderRpcPackageProjectExportPath)' != '' or '$(SunderPackageRootProject)' != ''">true</_SunderRpcProjectImportEnabled>
    <!-- Keep the package version local to its App leaf. A global Version would
         also retag source-referenced SDK projects and corrupt their identity. -->
    <Version Condition="'$(_SunderRpcProjectImportEnabled)' == 'true' and '$(SunderRpcPackageProjectExportPackageVersion)' != ''">$(SunderRpcPackageProjectExportPackageVersion)</Version>
    <SunderContractCacheRoot Condition="'$(SunderContractCacheRoot)' == ''">$([System.IO.Path]::Combine($([System.Environment]::GetFolderPath(SpecialFolder.UserProfile)), '.sunder', 'contracts', 'v1', 'sha256'))</SunderContractCacheRoot>
    <SunderAllowDevelopmentRegistryOrigin Condition="'$(SunderAllowDevelopmentRegistryOrigin)' == ''">false</SunderAllowDevelopmentRegistryOrigin>
    <SunderAcknowledgeBreakingChange Condition="'$(SunderAcknowledgeBreakingChange)' == ''">false</SunderAcknowledgeBreakingChange>
    <_SunderRpcPackResolveTargets Condition="'$(UsingMicrosoftNETSdk)' == 'true'">ResolveReferences;GenerateGlobalUsings</_SunderRpcPackResolveTargets>
    <_SunderRpcHasAuthoringInputs Condition="('$(SunderOwnedContractsPath)' != '' and Exists('$(SunderOwnedContractsPath)')) or ('$(SunderOwnedContractsPath)' == '' and Exists('$(MSBuildProjectDirectory)\sunder-contracts.owned.json')) or ('$(SunderContractLockPath)' != '' and Exists('$(SunderContractLockPath)')) or ('$(SunderContractLockPath)' == '' and Exists('$(MSBuildProjectDirectory)\sunder-contracts.lock.json'))">true</_SunderRpcHasAuthoringInputs>
    <_SunderRpcResolveReferencesTarget Condition="'$(_SunderRpcHasAuthoringInputs)' == 'true'">ResolveReferences</_SunderRpcResolveReferencesTarget>
    <SelfContained Condition="'$(SelfContained)' == ''">false</SelfContained>
    <UseAppHost Condition="'$(UseAppHost)' == ''">false</UseAppHost>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">false</PublishSingleFile>
    <PublishTrimmed Condition="'$(PublishTrimmed)' == ''">false</PublishTrimmed>
    <_SunderPackagePreparationTarget Condition="'$(SunderPackagePrimaryProject)' == 'true'">AggregateSunderPackage</_SunderPackagePreparationTarget>
    <_SunderPackagePreparationTarget Condition="'$(_SunderPackagePreparationTarget)' == ''">Build;EmitSunderDevOutput</_SunderPackagePreparationTarget>
    <_SunderPackageSingleProject>false</_SunderPackageSingleProject>
    <AfterMicrosoftNETSdkTargets>$(AfterMicrosoftNETSdkTargets);$(MSBuildThisFileDirectory)Sunder.Package.Build.Authoring.targets</AfterMicrosoftNETSdkTargets>
    <_SunderPreviousCrossTargetingTargets Condition="'$(SunderPackageProject)' == 'true' and '$(SunderPackageRole)' == '' and '$(SunderPackagePrimaryProject)' != 'true' and '$(SunderPackageRootProject)' == '' and '$(SunderPackageAppProject)' == '' and '$(_SunderRpcProjectImportEnabled)' != 'true'">$(CustomAfterMicrosoftCommonCrossTargetingTargets)</_SunderPreviousCrossTargetingTargets>
    <CustomAfterMicrosoftCommonCrossTargetingTargets Condition="'$(SunderPackageProject)' == 'true' and '$(SunderPackageRole)' == '' and '$(SunderPackagePrimaryProject)' != 'true' and '$(SunderPackageRootProject)' == '' and '$(SunderPackageAppProject)' == '' and '$(_SunderRpcProjectImportEnabled)' != 'true'">$(MSBuildThisFileDirectory)Sunder.Package.Build.Authoring.CrossTargeting.targets</CustomAfterMicrosoftCommonCrossTargetingTargets>
  </PropertyGroup>

  <Import Project="$(MSBuildThisFileDirectory)Sunder.Package.Build.SourceLock.targets" />

  <UsingTask TaskName="_SunderGetPackageBuildTaskCallerProperties"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))">
    <ParameterGroup>
      <KeepProperties ParameterType="System.String[]" Required="true" />
      <RemoveProperties ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Linq" />
      <Using Namespace="Microsoft.Build.Framework" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        var engine = BuildEngine as IBuildEngine6
            ?? throw new InvalidOperationException("MSBuild does not expose global property enumeration.");
        var keep = new HashSet<string>(KeepProperties.Select(name => name.Trim()), StringComparer.OrdinalIgnoreCase);
        // MSBuild removes properties AFTER applying explicit values. Do not remove canonical overrides.
        RemoveProperties = string.Join(";", engine.GetGlobalProperties().Keys
            .Where(name => !keep.Contains(name)).OrderBy(name => name, StringComparer.OrdinalIgnoreCase));
      ]]></Code>
    </Task>
  </UsingTask>

  <ItemGroup>
    <_SunderPackageRuntimeIdentifier Include="$(SunderPackageRuntimeIdentifiers)" />
  </ItemGroup>

  <ItemGroup Condition="Exists('$(_SunderPackageBuildProjectFullPath)') and '$(MSBuildProjectFullPath)' != '$(_SunderPackageBuildProjectFullPath)'">
    <_SunderPackageBuildProjectReference Include="$(_SunderPackageBuildProjectFullPath)" />
    <ProjectReference Remove="@(_SunderPackageBuildProjectReference)"
                      MatchOnMetadata="FullPath"
                      MatchOnMetadataOptions="PathLike" />
    <ProjectReference Include="$(_SunderPackageBuildProjectFullPath)"
                      ReferenceOutputAssembly="false"
                      BuildReference="false"
                      GlobalPropertiesToRemove="$(_SunderPackageBuildTaskGlobalPropertiesToRemove)"
                      PrivateAssets="all" />
  </ItemGroup>

  <UsingTask TaskName="_SunderStagePackageBuildTaskSet"
             TaskFactory="RoslynCodeTaskFactory"
             AssemblyFile="$([System.IO.Path]::Combine('$(MSBuildToolsPath)', 'Microsoft.Build.Tasks.Core.dll'))">
    <ParameterGroup>
      <SourceFiles ParameterType="Microsoft.Build.Framework.ITaskItem[]" Required="true" />
      <ShadowRoot ParameterType="System.String" Required="true" />
      <ShadowDirectory ParameterType="System.String" />
      <Immutable ParameterType="System.Boolean" Required="true" />
      <Fingerprint ParameterType="System.String" Output="true" />
      <PublishedDirectory ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.Collections.Generic" />
      <Using Namespace="System.Globalization" />
      <Using Namespace="System.IO" />
      <Using Namespace="System.Linq" />
      <Using Namespace="System.Security.Cryptography" />
      <Using Namespace="System.Text" />
      <Using Namespace="System.Threading" />
      <Code Type="Fragment" Language="cs"><![CDATA[
        const string markerFileName = ".sunder-task-set";
        const string temporaryPrefix = ".sunder-stage-";
        const string recoveryPrefix = ".sunder-recovery-";
        var pathComparison = Path.DirectorySeparatorChar == '\\'
            ? StringComparison.OrdinalIgnoreCase
            : StringComparison.Ordinal;
        var nameComparer = StringComparer.OrdinalIgnoreCase;

        string ToHex(byte[] bytes)
        {
            const string alphabet = "0123456789abcdef";
            var characters = new char[bytes.Length * 2];
            for (var index = 0; index < bytes.Length; index++)
            {
                characters[index * 2] = alphabet[bytes[index] >> 4];
                characters[(index * 2) + 1] = alphabet[bytes[index] & 15];
            }
            return new string(characters);
        }

        string NormalizeDirectory(string path)
        {
            var fullPath = Path.GetFullPath(path);
            var pathRoot = Path.GetPathRoot(fullPath) ?? string.Empty;
            while (fullPath.Length > pathRoot.Length
                   && (fullPath[fullPath.Length - 1] == Path.DirectorySeparatorChar
                       || fullPath[fullPath.Length - 1] == Path.AltDirectorySeparatorChar))
            {
                fullPath = fullPath.Substring(0, fullPath.Length - 1);
            }
            return fullPath;
        }

        string HashFile(string path)
        {
            using var stream = new FileStream(path, FileMode.Open, FileAccess.Read, FileShare.Read);
            using var sha256 = SHA256.Create();
            return ToHex(sha256.ComputeHash(stream));
        }

        List<(string Name, string SourcePath, long Length, string Hash)> Snapshot(
            IReadOnlyList<(string Name, string SourcePath)> files)
        {
            var result = new List<(string Name, string SourcePath, long Length, string Hash)>(files.Count);
            foreach (var file in files)
            {
                var info = new FileInfo(file.SourcePath);
                if (!info.Exists)
                {
                    throw new FileNotFoundException(
                        $"Required Sunder.Package.Build task dependency '{file.Name}' does not exist.",
                        file.SourcePath);
                }

                result.Add((file.Name, file.SourcePath, info.Length, HashFile(file.SourcePath)));
            }
            return result;
        }

        string FingerprintSet(IReadOnlyList<(string Name, string SourcePath, long Length, string Hash)> files)
        {
            using var hash = IncrementalHash.CreateHash(HashAlgorithmName.SHA256);
            foreach (var file in files)
            {
                hash.AppendData(Encoding.UTF8.GetBytes(file.Name));
                hash.AppendData(new byte[] { 0 });
                hash.AppendData(Encoding.UTF8.GetBytes(file.Length.ToString(CultureInfo.InvariantCulture)));
                hash.AppendData(new byte[] { 0 });
                hash.AppendData(Encoding.UTF8.GetBytes(file.Hash));
            }
            return ToHex(hash.GetHashAndReset());
        }

        string[] MarkerLines(
            IReadOnlyList<(string Name, string SourcePath, long Length, string Hash)> files,
            string fingerprint)
        {
            var lines = new List<string>(files.Count + 2)
            {
                "sunder-package-build-task-set-v1",
                "sha256=" + fingerprint,
            };
            lines.AddRange(files.Select(file =>
                file.Name + "|" + file.Length.ToString(CultureInfo.InvariantCulture) + "|" + file.Hash));
            return lines.ToArray();
        }

        bool SameSnapshot(
            IReadOnlyList<(string Name, string SourcePath, long Length, string Hash)> left,
            IReadOnlyList<(string Name, string SourcePath, long Length, string Hash)> right)
        {
            if (left.Count != right.Count)
            {
                return false;
            }
            for (var index = 0; index < left.Count; index++)
            {
                if (!string.Equals(left[index].Name, right[index].Name, StringComparison.Ordinal)
                    || left[index].Length != right[index].Length
                    || !string.Equals(left[index].Hash, right[index].Hash, StringComparison.Ordinal))
                {
                    return false;
                }
            }
            return true;
        }

        bool ValidateDirectory(
            string directory,
            IReadOnlyList<(string Name, string SourcePath, long Length, string Hash)> expectedFiles,
            string expectedFingerprint,
            out string reason)
        {
            try
            {
                if (!Directory.Exists(directory))
                {
                    reason = "the directory does not exist";
                    return false;
                }

                var expectedNames = new HashSet<string>(expectedFiles.Select(file => file.Name), nameComparer);
                expectedNames.Add(markerFileName);
                var entries = Directory.EnumerateFileSystemEntries(directory, "*", SearchOption.TopDirectoryOnly)
                    .ToArray();
                if (entries.Any(Directory.Exists))
                {
                    reason = "the directory contains an unexpected subdirectory";
                    return false;
                }
                var actualNames = new HashSet<string>(entries.Select(Path.GetFileName), nameComparer);
                if (entries.Length != expectedNames.Count || !actualNames.SetEquals(expectedNames))
                {
                    reason = "the declared dependency set is incomplete or contains unexpected files";
                    return false;
                }

                var markerPath = Path.Combine(directory, markerFileName);
                if (!File.ReadAllLines(markerPath).SequenceEqual(MarkerLines(expectedFiles, expectedFingerprint)))
                {
                    reason = "the dependency-set marker does not match";
                    return false;
                }

                foreach (var expectedFile in expectedFiles)
                {
                    var path = Path.Combine(directory, expectedFile.Name);
                    var info = new FileInfo(path);
                    if (!info.Exists
                        || info.Length != expectedFile.Length
                        || !string.Equals(HashFile(path), expectedFile.Hash, StringComparison.Ordinal))
                    {
                        reason = $"'{expectedFile.Name}' does not match its declared content";
                        return false;
                    }
                }

                reason = string.Empty;
                return true;
            }
            catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
            {
                reason = exception.Message;
                return false;
            }
        }

        void WriteMarker(
            string path,
            IReadOnlyList<(string Name, string SourcePath, long Length, string Hash)> files,
            string fingerprint)
        {
            using var stream = new FileStream(path, FileMode.CreateNew, FileAccess.Write, FileShare.None);
            using (var writer = new StreamWriter(stream, new UTF8Encoding(false), 1024, leaveOpen: true))
            {
                foreach (var line in MarkerLines(files, fingerprint))
                {
                    writer.WriteLine(line);
                }
                writer.Flush();
            }
            stream.Flush(flushToDisk: true);
        }

        void RemoveTemporaryDirectory(string path, string root)
        {
            if (!Directory.Exists(path))
            {
                return;
            }

            var fullPath = NormalizeDirectory(path);
            var parent = NormalizeDirectory(Path.GetDirectoryName(fullPath)
                ?? throw new InvalidDataException(
                    "The Sunder.Package.Build temporary task directory has no parent."));
            var name = Path.GetFileName(fullPath);
            if (!string.Equals(parent, root, pathComparison)
                || (!name.StartsWith(temporaryPrefix, StringComparison.Ordinal)
                    && !name.StartsWith(recoveryPrefix, StringComparison.Ordinal)))
            {
                throw new InvalidDataException(
                    $"Refusing to remove unowned Sunder.Package.Build task directory '{fullPath}'.");
            }

            var info = new DirectoryInfo(fullPath);
            if ((info.Attributes & FileAttributes.ReparsePoint) != 0)
            {
                throw new InvalidDataException(
                    $"Refusing to traverse reparse-point Sunder.Package.Build task directory '{fullPath}'.");
            }
            Directory.Delete(fullPath, recursive: true);
        }

        try
        {
            var sources = SourceFiles
                .Select(item =>
                {
                    var name = item.GetMetadata("TargetFileName");
                    if (string.IsNullOrWhiteSpace(name))
                    {
                        name = Path.GetFileName(item.ItemSpec);
                    }
                    if (string.IsNullOrWhiteSpace(name)
                        || !string.Equals(name, Path.GetFileName(name), StringComparison.Ordinal)
                        || name.Contains('|'))
                    {
                        throw new InvalidDataException(
                            $"Sunder.Package.Build task dependency name '{name}' is not a portable file name.");
                    }
                    var sourcePath = item.GetMetadata("FullPath");
                    return (Name: name, SourcePath: Path.GetFullPath(
                        string.IsNullOrWhiteSpace(sourcePath) ? item.ItemSpec : sourcePath));
                })
                .OrderBy(file => file.Name, StringComparer.Ordinal)
                .ToArray();
            if (sources.Length == 0)
            {
                throw new InvalidDataException("The Sunder.Package.Build task dependency set is empty.");
            }
            var duplicate = sources.GroupBy(file => file.Name, nameComparer).FirstOrDefault(group => group.Count() > 1);
            if (duplicate is not null)
            {
                throw new InvalidDataException(
                    $"The Sunder.Package.Build task dependency set declares '{duplicate.Key}' more than once.");
            }

            var root = NormalizeDirectory(ShadowRoot);
            var requestedDestination = string.IsNullOrEmpty(ShadowDirectory) ? null : NormalizeDirectory(ShadowDirectory);
            if (requestedDestination is not null
                && !string.Equals(root, NormalizeDirectory(Path.GetDirectoryName(requestedDestination)
                    ?? throw new InvalidDataException("The Sunder.Package.Build task shadow directory has no parent.")), pathComparison))
            {
                throw new InvalidDataException(
                    $"Sunder.Package.Build task shadow directory '{requestedDestination}' must be a direct child of '{root}'.");
            }

            Directory.CreateDirectory(root);
            var lockPath = Path.Combine(root, ".sunder-task-set.lock");
            FileStream publishLock = null;
            var lockDeadline = DateTime.UtcNow.AddMinutes(2);
            while (publishLock is null)
            {
                try
                {
                    publishLock = new FileStream(
                        lockPath,
                        FileMode.OpenOrCreate,
                        FileAccess.ReadWrite,
                        FileShare.None,
                        1,
                        FileOptions.None);
                }
                catch (IOException) when (DateTime.UtcNow < lockDeadline)
                {
                    Thread.Sleep(25);
                }
            }

            using (publishLock)
            {
                for (var attempt = 1; attempt <= 5; attempt++)
                {
                    var before = Snapshot(sources);
                    var fingerprint = FingerprintSet(before);
                    var destination = requestedDestination ?? Path.Combine(root, fingerprint);
                    if (ValidateDirectory(destination, before, fingerprint, out _))
                    {
                        var afterValidation = Snapshot(sources);
                        if (SameSnapshot(before, afterValidation))
                        {
                            Fingerprint = fingerprint;
                            PublishedDirectory = destination;
                            return true;
                        }
                    }

                    var replaceExisting = Directory.Exists(destination);
                    if (replaceExisting)
                    {
                        if (!File.Exists(Path.Combine(destination, markerFileName)))
                        {
                            throw new InvalidDataException(
                                $"Sunder.Package.Build task shadow '{destination}' is not marker-owned and will not be replaced.");
                        }
                        if (Immutable)
                        {
                            throw new InvalidDataException(
                                $"Immutable Sunder.Package.Build task shadow '{destination}' does not match the declared dependency set.");
                        }
                    }

                    var temporary = Path.Combine(root, temporaryPrefix + Guid.NewGuid().ToString("N"));
                    string recovery = null;
                    try
                    {
                        Directory.CreateDirectory(temporary);
                        foreach (var file in before)
                        {
                            using var source = new FileStream(
                                file.SourcePath,
                                FileMode.Open,
                                FileAccess.Read,
                                FileShare.Read);
                            using var target = new FileStream(
                                Path.Combine(temporary, file.Name),
                                FileMode.CreateNew,
                                FileAccess.Write,
                                FileShare.None);
                            source.CopyTo(target);
                            target.Flush(flushToDisk: true);
                        }
                        WriteMarker(Path.Combine(temporary, markerFileName), before, fingerprint);

                        var afterCopy = Snapshot(sources);
                        if (!SameSnapshot(before, afterCopy)
                            || !ValidateDirectory(temporary, before, fingerprint, out _))
                        {
                            RemoveTemporaryDirectory(temporary, root);
                            if (attempt < 5)
                            {
                                Thread.Sleep(20 * attempt);
                                continue;
                            }
                            throw new IOException(
                                "Sunder.Package.Build task outputs changed repeatedly while their immutable shadow was staged.");
                        }

                        if (replaceExisting)
                        {
                            recovery = Path.Combine(root, recoveryPrefix + Guid.NewGuid().ToString("N"));
                            Directory.Move(destination, recovery);
                        }

                        try
                        {
                            Directory.Move(temporary, destination);
                            if (!ValidateDirectory(destination, before, fingerprint, out var validationFailure))
                            {
                                throw new IOException(
                                    $"Published Sunder.Package.Build task shadow is incomplete: {validationFailure}.");
                            }
                        }
                        catch
                        {
                            if (recovery is not null && Directory.Exists(recovery) && !Directory.Exists(destination))
                            {
                                Directory.Move(recovery, destination);
                                recovery = null;
                            }
                            throw;
                        }

                        if (recovery is not null)
                        {
                            RemoveTemporaryDirectory(recovery, root);
                            recovery = null;
                        }
                        Fingerprint = fingerprint;
                        PublishedDirectory = destination;
                        return true;
                    }
                    finally
                    {
                        try
                        {
                            RemoveTemporaryDirectory(temporary, root);
                        }
                        catch (Exception exception) when (exception is IOException or UnauthorizedAccessException)
                        {
                            Log.LogMessage(
                                Microsoft.Build.Framework.MessageImportance.Low,
                                $"Could not remove Sunder.Package.Build temporary task staging directory '{temporary}': {exception.Message}");
                        }
                        if (recovery is not null)
                        {
                            Log.LogMessage(
                                Microsoft.Build.Framework.MessageImportance.Low,
                                $"Retained prior Sunder.Package.Build task generation for recovery at '{recovery}'.");
                        }
                    }
                }
            }

        }
        catch (Exception exception)
        {
            Log.LogErrorFromException(exception, showStackTrace: false);
            return false;
        }
      ]]></Code>
    </Task>
  </UsingTask>

  <UsingTask TaskName="Sunder.Package.Build.Tasks.GenerateSunderPackageManifestTask"
             AssemblyFile="$(_SunderPackageBuildTaskShadowAssemblyFullPath)"
             TaskFactory="TaskHostFactory"
             Runtime="NET"
             Architecture="$(SunderPackageBuildTaskHostArchitecture)"
             Condition="'$(SunderPackageBuildTaskSourceIsImmutable)' != 'true'" />
  <UsingTask TaskName="Sunder.Package.Build.Tasks.GenerateSunderPackageManifestTask"
             AssemblyFile="$(_SunderPackageBuildTaskShadowAssemblyFullPath)"
