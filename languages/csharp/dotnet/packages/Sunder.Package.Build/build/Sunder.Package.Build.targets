  <Target Name="_ExcludeSunderPackageBuildTaskProjectFromClean"
          BeforeTargets="CleanReferencedProjects"
          DependsOnTargets="PrepareProjectReferences"
          Condition="Exists('$(_SunderPackageBuildProjectFullPath)') and '$(MSBuildProjectFullPath)' != '$(_SunderPackageBuildProjectFullPath)'">
    <ItemGroup>
      <_MSBuildProjectReferenceExistent Remove="@(_SunderPackageBuildProjectReference)"
                                        MatchOnMetadata="FullPath"
                                        MatchOnMetadataOptions="PathLike" />
    </ItemGroup>
  </Target>

  <Target Name="_ReleaseSunderPackageBuildTaskSourceSnapshotLock"
          Condition="'$(_SunderPackageBuildTaskSourceSnapshotLeaseId)' != ''">
    <_SunderManagePackageBuildTaskSourceLock Action="Release"
                                             LockPath="$(_SunderPackageBuildTaskSourceLockFullPath)"
                                             Context="owner-snapshot $(_SunderPackageBuildProjectFullPath)"
                                             LeaseId="$(_SunderPackageBuildTaskSourceSnapshotLeaseId)" />
    <PropertyGroup>
      <_SunderPackageBuildTaskSourceSnapshotLeaseId></_SunderPackageBuildTaskSourceSnapshotLeaseId>
    </PropertyGroup>
  </Target>

  <!-- Invoked on this targets file as a shared project, not on each consumer. MSBuild
       coalesces the requests without creating yielded file-lock waiters that can
       exhaust its scheduling budget and starve the holder's nested build. -->
  <Target Name="_BuildSunderPackageBuildTaskSourceSnapshot"
          Returns="@(_SunderPackageBuildTaskSourceSnapshotFiles)">
    <_SunderManagePackageBuildTaskSourceLock Action="Acquire"
                                             LockPath="$(_SunderPackageBuildTaskSourceLockFullPath)"
                                             Context="owner-snapshot $(_SunderPackageBuildProjectFullPath)"
                                             AttemptSignalFile="$(_SunderPackageBuildTaskSourceLockAttemptSignalFile)">
      <Output TaskParameter="LeaseId" PropertyName="_SunderPackageBuildTaskSourceSnapshotLeaseId" />
    </_SunderManagePackageBuildTaskSourceLock>
    <MSBuild Projects="$(_SunderPackageBuildProjectFullPath)"
             Targets="Build"
             Properties="Configuration=$(SunderPackageBuildTaskBootstrapConfiguration);TargetFramework=net10.0;BuildProjectReferences=true;GeneratePackageOnBuild=false;SunderPackageBuildTaskSourceLockAlreadyHeld=true;SunderPackageBuildTaskSourceLockPath=$(_SunderPackageBuildTaskSourceLockFullPath);SunderPackageBuildSourceLockTargetsPath=$(MSBuildThisFileDirectory)Sunder.Package.Build.SourceLock.targets"
             RemoveProperties="SunderPackageBuildProject;SunderPackageBuildTaskAssembly;SunderPackageBuildTaskSourceIsImmutable"
             BuildInParallel="false"
             StopOnFirstFailure="true" />
    <CallTarget Targets="_CollectSunderPackageBuildTaskDependencyFiles">
      <Output TaskParameter="TargetOutputs" ItemName="_SunderPackageBuildTaskSnapshotInputs" />
    </CallTarget>
    <_SunderStagePackageBuildTaskSet SourceFiles="@(_SunderPackageBuildTaskSnapshotInputs)"
                                      ShadowRoot="$([System.IO.Path]::Combine('$(_SunderPackageBuildTaskProjectDirectory)', 'obj', 'sunder-package-build-task-sources'))"
                                      Immutable="true">
      <Output TaskParameter="PublishedDirectory" PropertyName="_SunderPackageBuildTaskSourceSnapshotDirectory" />
    </_SunderStagePackageBuildTaskSet>
    <ItemGroup>
      <_SunderPackageBuildTaskSourceSnapshotFiles Include="@(_SunderPackageBuildTaskSnapshotInputs->'$(_SunderPackageBuildTaskSourceSnapshotDirectory)/%(TargetFileName)')" />
    </ItemGroup>
    <_SunderManagePackageBuildTaskSourceLock Action="Release"
                                             LockPath="$(_SunderPackageBuildTaskSourceLockFullPath)"
                                             Context="owner-snapshot $(_SunderPackageBuildProjectFullPath)"
                                             LeaseId="$(_SunderPackageBuildTaskSourceSnapshotLeaseId)" />
    <PropertyGroup>
      <_SunderPackageBuildTaskSourceSnapshotLeaseId></_SunderPackageBuildTaskSourceSnapshotLeaseId>
    </PropertyGroup>
    <OnError ExecuteTargets="_ReleaseSunderPackageBuildTaskSourceSnapshotLock" />
  </Target>

  <Target Name="_CollectSunderPackageBuildTaskDependencyFiles"
          Returns="@(_SunderPackageBuildTaskDependencyFiles)">
    <PropertyGroup>
      <_SunderPackageBuildTaskSourceDirectory>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetDirectoryName('$(_SunderPackageBuildTaskAssemblyFullPath)'))))</_SunderPackageBuildTaskSourceDirectory>
      <_SunderPackageEditorAssembly>$(_SunderPackageBuildTaskSourceDirectory)Sunder.Package.Build.Editor.dll</_SunderPackageEditorAssembly>
      <_SunderPackageEditorAssembly Condition="!Exists('$(_SunderPackageEditorAssembly)')">$(MSBuildThisFileDirectory)../analyzers/dotnet/cs/Sunder.Package.Build.Editor.dll</_SunderPackageEditorAssembly>
    </PropertyGroup>

    <ItemGroup>
      <_SunderPackageBuildTaskDependencyFiles Remove="@(_SunderPackageBuildTaskDependencyFiles)" />
      <_SunderPackageBuildTaskDependencyFiles Include="$(_SunderPackageBuildTaskAssemblyFullPath)" TargetFileName="Sunder.Package.Build.dll" />
      <_SunderPackageBuildTaskDependencyFiles Include="$(_SunderPackageEditorAssembly)" TargetFileName="Sunder.Package.Build.Editor.dll" Condition="Exists('$(_SunderPackageEditorAssembly)')" />
      <_SunderPackageBuildTaskDependencyFiles Include="$(_SunderPackageBuildTaskSourceDirectory)Sunder.Package.Format.dll" TargetFileName="Sunder.Package.Format.dll" />
      <_SunderPackageBuildTaskDependencyFiles Include="$(_SunderPackageBuildTaskSourceDirectory)Sunder.Sdk.dll" TargetFileName="Sunder.Sdk.dll" />
      <_SunderPackageBuildTaskDependencyFiles Include="$(_SunderPackageBuildTaskSourceDirectory)Microsoft.Extensions.DependencyInjection.Abstractions.dll" TargetFileName="Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
      <_SunderPackageBuildTaskDependencyFiles Include="$(_SunderPackageBuildTaskSourceDirectory)Microsoft.Extensions.Logging.Abstractions.dll" TargetFileName="Microsoft.Extensions.Logging.Abstractions.dll" />
      <_SunderPackageBuildTaskDependencyFiles Include="$(_SunderPackageBuildTaskSourceDirectory)Microsoft.CodeAnalysis.dll" TargetFileName="Microsoft.CodeAnalysis.dll" />
      <_SunderPackageBuildTaskDependencyFiles Include="$(_SunderPackageBuildTaskSourceDirectory)Microsoft.CodeAnalysis.CSharp.dll" TargetFileName="Microsoft.CodeAnalysis.CSharp.dll" />
    </ItemGroup>
    <Error Condition="!Exists('%(_SunderPackageBuildTaskDependencyFiles.Identity)')"
           Text="Required Sunder.Package.Build task dependency '%(_SunderPackageBuildTaskDependencyFiles.TargetFileName)' was not produced at '%(_SunderPackageBuildTaskDependencyFiles.Identity)'." />
  </Target>

  <Target Name="_PrepareSunderPackageBuildTasks"
          Condition="'$(IsCrossTargetingBuild)' != 'true' and ('$(DesignTimeBuild)' != 'true' or ('$(_SunderPackageSingleProject)' == 'true' and '$(SunderPackageCompilationRole)' == ''))">
    <PropertyGroup>
      <_SunderPackageBuildTaskBuildFromSource>false</_SunderPackageBuildTaskBuildFromSource>
      <_SunderPackageBuildTaskBuildFromSource Condition="'$(SunderPackageBuildTaskSourceIsImmutable)' != 'true' and Exists('$(_SunderPackageBuildProjectFullPath)') and '$(MSBuildProjectFullPath)' != '$(_SunderPackageBuildProjectFullPath)'">true</_SunderPackageBuildTaskBuildFromSource>
    </PropertyGroup>
    <!-- Owner compiler inputs and fixture hooks must opt in by name; all other
         caller globals, including unknown future properties, are removed. -->
    <_SunderGetPackageBuildTaskCallerProperties
        KeepProperties="Configuration;TargetFramework;SunderPackageBuildProject;SunderPackageBuildTaskAssembly;SunderPackageBuildTaskSourceIsImmutable;SunderPackageBuildTaskSourceLockPath;$(SunderPackageBuildTaskSourceGlobalProperties)"
        Condition="'$(_SunderPackageBuildTaskBuildFromSource)' == 'true'">
      <Output TaskParameter="RemoveProperties" PropertyName="_SunderPackageBuildTaskCallerPropertiesToRemove" />
    </_SunderGetPackageBuildTaskCallerProperties>
    <MSBuild Projects="$(MSBuildThisFileFullPath)"
             Targets="_BuildSunderPackageBuildTaskSourceSnapshot"
             Properties="Configuration=$(SunderPackageBuildTaskBootstrapConfiguration);TargetFramework=net10.0;SunderPackageBuildProject=$(_SunderPackageBuildProjectFullPath);SunderPackageBuildTaskAssembly=$(_SunderPackageBuildTaskAssemblyFullPath);SunderPackageBuildTaskSourceIsImmutable=false;SunderPackageBuildTaskSourceLockPath=$(_SunderPackageBuildTaskSourceLockFullPath)"
             RemoveProperties="$(_SunderPackageBuildTaskCallerPropertiesToRemove)"
             BuildInParallel="false"
             StopOnFirstFailure="true"
             Condition="'$(_SunderPackageBuildTaskBuildFromSource)' == 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_SunderPackageBuildTaskStagingInputs" />
    </MSBuild>
    <Error Condition="'$(_SunderPackageBuildTaskBuildFromSource)' == 'true' and '@(_SunderPackageBuildTaskStagingInputs)' == ''"
           Text="The Sunder.Package.Build source request returned no snapshot files." />
    <CallTarget Targets="_CollectSunderPackageBuildTaskDependencyFiles"
                Condition="'$(_SunderPackageBuildTaskBuildFromSource)' != 'true'">
      <Output TaskParameter="TargetOutputs" ItemName="_SunderPackageBuildTaskStagingInputs" />
    </CallTarget>
    <_SunderStagePackageBuildTaskSet SourceFiles="@(_SunderPackageBuildTaskStagingInputs)"
                                      ShadowRoot="$(_SunderPackageBuildTaskShadowRootFullPath)"
                                      ShadowDirectory="$(_SunderPackageBuildTaskShadowDirectoryFullPath)"
                                      Immutable="$(SunderPackageBuildTaskSourceIsImmutable)">
      <Output TaskParameter="Fingerprint" PropertyName="SunderPackageBuildTaskShadowFingerprint" />
    </_SunderStagePackageBuildTaskSet>
    <Error Condition="!Exists('$(_SunderPackageBuildTaskShadowAssemblyFullPath)')"
           Text="Sunder.Package.Build task shadow '$(_SunderPackageBuildTaskShadowAssemblyFullPath)' is incomplete after staging." />
  </Target>

  <Target Name="_ValidateSunderContractCommandProject">
    <Error Condition="'$(DesignTimeBuild)' == 'true' or '$(IsCrossTargetingBuild)' == 'true' or '$(SunderPackageInnerBuild)' == 'true' or '$(SunderRpcProjectExportBuild)' == 'true' or '$(_SunderRpcProjectImportEnabled)' == 'true' or '$(SunderPackageProject)' == 'false'"
           Text="Sunder contract lifecycle commands run only on the canonical package source project, not App, inner-RID, project-export, design-time, or cross-targeting builds." />
    <ItemGroup>
      <_SunderContractCommandAppTarget Include="@(SunderPackageTarget)" Condition="'%(SunderPackageTarget.Role)' == 'app'" />
      <_SunderContractCommandRuntimeTarget Include="@(SunderPackageTarget)" Condition="'%(SunderPackageTarget.Role)' == 'runtime'" />
    </ItemGroup>
    <Error Condition="'@(_SunderContractCommandAppTarget)' != '' and '@(_SunderContractCommandRuntimeTarget)' == ''"
           Text="Run Sunder contract lifecycle commands on the canonical package source project, not its App project." />
  </Target>

  <Target Name="_BeginSunderContractSourceResolution">
    <Error Condition="'$(SunderPackageUsePrebuiltLeaves)' == 'true' and '$(BuildProjectReferences)' != 'false'"
           Text="Prebuilt contract source checks require BuildProjectReferences=false; they cannot rebuild Worker or App inputs." />
    <PropertyGroup>
      <_SunderContractSourceResolution>true</_SunderContractSourceResolution>
    </PropertyGroup>
  </Target>

  <Target Name="_PrepareSunderContractCommand"
          DependsOnTargets="_ValidateSunderContractCommandProject;_PrepareSunderPackageBuildTasks;_BeginSunderContractSourceResolution;ResolveReferences;GenerateGlobalUsings;$(_SunderPackageResourcePreparationTarget)">
    <PropertyGroup>
      <_SunderContractSourceResolution>false</_SunderContractSourceResolution>
      <_SunderRpcNullableEnabled>false</_SunderRpcNullableEnabled>
      <_SunderRpcNullableEnabled Condition="'$(Nullable)' == 'enable' or '$(Nullable)' == 'annotations'">true</_SunderRpcNullableEnabled>
    </PropertyGroup>
    <ItemGroup>
      <_SunderRpcCommandSource Remove="@(_SunderRpcCommandSource)" />
      <_SunderRpcCommandSource Include="@(Compile)" Condition="'%(Compile.AutoGen)' != 'true'" />
    </ItemGroup>
  </Target>

  <Target Name="CheckSunderContracts" DependsOnTargets="_PrepareSunderContractCommand">
    <GenerateSunderRpcBindingsTask ContractOperation="Check" GeneratePackageRoles="$(_SunderPackageSingleProject)"
                                   ContractReviewPath="$(SunderContractReviewPath)" ContractReviewOutputPath="$(SunderContractReviewOutputPath)"
                                   ProjectFile="$(MSBuildProjectFullPath)" ProjectImports="$(MSBuildAllProjects)"
                                  ResourceItems="@(_SunderResourceInputs)" GeneratorAnalyzers="@(Analyzer)" GeneratorProperties="@(_SunderGeneratorProperty)" RootNamespace="$(RootNamespace)"
                                  AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                                  ContractKey="$(SunderContractKey)" ContractCurrentVersion="$(SunderContractCurrentVersion)"
                                  ContractNextVersion="$(SunderContractNextVersion)" AcknowledgeBreakingChange="$(SunderAcknowledgeBreakingChange)"
                                  SourceFiles="@(_SunderRpcCommandSource)" ReferencePaths="@(ReferencePath)"
                                  PackageId="$(SunderPackageId)" PackageVersion="$(Version)"
                                  ProjectIdentity="$(MSBuildProjectName)" Configuration="$(Configuration)" TargetFramework="$(TargetFramework)"
                                  DefineConstants="$(DefineConstants)" OutputType="$(OutputType)" AssemblyName="$(AssemblyName)" NullableEnabled="$(_SunderRpcNullableEnabled)"
                                  OwnedContractsPath="$(SunderOwnedContractsPath)" ContractLockPath="$(SunderContractLockPath)"
                                  ContractCacheRoot="$(SunderContractCacheRoot)" ProjectDirectory="$(MSBuildProjectDirectory)"
                                  IntermediateOutputPath="$(IntermediateOutputPath)" />
  </Target>

  <Target Name="RestoreSunderContracts" DependsOnTargets="_ValidateSunderContractCommandProject;_PrepareSunderPackageBuildTasks">
    <Error Condition="'$(SunderRegistryOrigin)' != ''"
           Text="package-api.registry-origin-invalid: Restore uses the locked Registry origins and rejects an override." />
    <ItemGroup>
      <_SunderContractRestoreCandidate Remove="@(_SunderContractRestoreCandidate)" />
      <_SunderContractRestoreCandidate Include="$(SunderPackageCandidatePath)" Condition="'$(SunderPackageCandidatePath)' != ''" />
    </ItemGroup>
    <RestoreSunderContractsTask ProjectDirectory="$(MSBuildProjectDirectory)" ContractLockPath="$(SunderContractLockPath)"
                               AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                               ContractCacheRoot="$(SunderContractCacheRoot)" CandidateArchives="@(_SunderContractRestoreCandidate)"
                               PlatformCatalogPath="$(SunderPlatformCatalogPath)" />
  </Target>

  <UsingTask TaskName="Sunder.Package.Build.Tasks.CollectSunderContractCacheTask"
             AssemblyFile="$(_SunderPackageBuildTaskShadowAssemblyFullPath)"
             Condition="'$(SunderPackageBuildTaskSourceIsImmutable)' == 'true'" />
  <UsingTask TaskName="Sunder.Package.Build.Tasks.CollectSunderContractCacheTask"
             AssemblyFile="$(_SunderPackageBuildTaskShadowAssemblyFullPath)"
             TaskFactory="TaskHostFactory" Runtime="NET" Architecture="$(SunderPackageBuildTaskHostArchitecture)"
             Condition="'$(SunderPackageBuildTaskSourceIsImmutable)' != 'true'" />
  <Target Name="CollectSunderContractCache" DependsOnTargets="_PrepareSunderPackageBuildTasks">
    <ItemGroup>
      <_SunderReviewedContractCacheLock Remove="@(_SunderReviewedContractCacheLock)" />
      <_SunderReviewedContractCacheLock Include="$(SunderContractCacheLocks)" Condition="'$(SunderContractCacheLocks)' != ''" />
    </ItemGroup>
    <Error Condition="'@(_SunderReviewedContractCacheLock)' == ''"
           Text="contract-cache.entry-corrupt: GC requires an explicit SunderContractCacheLocks list of reviewed workspace locks." />
    <CollectSunderContractCacheTask ProjectDirectory="$(MSBuildProjectDirectory)" ContractCacheRoot="$(SunderContractCacheRoot)"
                                   ReviewedLocks="@(_SunderReviewedContractCacheLock)" GraceDays="$(SunderContractCacheGraceDays)" />
  </Target>

  <UsingTask TaskName="Sunder.Package.Build.Tasks.ManageSunderPackageApiTask"
             AssemblyFile="$(_SunderPackageBuildTaskShadowAssemblyFullPath)"
             Condition="'$(SunderPackageBuildTaskSourceIsImmutable)' == 'true'" />
  <UsingTask TaskName="Sunder.Package.Build.Tasks.ManageSunderPackageApiTask"
             AssemblyFile="$(_SunderPackageBuildTaskShadowAssemblyFullPath)"
             TaskFactory="TaskHostFactory" Runtime="NET" Architecture="$(SunderPackageBuildTaskHostArchitecture)"
             Condition="'$(SunderPackageBuildTaskSourceIsImmutable)' != 'true'" />

  <Target Name="AddSunderPackageApi" DependsOnTargets="_PrepareSunderContractCommand">
    <ManageSunderPackageApiTask Operation="Add" ProjectDirectory="$(MSBuildProjectDirectory)" ConsumerRoles="$(SunderPackageApiConsumerRoles)"
                               ProjectFile="$(MSBuildProjectFullPath)" ProjectImports="$(MSBuildAllProjects)"
                               GeneratePackageRoles="$(_SunderPackageSingleProject)" ResourceItems="@(_SunderResourceInputs)"
                               GeneratorAnalyzers="@(Analyzer)" GeneratorProperties="@(_SunderGeneratorProperty)" RootNamespace="$(RootNamespace)"
                               PlatformCatalogPath="$(SunderPlatformCatalogPath)"
                               AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                               ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)"
                               PackageId="$(SunderPackageId)" ContractId="$(SunderContractId)" VersionRange="$(SunderPackageVersionRange)"
                               IncludePrerelease="$(SunderPackageIncludePrerelease)" RegistryOrigin="$(SunderRegistryOrigin)"
                               Presence="$(SunderPackageApiPresence)" LocalName="$(SunderPackageApiLocalName)"
                               Candidate="$(SunderPackageCandidatePath)"
                               SourceFiles="@(_SunderRpcCommandSource)" ReferencePaths="@(ReferencePath)" PackageVersion="$(Version)"
                               OwnedContractsPath="$(SunderOwnedContractsPath)" IntermediateOutputPath="$(IntermediateOutputPath)"
                               ProjectIdentity="$(MSBuildProjectName)" Configuration="$(Configuration)" TargetFramework="$(TargetFramework)"
                               OutputType="$(OutputType)" AssemblyName="$(AssemblyName)" DefineConstants="$(DefineConstants)" NullableEnabled="$(_SunderRpcNullableEnabled)" />
  </Target>
  <Target Name="UpdateSunderPackageApi" DependsOnTargets="_PrepareSunderContractCommand">
    <ManageSunderPackageApiTask Operation="Update" ProjectDirectory="$(MSBuildProjectDirectory)" ConsumerRoles="$(SunderPackageApiConsumerRoles)"
                               ProjectFile="$(MSBuildProjectFullPath)" ProjectImports="$(MSBuildAllProjects)"
                               GeneratePackageRoles="$(_SunderPackageSingleProject)" ResourceItems="@(_SunderResourceInputs)"
                               GeneratorAnalyzers="@(Analyzer)" GeneratorProperties="@(_SunderGeneratorProperty)" RootNamespace="$(RootNamespace)"
                               PlatformCatalogPath="$(SunderPlatformCatalogPath)"
                               AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                               ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)"
                               PackageId="$(SunderPackageId)" ContractId="$(SunderContractId)" VersionRange="$(SunderPackageVersionRange)"
                               IncludePrerelease="$(SunderPackageIncludePrerelease)" RegistryOrigin="$(SunderRegistryOrigin)"
                               Presence="$(SunderPackageApiPresence)" LocalName="$(SunderPackageApiLocalName)"
                               Candidate="$(SunderPackageCandidatePath)"
                               SourceFiles="@(_SunderRpcCommandSource)" ReferencePaths="@(ReferencePath)" PackageVersion="$(Version)"
                               OwnedContractsPath="$(SunderOwnedContractsPath)" IntermediateOutputPath="$(IntermediateOutputPath)"
                               ProjectIdentity="$(MSBuildProjectName)" Configuration="$(Configuration)" TargetFramework="$(TargetFramework)"
                               OutputType="$(OutputType)" AssemblyName="$(AssemblyName)" DefineConstants="$(DefineConstants)" NullableEnabled="$(_SunderRpcNullableEnabled)" />
  </Target>
  <Target Name="RemoveSunderPackageApi" DependsOnTargets="_ValidateSunderContractCommandProject;_PrepareSunderPackageBuildTasks">
    <ManageSunderPackageApiTask Operation="Remove" ProjectDirectory="$(MSBuildProjectDirectory)"
                               AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                               ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)"
                               PackageId="$(SunderPackageId)" ContractId="$(SunderContractId)" VersionRange="$(SunderPackageVersionRange)"
                               IncludePrerelease="$(SunderPackageIncludePrerelease)" RegistryOrigin="$(SunderRegistryOrigin)"
                               Presence="$(SunderPackageApiPresence)" LocalName="$(SunderPackageApiLocalName)"
                               Candidate="$(SunderPackageCandidatePath)" />
  </Target>
  <Target Name="RequireSunderPackageApi" DependsOnTargets="_ValidateSunderContractCommandProject;_PrepareSunderPackageBuildTasks">
    <ManageSunderPackageApiTask Operation="Require" ProjectDirectory="$(MSBuildProjectDirectory)"
                               AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                               ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)"
                               PackageId="$(SunderPackageId)" ContractId="$(SunderContractId)" VersionRange="$(SunderPackageVersionRange)"
                               IncludePrerelease="$(SunderPackageIncludePrerelease)" RegistryOrigin="$(SunderRegistryOrigin)"
                               Presence="$(SunderPackageApiPresence)" LocalName="$(SunderPackageApiLocalName)"
                               Candidate="$(SunderPackageCandidatePath)" />
  </Target>
  <Target Name="UnrequireSunderPackageApi" DependsOnTargets="_ValidateSunderContractCommandProject;_PrepareSunderPackageBuildTasks">
    <ManageSunderPackageApiTask Operation="Unrequire" ProjectDirectory="$(MSBuildProjectDirectory)"
                               AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                               ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)"
                               PackageId="$(SunderPackageId)" ContractId="$(SunderContractId)" VersionRange="$(SunderPackageVersionRange)"
                               IncludePrerelease="$(SunderPackageIncludePrerelease)" RegistryOrigin="$(SunderRegistryOrigin)"
                               Presence="$(SunderPackageApiPresence)" LocalName="$(SunderPackageApiLocalName)"
                               Candidate="$(SunderPackageCandidatePath)" />
  </Target>
  <Target Name="ImplementSunderPackageApi" DependsOnTargets="_PrepareSunderContractCommand">
    <ManageSunderPackageApiTask Operation="Implement" ProjectDirectory="$(MSBuildProjectDirectory)"
                               ProjectFile="$(MSBuildProjectFullPath)" ProjectImports="$(MSBuildAllProjects)"
                               GeneratePackageRoles="$(_SunderPackageSingleProject)" ResourceItems="@(_SunderResourceInputs)"
                               GeneratorAnalyzers="@(Analyzer)" GeneratorProperties="@(_SunderGeneratorProperty)" RootNamespace="$(RootNamespace)"
                               PlatformCatalogPath="$(SunderPlatformCatalogPath)"
                               AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                               ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)"
                               PackageId="$(SunderPackageId)" ContractId="$(SunderContractId)" VersionRange="$(SunderPackageVersionRange)"
                               IncludePrerelease="$(SunderPackageIncludePrerelease)" RegistryOrigin="$(SunderRegistryOrigin)"
                               Presence="$(SunderPackageApiPresence)" LocalName="$(SunderPackageApiLocalName)"
                               Candidate="$(SunderPackageCandidatePath)"
                               SourceFiles="@(_SunderRpcCommandSource)" ReferencePaths="@(ReferencePath)" PackageVersion="$(Version)"
                               OwnedContractsPath="$(SunderOwnedContractsPath)" IntermediateOutputPath="$(IntermediateOutputPath)"
                               ProjectIdentity="$(MSBuildProjectName)" Configuration="$(Configuration)" TargetFramework="$(TargetFramework)"
                               OutputType="$(OutputType)" AssemblyName="$(AssemblyName)" DefineConstants="$(DefineConstants)" NullableEnabled="$(_SunderRpcNullableEnabled)" />
  </Target>
  <Target Name="UnimplementSunderPackageApi" DependsOnTargets="_PrepareSunderContractCommand">
    <ManageSunderPackageApiTask Operation="Unimplement" ProjectDirectory="$(MSBuildProjectDirectory)"
                               ProjectFile="$(MSBuildProjectFullPath)" ProjectImports="$(MSBuildAllProjects)"
                               GeneratePackageRoles="$(_SunderPackageSingleProject)" ResourceItems="@(_SunderResourceInputs)"
                               GeneratorAnalyzers="@(Analyzer)" GeneratorProperties="@(_SunderGeneratorProperty)" RootNamespace="$(RootNamespace)"
                               AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                               ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)"
                               PackageId="$(SunderPackageId)" ContractId="$(SunderContractId)" VersionRange="$(SunderPackageVersionRange)"
                               IncludePrerelease="$(SunderPackageIncludePrerelease)" RegistryOrigin="$(SunderRegistryOrigin)"
                               Presence="$(SunderPackageApiPresence)" LocalName="$(SunderPackageApiLocalName)"
                               Candidate="$(SunderPackageCandidatePath)"
                               SourceFiles="@(_SunderRpcCommandSource)" ReferencePaths="@(ReferencePath)" PackageVersion="$(Version)"
                               OwnedContractsPath="$(SunderOwnedContractsPath)" IntermediateOutputPath="$(IntermediateOutputPath)"
                               ProjectIdentity="$(MSBuildProjectName)" Configuration="$(Configuration)" TargetFramework="$(TargetFramework)"
                               OutputType="$(OutputType)" AssemblyName="$(AssemblyName)" DefineConstants="$(DefineConstants)" NullableEnabled="$(_SunderRpcNullableEnabled)" />
  </Target>
  <Target Name="ListSunderPackageApis" DependsOnTargets="_ValidateSunderContractCommandProject;_PrepareSunderPackageBuildTasks">
    <ManageSunderPackageApiTask Operation="List" ProjectDirectory="$(MSBuildProjectDirectory)"
                               AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                               ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)"
                               PackageId="$(SunderPackageId)" ContractId="$(SunderContractId)" VersionRange="$(SunderPackageVersionRange)"
                               IncludePrerelease="$(SunderPackageIncludePrerelease)" RegistryOrigin="$(SunderRegistryOrigin)"
                               Presence="$(SunderPackageApiPresence)" LocalName="$(SunderPackageApiLocalName)"
                               Candidate="$(SunderPackageCandidatePath)" />
  </Target>

  <Target Name="ImplementSunderPlatformApi" DependsOnTargets="_PrepareSunderContractCommand">
    <ManageSunderPackageApiTask Operation="PlatformImplement" ProjectDirectory="$(MSBuildProjectDirectory)"
                               ProjectFile="$(MSBuildProjectFullPath)" ProjectImports="$(MSBuildAllProjects)"
                               GeneratePackageRoles="$(_SunderPackageSingleProject)" ResourceItems="@(_SunderResourceInputs)"
                               GeneratorAnalyzers="@(Analyzer)" GeneratorProperties="@(_SunderGeneratorProperty)" RootNamespace="$(RootNamespace)"
                               PlatformCatalogPath="$(SunderPlatformCatalogPath)"
                               AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                               ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)"
                               PackageId="$(SunderPackageId)" ContractId="$(SunderContractId)" VersionRange="$(SunderPackageVersionRange)"
                               IncludePrerelease="$(SunderPackageIncludePrerelease)" RegistryOrigin="$(SunderRegistryOrigin)"
                               Presence="$(SunderPackageApiPresence)" LocalName="$(SunderPackageApiLocalName)" Candidate="$(SunderPackageCandidatePath)"
                               SourceFiles="@(_SunderRpcCommandSource)" ReferencePaths="@(ReferencePath)" PackageVersion="$(Version)"
                               OwnedContractsPath="$(SunderOwnedContractsPath)" IntermediateOutputPath="$(IntermediateOutputPath)"
                               ProjectIdentity="$(MSBuildProjectName)" Configuration="$(Configuration)" TargetFramework="$(TargetFramework)"
                               OutputType="$(OutputType)" AssemblyName="$(AssemblyName)" DefineConstants="$(DefineConstants)" NullableEnabled="$(_SunderRpcNullableEnabled)" />
  </Target>
  <Target Name="UpdateSunderPlatformApi" DependsOnTargets="_PrepareSunderContractCommand">
    <ManageSunderPackageApiTask Operation="PlatformUpdate" ProjectDirectory="$(MSBuildProjectDirectory)"
                               ProjectFile="$(MSBuildProjectFullPath)" ProjectImports="$(MSBuildAllProjects)"
                               GeneratePackageRoles="$(_SunderPackageSingleProject)" ResourceItems="@(_SunderResourceInputs)"
                               GeneratorAnalyzers="@(Analyzer)" GeneratorProperties="@(_SunderGeneratorProperty)" RootNamespace="$(RootNamespace)"
                               PlatformCatalogPath="$(SunderPlatformCatalogPath)"
                               AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                               ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)"
                               PackageId="$(SunderPackageId)" ContractId="$(SunderContractId)" VersionRange="$(SunderPackageVersionRange)"
                               IncludePrerelease="$(SunderPackageIncludePrerelease)" RegistryOrigin="$(SunderRegistryOrigin)"
                               Presence="$(SunderPackageApiPresence)" LocalName="$(SunderPackageApiLocalName)" Candidate="$(SunderPackageCandidatePath)"
                               SourceFiles="@(_SunderRpcCommandSource)" ReferencePaths="@(ReferencePath)" PackageVersion="$(Version)"
                               OwnedContractsPath="$(SunderOwnedContractsPath)" IntermediateOutputPath="$(IntermediateOutputPath)"
                               ProjectIdentity="$(MSBuildProjectName)" Configuration="$(Configuration)" TargetFramework="$(TargetFramework)"
                               OutputType="$(OutputType)" AssemblyName="$(AssemblyName)" DefineConstants="$(DefineConstants)" NullableEnabled="$(_SunderRpcNullableEnabled)" />
  </Target>
  <Target Name="UnimplementSunderPlatformApi" DependsOnTargets="_PrepareSunderContractCommand">
    <ManageSunderPackageApiTask Operation="PlatformUnimplement" ProjectDirectory="$(MSBuildProjectDirectory)"
                               ProjectFile="$(MSBuildProjectFullPath)" ProjectImports="$(MSBuildAllProjects)"
                               GeneratePackageRoles="$(_SunderPackageSingleProject)" ResourceItems="@(_SunderResourceInputs)"
                               GeneratorAnalyzers="@(Analyzer)" GeneratorProperties="@(_SunderGeneratorProperty)" RootNamespace="$(RootNamespace)"
                               AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                               ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)"
                               PackageId="$(SunderPackageId)" ContractId="$(SunderContractId)" VersionRange="$(SunderPackageVersionRange)"
                               IncludePrerelease="$(SunderPackageIncludePrerelease)" RegistryOrigin="$(SunderRegistryOrigin)"
                               Presence="$(SunderPackageApiPresence)" LocalName="$(SunderPackageApiLocalName)" Candidate="$(SunderPackageCandidatePath)"
                               SourceFiles="@(_SunderRpcCommandSource)" ReferencePaths="@(ReferencePath)" PackageVersion="$(Version)"
                               OwnedContractsPath="$(SunderOwnedContractsPath)" IntermediateOutputPath="$(IntermediateOutputPath)"
                               ProjectIdentity="$(MSBuildProjectName)" Configuration="$(Configuration)" TargetFramework="$(TargetFramework)"
                               OutputType="$(OutputType)" AssemblyName="$(AssemblyName)" DefineConstants="$(DefineConstants)" NullableEnabled="$(_SunderRpcNullableEnabled)" />
  </Target>
  <Target Name="ListSunderPlatformApis" DependsOnTargets="_ValidateSunderContractCommandProject;_PrepareSunderPackageBuildTasks">
    <ManageSunderPackageApiTask Operation="PlatformList" ProjectDirectory="$(MSBuildProjectDirectory)"
                               AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                               ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)"
                               PackageId="$(SunderPackageId)" ContractId="$(SunderContractId)" VersionRange="$(SunderPackageVersionRange)"
                               IncludePrerelease="$(SunderPackageIncludePrerelease)" RegistryOrigin="$(SunderRegistryOrigin)"
                               Presence="$(SunderPackageApiPresence)" LocalName="$(SunderPackageApiLocalName)" Candidate="$(SunderPackageCandidatePath)" />
  </Target>

  <UsingTask TaskName="Sunder.Package.Build.Tasks.ImportSunderContractPublicationTask"
             AssemblyFile="$(_SunderPackageBuildTaskShadowAssemblyFullPath)"
             Condition="'$(SunderPackageBuildTaskSourceIsImmutable)' == 'true'" />
  <UsingTask TaskName="Sunder.Package.Build.Tasks.ImportSunderContractPublicationTask"
             AssemblyFile="$(_SunderPackageBuildTaskShadowAssemblyFullPath)"
             TaskFactory="TaskHostFactory" Runtime="NET" Architecture="$(SunderPackageBuildTaskHostArchitecture)"
             Condition="'$(SunderPackageBuildTaskSourceIsImmutable)' != 'true'" />
  <Target Name="ImportSunderContractPublication" DependsOnTargets="_ValidateSunderContractCommandProject;_PrepareSunderPackageBuildTasks">
    <ImportSunderContractPublicationTask ProjectDirectory="$(MSBuildProjectDirectory)" OwnedContractsPath="$(SunderOwnedContractsPath)"
                                         PackagePath="$(SunderPackagePublicationPath)" RegistryOrigin="$(SunderRegistryOrigin)"
                                         AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)" />
  </Target>

  <Target Name="AcceptSunderContracts" DependsOnTargets="_PrepareSunderContractCommand">
    <GenerateSunderRpcBindingsTask ContractOperation="Accept" GeneratePackageRoles="$(_SunderPackageSingleProject)"
                                   ContractReviewPath="$(SunderContractReviewPath)" ContractReviewOutputPath="$(SunderContractReviewOutputPath)"
                                   ProjectFile="$(MSBuildProjectFullPath)" ProjectImports="$(MSBuildAllProjects)"
                                  ResourceItems="@(_SunderResourceInputs)" GeneratorAnalyzers="@(Analyzer)" GeneratorProperties="@(_SunderGeneratorProperty)" RootNamespace="$(RootNamespace)"
                                  AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                                  ContractKey="$(SunderContractKey)" ContractCurrentVersion="$(SunderContractCurrentVersion)"
                                  ContractNextVersion="$(SunderContractNextVersion)" AcknowledgeBreakingChange="$(SunderAcknowledgeBreakingChange)"
                                  SourceFiles="@(_SunderRpcCommandSource)" ReferencePaths="@(ReferencePath)"
                                  PackageId="$(SunderPackageId)" PackageVersion="$(Version)"
                                  ProjectIdentity="$(MSBuildProjectName)" Configuration="$(Configuration)" TargetFramework="$(TargetFramework)"
                                  DefineConstants="$(DefineConstants)" OutputType="$(OutputType)" AssemblyName="$(AssemblyName)" NullableEnabled="$(_SunderRpcNullableEnabled)"
                                  OwnedContractsPath="$(SunderOwnedContractsPath)" ContractLockPath="$(SunderContractLockPath)"
                                  ContractCacheRoot="$(SunderContractCacheRoot)" ProjectDirectory="$(MSBuildProjectDirectory)"
                                  IntermediateOutputPath="$(IntermediateOutputPath)" />
    <PropertyGroup>
      <_SunderRpcHasOwnedContractsBaseline>true</_SunderRpcHasOwnedContractsBaseline>
      <_SunderRpcResolveReferencesTarget>ResolveReferences</_SunderRpcResolveReferencesTarget>
    </PropertyGroup>
  </Target>

  <Target Name="FreezeSunderContracts" DependsOnTargets="_PrepareSunderContractCommand">
    <GenerateSunderRpcBindingsTask ContractOperation="Freeze" GeneratePackageRoles="$(_SunderPackageSingleProject)"
                                   ContractReviewPath="$(SunderContractReviewPath)" ContractReviewOutputPath="$(SunderContractReviewOutputPath)"
                                   ProjectFile="$(MSBuildProjectFullPath)" ProjectImports="$(MSBuildAllProjects)"
                                  ResourceItems="@(_SunderResourceInputs)" GeneratorAnalyzers="@(Analyzer)" GeneratorProperties="@(_SunderGeneratorProperty)" RootNamespace="$(RootNamespace)"
                                  AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                                  ContractKey="$(SunderContractKey)" ContractCurrentVersion="$(SunderContractCurrentVersion)"
                                  ContractNextVersion="$(SunderContractNextVersion)" AcknowledgeBreakingChange="$(SunderAcknowledgeBreakingChange)"
                                  SourceFiles="@(_SunderRpcCommandSource)" ReferencePaths="@(ReferencePath)"
                                  PackageId="$(SunderPackageId)" PackageVersion="$(Version)"
                                  ProjectIdentity="$(MSBuildProjectName)" Configuration="$(Configuration)" TargetFramework="$(TargetFramework)"
                                  DefineConstants="$(DefineConstants)" OutputType="$(OutputType)" AssemblyName="$(AssemblyName)" NullableEnabled="$(_SunderRpcNullableEnabled)"
                                  OwnedContractsPath="$(SunderOwnedContractsPath)" ContractLockPath="$(SunderContractLockPath)"
                                  ContractCacheRoot="$(SunderContractCacheRoot)" ProjectDirectory="$(MSBuildProjectDirectory)"
                                  IntermediateOutputPath="$(IntermediateOutputPath)" />
  </Target>

  <Target Name="_GenerateSunderRpcContractExports"
          DependsOnTargets="_PrepareSunderPackageBuildTasks;ResolveReferences"
          Returns="@(_SunderRpcPackageProjectExport)"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderRpcProjectExportBuild)' == 'true'">
    <PropertyGroup>
      <_SunderRpcNullableEnabled>false</_SunderRpcNullableEnabled>
      <_SunderRpcNullableEnabled Condition="'$(Nullable)' == 'enable' or '$(Nullable)' == 'annotations'">true</_SunderRpcNullableEnabled>
    </PropertyGroup>
    <ItemGroup>
      <_SunderRpcAuthoringSource Remove="@(_SunderRpcAuthoringSource)" />
      <_SunderRpcAuthoringSource Include="@(Compile)"
                                 Condition="'%(Compile.AutoGen)' != 'true'" />
      <_SunderRpcPackageProjectExport Remove="@(_SunderRpcPackageProjectExport)" />
      <_SunderRpcProjectExportLockDirectory Remove="@(_SunderRpcProjectExportLockDirectory)" />
      <_SunderRpcProjectExportLockDirectory Include="$([System.IO.Path]::Combine('$(IntermediateOutputPath)', 'sunder-rpc'))">
        <DiscoveryRoot>$(IntermediateOutputPath)</DiscoveryRoot>
      </_SunderRpcProjectExportLockDirectory>
    </ItemGroup>
    <ManageSunderRpcGeneratedOutputLockTask Action="Acquire"
                                             ProjectDirectory="$(MSBuildProjectDirectory)"
                                             OutputDirectories="@(_SunderRpcProjectExportLockDirectory)">
      <Output TaskParameter="LeaseId" PropertyName="_SunderRpcProjectExportOutputLockLeaseId" />
    </ManageSunderRpcGeneratedOutputLockTask>
    <GenerateSunderRpcBindingsTask GenerationMode="ProjectExport"
                                   ProjectFile="$(MSBuildProjectFullPath)" ProjectImports="$(MSBuildAllProjects)"
                                  AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                                   SourceFiles="@(_SunderRpcAuthoringSource)"
                                   ReferencePaths="@(ReferencePath)"
                                   PackageId="$(SunderPackageId)"
                                   PackageVersion="$(Version)"
                                   ProjectIdentity="$(MSBuildProjectName)"
                                   Configuration="$(Configuration)"
                                   TargetFramework="$(TargetFramework)"
                                   DefineConstants="$(DefineConstants)"
                                   OutputType="$(OutputType)"
                                   AssemblyName="$(AssemblyName)"
                                   NullableEnabled="$(_SunderRpcNullableEnabled)"
                                   OwnedContractsPath="$(SunderOwnedContractsPath)"
                                     ContractLockPath="$(SunderContractLockPath)"
                                     ContractCacheRoot="$(SunderContractCacheRoot)"
                                    ProjectDirectory="$(MSBuildProjectDirectory)"
                                    IntermediateOutputPath="$(IntermediateOutputPath)"
                                    OutputLockLeaseId="$(_SunderRpcProjectExportOutputLockLeaseId)">
      <Output TaskParameter="PackageProjectExports" ItemName="_SunderRpcPackageProjectExport" />
    </GenerateSunderRpcBindingsTask>
    <ManageSunderRpcGeneratedOutputLockTask Action="Release"
                                             ProjectDirectory="$(MSBuildProjectDirectory)"
                                             LeaseId="$(_SunderRpcProjectExportOutputLockLeaseId)">
      <Output TaskParameter="LeaseId" PropertyName="_SunderRpcProjectExportOutputLockLeaseId" />
    </ManageSunderRpcGeneratedOutputLockTask>
    <OnError ExecuteTargets="_ReleaseSunderRpcProjectExportOutputLock" />
  </Target>

  <Target Name="_ReleaseSunderRpcProjectExportOutputLock"
          Condition="'$(_SunderRpcProjectExportOutputLockLeaseId)' != ''">
    <ManageSunderRpcGeneratedOutputLockTask Action="Release"
                                             ProjectDirectory="$(MSBuildProjectDirectory)"
                                             LeaseId="$(_SunderRpcProjectExportOutputLockLeaseId)">
      <Output TaskParameter="LeaseId" PropertyName="_SunderRpcProjectExportOutputLockLeaseId" />
    </ManageSunderRpcGeneratedOutputLockTask>
  </Target>

  <Target Name="GenerateSunderRpcContractExports"
          Returns="@(_SunderRpcPackageProjectExport)"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderRpcProjectExportBuild)' != 'true' and '$(_SunderRpcProjectImportEnabled)' != 'true' and '$(_SunderRpcHasAuthoringInputs)' == 'true'">
    <PropertyGroup Condition="'$(SunderRpcExpectedAppProject)' != ''">
      <_SunderRpcExpectedAppProjectFullPath>$([System.IO.Path]::GetFullPath('$(SunderRpcExpectedAppProject)', '$(MSBuildProjectDirectory)'))</_SunderRpcExpectedAppProjectFullPath>
      <_SunderRpcConfiguredAppProjectFullPath Condition="'$(SunderPackageAppProject)' != ''">$([System.IO.Path]::GetFullPath('$(SunderPackageAppProject)', '$(MSBuildProjectDirectory)'))</_SunderRpcConfiguredAppProjectFullPath>
    </PropertyGroup>
    <PropertyGroup>
      <_SunderRpcProjectExportIntermediateOutputPath>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', '$(Configuration)', '$(TargetFramework)'))))))</_SunderRpcProjectExportIntermediateOutputPath>
    </PropertyGroup>
    <Error Condition="'$(SunderRpcExpectedAppProject)' != '' and '$(_SunderRpcConfiguredAppProjectFullPath)' != '$(_SunderRpcExpectedAppProjectFullPath)'"
           Text="SunderPackageRootProject and SunderPackageAppProject must identify one another after path normalization." />
    <ItemGroup>
      <_SunderRpcPackageProjectExport Remove="@(_SunderRpcPackageProjectExport)" />
    </ItemGroup>
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="_GenerateSunderRpcContractExports"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);SunderRpcProjectExportBuild=true;SunderPackagePrimaryProject=false;SunderPackageInnerBuild=true;IntermediateOutputPath=$(_SunderRpcProjectExportIntermediateOutputPath);AppendRuntimeIdentifierToOutputPath=false"
             RemoveProperties="RuntimeIdentifier;SelfContained;UseAppHost;PublishSingleFile;PublishTrimmed;OutputPath;OutDir;MSBuildProjectExtensionsPath"
             BuildInParallel="false"
             StopOnFirstFailure="true">
      <Output TaskParameter="TargetOutputs" ItemName="_SunderRpcPackageProjectExport" />
    </MSBuild>
  </Target>

  <Target Name="_ResolveSunderRpcProjectImport"
           Returns="@(_SunderRpcPackageProjectExport)"
           Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderRpcProjectExportBuild)' != 'true' and '$(_SunderRpcProjectImportEnabled)' == 'true'">
    <PropertyGroup Condition="'$(SunderRpcPackageProjectExportPath)' != ''">
      <_SunderRpcExplicitPackageProjectExportFullPath>$([System.IO.Path]::GetFullPath('$(SunderRpcPackageProjectExportPath)', '$(MSBuildProjectDirectory)'))</_SunderRpcExplicitPackageProjectExportFullPath>
      <_SunderRpcExplicitPackageProjectExportGeneratedDirectory>$([System.IO.Path]::GetDirectoryName('$(_SunderRpcExplicitPackageProjectExportFullPath)'))</_SunderRpcExplicitPackageProjectExportGeneratedDirectory>
      <_SunderRpcExplicitPackageProjectExportIntermediateOutputPath>$([System.IO.Path]::GetDirectoryName('$(_SunderRpcExplicitPackageProjectExportGeneratedDirectory)'))</_SunderRpcExplicitPackageProjectExportIntermediateOutputPath>
    </PropertyGroup>
    <PropertyGroup Condition="'$(SunderRpcPackageProjectExportPath)' == '' and '$(SunderPackageRootProject)' != ''">
      <_SunderPackageRootProjectFullPath>$([System.IO.Path]::GetFullPath('$(SunderPackageRootProject)', '$(MSBuildProjectDirectory)'))</_SunderPackageRootProjectFullPath>
    </PropertyGroup>
    <Error Condition="'$(SunderRpcPackageProjectExportPath)' == '' and '$(SunderPackageRootProject)' == ''"
           Text="Project RPC import requires an explicit package project export or SunderPackageRootProject." />
    <Error Condition="'$(_SunderPackageRootProjectFullPath)' != '' and '$(_SunderPackageRootProjectFullPath)' == '$(MSBuildProjectFullPath)'"
           Text="SunderPackageRootProject must identify the canonical package project, not the App project itself." />
    <Error Condition="'$(_SunderPackageRootProjectFullPath)' != '' and !Exists('$(_SunderPackageRootProjectFullPath)')"
           Text="SunderPackageRootProject '$(_SunderPackageRootProjectFullPath)' does not exist." />
    <ItemGroup>
      <_SunderRpcPackageProjectExport Remove="@(_SunderRpcPackageProjectExport)" />
      <_SunderRpcPackageProjectExport Include="$(_SunderRpcExplicitPackageProjectExportFullPath)"
                                      Condition="'$(SunderRpcPackageProjectExportPath)' != ''">
        <Sha256>$(SunderRpcPackageProjectExportSha256)</Sha256>
        <ProjectIdentity>$(SunderRpcPackageProjectExportProjectIdentity)</ProjectIdentity>
        <Configuration>$(SunderRpcPackageProjectExportConfiguration)</Configuration>
        <TargetFramework>$(SunderRpcPackageProjectExportTargetFramework)</TargetFramework>
        <PackageId>$(SunderRpcPackageProjectExportPackageId)</PackageId>
        <PackageVersion>$(SunderRpcPackageProjectExportPackageVersion)</PackageVersion>
        <GeneratedDirectory>$(_SunderRpcExplicitPackageProjectExportGeneratedDirectory)</GeneratedDirectory>
        <IntermediateOutputPath>$(_SunderRpcExplicitPackageProjectExportIntermediateOutputPath)</IntermediateOutputPath>
      </_SunderRpcPackageProjectExport>
    </ItemGroup>
    <MSBuild Projects="$(_SunderPackageRootProjectFullPath)"
             Targets="GenerateSunderRpcContractExports"
             Properties="Configuration=$(Configuration);SunderRpcExpectedAppProject=$(MSBuildProjectFullPath)"
             RemoveProperties="TargetFramework;RuntimeIdentifier;SelfContained;UseAppHost;PublishSingleFile;PublishTrimmed;OutputPath;OutDir;IntermediateOutputPath;MSBuildProjectExtensionsPath;AppendRuntimeIdentifierToOutputPath;SunderRpcProjectImportBuild;SunderRpcPackageProjectExportPath;SunderRpcPackageProjectExportSha256;SunderRpcPackageProjectExportProjectIdentity;SunderRpcPackageProjectExportConfiguration;SunderRpcPackageProjectExportTargetFramework;SunderRpcPackageProjectExportPackageId;SunderRpcPackageProjectExportPackageVersion;SunderPackageRootProject"
             BuildInParallel="false"
             StopOnFirstFailure="true"
             Condition="'$(SunderRpcPackageProjectExportPath)' == '' and '$(_SunderPackageRootProjectFullPath)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SunderRpcPackageProjectExport" />
    </MSBuild>
  </Target>

  <Target Name="PrepareSunderRpcImportedSources"
          DependsOnTargets="GenerateSunderRpcContractExports;_ResolveSunderRpcProjectImport"
           Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderRpcProjectExportBuild)' != 'true'" />

  <Target Name="_AcquireSunderRpcImplementationOutputLock"
          DependsOnTargets="PrepareSunderRpcImportedSources;_PrepareSunderPackageBuildTasks;$(_SunderRpcResolveReferencesTarget)"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderRpcProjectExportBuild)' != 'true' and '$(_SunderRpcGeneratedOutputLockLeaseId)' == ''">
    <PropertyGroup>
      <_SunderRpcLocalIntermediateOutputPath>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)', '$(MSBuildProjectDirectory)'))</_SunderRpcLocalIntermediateOutputPath>
    </PropertyGroup>
    <ItemGroup>
      <_SunderRpcLocalGeneratedOutputLockDirectory Remove="@(_SunderRpcLocalGeneratedOutputLockDirectory)" />
      <_SunderRpcLocalGeneratedOutputLockDirectory Include="$([System.IO.Path]::Combine('$(_SunderRpcLocalIntermediateOutputPath)', 'sunder-rpc'))">
        <DiscoveryRoot>$(_SunderRpcLocalIntermediateOutputPath)</DiscoveryRoot>
      </_SunderRpcLocalGeneratedOutputLockDirectory>
      <_SunderRpcGeneratedOutputLockDirectory Remove="@(_SunderRpcGeneratedOutputLockDirectory)" />
      <_SunderRpcGeneratedOutputLockDirectory Include="@(_SunderRpcLocalGeneratedOutputLockDirectory)" />
      <_SunderRpcGeneratedOutputLockDirectory Include="@(_SunderRpcPackageProjectExport->'%(GeneratedDirectory)')"
                                              Condition="'%(_SunderRpcPackageProjectExport.GeneratedDirectory)' != ''">
        <DiscoveryRoot>%(_SunderRpcPackageProjectExport.IntermediateOutputPath)</DiscoveryRoot>
      </_SunderRpcGeneratedOutputLockDirectory>
    </ItemGroup>
    <ManageSunderRpcGeneratedOutputLockTask Action="Acquire"
                                             ProjectDirectory="$(MSBuildProjectDirectory)"
                                             OutputDirectories="@(_SunderRpcGeneratedOutputLockDirectory)">
      <Output TaskParameter="LeaseId" PropertyName="_SunderRpcGeneratedOutputLockLeaseId" />
    </ManageSunderRpcGeneratedOutputLockTask>
  </Target>

  <Target Name="_ReleaseSunderRpcGeneratedOutputLock"
          Condition="'$(_SunderRpcGeneratedOutputLockLeaseId)' != ''">
    <ManageSunderRpcGeneratedOutputLockTask Action="Release"
                                             ProjectDirectory="$(MSBuildProjectDirectory)"
                                             LeaseId="$(_SunderRpcGeneratedOutputLockLeaseId)">
      <Output TaskParameter="LeaseId" PropertyName="_SunderRpcGeneratedOutputLockLeaseId" />
    </ManageSunderRpcGeneratedOutputLockTask>
  </Target>

  <Target Name="_ReleaseSunderRpcGeneratedOutputLockAfterCompile"
          AfterTargets="CoreCompile"
          DependsOnTargets="_ReleaseSunderRpcGeneratedOutputLock"
          Condition="'$(_SunderRpcGeneratedOutputLockLeaseId)' != '' and '$(SunderPackageProject)' == 'false'" />

  <Target Name="_ReleaseSunderRpcGeneratedOutputLockAfterManifest"
          AfterTargets="GenerateSunderPackageManifest"
          DependsOnTargets="_ReleaseSunderRpcGeneratedOutputLock"
          Condition="'$(_SunderRpcGeneratedOutputLockLeaseId)' != ''" />

  <Target Name="GenerateSunderRpcImplementationBindings"
           BeforeTargets="CoreCompile"
           DependsOnTargets="_AcquireSunderRpcImplementationOutputLock"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderRpcProjectExportBuild)' != 'true' and '$(_SunderRpcProjectImportEnabled)' != 'true' and '$(_SunderPackageSingleProject)' != 'true'">
    <PropertyGroup>
      <_SunderRpcNullableEnabled>false</_SunderRpcNullableEnabled>
      <_SunderRpcNullableEnabled Condition="'$(Nullable)' == 'enable' or '$(Nullable)' == 'annotations'">true</_SunderRpcNullableEnabled>
    </PropertyGroup>
    <ItemGroup>
      <_SunderRpcAuthoringSource Remove="@(_SunderRpcAuthoringSource)" />
      <_SunderRpcAuthoringSource Include="@(Compile)"
                                 Condition="'%(Compile.AutoGen)' != 'true'" />
      <_SunderSourceContractBundle Remove="@(_SunderSourceContractBundle)" />
      <_SunderSourceRpcProvider Remove="@(_SunderSourceRpcProvider)" />
      <_SunderSourceRpcUse Remove="@(_SunderSourceRpcUse)" />
      <_SunderRpcAuthoringReceipt Remove="@(_SunderRpcAuthoringReceipt)" />
    </ItemGroup>
    <GenerateSunderRpcBindingsTask GenerationMode="Implementation"
                                   ProjectFile="$(MSBuildProjectFullPath)" ProjectImports="$(MSBuildAllProjects)"
                                  AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                                   Bindings="@(SunderRpcBinding)"
                                   SourceFiles="@(_SunderRpcAuthoringSource)"
                                   ReferencePaths="@(ReferencePath)"
                                   ExpectedPackageProjectExports="@(_SunderRpcPackageProjectExport)"
                                   PackageId="$(SunderPackageId)"
                                   PackageVersion="$(Version)"
                                   ProjectIdentity="$(MSBuildProjectName)"
                                   Configuration="$(Configuration)"
                                   TargetFramework="$(TargetFramework)"
                                   DefineConstants="$(DefineConstants)"
                                   OutputType="$(OutputType)"
                                   AssemblyName="$(AssemblyName)"
                                   NullableEnabled="$(_SunderRpcNullableEnabled)"
                                   OwnedContractsPath="$(SunderOwnedContractsPath)"
                                     ContractLockPath="$(SunderContractLockPath)"
                                     ContractCacheRoot="$(SunderContractCacheRoot)"
                                    ProjectDirectory="$(MSBuildProjectDirectory)"
                                    IntermediateOutputPath="$(IntermediateOutputPath)"
                                    OutputLockLeaseId="$(_SunderRpcGeneratedOutputLockLeaseId)">
      <Output TaskParameter="CompileItems" ItemName="Compile" />
      <Output TaskParameter="BindingSnapshots" ItemName="_SunderRpcBindingSnapshot" />
      <Output TaskParameter="ContractBundles" ItemName="_SunderSourceContractBundle" />
      <Output TaskParameter="RpcProviders" ItemName="_SunderSourceRpcProvider" />
      <Output TaskParameter="RpcUses" ItemName="_SunderSourceRpcUse" />
      <Output TaskParameter="AuthoringReceipts" ItemName="_SunderRpcAuthoringReceipt" />
    </GenerateSunderRpcBindingsTask>
    <ManageSunderRpcGeneratedOutputLockTask Action="Retain"
                                             ProjectDirectory="$(MSBuildProjectDirectory)"
                                             OutputDirectories="@(_SunderRpcLocalGeneratedOutputLockDirectory)"
                                             LeaseId="$(_SunderRpcGeneratedOutputLockLeaseId)" />
    <OnError ExecuteTargets="_ReleaseSunderRpcGeneratedOutputLock" />
  </Target>

  <Target Name="ImportSunderRpcProjectContracts"
           BeforeTargets="CoreCompile"
           DependsOnTargets="_AcquireSunderRpcImplementationOutputLock"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderRpcProjectExportBuild)' != 'true' and '$(_SunderRpcProjectImportEnabled)' == 'true'">
    <ItemGroup>
      <_SunderSourceContractBundle Remove="@(_SunderSourceContractBundle)" />
      <_SunderSourceRpcUse Remove="@(_SunderSourceRpcUse)" />
      <_SunderRpcAuthoringReceipt Remove="@(_SunderRpcAuthoringReceipt)" />
    </ItemGroup>
    <GenerateSunderRpcBindingsTask GenerationMode="ProjectImport"
                                  AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                                   ExpectedPackageProjectExports="@(_SunderRpcPackageProjectExport)"
                                   PackageId="%(_SunderRpcPackageProjectExport.PackageId)"
                                   PackageVersion="$(Version)"
                                    ProjectIdentity="$(MSBuildProjectName)"
                                    Configuration="$(Configuration)"
                                    TargetFramework="$(TargetFramework)"
                                    ProjectDirectory="$(MSBuildProjectDirectory)"
                                    IntermediateOutputPath="$(IntermediateOutputPath)"
                                    OutputLockLeaseId="$(_SunderRpcGeneratedOutputLockLeaseId)"
                                    Condition="'@(_SunderRpcPackageProjectExport)' != ''">
      <Output TaskParameter="CompileItems" ItemName="Compile" />
      <Output TaskParameter="BindingSnapshots" ItemName="_SunderRpcBindingSnapshot" />
      <Output TaskParameter="ContractBundles" ItemName="_SunderSourceContractBundle" />
      <Output TaskParameter="RpcUses" ItemName="_SunderSourceRpcUse" />
      <Output TaskParameter="AuthoringReceipts" ItemName="_SunderRpcAuthoringReceipt" />
    </GenerateSunderRpcBindingsTask>
    <ManageSunderRpcGeneratedOutputLockTask Action="Retain"
                                             ProjectDirectory="$(MSBuildProjectDirectory)"
                                             OutputDirectories="@(_SunderRpcLocalGeneratedOutputLockDirectory)"
                                             LeaseId="$(_SunderRpcGeneratedOutputLockLeaseId)" />
    <OnError ExecuteTargets="_ReleaseSunderRpcGeneratedOutputLock" />
  </Target>

  <Target Name="GenerateSunderRpcBindings"
           DependsOnTargets="GenerateSunderRpcImplementationBindings;ImportSunderRpcProjectContracts"
           Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderRpcProjectExportBuild)' != 'true'" />

  <Target Name="CleanSunderRpcGeneratedOutput"
          BeforeTargets="CoreClean"
          DependsOnTargets="_ReleaseSunderRpcGeneratedOutputLock;_PrepareSunderPackageBuildTasks"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderRpcProjectExportBuild)' != 'true'">
    <PropertyGroup>
      <_SunderRpcCleanLocalIntermediateOutputPath>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)', '$(MSBuildProjectDirectory)'))</_SunderRpcCleanLocalIntermediateOutputPath>
      <_SunderRpcCleanNeutralIntermediateOutputPath>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)', '$(Configuration)', '$(TargetFramework)'))))</_SunderRpcCleanNeutralIntermediateOutputPath>
    </PropertyGroup>
    <ItemGroup>
      <_SunderRpcGeneratedDirectoryToClean Remove="@(_SunderRpcGeneratedDirectoryToClean)" />
      <_SunderRpcGeneratedDirectoryToClean Include="$([System.IO.Path]::Combine('$(_SunderRpcCleanLocalIntermediateOutputPath)', 'sunder-rpc'))">
        <DiscoveryRoot>$(_SunderRpcCleanLocalIntermediateOutputPath)</DiscoveryRoot>
      </_SunderRpcGeneratedDirectoryToClean>
      <_SunderRpcGeneratedDirectoryToClean Include="$([System.IO.Path]::Combine('$(_SunderRpcCleanNeutralIntermediateOutputPath)', 'sunder-rpc'))"
                                          Condition="'$(SunderPackageCompilationRole)' == ''">
        <DiscoveryRoot>$(_SunderRpcCleanNeutralIntermediateOutputPath)</DiscoveryRoot>
      </_SunderRpcGeneratedDirectoryToClean>
      <_SunderRpcGeneratedDirectoryToClean Include="$([System.IO.Path]::Combine('$(_SunderRpcCleanNeutralIntermediateOutputPath)', 'sunder-design-time', 'sunder-rpc'))"
                                          Condition="'$(SunderPackageCompilationRole)' == '' and '$(_SunderPackageSingleProject)' == 'true'">
        <DiscoveryRoot>$([System.IO.Path]::Combine('$(_SunderRpcCleanNeutralIntermediateOutputPath)', 'sunder-design-time'))</DiscoveryRoot>
      </_SunderRpcGeneratedDirectoryToClean>
    </ItemGroup>
    <CleanSunderRpcGeneratedOutputTask ProjectDirectory="$(MSBuildProjectDirectory)"
                                       GeneratedDirectories="@(_SunderRpcGeneratedDirectoryToClean)" />
  </Target>

  <Target Name="GenerateSunderPackageManifest"
           DependsOnTargets="_PrepareSunderPackageBuildTasks;GenerateSunderRpcBindings"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackageProject)' != 'false' and ('$(_SunderPackageSingleProject)' != 'true' or '$(SunderPackageCompilationRole)' != '')">
    <Error Condition="'$(SunderGeneratedPackageManifest)' == '' and '$(IntermediateOutputPath)' == ''"
           Text="Sunder manifest generation requires a resolved intermediate output path or an explicit SunderGeneratedPackageManifest." />
    <PropertyGroup>
      <!-- A source import may precede Sdk.targets and its TFM/RID path defaults. -->
      <SunderGeneratedPackageManifest Condition="'$(SunderGeneratedPackageManifest)' == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'sunder-package.json'))))</SunderGeneratedPackageManifest>
    </PropertyGroup>
    <ItemGroup>
      <_SunderAuthoredAssembly Include="$(TargetPath)" />
      <_SunderAuthoredAssembly Include="@(ReferenceCopyLocalPaths)"
                               Condition="'%(ReferenceCopyLocalPaths.ReferenceSourceTarget)' == 'ProjectReference' and '%(ReferenceCopyLocalPaths.Extension)' == '.dll'" />
    </ItemGroup>
    <GenerateSunderPackageManifestTask TargetAssemblyPath="$(TargetPath)"
                                       ManifestOutputPath="$(SunderGeneratedPackageManifest)"
                                       EntryAssembly="$(TargetFileName)"
                                       PackageVersion="$(Version)"
                                        ProjectDirectory="$(MSBuildProjectDirectory)"
                                        AssetsDirectory="$(SunderPackageAssetsDirectory)"
                                        TargetFramework="$(TargetFramework)"
                                       SdkPackageVersion="$(SunderSdkPackageVersion)"
                                       SdkCapabilities="@(SunderSdkCapability)"
                                       ReferencePaths="@(ReferencePath)"
                                        RuntimeCopyLocalPaths="@(ReferenceCopyLocalPaths)"
                                        AuthoredAssemblyPaths="@(_SunderAuthoredAssembly)"
                                        DynamicAccessAcknowledgements="@(SunderSdkDynamicAccess)"
                                         RuntimeIdentifiers="@(_SunderPackageRuntimeIdentifier)"
                                         PackageTargets="@(SunderPackageTarget)"
                                          PackageViews="@(SunderPackageView)"
                                           ContractBundles="@(SunderContractBundle);@(_SunderSourceContractBundle)"
                                          BindingSnapshots="@(_SunderRpcBindingSnapshot)"
                                           UsesContracts="@(SunderUsesContract);@(_SunderSourceRpcUse)"
                                            RpcProviders="@(SunderRpcProvider);@(_SunderSourceRpcProvider)"
                                            AuthoringReceipts="@(_SunderRpcAuthoringReceipt)"
                                           RpcOutputLockLeaseId="$(_SunderRpcGeneratedOutputLockLeaseId)"
                                          RuntimeIdentifier="$(RuntimeIdentifier)"
                                         OutputType="$(OutputType)"
                                          SelfContained="$(SelfContained)"
                                          UseAppHost="$(UseAppHost)"
                                          PublishSingleFile="$(PublishSingleFile)"
                                          PublishTrimmed="$(PublishTrimmed)">
      <Output TaskParameter="ResolvedTargets" ItemName="_SunderResolvedPackageTarget" />
      <Output TaskParameter="ResolvedContractFiles" ItemName="_SunderResolvedContractFile" />
      <Output TaskParameter="HasWorkerTarget" PropertyName="_SunderHasWorkerTarget" />
      <Output TaskParameter="WorkerEntryPointRelativePath" PropertyName="SunderPackageWorkerEntryPointRelativePath" />
    </GenerateSunderPackageManifestTask>
    <OnError ExecuteTargets="_ReleaseSunderRpcGeneratedOutputLock" />
  </Target>

  <Target Name="_CollectSunderWorkerFiles"
          DependsOnTargets="ComputeFilesToPublish"
          Condition="'$(_SunderHasWorkerTarget)' == 'true'">
    <PropertyGroup Condition="'$(SunderPackageWorkerSigningTargets)' != ''">
      <_SunderPackageWorkerSigningDirectory>$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(IntermediateOutputPath)', 'sunder-worker-signing'))))\</_SunderPackageWorkerSigningDirectory>
    </PropertyGroup>
    <RemoveDir Directories="$(_SunderPackageWorkerSigningDirectory)"
               Condition="'$(SunderPackageWorkerSigningTargets)' != ''" />
    <MakeDir Directories="$(_SunderPackageWorkerSigningDirectory)"
               Condition="'$(SunderPackageWorkerSigningTargets)' != ''" />
    <ItemGroup>
      <_SunderWorkerPublishFile Remove="@(_SunderWorkerPublishFile)" />
      <_SunderWorkerReferenceFile Remove="@(_SunderWorkerReferenceFile)" />
      <_SunderPublishedAssembly Remove="@(_SunderPublishedAssembly)" />
      <_SunderXmlDocumentationFile Remove="@(_SunderXmlDocumentationFile)" />
      <_SunderWorkerSymbolFile Remove="@(_SunderWorkerSymbolFile)" />
      <_SunderWorkerSourceFile Remove="@(_SunderWorkerSourceFile)" />
      <_SunderWorkerFile Remove="@(_SunderWorkerFile)" />
      <_SunderWorkerPublishFile Include="@(ResolvedFileToPublish)" />
      <_SunderWorkerReferenceFile Include="@(ReferenceCopyLocalPaths)"
                                  Exclude="@(ResolvedFileToPublish)">
        <RelativePath Condition="'%(ReferenceCopyLocalPaths.DestinationSubPath)' != ''">%(ReferenceCopyLocalPaths.DestinationSubPath)</RelativePath>
        <RelativePath Condition="'%(ReferenceCopyLocalPaths.DestinationSubPath)' == ''">%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)</RelativePath>
      </_SunderWorkerReferenceFile>
      <_SunderWorkerPublishFile Include="@(_SunderWorkerReferenceFile)" />
      <_SunderPublishedAssembly Include="@(_SunderWorkerPublishFile)"
                                 Condition="'%(_SunderWorkerPublishFile.Extension)' == '.dll'" />
      <_SunderXmlDocumentationFile Include="@(_SunderPublishedAssembly->'%(RootDir)%(Directory)%(Filename).xml')" />
      <_SunderWorkerSymbolFile Include="@(_SunderWorkerPublishFile)"
                               Condition="'%(_SunderWorkerPublishFile.Extension)' == '.pdb' or '%(_SunderWorkerPublishFile.Extension)' == '.mdb'" />
      <_SunderWorkerSourceFile Include="@(_SunderWorkerPublishFile)"
                                Exclude="@(_SunderXmlDocumentationFile);@(_SunderWorkerSymbolFile)"
                                Condition="'$(SunderPackageWorkerSigningTargets)' != ''" />
      <_SunderWorkerFile Include="@(_SunderWorkerPublishFile)"
                          Exclude="@(_SunderXmlDocumentationFile);@(_SunderWorkerSymbolFile)"
                          Condition="'$(SunderPackageWorkerSigningTargets)' == ''" />
    </ItemGroup>
    <Copy SourceFiles="@(_SunderWorkerSourceFile)"
          DestinationFiles="@(_SunderWorkerSourceFile->'$(_SunderPackageWorkerSigningDirectory)%(RelativePath)')"
          Condition="'$(SunderPackageWorkerSigningTargets)' != ''" />
    <ItemGroup Condition="'$(SunderPackageWorkerSigningTargets)' != ''">
      <_SunderWorkerFile Include="@(_SunderWorkerSourceFile->'$(_SunderPackageWorkerSigningDirectory)%(RelativePath)')">
        <RelativePath>%(_SunderWorkerSourceFile.RelativePath)</RelativePath>
      </_SunderWorkerFile>
      <SunderPackageWorkerSigningFile Include="@(_SunderWorkerFile)" />
    </ItemGroup>
  </Target>

  <Target Name="_RunSunderPackageWorkerSigning"
          DependsOnTargets="_CollectSunderWorkerFiles;$(SunderPackageWorkerSigningTargets)"
          Condition="'$(_SunderHasWorkerTarget)' == 'true'" />

  <Target Name="_ValidateSunderDevOutputPath"
            DependsOnTargets="_PrepareSunderPackageBuildTasks"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackageProject)' != 'false'">
    <PropertyGroup>
      <SunderDevOutputPath Condition="'$(SunderDevOutputPath)' == ''">$([System.IO.Path]::Combine('$(TargetDir)', 'sunder-dev'))</SunderDevOutputPath>
      <SunderDevOutputDiscoveryRoot Condition="'$(SunderDevOutputDiscoveryRoot)' == ''">$(TargetDir)</SunderDevOutputDiscoveryRoot>
    </PropertyGroup>

    <ValidateSunderDevOutputPathTask DevOutputPath="$(SunderDevOutputPath)"
                                      DiscoveryRoot="$(SunderDevOutputDiscoveryRoot)"
                                      ProjectDirectory="$(MSBuildProjectDirectory)"
                                      TargetDirectory="$(TargetDir)">
      <Output TaskParameter="NormalizedDevOutputPath" PropertyName="SunderDevOutputPath" />
      <Output TaskParameter="OwnershipMarkerPath" PropertyName="SunderDevOutputMarkerPath" />
    </ValidateSunderDevOutputPathTask>
  </Target>

  <Target Name="EmitSunderDevOutput"
            AfterTargets="Build"
            DependsOnTargets="GenerateSunderPackageManifest;_RunSunderPackageWorkerSigning;_ValidateSunderDevOutputPath"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackageProject)' != 'false' and ('$(_SunderPackageSingleProject)' != 'true' or '$(SunderPackageCompilationRole)' != '')">
    <ItemGroup>
      <_SunderRuntimeFiles Include="$(TargetDir)*.dll" />
      <_SunderRuntimeFiles Include="$(TargetDir)*.pdb" />
      <_SunderRuntimeFiles Include="$(TargetDir)*.deps.json" />
      <_SunderRuntimeFiles Include="$(TargetDir)*.runtimeconfig.json" />
      <_SunderRuntimeFiles Include="$(TargetDir)**\*.resources.dll"
                           Exclude="$(TargetDir)runtimes\**\*;$(SunderDevOutputPath)**\*" />
      <_SunderNativeRuntimeFiles Include="$(TargetDir)runtimes\**\*"
                                 Condition="Exists('$(TargetDir)runtimes')" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Sunder.Sdk.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Sunder.Sdk.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Sunder.Sdk.Stacks.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Sunder.Sdk.Stacks.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Sunder.Sdk.Avalonia.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Sunder.Sdk.Avalonia.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Microsoft.Extensions.DependencyInjection.Abstractions.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Microsoft.Extensions.DependencyInjection.Abstractions.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Microsoft.Extensions.Logging.Abstractions.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Microsoft.Extensions.Logging.Abstractions.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Controls.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Controls.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Base.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Base.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Markup.Xaml.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Markup.Xaml.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Markup.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Markup.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Dialogs.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Dialogs.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.DesignerSupport.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.DesignerSupport.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Remote.Protocol.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Remote.Protocol.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Metal.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Metal.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.OpenGL.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.OpenGL.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Vulkan.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.Vulkan.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.MicroCom.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)Avalonia.MicroCom.pdb" />
      <_SunderRuntimeFiles Remove="$(TargetDir)MicroCom.Runtime.dll" />
      <_SunderRuntimeFiles Remove="$(TargetDir)MicroCom.Runtime.pdb" />
      <_SunderAssetFiles Include="$(SunderPackageAssetsDirectory)\**\*"
                         Condition="Exists('$(SunderPackageAssetsDirectory)')" />
    </ItemGroup>

    <EmitSunderDevOutputTask ManifestPath="$(SunderGeneratedPackageManifest)"
                             ProjectDirectory="$(MSBuildProjectDirectory)"
                             ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)" AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                             DevPackagePath="$(SunderDevOutputPath)"
                             DiscoveryRoot="$(SunderDevOutputDiscoveryRoot)"
                             TargetDirectory="$(TargetDir)"
                             AssetsDirectory="$(SunderPackageAssetsDirectory)"
                               ManagedFiles="@(_SunderRuntimeFiles)"
                               NativeRuntimeFiles="@(_SunderNativeRuntimeFiles)"
                                WorkerFiles="@(_SunderWorkerFile)"
                                RoleContentFiles="@(_SunderRoleAppContent)"
                               AssetFiles="@(_SunderAssetFiles)"
                              ContractFiles="@(_SunderResolvedContractFile)" />
  </Target>

  <Target Name="_ValidateSunderPackagePrimaryProject"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true'">
    <PropertyGroup>
      <_SunderPackageAppProjectFullPath Condition="'$(SunderPackageAppProject)' != ''">$([System.IO.Path]::GetFullPath('$(SunderPackageAppProject)', '$(MSBuildProjectDirectory)'))</_SunderPackageAppProjectFullPath>
      <_SunderPackageAppProjectDirectory Condition="'$(_SunderPackageAppProjectFullPath)' != ''">$([System.IO.Path]::GetDirectoryName('$(_SunderPackageAppProjectFullPath)'))</_SunderPackageAppProjectDirectory>
      <SunderPackageAppTargetDiscoveryRoot Condition="'$(SunderPackageAppTargetDiscoveryRoot)' == '' and '$(_SunderPackageAppProjectDirectory)' != ''">$([System.IO.Path]::Combine('$(_SunderPackageAppProjectDirectory)', 'bin', '$(Configuration)', '$(SunderPackageAppTargetFramework)'))</SunderPackageAppTargetDiscoveryRoot>
      <SunderPackageAppTargetLeaf Condition="'$(SunderPackageAppTargetLeaf)' == '' and '$(SunderPackageAppTargetDiscoveryRoot)' != ''">$([System.IO.Path]::Combine('$(SunderPackageAppTargetDiscoveryRoot)', 'sunder-dev'))</SunderPackageAppTargetLeaf>
    </PropertyGroup>

    <ItemGroup>
      <_SunderPackageConfiguredRuntimeIdentifier Include="$(SunderPackageRuntimeIdentifiers)" />
      <_SunderPackageSelectedRuntimeIdentifier Include="$(SunderPackageComposeRuntimeIdentifiers)" />
      <_SunderPackageUnknownRuntimeIdentifier Include="@(_SunderPackageSelectedRuntimeIdentifier)"
                                              Exclude="@(_SunderPackageConfiguredRuntimeIdentifier)" />
    </ItemGroup>

    <Error Condition="'$(SunderPackageAppProject)' != '' and !Exists('$(_SunderPackageAppProjectFullPath)')"
           Text="SunderPackageAppProject '$(_SunderPackageAppProjectFullPath)' does not exist." />
    <Error Condition="'@(_SunderPackageSelectedRuntimeIdentifier)' == ''"
           Text="SunderPackageComposeRuntimeIdentifiers must select at least one configured RID." />
    <Error Condition="'@(_SunderPackageUnknownRuntimeIdentifier)' != ''"
           Text="SunderPackageComposeRuntimeIdentifiers contains unconfigured RID(s): @(_SunderPackageUnknownRuntimeIdentifier, ', ')." />
    <Error Condition="'$(SunderPackageUsePrebuiltLeaves)' == 'true' and '$(BuildProjectReferences)' != 'false'"
           Text="SunderPackageUsePrebuiltLeaves=true requires BuildProjectReferences=false so signed prebuilt inputs cannot trigger Worker or App builds." />
  </Target>

  <Target Name="_RejectSunderPackageBuildInPrebuiltMode"
          BeforeTargets="BeforeBuild;Compile;CoreCompile;Build"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true' and '$(SunderPackageUsePrebuiltLeaves)' == 'true'">
    <Error Text="SunderPackageUsePrebuiltLeaves=true does not permit Build. Invoke PackSunderPackage with BuildProjectReferences=false." />
  </Target>

  <Target Name="_RejectSunderPackagePreparationInPrebuiltMode"
          BeforeTargets="PrepareForBuild"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true' and '$(SunderPackageUsePrebuiltLeaves)' == 'true' and '$(_SunderContractSourceResolution)' != 'true'">
    <Error Text="SunderPackageUsePrebuiltLeaves=true permits reference-only contract checks, not Build preparation. Invoke PackSunderPackage with BuildProjectReferences=false." />
  </Target>

  <Target Name="_PrepareSunderPackageAppRpcExport"
          DependsOnTargets="_ValidateSunderPackagePrimaryProject;GenerateSunderRpcContractExports"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true' and '$(SunderPackageUsePrebuiltLeaves)' != 'true' and '$(SunderPackageAppProject)' != '' and '$(_SunderRpcHasOwnedContractsBaseline)' == 'true'" />

  <Target Name="_BuildSunderPackageApp"
          DependsOnTargets="_ValidateSunderPackagePrimaryProject;_PrepareSunderPackageAppRpcExport"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true' and '$(SunderPackageUsePrebuiltLeaves)' != 'true' and '$(SunderPackageAppProject)' != ''">
    <PropertyGroup Condition="'@(_SunderRpcPackageProjectExport)' != ''">
      <_SunderPackageAppBuildProperties>$(_SunderPackageAppBuildProperties);SunderRpcProjectImportBuild=true;SunderPackageRootProject=$(MSBuildProjectFullPath);SunderRpcPackageProjectExportPath=@(_SunderRpcPackageProjectExport->'%(FullPath)');SunderRpcPackageProjectExportSha256=@(_SunderRpcPackageProjectExport->'%(Sha256)');SunderRpcPackageProjectExportProjectIdentity=@(_SunderRpcPackageProjectExport->'%(ProjectIdentity)');SunderRpcPackageProjectExportConfiguration=@(_SunderRpcPackageProjectExport->'%(Configuration)');SunderRpcPackageProjectExportTargetFramework=@(_SunderRpcPackageProjectExport->'%(TargetFramework)');SunderRpcPackageProjectExportPackageId=@(_SunderRpcPackageProjectExport->'%(PackageId)');SunderRpcPackageProjectExportPackageVersion=@(_SunderRpcPackageProjectExport->'%(PackageVersion)')</_SunderPackageAppBuildProperties>
    </PropertyGroup>
    <MSBuild Projects="$(_SunderPackageAppProjectFullPath)"
             Targets="Build"
             Properties="$(_SunderPackageAppBuildProperties)"
             RemoveProperties="RuntimeIdentifier;SunderPackagePrimaryProject;SunderPackageInnerBuild;SunderPackageUsePrebuiltLeaves;SunderPackageComposeRuntimeIdentifiers"
             BuildInParallel="false"
             StopOnFirstFailure="true" />
  </Target>

  <Target Name="_BuildSunderPackagePrimaryLeaves"
          DependsOnTargets="_ValidateSunderPackagePrimaryProject"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true' and '$(SunderPackageUsePrebuiltLeaves)' != 'true'">
    <MSBuild Projects="$(MSBuildProjectFullPath)"
             Targets="Build"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=%(_SunderPackageSelectedRuntimeIdentifier.Identity);SunderPackageInnerBuild=true;SunderPackageUsePrebuiltLeaves=false"
             BuildInParallel="false"
             StopOnFirstFailure="true" />
  </Target>

  <Target Name="ComposeSunderPackage"
          AfterTargets="Build"
          DependsOnTargets="EmitSunderDevOutput;_ValidateSunderPackagePrimaryProject;_BuildSunderPackageApp;_PrepareSunderPackageBuildTasks"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true' and '$(SunderPackageUsePrebuiltLeaves)' != 'true'">
    <ItemGroup>
      <_SunderPackageCompositionLeaf Remove="@(_SunderPackageCompositionLeaf)" />
      <_SunderPackageCompositionLeaf Include="$(SunderDevOutputPath)"
                                     DiscoveryRoot="$(SunderDevOutputDiscoveryRoot)" />
      <_SunderPackageCompositionLeaf Include="$(SunderPackageAppTargetLeaf)"
                                     DiscoveryRoot="$(SunderPackageAppTargetDiscoveryRoot)"
                                     Condition="'$(SunderPackageAppTargetLeaf)' != ''" />
      <_SunderPackageCompositionLeaf Include="@(SunderPackageTargetLeaf)" />
      <_SunderPackageCompositionLeaf Include="@(SunderNodePackageTargetLeaf)" />
    </ItemGroup>

    <AggregateSunderPackageTask TargetLeaves="@(_SunderPackageCompositionLeaf)"
                                ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)" AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                                OutputPath="$(SunderPackageComposedOutputPath)"
                                OutputDiscoveryRoot="$(SunderPackageComposedOutputRoot)"
                                ProjectDirectory="$(MSBuildProjectDirectory)"
                                TargetDirectory="$(SunderPackageComposedOutputRoot)"
                                ExpectedPackageVersion="$(Version)" />
  </Target>

  <Target Name="AggregateSunderPackage"
          DependsOnTargets="_ValidateSunderPackagePrimaryProject;_BuildSunderPackageApp;_BuildSunderPackagePrimaryLeaves;_PrepareSunderPackageBuildTasks"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true'">
    <ItemGroup>
      <_SunderPackageCompositionLeaf Remove="@(_SunderPackageCompositionLeaf)" />
      <_SunderPackageCompositionLeaf Include="$([System.IO.Path]::Combine('$(SunderPackagePrimaryTargetLeafRoot)', '%(_SunderPackageSelectedRuntimeIdentifier.Identity)', 'sunder-dev'))">
        <DiscoveryRoot>$([System.IO.Path]::Combine('$(SunderPackagePrimaryTargetLeafRoot)', '%(_SunderPackageSelectedRuntimeIdentifier.Identity)'))</DiscoveryRoot>
      </_SunderPackageCompositionLeaf>
      <_SunderPackageCompositionLeaf Include="$(SunderPackageAppTargetLeaf)"
                                     DiscoveryRoot="$(SunderPackageAppTargetDiscoveryRoot)"
                                     Condition="'$(SunderPackageAppTargetLeaf)' != ''" />
      <_SunderPackageCompositionLeaf Include="@(SunderPackageTargetLeaf)" />
      <_SunderPackageCompositionLeaf Include="@(SunderNodePackageTargetLeaf)" />
    </ItemGroup>

    <AggregateSunderPackageTask TargetLeaves="@(_SunderPackageCompositionLeaf)"
                                  ContractLockPath="$(SunderContractLockPath)" ContractCacheRoot="$(SunderContractCacheRoot)" AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                                  OutputPath="$(SunderPackageComposedOutputPath)"
                                  OutputDiscoveryRoot="$(SunderPackageComposedOutputRoot)"
                                  ProjectDirectory="$(MSBuildProjectDirectory)"
                                  TargetDirectory="$(SunderPackageComposedOutputRoot)"
                                  ExpectedPackageVersion="$(Version)">
      <Output TaskParameter="NormalizedOutputPath" PropertyName="SunderPackageComposedOutputPath" />
    </AggregateSunderPackageTask>
  </Target>

  <Target Name="CleanSunderPackageComposedOutput"
          AfterTargets="Clean"
          DependsOnTargets="_PrepareSunderPackageBuildTasks"
          Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true'">
    <CleanSunderPackageOutputTask OutputPath="$(SunderPackageComposedOutputPath)"
                                  OutputDiscoveryRoot="$(SunderPackageComposedOutputRoot)"
                                  ProjectDirectory="$(MSBuildProjectDirectory)"
                                  TargetDirectory="$(SunderPackageComposedOutputRoot)" />
  </Target>

  <!-- Query authored App uses without building or trusting a prebuilt leaf's grants.
       Preserve duplicates so the manifest builder can reject invalid declarations. -->
  <Target Name="_GetSunderPackageAppContractUses"
          Returns="@(SunderUsesContract)"
          KeepDuplicateOutputs="true">
    <Error Condition="'@(SunderUsesContract)' != '' and !$([System.String]::Copy('%(SunderUsesContract.Role)').Trim().Equals('app'))"
           Text="SunderPackageAppProject contract uses must explicitly declare Role=app." />
  </Target>

  <Target Name="_PrepareSunderContractPackInputs" DependsOnTargets="_BeginSunderContractSourceResolution;$(_SunderRpcPackResolveTargets)">
    <PropertyGroup>
      <_SunderContractSourceResolution>false</_SunderContractSourceResolution>
      <_SunderRpcPackNullableEnabled>false</_SunderRpcPackNullableEnabled>
      <_SunderRpcPackNullableEnabled Condition="'$(Nullable)' == 'enable' or '$(Nullable)' == 'annotations'">true</_SunderRpcPackNullableEnabled>
    </PropertyGroup>
    <ItemGroup>
      <_SunderRpcPackSource Remove="@(_SunderRpcPackSource)" />
      <_SunderRpcPackSource Include="@(Compile)" Condition="'%(Compile.AutoGen)' != 'true'" />
      <_SunderRpcPackAppUse Remove="@(_SunderRpcPackAppUse)" />
    </ItemGroup>
    <MSBuild Projects="$(_SunderPackageAppProjectFullPath)"
             Targets="_GetSunderPackageAppContractUses"
             Properties="$(_SunderPackageAppBuildProperties);BuildProjectReferences=false"
             RemoveProperties="RuntimeIdentifier;SunderPackagePrimaryProject;SunderPackageInnerBuild;SunderPackageUsePrebuiltLeaves;SunderPackageComposeRuntimeIdentifiers"
             BuildInParallel="false"
             StopOnFirstFailure="true"
             Condition="'$(SunderPackagePrimaryProject)' == 'true' and '$(SunderPackageInnerBuild)' != 'true' and '$(_SunderPackageAppProjectFullPath)' != ''">
      <Output TaskParameter="TargetOutputs" ItemName="_SunderRpcPackAppUse" />
    </MSBuild>
  </Target>

  <Target Name="PackSunderPackage"
            DependsOnTargets="$(_SunderPackagePreparationTarget);_PrepareSunderContractPackInputs"
            Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackageProject)' != 'false'">
    <PropertyGroup>
      <_SunderPackageVersion Condition="'$(Version)' != ''">$(Version)</_SunderPackageVersion>
      <_SunderPackageVersion Condition="'$(_SunderPackageVersion)' == ''">1.1.0</_SunderPackageVersion>
      <SunderPackageFileName Condition="'$(SunderPackageFileName)' == ''">$(AssemblyName).$(_SunderPackageVersion).sunderpkg</SunderPackageFileName>
      <_SunderPackagePackOutputRoot Condition="'$(SunderPackagePrimaryProject)' == 'true'">$(SunderPackageComposedOutputRoot)</_SunderPackagePackOutputRoot>
      <_SunderPackagePackOutputRoot Condition="'$(_SunderPackagePackOutputRoot)' == ''">$(TargetDir)</_SunderPackagePackOutputRoot>
      <SunderPackageOutputPath Condition="'$(SunderPackageOutputPath)' == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(_SunderPackagePackOutputRoot)', '$(SunderPackageFileName)'))))</SunderPackageOutputPath>
      <_SunderPackagePackInputPath Condition="'$(SunderPackagePrimaryProject)' == 'true'">$(SunderPackageComposedOutputPath)</_SunderPackagePackInputPath>
      <_SunderPackagePackInputPath Condition="'$(_SunderPackagePackInputPath)' == ''">$(SunderDevOutputPath)</_SunderPackagePackInputPath>
      <_SunderPackagePackDiscoveryRoot Condition="'$(SunderPackagePrimaryProject)' == 'true'">$(SunderPackageComposedOutputRoot)</_SunderPackagePackDiscoveryRoot>
      <_SunderPackagePackDiscoveryRoot Condition="'$(_SunderPackagePackDiscoveryRoot)' == ''">$(SunderDevOutputDiscoveryRoot)</_SunderPackagePackDiscoveryRoot>
    </PropertyGroup>

    <PackSunderPackageTask DevPackagePath="$(_SunderPackagePackInputPath)"
                           ProjectFile="$(MSBuildProjectFullPath)" ProjectImports="$(MSBuildAllProjects)"
                          AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                             DevPackageDiscoveryRoot="$(_SunderPackagePackDiscoveryRoot)"
                             PackageOutputPath="$(SunderPackageOutputPath)"
                              ProjectDirectory="$(MSBuildProjectDirectory)"
                              SourceFiles="@(_SunderRpcPackSource)" ReferencePaths="@(ReferencePath)"
                              AuthoringReceipts="@(_SunderRpcAuthoringReceipt)"
                               ContractBundles="@(SunderContractBundle)" UsesContracts="@(SunderUsesContract);@(_SunderRpcPackAppUse)" RpcProviders="@(SunderRpcProvider)"
                              ProjectIdentity="$(MSBuildProjectName)" Configuration="$(Configuration)" TargetFramework="$(TargetFramework)"
                              DefineConstants="$(DefineConstants)" OutputType="$(OutputType)" AssemblyName="$(AssemblyName)" NullableEnabled="$(_SunderRpcPackNullableEnabled)"
                              OwnedContractsPath="$(SunderOwnedContractsPath)" ContractLockPath="$(SunderContractLockPath)"
                              ContractCacheRoot="$(SunderContractCacheRoot)" IntermediateOutputPath="$(IntermediateOutputPath)" />
  </Target>

  <Target Name="PackSunderPackageOnPublish"
            AfterTargets="Publish"
            DependsOnTargets="$(_SunderPackagePreparationTarget);_PrepareSunderContractPackInputs"
           Condition="'$(DesignTimeBuild)' != 'true' and '$(IsCrossTargetingBuild)' != 'true' and '$(SunderPackageProject)' != 'false'">
    <PropertyGroup>
      <_SunderPackageVersion Condition="'$(Version)' != ''">$(Version)</_SunderPackageVersion>
      <_SunderPackageVersion Condition="'$(_SunderPackageVersion)' == ''">1.1.0</_SunderPackageVersion>
      <SunderPackageFileName Condition="'$(SunderPackageFileName)' == ''">$(AssemblyName).$(_SunderPackageVersion).sunderpkg</SunderPackageFileName>
      <SunderPublishPackageOutputPath Condition="'$(SunderPublishPackageOutputPath)' == ''">$([System.IO.Path]::GetFullPath($([System.IO.Path]::Combine('$(MSBuildProjectDirectory)', '$(PublishDir)', '$(SunderPackageFileName)'))))</SunderPublishPackageOutputPath>
      <_SunderPackagePublishInputPath Condition="'$(SunderPackagePrimaryProject)' == 'true'">$(SunderPackageComposedOutputPath)</_SunderPackagePublishInputPath>
      <_SunderPackagePublishInputPath Condition="'$(_SunderPackagePublishInputPath)' == ''">$(SunderDevOutputPath)</_SunderPackagePublishInputPath>
      <_SunderPackagePublishDiscoveryRoot Condition="'$(SunderPackagePrimaryProject)' == 'true'">$(SunderPackageComposedOutputRoot)</_SunderPackagePublishDiscoveryRoot>
      <_SunderPackagePublishDiscoveryRoot Condition="'$(_SunderPackagePublishDiscoveryRoot)' == ''">$(SunderDevOutputDiscoveryRoot)</_SunderPackagePublishDiscoveryRoot>
    </PropertyGroup>

    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName('$(SunderPublishPackageOutputPath)'))" />
    <PackSunderPackageTask DevPackagePath="$(_SunderPackagePublishInputPath)"
                           ProjectFile="$(MSBuildProjectFullPath)" ProjectImports="$(MSBuildAllProjects)"
                          AllowDevelopmentRegistryOrigin="$(SunderAllowDevelopmentRegistryOrigin)"
                             DevPackageDiscoveryRoot="$(_SunderPackagePublishDiscoveryRoot)"
                             PackageOutputPath="$(SunderPublishPackageOutputPath)"
                              ProjectDirectory="$(MSBuildProjectDirectory)"
                              SourceFiles="@(_SunderRpcPackSource)" ReferencePaths="@(ReferencePath)"
                              AuthoringReceipts="@(_SunderRpcAuthoringReceipt)"
                               ContractBundles="@(SunderContractBundle)" UsesContracts="@(SunderUsesContract);@(_SunderRpcPackAppUse)" RpcProviders="@(SunderRpcProvider)"
                              ProjectIdentity="$(MSBuildProjectName)" Configuration="$(Configuration)" TargetFramework="$(TargetFramework)"
                              DefineConstants="$(DefineConstants)" OutputType="$(OutputType)" AssemblyName="$(AssemblyName)" NullableEnabled="$(_SunderRpcPackNullableEnabled)"
                              OwnedContractsPath="$(SunderOwnedContractsPath)" ContractLockPath="$(SunderContractLockPath)"
                              ContractCacheRoot="$(SunderContractCacheRoot)" IntermediateOutputPath="$(IntermediateOutputPath)" />
  </Target>
</Project>
