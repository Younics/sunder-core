  <!-- Operation leases span nested builds and must call the scheduler. Compiler
       and RPC-plan tasks continue to use their isolated task-host registrations. -->
  <UsingTask TaskName="Sunder.Package.Build.Tasks.ManageSunderPackageOperationLockTask"
             AssemblyFile="$(_SunderPackageBuildTaskShadowAssemblyFullPath)" />
