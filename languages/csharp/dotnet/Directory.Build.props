<Project>
    <Import Project="$(MSBuildThisFileDirectory)packages/Sunder.Package.Build/build/Sunder.Toolchains.props" />
    <PropertyGroup>
        <TargetFramework>$(SunderCurrentTargetFramework)</TargetFramework>
        <RuntimeFrameworkVersion Condition="'$(MSBuildProjectName)' == 'Sunder.App' or '$(MSBuildProjectName)' == 'Sunder.Runtime.Host' or '$(MSBuildProjectName)' == 'Sunder.Host.Supervisor' or '$(MSBuildProjectName)' == 'Sunder.Cli'">$(SunderHostRuntimeFrameworkVersion)</RuntimeFrameworkVersion>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <AnalysisLevel>latest</AnalysisLevel>
        <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
        <IsPackable>false</IsPackable>
        <SunderSdkAssemblyVersion>1.0.0.0</SunderSdkAssemblyVersion>
        <DefaultAllowedOutputExtensionsInPackageBuildOutputFolder>.dll; .exe; .winmd; .json; .pri</DefaultAllowedOutputExtensionsInPackageBuildOutputFolder>
        <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
        <RestoreLockedMode Condition="'$(CI)' == 'true' or '$(GITHUB_ACTIONS)' == 'true'">true</RestoreLockedMode>
    </PropertyGroup>
</Project>
