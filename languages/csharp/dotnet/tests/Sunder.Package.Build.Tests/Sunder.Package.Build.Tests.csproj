<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\packages\Sunder.Package.Build\Sunder.Package.Build.csproj" />
    <ProjectReference Include="..\..\libraries\Sunder.Package.Format\Sunder.Package.Format.csproj" />
    <ProjectReference Include="..\..\packages\Sunder.Sdk\Sunder.Sdk.csproj" />
    <ProjectReference Include="..\..\packages\Sunder.Sdk.Avalonia\Sunder.Sdk.Avalonia.csproj" />
    <ProjectReference Include="..\..\packages\Sunder.Sdk.Stacks\Sunder.Sdk.Stacks.csproj" />
    <ProjectReference Include="..\..\packages\Sunder.Sdk.Worker\Sunder.Sdk.Worker.csproj" />
    <ProjectReference Include="..\Sunder.Package.Build.TestFixtures\AuthoredReflection\AuthoredReflection.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Sunder.Package.Build.TestFixtures\AuthoredDynamicReflection\AuthoredDynamicReflection.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Sunder.Package.Build.TestFixtures\ExternalDependency\ExternalDependency.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Sunder.Package.Build.TestFixtures\GeneratedAvalonia\GeneratedAvalonia.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Sunder.Package.Build.TestFixtures\MissingExternal\MissingExternal.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Sunder.Package.Build.TestFixtures\MissingSdkDependency\MissingSdkDependency.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Sunder.Package.Build.TestFixtures\SourceReferencePackage\SourceReferencePackage.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="..\Sunder.Package.Build.TestFixtures\WorkerV1Executable\WorkerV1Executable.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Build.Framework" />
    <PackageReference Include="Microsoft.Build.Utilities.Core" />
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="PackedAppActivationProbe.cs" />
    <None Include="PackedAppActivationProbe.cs" />
    <EmbeddedResource Include="..\Sunder.Sdk.Worker.Tests\TestSupport\WorkerHarness.cs" LogicalName="WorkerHarnessSources.WorkerHarness.cs" />
    <EmbeddedResource Include="..\Sunder.Sdk.Worker.Tests\TestSupport\AsyncByteStream.cs" LogicalName="WorkerHarnessSources.AsyncByteStream.cs" />
    <None Include="..\..\..\..\..\specs\generated-output\v1\conformance\documents.json"
          Link="GeneratedOutputConformance\documents.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\..\eng\test-oracles\core-public-packages.json"
          Link="TestOracles\core-public-packages.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\..\specs\rpc\v1\authoring\current-parity\csharp\**\*"
          Link="CurrentRpcAuthoring\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="_CopyEditorAnalyzerForTests" AfterTargets="CopyFilesToOutputDirectory">
    <ItemGroup>
      <_EditorToolOwner Include="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Filename)%(ReferenceCopyLocalPaths.Extension)' == 'Sunder.Package.Build.dll'" />
    </ItemGroup>
    <Copy SourceFiles="@(_EditorToolOwner->'%(RootDir)%(Directory)Sunder.Package.Build.Editor.dll')"
          DestinationFiles="$(TargetDir)Sunder.Package.Build.Editor.dll" SkipUnchangedFiles="true" />
    <ItemGroup><FileWrites Include="$(TargetDir)Sunder.Package.Build.Editor.dll" /></ItemGroup>
  </Target>
  <Target Name="BuildPackedAppActivationProbe" AfterTargets="Build" DependsOnTargets="ResolveReferences"
          Inputs="PackedAppActivationProbe.cs;@(ReferencePathWithRefAssemblies)"
          Outputs="$(TargetDir)packed-app-probe/PackedAppActivationProbe.dll">
    <MakeDir Directories="$(TargetDir)packed-app-probe" />
    <Csc Sources="PackedAppActivationProbe.cs" References="@(ReferencePathWithRefAssemblies)"
         OutputAssembly="$(TargetDir)packed-app-probe/PackedAppActivationProbe.dll"
         TargetType="Exe" TargetFramework="$(TargetFramework)" LangVersion="$(LangVersion)" Nullable="$(Nullable)"
         NoConfig="true" NoLogo="true" NoStandardLib="true" Deterministic="true" TreatWarningsAsErrors="true"
         ToolExe="$(CscToolExe)" ToolPath="$(CscToolPath)" />
    <ItemGroup><FileWrites Include="$(TargetDir)packed-app-probe/PackedAppActivationProbe.dll" /></ItemGroup>
  </Target>
</Project>
