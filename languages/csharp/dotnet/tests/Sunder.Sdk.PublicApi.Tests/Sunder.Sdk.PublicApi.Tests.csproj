<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <ProjectReference Include="..\..\host\Sunder.Host.Contracts\Sunder.Host.Contracts.csproj" />
    <ProjectReference Include="..\..\host\Sunder.Runtime.Contracts\Sunder.Runtime.Contracts.csproj" />
    <ProjectReference Include="..\..\libraries\Sunder.Registry.Contracts\Sunder.Registry.Contracts.csproj" />
    <ProjectReference Include="..\..\packages\Sunder.Sdk\Sunder.Sdk.csproj" />
    <ProjectReference Include="..\..\packages\Sunder.Sdk.Avalonia\Sunder.Sdk.Avalonia.csproj" />
    <ProjectReference Include="..\..\packages\Sunder.Sdk.Stacks\Sunder.Sdk.Stacks.csproj" />
    <ProjectReference Include="..\..\packages\Sunder.Sdk.Worker\Sunder.Sdk.Worker.csproj" />
    <ProjectReference Include="..\..\packages\Sunder.Package.Build\Sunder.Package.Build.csproj" />
    <ProjectReference Include="..\..\libraries\Sunder.Package.Format\Sunder.Package.Format.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.CodeAnalysis">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Microsoft.CodeAnalysis.CSharp">
      <HintPath>$(MSBuildSDKsPath)/../Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <!-- Frozen migration oracle source is retained byte-for-byte as inert history.
         Current Stack checks belong to source parity, platform lifecycle and package artifact tests. -->
    <Compile Remove="StackContributorRpcMigrationBaselineTests.cs" />
    <None Include="PublicApi\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="ApiFidelity\*.txt" CopyToOutputDirectory="PreserveNewest" />
    <None Include="RuntimeContracts\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="PolicyContracts\*.json" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\..\specs\policy\v1\*.json" Link="PolicySpecs\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\..\specs\rpc\v1\conformance\**\*.json"
          Link="RpcV1Conformance\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\..\specs\rpc\v1\descriptor.schema.json"
          Link="RpcV1Conformance\descriptor.schema.json"
          CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\..\..\..\specs\rpc\v1\authoring\**\*"
          Exclude="..\..\..\..\..\specs\rpc\v1\authoring\parity\**\*"
          Link="RpcV1Authoring\%(RecursiveDir)%(Filename)%(Extension)"
          CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\..\..\..\specs\rpc\v1\conformance\identifier-keywords.json"
             Link="conformance\identifier-keywords.json"
             CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
