<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <Version>1.0.0</Version>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SunderSdkPackageVersion>1.1.0</SunderSdkPackageVersion>
    <SunderGeneratedPackageManifest>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\sunder-package.json'))</SunderGeneratedPackageManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\packages\Sunder.Sdk.Worker\Sunder.Sdk.Worker.csproj" />
    <ProjectReference Include="..\..\packages\Sunder.Package.Build\Sunder.Package.Build.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <SunderContractBundle Include="Contracts\example.rpc.json"
                          ContractId="example.messages"
                          Version="2.0.0"
                          DescriptorPath="contracts/example.rpc.json"
                          Exposure="public" />
    <SunderUsesContract Include="example.messages"
                        Role="runtime"
                        ContractVersion="2.0.0"
                        Required="true"
                        Actions="discover;invoke;subscribe" />
    <SunderRpcProvider Include="sunder.interop.dotnet.provider"
                       ContractId="example.messages"
                       ContractVersion="2.0.0"
                       Role="runtime"
                       Audience="public" />
    <SunderPackageTarget Include="runtime/$(RuntimeIdentifier)"
                         Role="runtime"
                         Rid="$(RuntimeIdentifier)"
                         Kind="worker" />
  </ItemGroup>

  <Import Project="..\..\packages\Sunder.Package.Build\build\Sunder.Package.Build.targets" />
</Project>
