<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Version>1.0.0</Version>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <RuntimeIdentifiers>win-x64;win-arm64;linux-x64;linux-arm64;osx-x64;osx-arm64</RuntimeIdentifiers>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <SunderPackagePrimaryProject>true</SunderPackagePrimaryProject>
    <SunderSdkPackageVersion>1.1.0</SunderSdkPackageVersion>
    <SunderGeneratedPackageManifest>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\obj\$(Configuration)\$(TargetFramework)\$(RuntimeIdentifier)\sunder-package.json'))</SunderGeneratedPackageManifest>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\..\packages\Sunder.Sdk.Worker\Sunder.Sdk.Worker.csproj" />
    <ProjectReference Include="..\..\..\packages\Sunder.Package.Build\Sunder.Package.Build.csproj"
                      ReferenceOutputAssembly="false"
                      PrivateAssets="all" />
    <SunderPackageTarget Include="runtime/$(RuntimeIdentifier)"
                         Role="runtime"
                         Rid="$(RuntimeIdentifier)"
                         Kind="worker" />
    <SunderNodePackageTargetLeaf Include="$(SunderFixtureAdditionalNodeLeaf)"
                                 DiscoveryRoot="$(SunderFixtureAdditionalNodeLeafDiscoveryRoot)"
                                 Condition="'$(SunderFixtureAdditionalNodeLeaf)' != ''" />
  </ItemGroup>

  <Target Name="TraceSunderPackageFixtureBuild"
          BeforeTargets="Build"
          Condition="'$(SunderPackageBuildTraceFile)' != ''">
    <WriteLinesToFile File="$(SunderPackageBuildTraceFile)"
                      Lines="$(RuntimeIdentifier)|$(SunderPackageInnerBuild)"
                      Overwrite="false" />
  </Target>

  <Import Project="..\..\..\packages\Sunder.Package.Build\build\Sunder.Package.Build.targets" />
</Project>
