<Project Sdk="Microsoft.NET.Sdk">
  <ItemGroup>
    <PackageReference Include="Avalonia.Headless" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="..\AgentCurrentBaseline.cs" Link="AgentCurrentBaseline.cs" />
    <Compile Include="..\AgentCurrentInputs.cs" Link="AgentCurrentInputs.cs" />
    <ProjectReference Include="..\..\host\Sunder.App\Sunder.App.csproj" OutputItemType="_SunderAppTargetPath" />
    <Compile Remove="SdkCorpusAppProbe.cs" />
    <None Include="SdkCorpusAppProbe.cs" />
    <Compile Remove="PolicyHeartbeatProcessProbe.cs" />
    <None Include="PolicyHeartbeatProcessProbe.cs" />
    <Compile Remove="MacOsWindowDelegateProcessProbe.cs" />
    <None Include="MacOsWindowDelegateProcessProbe.cs" />
  </ItemGroup>

  <Target Name="WriteSunderAppTargetPathForTests"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <Error Condition="'@(_SunderAppTargetPath->Count())' != '1'"
           Text="The App tests could not resolve the Sunder.App build output." />
    <WriteLinesToFile File="$(OutDir)sunder-app-target-path.txt"
                      Lines="@(_SunderAppTargetPath->'%(FullPath)')"
                      Overwrite="true" />
  </Target>

  <Target Name="BuildSdkCorpusAppProbe" AfterTargets="Build" DependsOnTargets="ResolveReferences"
          Inputs="$(MSBuildProjectDirectory)/SdkCorpusAppProbe.cs;$(MSBuildProjectDirectory)/TestAppPackageHost.cs;$(MSBuildProjectDirectory)/RuntimeContractTestData.cs;@(ReferencePathWithRefAssemblies)"
          Outputs="$(TargetDir)corpus-probe/Sunder.App.Tests.dll">
    <MakeDir Directories="$(TargetDir)corpus-probe" />
    <Csc Sources="SdkCorpusAppProbe.cs;TestAppPackageHost.cs;RuntimeContractTestData.cs"
         References="@(ReferencePathWithRefAssemblies)" OutputAssembly="$(TargetDir)corpus-probe/Sunder.App.Tests.dll"
         TargetType="Exe" TargetFramework="$(TargetFramework)" LangVersion="$(LangVersion)" Nullable="$(Nullable)"
         NoConfig="true" NoLogo="true" NoStandardLib="true" Deterministic="true" TreatWarningsAsErrors="true"
         ToolExe="$(CscToolExe)" ToolPath="$(CscToolPath)" />
  </Target>

  <Target Name="BuildPolicyHeartbeatProcessProbe" AfterTargets="Build" DependsOnTargets="ResolveReferences"
          Inputs="$(MSBuildProjectDirectory)/PolicyHeartbeatProcessProbe.cs;@(ReferencePathWithRefAssemblies)"
          Outputs="$(TargetDir)policy-heartbeat-probe/Sunder.App.Tests.dll">
    <MakeDir Directories="$(TargetDir)policy-heartbeat-probe" />
    <Csc Sources="PolicyHeartbeatProcessProbe.cs" References="@(ReferencePathWithRefAssemblies)"
         OutputAssembly="$(TargetDir)policy-heartbeat-probe/Sunder.App.Tests.dll"
         TargetType="Exe" TargetFramework="$(TargetFramework)" LangVersion="$(LangVersion)" Nullable="$(Nullable)"
         NoConfig="true" NoLogo="true" NoStandardLib="true" Deterministic="true" TreatWarningsAsErrors="true"
         ToolExe="$(CscToolExe)" ToolPath="$(CscToolPath)" />
  </Target>

  <Target Name="BuildMacOsWindowDelegateProcessProbe" AfterTargets="Build" DependsOnTargets="ResolveReferences"
          Inputs="$(MSBuildProjectDirectory)/MacOsWindowDelegateProcessProbe.cs;@(ReferencePathWithRefAssemblies)"
          Outputs="$(TargetDir)window-delegate-probe/Sunder.App.Tests.dll">
    <MakeDir Directories="$(TargetDir)window-delegate-probe" />
    <Csc Sources="MacOsWindowDelegateProcessProbe.cs" References="@(ReferencePathWithRefAssemblies)"
         OutputAssembly="$(TargetDir)window-delegate-probe/Sunder.App.Tests.dll"
         TargetType="Exe" TargetFramework="$(TargetFramework)" LangVersion="$(LangVersion)" Nullable="$(Nullable)"
         NoConfig="true" NoLogo="true" NoStandardLib="true" Deterministic="true" TreatWarningsAsErrors="true"
         ToolExe="$(CscToolExe)" ToolPath="$(CscToolPath)" />
  </Target>
  <Target Name="CopyMacOsWindowDelegateProbeNativeAssets" AfterTargets="BuildMacOsWindowDelegateProcessProbe">
    <ItemGroup>
      <_WindowDelegateProbeNative Include="$(TargetDir)runtimes/osx/native/*.dylib" />
    </ItemGroup>
    <Copy SourceFiles="@(_WindowDelegateProbeNative)" DestinationFolder="$(TargetDir)window-delegate-probe" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(_WindowDelegateProbeNative)" DestinationFolder="$(TargetDir)policy-heartbeat-probe" SkipUnchangedFiles="true" />
  </Target>
</Project>
