<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sunder.App.ViewModels">
  <Style Selector="ItemsControl.people-list">
    <Setter Property="ItemTemplate">
      <DataTemplate x:DataType="vm:RegistryUserAttributionViewModel">
        <Border Classes="detail-row" Margin="0,0,0,4">
          <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
            <Border Width="30" Height="30" CornerRadius="15" Background="{DynamicResource Sunder.Brush.Accent.Soft}">
              <TextBlock Text="{Binding Initial}" Foreground="{DynamicResource Sunder.Brush.Info}"
                         FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <StackPanel Grid.Column="1">
              <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" TextWrapping="Wrap" />
              <TextBlock Classes="caption" Text="{Binding Role}" />
            </StackPanel>
          </Grid>
        </Border>
      </DataTemplate>
    </Setter>
  </Style>
  <Style Selector="ListBox.package-list">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Transparent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

  <Style Selector="ListBox.package-list ListBoxItem">
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0,0,0,4" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
  </Style>

  <Style Selector="ListBox.package-list ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
  </Style>

  <Style Selector="Border.package-list-row">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Medium}" />
    <Setter Property="Padding" Value="10" />
  </Style>

  <Style Selector="Border.package-list-row:pointerover">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
  </Style>

  <Style Selector="Border.package-list-row.selected">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
  </Style>

  <Style Selector="Border.package-row-badge">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Full}" />
    <Setter Property="Padding" Value="7,2" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="Border.package-row-badge.update">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Info.Soft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
  </Style>

  <Style Selector="Border.package-row-badge TextBlock">
    <Setter Property="FontSize" Value="10" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
  </Style>

  <Style Selector="Border.package-row-badge.update TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Accent}" />
  </Style>

  <Style Selector="Border.package-row-badge.supported">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Success.Soft}" />
  </Style>
  <Style Selector="Border.package-row-badge.supported TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Success}" />
  </Style>
  <Style Selector="Border.package-row-badge.unsupported">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Warning.Soft}" />
  </Style>
  <Style Selector="Border.package-row-badge.unsupported TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Warning}" />
  </Style>

  <Style Selector="Border.marketplace-profile-row">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Medium}" />
    <Setter Property="Padding" Value="10,9" />
    <Setter Property="Margin" Value="0,0,0,7" />
  </Style>

  <Style Selector="HyperlinkButton.marketplace-profile-link">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Transparent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Accent}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="HorizontalContentAlignment" Value="Left" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="HyperlinkButton.marketplace-profile-link:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
  </Style>

  <Style Selector="HyperlinkButton.marketplace-profile-link:visited">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
  </Style>

  <Style Selector="Border.marketplace-tag-chip">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Full}" />
    <Setter Property="Margin" Value="0,0,6,6" />
    <Setter Property="Padding" Value="8,4" />
  </Style>

  <Style Selector="Border.marketplace-tag-chip TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Button.marketplace-image-thumb">
    <Setter Property="Width" Value="148" />
    <Setter Property="Height" Value="100" />
    <Setter Property="Padding" Value="7" />
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="16" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="VerticalContentAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Button.marketplace-image-thumb:pointerover">
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
  </Style>

  <Style Selector="Border.marketplace-image-frame">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Background.App}" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>

  <Style Selector="TextBlock.marketplace-image-loading">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
  </Style>

  <Style Selector="Path.marketplace-detail-spinner">
    <Setter Property="Width" Value="28" />
    <Setter Property="Height" Value="28" />
    <Setter Property="Stretch" Value="Uniform" />
    <Setter Property="Stroke" Value="{DynamicResource Sunder.Brush.Accent}" />
    <Setter Property="StrokeThickness" Value="3" />
    <Setter Property="StrokeLineCap" Value="Round" />
    <Setter Property="Opacity" Value="0.78" />
    <Style.Animations>
      <Animation Duration="0:0:0.9" IterationCount="Infinite">
        <KeyFrame Cue="0%">
          <Setter Property="RotateTransform.Angle" Value="0" />
        </KeyFrame>
        <KeyFrame Cue="100%">
          <Setter Property="RotateTransform.Angle" Value="360" />
        </KeyFrame>
      </Animation>
    </Style.Animations>
  </Style>
</Styles>
