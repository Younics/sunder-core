<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window.management-window Border.toolbar-surface">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>
  <Style Selector="Border.window-footer">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="16,10" />
  </Style>
  <Style Selector="Border.detail-surface">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Workspace}" />
  </Style>
  <Style Selector="Border.detail-row, Window.management-window Border.card-surface">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="8" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="BoxShadow" Value="none" />
  </Style>
  <Style Selector="Border.review-warning, Border.review-error">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Warning.Soft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Warning}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="12,9" />
  </Style>
  <Style Selector="Border.review-error">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Danger.Soft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Danger}" />
  </Style>
  <Style Selector="TextBlock.section-label">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Muted}" />
  </Style>
  <Style Selector="Border.wizard-stage">
    <Setter Property="BorderThickness" Value="0,0,0,2" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="Padding" Value="6,8" />
  </Style>
  <Style Selector="Border.wizard-stage.active">
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Selected}" />
  </Style>
  <Style Selector="Border.wizard-stage TextBlock">
    <Setter Property="HorizontalAlignment" Value="Center" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>
  <Style Selector="TextBlock.detail-intro">
    <Setter Property="FontSize" Value="16" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="TextBlock.code-value, SelectableTextBlock.code-value">
    <Setter Property="FontFamily" Value="Menlo,Consolas,monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Window.management-window Button.primary-action, Window.management-window Button.secondary-action:not(.settings-nav-button)">
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}"
                          Padding="{TemplateBinding Padding}" Content="{TemplateBinding Content}"
                          ContentTemplate="{TemplateBinding ContentTemplate}" RecognizesAccessKey="True"
                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
      </ControlTemplate>
    </Setter>
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="CornerRadius" Value="7" />
  </Style>
  <Style Selector="Window.management-window Button.danger-action">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Danger}" />
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Danger.Soft}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Danger}" />
  </Style>
  <Style Selector="Window.management-window Button.danger-action:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.OnDanger}" />
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Danger}" />
  </Style>
  <Style Selector="Window.management-window Button.primary-action:pressed, Window.management-window Button.secondary-action:pressed">
    <Setter Property="Opacity" Value="0.8" />
  </Style>
  <Style Selector="Window.management-window Button.primary-action:disabled, Window.management-window Button.secondary-action:disabled">
    <Setter Property="Opacity" Value="0.5" />
  </Style>
  <Style Selector="TabControl.detail-tabs TabItem">
    <Setter Property="Template">
      <ControlTemplate>
        <ContentPresenter Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                          Padding="{TemplateBinding Padding}" BorderBrush="{TemplateBinding BorderBrush}"
                          BorderThickness="0,0,0,2" Background="{TemplateBinding Background}"
                          VerticalContentAlignment="Center" />
      </ControlTemplate>
    </Setter>
    <Setter Property="FontSize" Value="13" />
    <Setter Property="MinHeight" Value="32" />
    <Setter Property="Padding" Value="8,8" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
  </Style>
  <Style Selector="TabControl.package-tabs">
    <Setter Property="ItemsPanel"><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></Setter>
  </Style>
  <ContainerQuery Name="PackageTabArea" Query="max-width:510">
    <Style Selector="TabControl.package-tabs">
      <Setter Property="ItemsPanel"><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></Setter>
    </Style>
  </ContainerQuery>
  <Style Selector="TabControl.detail-tabs TabItem:pointerover">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
  </Style>
  <Style Selector="TabControl.detail-tabs TabItem:selected">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Info}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
  </Style>
  <Style Selector="Window.management-window Expander">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="38" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="CornerRadius" Value="8" />
  </Style>
  <Style Selector="Window.management-window Expander /template/ ToggleButton#ExpanderHeader">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Base}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    <Setter Property="Padding" Value="12,4,0,4" />
  </Style>
  <Style Selector="Window.management-window Expander /template/ ToggleButton#ExpanderHeader:pointerover /template/ Border#ToggleButtonBackground">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
  </Style>
  <Style Selector="Window.management-window ProgressBar">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
  </Style>
  <Style Selector="ListBox.theme-choices">
    <Setter Property="Padding" Value="0" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ListBox.theme-choices ListBoxItem">
    <Setter Property="Padding" Value="9" />
    <Setter Property="Margin" Value="0,0,8,6" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
  </Style>
  <Style Selector="ListBox.theme-choices ListBoxItem:selected">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Selected}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
  </Style>
</Styles>
