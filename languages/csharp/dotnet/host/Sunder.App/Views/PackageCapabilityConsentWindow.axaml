<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Sunder.App.Views.Controls"
        xmlns:vm="using:Sunder.App.ViewModels"
        x:Class="Sunder.App.Views.PackageCapabilityConsentWindow"
        x:DataType="vm:PackageCapabilityConsentViewModel"
        mc:Ignorable="d"
        Width="680"
        Height="700"
        MinWidth="360"
        MinHeight="380"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Install package from marketplace"
        Icon="avares://Sunder.App/Assets/Images/app.ico"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ShowInTaskbar="False"
        Classes="secondary-window management-window">
  <Grid RowDefinitions="52,*,Auto"
        Background="{DynamicResource Sunder.Brush.Surface.Workspace}">
    <controls:WindowTitleBar Grid.Row="0">
      <controls:WindowTitleBar.CenterContent>
        <TextBlock Classes="section-title"
                   VerticalAlignment="Center"
                   TextWrapping="Wrap"
                   Text="{Binding $parent[Window].Title}" />
      </controls:WindowTitleBar.CenterContent>
    </controls:WindowTitleBar>

    <ScrollViewer Grid.Row="1"
                  Margin="20,12,20,8"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14">
        <TextBlock Classes="page-title" Text="{Binding ReviewTitle}" TextWrapping="Wrap" />
        <StackPanel Spacing="8" IsVisible="{Binding HasRegistryPlans}">
          <TextBlock Classes="section-label" Text="Source" />
          <ItemsControl ItemsSource="{Binding RegistryPlans}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RegistryPlanConfirmationItemViewModel">
                <Border Classes="card-surface" Margin="0,0,0,8">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding RegistryOrigin}" TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="{Binding PrereleasePolicyText}" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Classes="caption" Text="{Binding Device, StringFormat='Device: {0}'}" />

        <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10">
          <Border Classes="card-surface">
            <StackPanel Spacing="4">
              <TextBlock Classes="caption" Text="Packages" TextWrapping="Wrap" />
              <TextBlock Classes="section-title" Text="{Binding PackageDownloadText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card-surface">
            <StackPanel Spacing="4">
              <TextBlock Classes="caption" Text="Runtime" TextWrapping="Wrap" />
              <TextBlock Classes="section-title" Text="{Binding SharedRuntimeDownloadText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Grid.Column="2" Classes="card-surface">
            <StackPanel Spacing="4">
              <TextBlock Classes="caption" Text="Total" />
              <TextBlock Classes="section-title" Text="{Binding TotalDownloadText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>
        <TextBlock Classes="caption" Text="{Binding SharedRuntimeReuseText}" TextWrapping="Wrap" />

        <StackPanel Spacing="8" IsVisible="{Binding HasChanges}">
          <TextBlock Classes="section-title" Text="Package changes" />
          <ItemsControl ItemsSource="{Binding Changes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PackageChangeConfirmationItemViewModel">
                <Border Classes="card-surface" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                    <StackPanel Spacing="3">
                      <TextBlock FontWeight="SemiBold" Text="{Binding PackageId}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding PackageVersion}" TextWrapping="Wrap" />
                    </StackPanel>
                    <Border Grid.Column="1" Classes="package-row-badge"><TextBlock Text="{Binding ActionText}" /></Border>
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding HasExecutionRuntimes}">
          <TextBlock Classes="section-title" Text="Package runtimes" />
          <ItemsControl ItemsSource="{Binding ExecutionRuntimes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ExecutionRuntimeDownloadItemViewModel">
                <Border Classes="card-surface" Margin="0,0,0,8">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock FontWeight="SemiBold" Text="{Binding IdentityText}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding DownloadText}" />
                    </Grid>
                    <StackPanel Spacing="3">
                      <TextBlock Classes="caption" Text="{Binding TargetText}" TextWrapping="Wrap" />
                      <TextBlock Classes="caption" Text="{Binding SourceText}" TextWrapping="Wrap" />
                    </StackPanel>
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Warnings}" IsVisible="{Binding HasWarnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="review-warning" Margin="0,0,0,8">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="8" IsVisible="{Binding HasCapabilityConsents}">
          <TextBlock Classes="section-title" Text="Allow Docker connection settings?" TextWrapping="Wrap" />
          <TextBlock Classes="muted"
                     Text="Approval allows the workers below to receive the allowlisted Docker CLI connection variables. It applies to these exact package manifests."
                     TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PackageCapabilityConsentItemViewModel">
                <Border Classes="review-warning" Margin="0,0,0,6">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock FontWeight="SemiBold" Text="{Binding PackageId}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding PackageVersion}" />
                    </Grid>
                    <TextBlock Classes="caption" Text="{Binding CapabilitiesText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <TextBlock Classes="section-title" Text="Sensitive access" IsVisible="{Binding HasSensitiveAccess}" />
        <ItemsControl ItemsSource="{Binding SensitiveAccess}" IsVisible="{Binding HasSensitiveAccess}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String">
            <Border Classes="review-warning" Margin="0,0,0,6"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Expander Header="Review details">
          <SelectableTextBlock Classes="code-value" Text="{Binding ReviewDetails}" />
        </Expander>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="window-footer">
      <WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="4">
        <Button Classes="secondary-action" Content="Cancel" Click="CancelButton_OnClick" />
        <Button Classes="primary-action" Content="Approve &amp; Install" Click="ApproveButton_OnClick" />
      </WrapPanel>
    </Border>
  </Grid>
</Window>
