<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Sunder.App.Views.Controls"
        xmlns:vm="using:Sunder.App.ViewModels"
        x:Class="Sunder.App.Views.PackageCapabilityConsentWindow"
        x:DataType="vm:PackageCapabilityConsentViewModel"
        mc:Ignorable="d"
        Width="680"
        Height="700"
        MinWidth="600"
        MinHeight="620"
        CanResize="False"
        WindowStartupLocation="CenterOwner"
        Title="Confirm Package Changes"
        Icon="avares://Sunder.App/Assets/Images/app.ico"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ShowInTaskbar="False"
        Classes="secondary-window">
  <Grid RowDefinitions="52,*,Auto"
        Background="{DynamicResource Sunder.Brush.Background.App}">
    <controls:WindowTitleBar Grid.Row="0">
      <controls:WindowTitleBar.LeadingContent>
        <TextBlock Classes="section-title"
                   VerticalAlignment="Center"
                    Text="Confirm Package Changes" />
      </controls:WindowTitleBar.LeadingContent>
    </controls:WindowTitleBar>

    <ScrollViewer Grid.Row="1"
                  Margin="20,12,20,8"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14">
        <Border Classes="settings-note-card">
          <StackPanel Spacing="6">
            <TextBlock FontWeight="SemiBold" Text="Review downloads and changes" />
            <TextBlock Classes="muted"
                       Text="Execution runtimes are shared by compatible packages. Exact healthy runtimes already on this device are reused instead of downloaded again."
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="8" IsVisible="{Binding HasRegistryPlans}">
          <TextBlock Classes="section-title" Text="Registry plan fence" />
          <ItemsControl ItemsSource="{Binding RegistryPlans}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RegistryPlanConfirmationItemViewModel">
                <Border Classes="card-surface" Margin="0,0,0,8">
                  <StackPanel Spacing="4">
                    <TextBlock FontWeight="SemiBold" Text="{Binding RegistryOrigin}" TextWrapping="Wrap" />
                    <TextBlock Classes="caption" Text="{Binding PrereleasePolicyText}" />
                    <TextBlock Classes="muted"
                               FontFamily="monospace"
                               FontSize="11"
                               Text="{Binding ResolutionFingerprint}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Grid ColumnDefinitions="*,*" ColumnSpacing="10">
          <Border Classes="card-surface">
            <StackPanel Spacing="4">
              <TextBlock Classes="caption" Text="Package downloads" />
              <TextBlock Classes="section-title" Text="{Binding PackageDownloadText}" />
            </StackPanel>
          </Border>
          <Border Grid.Column="1" Classes="card-surface">
            <StackPanel Spacing="4">
              <TextBlock Classes="caption" Text="Shared runtime downloads" />
              <TextBlock Classes="section-title" Text="{Binding SharedRuntimeDownloadText}" />
              <TextBlock Classes="muted" FontSize="11" Text="{Binding SharedRuntimeReuseText}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
        </Grid>

        <StackPanel Spacing="8" IsVisible="{Binding HasChanges}">
          <TextBlock Classes="section-title" Text="Package changes" />
          <ItemsControl ItemsSource="{Binding Changes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PackageChangeConfirmationItemViewModel">
                <Border Classes="card-surface" Margin="0,0,0,8">
                  <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                    <TextBlock Classes="caption" Text="{Binding ActionText}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="{Binding PackageId}" TextWrapping="Wrap" />
                    <TextBlock Grid.Column="2" Classes="caption" Text="{Binding PackageVersion}" />
                  </Grid>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel Spacing="8" IsVisible="{Binding HasExecutionRuntimes}">
          <TextBlock Classes="section-title" Text="Shared execution runtimes" />
          <ItemsControl ItemsSource="{Binding ExecutionRuntimes}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:ExecutionRuntimeDownloadItemViewModel">
                <Border Classes="card-surface" Margin="0,0,0,8">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock FontWeight="SemiBold" Text="{Binding IdentityText}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding DownloadText}" />
                    </Grid>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock Classes="caption" Text="{Binding TargetText}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding LifecycleText}" />
                    </Grid>
                    <TextBlock Classes="muted" Text="{Binding LifecycleMessage}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <ItemsControl ItemsSource="{Binding Warnings}" IsVisible="{Binding HasWarnings}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="settings-note-card" Margin="0,0,0,8">
                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <StackPanel Spacing="8" IsVisible="{Binding HasCapabilityConsents}">
          <TextBlock Classes="section-title" Text="Sensitive Worker Capability" />
          <TextBlock Classes="muted"
                     Text="These exact package manifests request access to your allowlisted Docker CLI connection environment. Package code runs with your user account; approve only packages and sources you trust."
                     TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding Items}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PackageCapabilityConsentItemViewModel">
                <Border Classes="card-surface" Margin="0,0,0,10">
                  <StackPanel Spacing="6">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="10">
                      <TextBlock FontWeight="SemiBold" Text="{Binding PackageId}" TextWrapping="Wrap" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding PackageVersion}" />
                    </Grid>
                    <TextBlock Classes="caption" Text="{Binding CapabilitiesText}" TextWrapping="Wrap" />
                    <TextBlock Classes="muted"
                               FontFamily="monospace"
                               FontSize="11"
                               Text="{Binding ManifestSha256}"
                               TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Padding="20,14"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource Sunder.Brush.Border.Subtle}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBlock Classes="caption"
                   VerticalAlignment="Center"
                    Text="{Binding ApprovalScopeText}"
                   TextWrapping="Wrap" />
        <Button Grid.Column="1"
                Classes="secondary-action"
                Content="Cancel"
                Click="CancelButton_OnClick" />
        <Button Grid.Column="2"
                Classes="primary-action"
                Content="Approve and Continue"
                Click="ApproveButton_OnClick" />
      </Grid>
    </Border>
  </Grid>
</Window>
