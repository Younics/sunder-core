<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Sunder.App.ViewModels"
        xmlns:controls="using:Sunder.App.Views.Controls"
        xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
        x:Class="Sunder.App.Views.UseStackWizardWindow"
        x:DataType="vm:UseStackWizardViewModel"
        mc:Ignorable="d"
        Width="780"
        Height="720"
        MinWidth="360"
        MinHeight="460"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Use Stack"
        Icon="avares://Sunder.App/Assets/Images/app.ico"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Classes="secondary-window management-window">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
    <StyleInclude Source="avares://Sunder.App/Styles/MarketplaceMarkdownStyles.axaml" />
  </Window.Styles>

  <Grid RowDefinitions="52,*,Auto"
        Background="{DynamicResource Sunder.Brush.Surface.Workspace}">
    <controls:WindowTitleBar Grid.Row="0">
      <controls:WindowTitleBar.LeadingContent>
        <TextBlock Classes="section-title"
                   VerticalAlignment="Center"
                   Text="Use Stack" />
      </controls:WindowTitleBar.LeadingContent>
    </controls:WindowTitleBar>

    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16" Spacing="14">
              <StackPanel Spacing="6">
                <TextBlock Classes="page-title" Text="{Binding StackTitle}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="caption"
                           Text="{Binding StackSubtitle}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="detail-intro" IsVisible="{Binding StackSummary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                           Text="{Binding StackSummary}"
                           TextWrapping="Wrap" />
                 <TextBlock Classes="caption"
                            Text="{Binding StackMetadata}"
                            TextWrapping="Wrap" />
                 <TextBlock Classes="caption" Text="{Binding PackageSource, StringFormat='Package Hub: {0}'}"
                            TextWrapping="Wrap" />
              </StackPanel>

              <controls:StackInstallPlan Items="{Binding PackageRows}"
                                         Warnings="{Binding InstallPlanWarnings}"
                                         Errors="{Binding InstallPlanErrors}"
                                         HasItems="{Binding HasPackages}"
                                         HasWarnings="{Binding HasInstallPlanWarnings}"
                                         HasErrors="{Binding HasInstallPlanErrors}"
                                         ShowNoChanges="{Binding ShowNoInstallPlanChanges}"
                                         IsVisible="{Binding ShowInstallPlan}">
                <controls:StackInstallPlan.ItemTemplate>
                    <DataTemplate x:DataType="vm:UseStackPackageReviewViewModel">
                      <Border Classes="stack-wizard-card package"
                              Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" RowSpacing="5" ColumnSpacing="10">
                          <controls:PackageIconView Width="34"
                                                    Height="34"
                                                    IconImage="{Binding IconImage}"
                                                    HasIconImage="{Binding HasIconImage}"
                                                    Glyph="{Binding Glyph}"
                                                    ShowFallbackContainer="{Binding ShowGlyphFallback}"
                                                    GlyphFontSize="14"
                                                    GlyphForeground="{DynamicResource Sunder.Brush.Accent}" />
                          <StackPanel Grid.Column="1"
                                      Spacing="2">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Classes="caption"
                                       Text="{Binding PackageId}"
                                       TextWrapping="Wrap" />
                            <TextBlock Classes="muted"
                                       Text="{Binding RequirementText}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                          <Border Grid.Row="1" Grid.Column="1" Classes="package-row-badge" HorizontalAlignment="Left">
                            <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                </controls:StackInstallPlan.ItemTemplate>
              </controls:StackInstallPlan>

              <Border Classes="review-warning" IsVisible="{Binding ShowInstallBeforeImport}">
                <TextBlock Text="Install the required packages first, then review the refreshed setup actions." TextWrapping="Wrap" />
              </Border>
              <StackPanel Spacing="8"
                          IsVisible="{Binding HasSetupPackageGroups}">
                <TextBlock Classes="section-title" Text="Setup items" />
                <ItemsControl ItemsSource="{Binding SetupPackageGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UseStackSetupPackageGroupViewModel">
                      <Border Classes="stack-wizard-card package"
                              Margin="0,0,0,10">
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="10">
                           <Grid ColumnDefinitions="Auto,*,Auto"
                                 ColumnSpacing="12">
                            <controls:PackageIconView Width="34"
                                                      Height="34"
                                                      IconImage="{Binding IconImage}"
                                                      HasIconImage="{Binding HasIconImage}"
                                                      Glyph="{Binding Glyph}"
                                                      ShowFallbackContainer="{Binding ShowGlyphFallback}"
                                                      GlyphFontSize="14"
                                                      GlyphForeground="{DynamicResource Sunder.Brush.Accent}" />
                            <StackPanel Grid.Column="1"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                              <TextBlock Text="{Binding DisplayName}"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="caption"
                                         Text="{Binding PackageId}"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Classes="stack-card-toggle"
                                    Command="{Binding ToggleExpandedCommand}"
                                    Content="{Binding ExpandActionText}" />
                          </Grid>

                          <StackPanel Grid.Row="1"
                                      Spacing="8"
                                      IsVisible="{Binding IsExpanded}">
                            <ItemsControl ItemsSource="{Binding ItemGroups}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UseStackSetupKindGroupViewModel">
                                  <StackPanel Spacing="8"
                                              Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                      <TextBlock Text="{Binding DisplayName}"
                                                 FontWeight="SemiBold"
                                                 TextWrapping="Wrap" />
                                      <Border Grid.Column="1"
                                              Classes="stack-chip">
                                        <TextBlock Text="{Binding CountText}" />
                                      </Border>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:UseStackSetupItemViewModel">
                                          <Border Classes="stack-wizard-item-card"
                                                  Classes.selected="{Binding IsSelected}"
                                                  Margin="0,0,0,8">
                                            <StackPanel Spacing="8">
                                              <Grid ColumnDefinitions="Auto,*,Auto"
                                                    ColumnSpacing="12">
                                                <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding DisplayName}"
                                                          VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1"
                                                            Spacing="4">
                                                  <TextBlock Text="{Binding DisplayName}"
                                                             FontWeight="SemiBold"
                                                             TextWrapping="Wrap" />
                                                  <TextBlock Classes="caption"
                                                             Text="{Binding Summary}"
                                                             TextWrapping="Wrap" />
                                                  <TextBlock Classes="muted"
                                                             Text="{Binding Description}"
                                                             TextWrapping="Wrap"
                                                             MaxLines="2"
                                                             IsVisible="{Binding HasDescription}" />
                                                </StackPanel>
                                                <Border Grid.Column="2"
                                                        Classes="stack-chip"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding HasDetails}">
                                                  <TextBlock Text="{Binding DetailCountText}" />
                                                </Border>
                                              </Grid>

                                              <ItemsControl ItemsSource="{Binding Details}"
                                                            IsVisible="{Binding HasDetails}">
                                                <ItemsControl.ItemTemplate>
                                                  <DataTemplate x:DataType="vm:LocalStackDetailValueViewModel">
                                                    <Border Classes="stack-export-detail-row"
                                                            Margin="0,0,0,6">
                                                      <Grid ColumnDefinitions="*,Auto"
                                                            RowDefinitions="Auto,Auto,Auto"
                                                            ColumnSpacing="10"
                                                            RowSpacing="4">
                                                        <WrapPanel ItemSpacing="8" LineSpacing="3">
                                                          <TextBlock Text="{Binding Label}"
                                                                     FontWeight="SemiBold"
                                                                     TextWrapping="Wrap" />
                                                          <Border Classes="stack-chip safety"
                                                                  IsVisible="{Binding HasBehavior}">
                                                            <TextBlock Text="{Binding Behavior}" />
                                                          </Border>
                                                        </WrapPanel>
                                                        <Button Grid.Column="1"
                                                                Classes="stack-card-toggle"
                                                                Command="{Binding ToggleExpandedCommand}"
                                                                Content="{Binding ExpandActionText}" />
                                                        <TextBlock Grid.Row="1"
                                                                   Grid.ColumnSpan="2"
                                                                   Classes="muted"
                                                                   Text="{Binding ValuePreview}"
                                                                   TextWrapping="Wrap"
                                                                   IsVisible="{Binding IsCollapsed}" />
                                                        <TextBlock Grid.Row="2"
                                                                   Grid.ColumnSpan="2"
                                                                   Classes="muted"
                                                                   Text="{Binding Value}"
                                                                   TextWrapping="Wrap"
                                                                   IsVisible="{Binding IsExpanded}" />
                                                      </Grid>
                                                    </Border>
                                                  </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                              </ItemsControl>
                                            </StackPanel>
                                          </Border>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <controls:StackImportPreview Actions="{Binding ImportActions}"
                                           RequiredInputs="{Binding RequiredInputs}"
                                           Warnings="{Binding ImportWarnings}"
                                           Errors="{Binding ImportErrors}"
                                           HasActions="{Binding HasImportActions}"
                                           HasRequiredInputs="{Binding HasRequiredInputs}"
                                           HasWarnings="{Binding HasImportWarnings}"
                                           HasErrors="{Binding HasImportErrors}"
                                           IsVisible="{Binding ShowImportPreview}">
                <controls:StackImportPreview.ActionTemplate>
                  <DataTemplate x:DataType="vm:UseStackImportActionViewModel">
                    <Border Classes="detail-row" Margin="0,0,0,6">
                      <Grid ColumnDefinitions="Auto,*" ColumnSpacing="10">
                        <CheckBox IsChecked="{Binding IsSelected}" AutomationProperties.Name="{Binding DisplayName}" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Spacing="4">
                          <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                          <TextBlock Classes="caption" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                          <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
                        </StackPanel>
                      </Grid>
                    </Border>
                  </DataTemplate>
                </controls:StackImportPreview.ActionTemplate>
                <controls:StackImportPreview.RequiredInputTemplate>
                    <DataTemplate x:DataType="vm:UseStackRequiredInputValueViewModel">
                      <Border Classes="detail-row" Margin="0,0,0,4">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="6">
                          <Grid>
                            <TextBlock Text="{Binding Label}" TextWrapping="Wrap"
                                       FontWeight="SemiBold" />
                          </Grid>
                          <TextBlock Grid.Row="1"
                                     Classes="caption"
                                     Text="{Binding Description}"
                                     TextWrapping="Wrap" />
                          <TextBox Grid.Row="2"
                                   Text="{Binding Value}" AutomationProperties.Name="{Binding Label}"
                                   PlaceholderText="{Binding Placeholder}"
                                   PasswordChar="{Binding PasswordCharacter}" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                </controls:StackImportPreview.RequiredInputTemplate>
              </controls:StackImportPreview>
              <Expander Header="Stack README" IsVisible="{Binding HasStackReadme}">
                <md:MarkdownRenderer MarkdownBuilder="{Binding StackReadmeMarkdownBuilder}" />
              </Expander>
              <controls:MarketplaceMediaStrip Items="{Binding StackProfileMedia}" IsVisible="{Binding HasStackProfileMedia}" />
            </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="2" Classes="window-footer">
      <StackPanel Spacing="6">
        <TextBlock Classes="status-text" Text="{Binding StatusText}" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding StatusText}" />
        <WrapPanel ItemSpacing="8" LineSpacing="4" HorizontalAlignment="Right">
          <Button Classes="secondary-action" Command="{Binding CancelCommand}" Content="Cancel" />
          <Button Classes="primary-action" Command="{Binding ApplyCommand}" Content="{Binding PrimaryActionText}" IsEnabled="{Binding CanApply}" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
