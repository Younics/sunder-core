<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Sunder.App.ViewModels"
        xmlns:controls="using:Sunder.App.Views.Controls"
        x:Class="Sunder.App.Views.CreateStackWizardWindow"
        x:DataType="vm:CreateStackWizardViewModel"
        mc:Ignorable="d"
        Width="780"
        Height="720"
        MinWidth="360"
        MinHeight="460"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="{Binding WindowTitle}"
        Icon="avares://Sunder.App/Assets/Images/app.ico"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Classes="secondary-window management-window">
  <Grid RowDefinitions="52,Auto,*,Auto"
        Background="{DynamicResource Sunder.Brush.Surface.Workspace}">
    <controls:WindowTitleBar Grid.Row="0">
      <controls:WindowTitleBar.LeadingContent>
        <TextBlock Classes="section-title"
                   VerticalAlignment="Center"
                   Text="{Binding WindowTitle}" />
      </controls:WindowTitleBar.LeadingContent>
    </controls:WindowTitleBar>

    <UniformGrid Grid.Row="1" Rows="1" Columns="3" Margin="16,12,16,0">
      <Border Classes="wizard-stage" Classes.active="{Binding IsPackagesStep}" ToolTip.Tip="{Binding PackagesStepStatus}">
        <TextBlock Text="1 · Packages" />
      </Border>
      <Border Classes="wizard-stage" Classes.active="{Binding IsItemsStep}" ToolTip.Tip="{Binding ItemsStepStatus}">
        <TextBlock Text="2 · Items" />
      </Border>
      <Border Classes="wizard-stage" Classes.active="{Binding IsReviewStep}" ToolTip.Tip="{Binding ReviewStepStatus}">
        <TextBlock Text="3 · Review" />
      </Border>
    </UniformGrid>
    <ScrollViewer Grid.Row="2" x:Name="StepScrollViewer" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="16" Spacing="14">
                <StackPanel Spacing="6">
                  <TextBlock Classes="page-title" Text="{Binding StepTitle}" TextWrapping="Wrap" />
                  <TextBlock Classes="caption"
                             Text="{Binding StepDescription}"
                             TextWrapping="Wrap" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsPackagesStep}"
                            Spacing="16">
                  <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto,Auto" ColumnSpacing="12" RowSpacing="5">
                    <TextBlock Classes="section-label" Text="Stack name" />
                    <TextBlock Grid.Column="1" Classes="section-label" Text="Stack ID" />
                    <TextBox Grid.Row="1" Text="{Binding StackName}" AutomationProperties.Name="Stack name" />
                    <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding StackId}" AutomationProperties.Name="Stack ID" IsReadOnly="{Binding IsStackIdReadOnly}" />
                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Classes="section-label" Text="Short description" Margin="0,5,0,0" />
                    <TextBox Grid.Row="3" Grid.ColumnSpan="2" Text="{Binding StackShortDescription}" AutomationProperties.Name="Short description"
                             AcceptsReturn="True" TextWrapping="Wrap" MinHeight="52" PlaceholderText="Shown in the Stack library" />
                  </Grid>
                  <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding HasPackageGroups}">
                    <TextBlock Classes="section-title" Text="Packages" VerticalAlignment="Center" />
                    <Button Grid.Column="1" Classes="stack-card-toggle" Command="{Binding SelectAllPackagesCommand}" Content="Select all" IsVisible="{Binding CanSelectAllPackages}" />
                    <Button Grid.Column="1" Classes="stack-card-toggle" Command="{Binding UnselectAllPackagesCommand}" Content="Unselect all" IsVisible="{Binding !CanSelectAllPackages}" />
                  </Grid>

                  <ItemsControl ItemsSource="{Binding PackageGroups}"
                                IsVisible="{Binding HasPackageGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CreateStackPackageGroupViewModel">
                        <Border Classes="stack-wizard-card"
                                Classes.selected="{Binding IsSelected}"
                                Margin="0,0,0,8">
                          <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                RowDefinitions="Auto,Auto"
                                ColumnSpacing="12"
                                RowSpacing="6">
                            <CheckBox IsChecked="{Binding IsSelected}"
                                      VerticalAlignment="Center" />
                            <controls:PackageIconView Grid.Column="1"
                                                      Width="34"
                                                      Height="34"
                                                      IconImage="{Binding IconImage}"
                                                      HasIconImage="{Binding HasIconImage}"
                                                      Glyph="{Binding Glyph}"
                                                      ShowFallbackContainer="{Binding ShowGlyphFallback}"
                                                      GlyphFontSize="14"
                                                      GlyphForeground="{DynamicResource Sunder.Brush.Accent}" />
                            <StackPanel Grid.Column="2"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                              <TextBlock Text="{Binding DisplayName}"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="caption"
                                         Text="{Binding PackageId}"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                            <Border Grid.Column="3"
                                    Classes="stack-chip"
                                    VerticalAlignment="Center">
                              <TextBlock Text="{Binding CountText}" />
                            </Border>
                            <StackPanel Grid.Row="1"
                                        Grid.Column="2"
                                        Grid.ColumnSpan="2"
                                        Spacing="4">
                              <TextBlock Classes="muted"
                                         Text="{Binding ContentSummary}"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="caption"
                                         Text="{Binding SecretSummary}"
                                         TextWrapping="Wrap"
                                         IsVisible="{Binding HasSecretSummary}" />
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <TextBlock Classes="muted"
                             Text="No active packages were found."
                             TextWrapping="Wrap"
                             IsVisible="{Binding ShowNoPackageGroups}" />
                </StackPanel>

                <StackPanel IsVisible="{Binding IsItemsStep}"
                            Spacing="12">
                  <ItemsControl ItemsSource="{Binding PackageGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CreateStackPackageGroupViewModel">
                        <Border Classes="stack-wizard-card package"
                                Classes.selected="{Binding IsSelected}"
                                IsVisible="{Binding IsVisibleInItemsStep}"
                                Margin="0,0,0,10">
                          <Grid RowDefinitions="Auto,Auto,Auto"
                                RowSpacing="12">
                            <Grid ColumnDefinitions="Auto,Auto,*,Auto"
                                  ColumnSpacing="12">
                              <CheckBox IsChecked="{Binding IsSelected}"
                                        VerticalAlignment="Center" />
                              <controls:PackageIconView Grid.Column="1"
                                                        Width="34"
                                                        Height="34"
                                                        IconImage="{Binding IconImage}"
                                                        HasIconImage="{Binding HasIconImage}"
                                                        Glyph="{Binding Glyph}"
                                                        ShowFallbackContainer="{Binding ShowGlyphFallback}"
                                                        GlyphFontSize="14"
                                                        GlyphForeground="{DynamicResource Sunder.Brush.Accent}" />
                              <StackPanel Grid.Column="2"
                                          Spacing="2"
                                          VerticalAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="caption"
                                           Text="{Binding ContentSummary}"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                              <Button Grid.Column="3"
                                      Classes="stack-card-toggle"
                                      Command="{Binding ToggleExpandedCommand}"
                                      Content="{Binding ExpandActionText}" />
                            </Grid>

                            <WrapPanel Grid.Row="1">
                              <Border Classes="stack-chip"
                                      Margin="0,0,8,8">
                                <TextBlock Text="{Binding CountText}" />
                              </Border>
                              <Button Classes="stack-card-toggle"
                                      Command="{Binding SelectAllItemsCommand}"
                                      Content="Select all items"
                                      Margin="0,0,8,8" />
                              <Button Classes="stack-card-toggle"
                                      Command="{Binding UnselectAllItemsCommand}"
                                      Content="Unselect all items"
                                      Margin="0,0,8,8" />
                            </WrapPanel>

                            <StackPanel Grid.Row="2"
                                        Spacing="8"
                                        IsVisible="{Binding IsExpanded}">
                          <ItemsControl ItemsSource="{Binding ItemGroups}">
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:CreateStackExportKindGroupViewModel">
                                <StackPanel Spacing="8"
                                            Margin="0,0,0,8">
                                  <Grid ColumnDefinitions="*,Auto"
                                        ColumnSpacing="10">
                                    <TextBlock Text="{Binding DisplayName}"
                                               FontWeight="SemiBold"
                                               TextWrapping="Wrap" />
                                    <Border Grid.Column="1"
                                            Classes="stack-chip">
                                      <TextBlock Text="{Binding CountText}" />
                                    </Border>
                                  </Grid>
                                  <ItemsControl ItemsSource="{Binding Items}">
                                    <ItemsControl.ItemTemplate>
                                      <DataTemplate x:DataType="vm:CreateStackExportItemViewModel">
                                        <Border Classes="stack-wizard-item-card"
                                                Classes.selected="{Binding IsSelected}"
                                                Margin="0,0,0,8">
                                          <Grid RowDefinitions="Auto,Auto"
                                                RowSpacing="10">
                                            <Grid ColumnDefinitions="Auto,*,Auto"
                                                  ColumnSpacing="12">
                                              <CheckBox IsChecked="{Binding IsSelected}"
                                                        VerticalAlignment="Center" />
                                              <StackPanel Grid.Column="1"
                                                          Spacing="4">
                                                <TextBlock Text="{Binding DisplayName}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Classes="caption"
                                                           Text="{Binding SummaryText}"
                                                           TextWrapping="Wrap" />
                                                <TextBlock Classes="muted"
                                                           Text="{Binding DescriptionPreview}"
                                                           TextWrapping="Wrap"
                                                           MaxLines="2" />
                                              </StackPanel>
                                              <Button Grid.Column="2"
                                                      Classes="stack-card-toggle"
                                                      Command="{Binding ToggleExpandedCommand}"
                                                      Content="{Binding ExpandActionText}" />
                                            </Grid>

                                            <Border Grid.Row="1"
                                                    Classes="stack-wizard-item-details"
                                                    IsVisible="{Binding IsExpanded}">
                                              <StackPanel Spacing="10">
                                                <StackPanel Spacing="4">
                                                  <StackPanel Spacing="2">
                                                    <TextBlock Text="Values to include"
                                                               FontWeight="SemiBold" />
                                                    <TextBlock Classes="caption"
                                                               Text="{Binding DetailCountText}" />
                                                  </StackPanel>
                                                  <WrapPanel>
                                                    <Button Classes="stack-card-toggle"
                                                            Command="{Binding SelectAllDetailsCommand}"
                                                            Content="Select all"
                                                            Margin="0,0,8,0" />
                                                    <Button Classes="stack-card-toggle"
                                                            Command="{Binding UnselectAllDetailsCommand}"
                                                            Content="Unselect all" />
                                                  </WrapPanel>
                                                </StackPanel>
                                                <ItemsControl ItemsSource="{Binding Details}"
                                                              IsVisible="{Binding HasDetails}">
                                                  <ItemsControl.ItemTemplate>
                                                    <DataTemplate x:DataType="vm:CreateStackExportDetailViewModel">
                                                      <Border Classes="stack-export-detail-row"
                                                              Margin="0,0,0,8">
                                                        <Grid RowDefinitions="Auto,Auto,Auto,Auto"
                                                              RowSpacing="6">
                                                          <Grid ColumnDefinitions="Auto,*,Auto"
                                                                ColumnSpacing="10">
                                                            <CheckBox IsChecked="{Binding IsSelected}"
                                                                      VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="1"
                                                                       Text="{Binding Label}"
                                                                       FontWeight="SemiBold"
                                                                       TextWrapping="Wrap" />
                                                            <Button Grid.Column="2"
                                                                    Classes="stack-card-toggle"
                                                                    Command="{Binding ToggleExpandedCommand}"
                                                                    Content="{Binding ExpandActionText}" />
                                                          </Grid>
                                                          <WrapPanel Grid.Row="1">
                                                            <Border Classes="stack-chip safety"
                                                                    IsVisible="{Binding HasFlagText}"
                                                                    Margin="0,0,8,0">
                                                              <TextBlock Text="{Binding FlagText}" />
                                                            </Border>
                                                            <controls:SunderComboBox ItemsSource="{Binding AvailableExportBehaviors}" AutomationProperties.Name="Export behavior"
                                                                      SelectedItem="{Binding SelectedExportBehavior}"
                                                                      MinWidth="150"
                                                                      Margin="0,0,8,0"
                                                                      IsVisible="{Binding IsExpanded}" />
                                                          </WrapPanel>
                                                          <TextBlock Grid.Row="2"
                                                                     Classes="muted"
                                                                     Text="{Binding EffectiveValuePreview}"
                                                                     TextWrapping="Wrap"
                                                                     IsVisible="{Binding IsCollapsed}" />
                                                          <TextBox Grid.Row="3"
                                                                   Text="{Binding EditedValue}"
                                                                   AcceptsReturn="True"
                                                                   MinHeight="76"
                                                                   IsVisible="{Binding IsExpanded}"
                                                                   IsEnabled="{Binding CanEditValue}" />
                                                        </Grid>
                                                      </Border>
                                                    </DataTemplate>
                                                  </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                              </StackPanel>
                                            </Border>
                                          </Grid>
                                        </Border>
                                      </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                  </ItemsControl>
                                </StackPanel>
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                            </StackPanel>
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <Border Classes="settings-note-card"
                          IsVisible="{Binding ShowNoItemsStepPackages}">
                    <TextBlock Classes="muted"
                               Text="Selected packages do not expose setup items. They will still be included in the Stack."
                               TextWrapping="Wrap" />
                  </Border>
                </StackPanel>

                <StackPanel IsVisible="{Binding IsReviewStep}"
                            Spacing="14">
                  <Border Classes="settings-note-card">
                    <StackPanel Spacing="5">
                       <TextBlock Text="{Binding StackName}"
                                 TextWrapping="Wrap"
                                 FontSize="20"
                                 FontWeight="SemiBold" />
                      <TextBlock Classes="caption"
                                 Text="{Binding StackId}" TextWrapping="Wrap" />
                      <TextBlock Classes="muted"
                                 Text="{Binding StackShortDescription}"
                                 TextWrapping="Wrap"
                                 IsVisible="{Binding HasStackShortDescription}" />
                    </StackPanel>
                  </Border>

                  <Border Classes="settings-note-card">
                    <StackPanel Spacing="5">
                      <StackPanel Spacing="4">
                        <TextBlock Text="Export Review"
                                   FontWeight="SemiBold" />
                        <TextBlock Classes="caption"
                                   Text="{Binding ReviewImpactSummary}"
                                   TextWrapping="Wrap" />
                      </StackPanel>
                      <TextBlock Classes="caption"
                                 Text="Raw secret values are never exported."
                                 TextWrapping="Wrap"
                                 VerticalAlignment="Center" />
                    </StackPanel>
                  </Border>

                  <ItemsControl ItemsSource="{Binding PackageGroups}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:CreateStackPackageGroupViewModel">
                        <Border Classes="stack-wizard-card"
                                IsVisible="{Binding IsSelected}"
                                Margin="0,0,0,8">
                          <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto"
                                  ColumnSpacing="12">
                              <controls:PackageIconView Width="30"
                                                        Height="30"
                                                        IconImage="{Binding IconImage}"
                                                        HasIconImage="{Binding HasIconImage}"
                                                        Glyph="{Binding Glyph}"
                                                        ShowFallbackContainer="{Binding ShowGlyphFallback}"
                                                        GlyphFontSize="13"
                                                        GlyphForeground="{DynamicResource Sunder.Brush.Accent}" />
                              <StackPanel Grid.Column="1"
                                          Spacing="2">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontWeight="SemiBold"
                                           TextWrapping="Wrap" />
                                <TextBlock Classes="caption"
                                           Text="{Binding PackageId}"
                                           TextWrapping="Wrap" />
                              </StackPanel>
                              <Border Grid.Column="2"
                                      Classes="stack-chip"
                                      VerticalAlignment="Center">
                                <TextBlock Text="{Binding CountText}" />
                              </Border>
                            </Grid>
                            <TextBlock Classes="muted"
                                       Text="{Binding ReviewNoSelectedItemsText}"
                                       TextWrapping="Wrap"
                                       IsVisible="{Binding ShowReviewNoSelectedItems}" />
                            <ItemsControl ItemsSource="{Binding ItemGroups}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:CreateStackExportKindGroupViewModel">
                                  <StackPanel Spacing="8"
                                              IsVisible="{Binding IsIncludedInReview}"
                                              Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                      <TextBlock Text="{Binding DisplayName}"
                                                 FontWeight="SemiBold"
                                                 TextWrapping="Wrap" />
                                      <Border Grid.Column="1"
                                              Classes="stack-chip">
                                        <TextBlock Text="{Binding ReviewCountText}" />
                                      </Border>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding ReviewItems}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:CreateStackExportItemViewModel">
                                          <Border Classes="stack-wizard-item-details"
                                                  IsVisible="{Binding IsIncludedInReview}"
                                                  Margin="0,0,0,8">
                                            <StackPanel Spacing="8">
                                              <Grid ColumnDefinitions="*,Auto"
                                                    ColumnSpacing="10">
                                                <StackPanel Spacing="2">
                                                  <TextBlock Text="{Binding DisplayName}"
                                                             FontWeight="SemiBold"
                                                             TextWrapping="Wrap" />
                                                  <TextBlock Classes="caption"
                                                             Text="{Binding SummaryText}"
                                                             TextWrapping="Wrap" />
                                                </StackPanel>
                                              </Grid>
                                              <ItemsControl ItemsSource="{Binding Details}">
                                                <ItemsControl.ItemTemplate>
                                                  <DataTemplate x:DataType="vm:CreateStackExportDetailViewModel">
                                                    <Border Classes="stack-export-detail-row"
                                                            Classes.excluded="{Binding IsExcludedByOptions}"
                                                            IsVisible="{Binding IsSelected}"
                                                            Margin="0,0,0,6">
                                                      <Grid ColumnDefinitions="*,Auto"
                                                            RowDefinitions="Auto,Auto,Auto"
                                                            ColumnSpacing="10"
                                                            RowSpacing="4">
                                                        <WrapPanel ItemSpacing="8">
                                                          <TextBlock Text="{Binding Label}"
                                                                     FontWeight="SemiBold"
                                                                     TextWrapping="Wrap" />
                                                          <TextBlock Classes="caption"
                                                                     Text="{Binding FlagText}"
                                                                     IsVisible="{Binding HasFlagText}" />
                                                        </WrapPanel>
                                                        <Button Grid.Column="1"
                                                                Classes="stack-card-toggle"
                                                                Command="{Binding ToggleExpandedCommand}"
                                                                Content="{Binding ExpandActionText}" />
                                                        <TextBlock Grid.Row="1"
                                                                   Grid.ColumnSpan="2"
                                                                   Classes="muted"
                                                                   Text="{Binding EffectiveValuePreview}"
                                                                   IsVisible="{Binding IsCollapsed}"
                                                                   TextWrapping="Wrap" />
                                                        <TextBlock Grid.Row="2"
                                                                   Grid.ColumnSpan="2"
                                                                   Classes="muted"
                                                                   Text="{Binding EffectiveValue}"
                                                                   IsVisible="{Binding IsExpanded}"
                                                                   TextWrapping="Wrap" />
                                                      </Grid>
                                                    </Border>
                                                  </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                              </ItemsControl>
                                            </StackPanel>
                                          </Border>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>

                <Border Classes="settings-note-card"
                        IsVisible="{Binding HasPreservedFragments}">
                  <StackPanel Spacing="10">
                    <StackPanel Spacing="4">
                      <TextBlock Text="Unavailable existing setup items"
                                 FontWeight="SemiBold" />
                      <TextBlock Classes="muted"
                                 Text="{Binding PreservedFragmentsSummary}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                    <ItemsControl ItemsSource="{Binding PreservedFragments}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CreateStackPreservedFragmentViewModel">
                          <Border Classes="marketplace-profile-row"
                                  Margin="0,0,0,6">
                            <StackPanel Spacing="3">
                              <TextBlock Text="{Binding DisplayName}"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="caption"
                                         Text="{Binding Subtitle}"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="muted"
                                         Text="{Binding Summary}"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Warnings}"
                              IsVisible="{Binding HasWarnings}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="review-warning"
                              Margin="0,0,0,6">
                        <TextBlock Classes="muted"
                                   Text="{Binding}"
                                   TextWrapping="Wrap" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

                <ItemsControl ItemsSource="{Binding Errors}"
                              IsVisible="{Binding HasErrors}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate>
                      <Border Classes="review-error"
                              Margin="0,0,0,6">
                        <TextBlock Classes="runtime-error-text"
                                   Text="{Binding}"
                                   TextWrapping="Wrap" />
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
    </ScrollViewer>
    <Border Grid.Row="3" Classes="window-footer">
      <StackPanel Spacing="6">
        <TextBlock Classes="caption" Text="{Binding SelectedSummary}" TextWrapping="Wrap" />
        <TextBlock Classes="status-text" Text="{Binding StatusText}" TextWrapping="Wrap" MaxLines="2" ToolTip.Tip="{Binding StatusText}" />
        <WrapPanel ItemSpacing="8" LineSpacing="4" HorizontalAlignment="Right">
          <Button Classes="secondary-action" Content="Cancel" Command="{Binding CancelCommand}" />
          <Button Classes="secondary-action" Content="Back" Command="{Binding BackCommand}" IsVisible="{Binding !IsPackagesStep}" IsEnabled="{Binding CanGoBack}" />
          <Button Classes="primary-action" Content="Next" Command="{Binding NextCommand}" IsEnabled="{Binding CanGoNext}" IsVisible="{Binding ShowNextButton}" />
          <Button Classes="primary-action" Content="{Binding PrimaryActionText}" Command="{Binding CreateCommand}" IsEnabled="{Binding CanCreate}" IsVisible="{Binding IsReviewStep}" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
