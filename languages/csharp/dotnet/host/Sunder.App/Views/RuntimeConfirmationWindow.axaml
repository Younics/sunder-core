<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Sunder.App.ViewModels" xmlns:controls="using:Sunder.App.Views.Controls"
        x:Class="Sunder.App.Views.RuntimeConfirmationWindow" x:DataType="vm:RuntimeConfirmationViewModel"
        Width="640" Height="530" MinWidth="560" MinHeight="420" WindowStartupLocation="CenterOwner"
        Title="{Binding Title}" Icon="avares://Sunder.App/Assets/Images/app.ico" ShowInTaskbar="False"
        WindowDecorations="BorderOnly" ExtendClientAreaToDecorationsHint="True" Classes="secondary-window">
  <Grid RowDefinitions="52,*,Auto" Background="{DynamicResource Sunder.Brush.Background.App}">
    <controls:WindowTitleBar>
      <controls:WindowTitleBar.LeadingContent><TextBlock Classes="section-title" Text="{Binding Title}" /></controls:WindowTitleBar.LeadingContent>
    </controls:WindowTitleBar>
    <ScrollViewer Grid.Row="1" Margin="20,12" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="16">
        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" />
        <ItemsControl ItemsSource="{Binding Items}">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="x:String">
            <Border Classes="settings-note-card" Margin="0,0,0,8"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></Border>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
        <Expander Header="Details"><TextBlock Margin="0,10,0,0" Classes="caption" Text="{Binding Details}" TextWrapping="Wrap" /></Expander>
      </StackPanel>
    </ScrollViewer>
    <WrapPanel Grid.Row="2" Margin="20,12" HorizontalAlignment="Right">
      <Button Margin="0,0,8,8" Classes="secondary-action" Content="Cancel" Click="Cancel_OnClick" />
      <Button Margin="0,0,0,8" Classes="primary-action" Content="{Binding ConfirmText}" IsEnabled="{Binding CanConfirm}" Click="Confirm_OnClick" />
    </WrapPanel>
  </Grid>
</Window>
