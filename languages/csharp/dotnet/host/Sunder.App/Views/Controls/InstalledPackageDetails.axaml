<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sunder.App.ViewModels"
             xmlns:controls="using:Sunder.App.Views.Controls"
             x:Class="Sunder.App.Views.Controls.InstalledPackageDetails"
             x:DataType="vm:PackagesWindowViewModel">
  <UserControl.Styles>
    <Style Selector="TextBlock.attention-title"><Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Accent}" /></Style>
    <Style Selector="TextBlock.attention-title.package-failed"><Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Danger}" /></Style>
  </UserControl.Styles>
  <StackPanel Spacing="16">
    <Border Classes="settings-note-card" IsVisible="{Binding SelectedInstalledPackage.NeedsAttention}">
      <StackPanel Spacing="6">
        <TextBlock Classes="attention-title" FontWeight="SemiBold"
                   Classes.package-failed="{Binding SelectedInstalledPackage.IsFailed}"
                   Text="{Binding SelectedInstalledPackage.AttentionSummary}" TextWrapping="Wrap" />
        <TextBlock Classes="muted" Text="{Binding SelectedPackageOperationHint}" TextWrapping="Wrap" />
        <Expander IsExpanded="False" IsVisible="{Binding SelectedPackageHasError}">
          <Expander.Header><TextBlock Text="Failure details" /></Expander.Header>
          <TextBlock Classes="muted" Text="{Binding SelectedPackageError}" TextWrapping="Wrap" />
        </Expander>
      </StackPanel>
    </Border>
    <StackPanel Spacing="6" IsVisible="{Binding Operations.ShowSelectedPackageOperationStatus}">
      <TextBlock Text="{Binding Operations.SelectedPackageOperationStatusText}" TextWrapping="Wrap" />
      <ProgressBar Minimum="0" Maximum="100" Value="{Binding Operations.SelectedPackageOperationProgressPercent}"
                   IsIndeterminate="{Binding Operations.SelectedPackageOperationIsIndeterminate}" />
    </StackPanel>
    <Border Classes="card-surface" IsVisible="{Binding HasSelectedPackageExecutionRuntimes}">
      <Expander IsExpanded="{Binding SelectedPackageExecutionRuntimeNeedsAttention}">
        <Expander.Header>
          <StackPanel Spacing="3">
            <TextBlock Classes="section-title" Text="Runtime compatibility" />
            <TextBlock Classes="caption" Text="{Binding SelectedPackageExecutionRuntimeSummary}" TextWrapping="Wrap" />
          </StackPanel>
        </Expander.Header>
        <ItemsControl ItemsSource="{Binding SelectedPackageExecutionRuntimes}" Margin="0,8,0,0">
          <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PackageExecutionRuntimeStatusViewModel">
            <StackPanel Spacing="5" Margin="0,8">
              <WrapPanel ItemSpacing="12" LineSpacing="6">
                <TextBlock FontWeight="SemiBold" Text="{Binding Title}" TextWrapping="Wrap" />
                <TextBlock Text="{Binding StatusText}" TextWrapping="Wrap" />
              </WrapPanel>
              <TextBlock Classes="caption" Text="{Binding TargetText}" TextWrapping="Wrap" />
              <TextBlock Classes="muted" Text="{Binding DetailText}" TextWrapping="Wrap" />
              <Button Classes="primary-action compact-action" Content="{Binding ActionText}" IsVisible="{Binding CanRepair}"
                      HorizontalAlignment="Left" Command="{Binding $parent[ItemsControl].DataContext.RepairExecutionRuntimeCommand}" CommandParameter="{Binding}" />
            </StackPanel>
          </DataTemplate></ItemsControl.ItemTemplate>
        </ItemsControl>
      </Expander>
    </Border>
    <controls:PackageInformationView DataContext="{Binding Information}" />
    <Expander IsExpanded="False" IsVisible="{Binding SelectedInstalledPackage.ShowHistoricalError}">
      <Expander.Header><TextBlock Text="Last recorded failure" /></Expander.Header>
      <TextBlock Classes="muted" Text="{Binding SelectedPackageError}" TextWrapping="Wrap" />
    </Expander>
  </StackPanel>
</UserControl>
