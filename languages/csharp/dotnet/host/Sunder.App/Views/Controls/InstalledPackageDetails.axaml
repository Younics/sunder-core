<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Sunder.App.ViewModels"
             x:Class="Sunder.App.Views.Controls.InstalledPackageDetails"
             x:DataType="vm:PackagesWindowViewModel"
             mc:Ignorable="d">
  <StackPanel Spacing="14">
    <TextBlock Classes="caption" Text="{Binding SelectedPackageStatus}" />
    <TextBlock Classes="muted" Text="{Binding SelectedPackageOperationHint}" TextWrapping="Wrap" />

    <TextBlock Classes="caption"
               Text="{Binding Operations.SelectedPackageOperationStatusText}"
               IsVisible="{Binding Operations.ShowSelectedPackageOperationStatus}"
               TextWrapping="Wrap" />
    <ProgressBar Minimum="0"
                 Maximum="100"
                 Margin="0,5,0,0"
                 Value="{Binding Operations.SelectedPackageOperationProgressPercent}"
                 IsIndeterminate="{Binding Operations.SelectedPackageOperationIsIndeterminate}"
                  IsVisible="{Binding Operations.ShowSelectedPackageOperationStatus}" />

    <Border Classes="card-surface">
      <Expander IsExpanded="False">
        <Expander.Header>
          <StackPanel Spacing="2">
            <TextBlock Classes="section-title" Text="RPC Access" />
            <TextBlock Classes="caption"
                       Text="{Binding SelectedInstalledPackage.RpcAccessSummary}" />
          </StackPanel>
        </Expander.Header>
        <StackPanel Margin="0,12,0,0" Spacing="10">
          <TextBlock Classes="muted"
                     IsVisible="{Binding SelectedInstalledPackage.HasNoRpcContractUses}"
                     Text="This package does not declare access to another package's RPC contract."
                     TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding SelectedInstalledPackage.RpcContractUses}"
                        IsVisible="{Binding SelectedInstalledPackage.HasRpcContractUses}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:PackageRpcAccessItemViewModel">
                <Border Classes="settings-note-card" Margin="0,0,0,8">
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
                      <TextBlock FontWeight="SemiBold" Text="{Binding ContractId}" />
                      <TextBlock Grid.Column="1" Classes="caption" Text="{Binding VersionRange}" />
                      <TextBlock Grid.Column="2" Classes="caption" Text="{Binding RequirementText}" />
                    </Grid>
                    <TextBlock Classes="muted" Text="{Binding ActionsText}" TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Expander>
    </Border>

    <Separator />
    <TextBlock Classes="section-title" Text="Last Error" IsVisible="{Binding SelectedPackageHasError}" />
    <TextBlock Classes="muted"
               IsVisible="{Binding SelectedPackageHasError}"
               Text="{Binding SelectedPackageError}"
               TextWrapping="Wrap" />
    <TextBlock Classes="muted"
               IsVisible="{Binding ShowNoInstalledPackageError}"
               Text="No package failure has been recorded for the selected package."
               TextWrapping="Wrap" />
  </StackPanel>
</UserControl>
