<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Sunder.App.Views.Controls"
             x:Class="Sunder.App.Views.Controls.StackInstallPlan"
             x:DataType="controls:StackInstallPlan"
             x:Name="Root">
  <StackPanel Spacing="8">
    <TextBlock Text="Packages" FontWeight="SemiBold" />
    <ItemsControl ItemsSource="{Binding Items, ElementName=Root}"
                  ItemTemplate="{Binding ItemTemplate, ElementName=Root}"
                  IsVisible="{Binding HasItems, ElementName=Root}" />
    <Border Classes="settings-note-card" IsVisible="{Binding ShowNoChanges, ElementName=Root}">
      <TextBlock Classes="muted" Text="All package requirements are already satisfied." />
    </Border>
    <ItemsControl ItemsSource="{Binding Warnings, ElementName=Root}"
                  IsVisible="{Binding HasWarnings, ElementName=Root}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="settings-note-card" Margin="0,0,0,6">
            <TextBlock Classes="muted" Text="{Binding}" TextWrapping="Wrap" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <ItemsControl ItemsSource="{Binding Errors, ElementName=Root}"
                  IsVisible="{Binding HasErrors, ElementName=Root}">
      <ItemsControl.ItemTemplate>
        <DataTemplate>
          <Border Classes="settings-note-card" Margin="0,0,0,6">
            <TextBlock Classes="runtime-error-text" Text="{Binding}" TextWrapping="Wrap" />
          </Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
  </StackPanel>
</UserControl>
