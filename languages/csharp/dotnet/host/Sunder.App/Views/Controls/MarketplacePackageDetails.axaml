<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Sunder.App.ViewModels"
             xmlns:controls="using:Sunder.App.Views.Controls"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="Sunder.App.Views.Controls.MarketplacePackageDetails"
             x:DataType="vm:PackagesWindowViewModel">
  <StackPanel Spacing="12">
    <ProgressBar IsIndeterminate="True" IsVisible="{Binding ShowMarketplacePackageDetailsLoading}" />
    <TextBlock Text="{Binding MarketplacePackageDetailsError}" IsVisible="{Binding ShowMarketplacePackageDetailsError}" TextWrapping="Wrap" />
    <TabControl IsVisible="{Binding ShowMarketplacePackageDetailsContent}" SelectedIndex="{Binding DetailTabIndex}">
      <TabControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></TabControl.ItemsPanel>
      <TabItem Header="Overview">
        <StackPanel Margin="0,12,0,0" Spacing="12">
          <TextBlock Classes="section-title" Text="On this device" />
          <TextBlock Text="{Binding Platforms.DeviceSummary}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Platforms.DeviceComponents, StringFormat='Components: {0}'}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Marketplace.RuntimeRequirements, StringFormat='Shared runtime: {0}'}"
                     IsVisible="{Binding Marketplace.RuntimeRequirements, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Information.ProvidedServices, StringFormat='Provides: {0}'}"
                     IsVisible="{Binding Information.ProvidedServices, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" TextWrapping="Wrap" />
          <controls:PackageInformationView DataContext="{Binding Information}" OverviewOnly="True" />
          <controls:MarketplaceMediaStrip Items="{Binding Marketplace.ProfileMedia}" IsVisible="{Binding HasMarketplaceProfileMedia}" />
          <md:MarkdownRenderer MarkdownBuilder="{Binding Marketplace.ReadmeMarkdownBuilder}" IsVisible="{Binding HasMarketplaceReadme}" />
          <controls:MarketplaceProfileCard Description="Project links and package metadata."
              Links="{Binding Marketplace.ProfileLinks}" Metadata="{Binding Marketplace.ProfileMetadata}" Tags="{Binding Marketplace.ProfileTags}"
              HasLinks="{Binding HasMarketplaceProfileLinks}" HasMetadata="{Binding HasMarketplaceProfileMetadata}"
              HasTags="{Binding HasMarketplaceProfileTags}" IsVisible="{Binding HasMarketplaceProfile}" />
          <Expander Header="People" IsVisible="{Binding HasMarketplaceAttributions}">
            <StackPanel Spacing="4">
              <TextBlock Classes="caption" Text="Creator" IsVisible="{Binding HasMarketplaceCreators}" />
              <ItemsControl ItemsSource="{Binding Marketplace.Creators}"><ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RegistryUserAttributionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
              </ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Classes="caption" Text="Maintainers" IsVisible="{Binding HasMarketplaceMaintainers}" />
              <ItemsControl ItemsSource="{Binding Marketplace.Maintainers}"><ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RegistryUserAttributionViewModel"><TextBlock Text="{Binding DisplayName}" /></DataTemplate>
              </ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </Expander>
        </StackPanel>
      </TabItem>
      <TabItem Header="Access &amp; integrations">
        <controls:PackageInformationView Margin="0,12,0,0" DataContext="{Binding Information}" />
      </TabItem>
      <TabItem Header="Versions">
        <ListBox Classes="package-list" Margin="0,12,0,0" MaxHeight="340" ItemsSource="{Binding Marketplace.Versions}"
                 SelectedItem="{Binding SelectedMarketplaceVersion, Mode=TwoWay}">
          <ListBox.ItemTemplate><DataTemplate x:DataType="vm:RegistryPackageVersionItemViewModel">
            <WrapPanel ItemSpacing="10" LineSpacing="4">
              <TextBlock FontWeight="SemiBold" Text="{Binding Version}" />
              <TextBlock Classes="caption" Text="{Binding StatusText}" />
              <TextBlock Classes="caption" Text="{Binding PublishedAtText}" />
            </WrapPanel>
          </DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </TabItem>
      <TabItem Header="Technical details">
        <StackPanel Margin="0,12,0,0" Spacing="12">
          <controls:PackagePlatformsView DataContext="{Binding Platforms}" />
          <TextBlock Classes="caption" Text="Canonical archive SHA-256" />
          <TextBlock Text="{Binding Marketplace.Release.ArchiveSha256}" FontFamily="monospace" TextWrapping="Wrap" />
          <TextBlock Text="{Binding Marketplace.Release.ArchiveSize, StringFormat='Canonical archive: {0:N0} bytes'}" />
        </StackPanel>
      </TabItem>
    </TabControl>
  </StackPanel>
</UserControl>
