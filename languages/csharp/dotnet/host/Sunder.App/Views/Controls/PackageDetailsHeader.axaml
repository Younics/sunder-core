<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Sunder.App.ViewModels"
             xmlns:controls="using:Sunder.App.Views.Controls"
             x:Class="Sunder.App.Views.Controls.PackageDetailsHeader"
             x:DataType="vm:PackagesWindowViewModel"
             mc:Ignorable="d">
  <Grid ColumnDefinitions="Auto,*"
        RowDefinitions="Auto,Auto"
        ColumnSpacing="12"
        RowSpacing="10">
    <controls:PackageIconView Width="64"
                              Height="64"
                              VerticalAlignment="Top"
                              IsVisible="{Binding ShowSelectedPackageIcon}"
                              IconImage="{Binding SelectedPackageIconImage}"
                              HasIconImage="{Binding SelectedPackageHasIconImage}"
                              Glyph="{Binding SelectedPackageGlyph}"
                              ShowFallbackContainer="{Binding SelectedPackageShowGlyphFallback}"
                              FallbackCornerRadius="10"
                              FallbackPadding="5"
                              GlyphFontSize="16"
                              GlyphForeground="{DynamicResource Sunder.Brush.Accent}" />

    <StackPanel Grid.Column="1"
                Spacing="5">
      <TextBlock Classes="page-title" Text="{Binding SelectedPackageTitle}" TextWrapping="Wrap" />
      <TextBlock Classes="caption" Text="{Binding SelectedPackageSubtitle}" TextWrapping="Wrap" />
      <TextBlock Classes="muted" Text="{Binding SelectedPackageSummary}" TextWrapping="Wrap" />
      <WrapPanel ItemSpacing="8" LineSpacing="6" IsVisible="{Binding ShowInstalledDetails}">
        <Border Classes="package-row-badge"><TextBlock Text="{Binding SelectedPackageStatus}" /></Border>
        <TextBlock Classes="caption" Text="{Binding SelectedInstalledPackage.UpdateText}" IsVisible="{Binding SelectedInstalledPackage.HasUpdate}" TextWrapping="Wrap" />
      </WrapPanel>
      <WrapPanel ItemSpacing="10" LineSpacing="6" IsVisible="{Binding ShowMarketplacePackageDetailsContent}">
        <TextBlock Classes="caption" Text="{Binding MarketplaceSelectedVersion, StringFormat='Selected: {0}'}" />
        <TextBlock Classes="caption" Text="{Binding MarketplaceLatestVersion, StringFormat='Latest: {0}'}" />
        <TextBlock Classes="caption" Text="{Binding SelectedMarketplacePackage.InstalledVersionText}" />
      </WrapPanel>
    </StackPanel>

    <WrapPanel Grid.Row="1" Grid.ColumnSpan="2" ItemSpacing="8" LineSpacing="6">
      <Button Classes="primary-action" Content="Install…" Command="{Binding InstallSelectedMarketplacePackageCommand}" IsVisible="{Binding ShowMarketplaceInstallButton}" />
      <Button Classes="primary-action" Content="Update…" Command="{Binding UpdateSelectedMarketplacePackageCommand}" IsVisible="{Binding ShowMarketplaceUpdateButton}" />
      <Button Classes="primary-action" Content="Update…" Command="{Binding UpdateSelectedInstalledPackageCommand}" IsVisible="{Binding ShowUpdateSelectedInstalledPackage}" />
      <Button Classes="primary-action" Content="Adopt source &amp; update" Command="{Binding AdoptSelectedInstalledPackageSourceCommand}" IsVisible="{Binding ShowAdoptSelectedInstalledPackageSource}" />
      <Button Classes="secondary-action" Content="Enable" Command="{Binding EnableSelectedPackageCommand}" IsVisible="{Binding ShowEnableSelectedPackage}" />
      <Button Classes="secondary-action" Content="Disable" Command="{Binding DisableSelectedPackageCommand}" IsVisible="{Binding ShowDisableSelectedPackage}" />
      <Button Classes="secondary-action" Content="Uninstall…" Command="{Binding UninstallSelectedPackageCommand}" IsVisible="{Binding ShowUninstallSelectedPackage}" />
      <Button Classes="secondary-action" Content="Uninstall…" Command="{Binding UninstallSelectedMarketplacePackageCommand}" IsVisible="{Binding ShowMarketplaceUninstallButton}" />
      <TextBlock Classes="caption" Text="{Binding Operations.SelectedPackageOperationStatusText}" VerticalAlignment="Center" IsVisible="{Binding Operations.ShowSelectedPackageOperationStatus}" />
      <Button Classes="secondary-action" Content="Cancel" Command="{Binding CancelSelectedPackageOperationCommand}" IsVisible="{Binding Operations.ShowCancelSelectedPackageOperation}" />
      <TextBlock Classes="caption"
                 Text="{Binding MarketplacePackageStatsText}"
                 TextAlignment="Right"
                 VerticalAlignment="Center"
                 IsVisible="{Binding ShowMarketplacePackageStats}" />
      <Button Classes="secondary-action star-action"
              Classes.starred="{Binding SelectedMarketplacePackageIsStarred}"
              Command="{Binding ToggleSelectedMarketplacePackageStarCommand}"
              IsEnabled="{Binding CanToggleSelectedMarketplacePackageStar}"
              IsVisible="{Binding ShowMarketplacePackageStarAction}"
              ToolTip.Tip="{Binding MarketplacePackageStarActionText}">
        <Path Width="16"
              Height="16"
              Classes="star-icon"
              Data="{StaticResource Sunder.Icon.Star}" />
      </Button>
    </WrapPanel>
  </Grid>
</UserControl>
