<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:controls="using:Sunder.App.Views.Controls"
             x:Class="Sunder.App.Views.Controls.PackageListRow"
             x:Name="Root"
             mc:Ignorable="d">
  <Border Classes="package-list-row"
          Classes.selected="{Binding IsSelected, ElementName=Root}">
    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" MinHeight="38">
      <controls:PackageIconView Width="30"
                                Height="30"
                                IconImage="{Binding IconImage, ElementName=Root}"
                                HasIconImage="{Binding HasIconImage, ElementName=Root}"
                                Glyph="{Binding Glyph, ElementName=Root}"
                                ShowFallbackContainer="{Binding ShowGlyphFallback, ElementName=Root}"
                                GlyphFontSize="13"
                                GlyphForeground="{DynamicResource Sunder.Brush.Accent}" />

      <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
        <TextBlock FontWeight="SemiBold" Text="{Binding Title, ElementName=Root}" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="caption" Text="{Binding Status, ElementName=Root}"
                   IsVisible="{Binding !ShowOperationStatus, ElementName=Root}" TextTrimming="CharacterEllipsis" />
        <TextBlock Classes="caption" Text="{Binding OperationStatusText, ElementName=Root}"
                   IsVisible="{Binding ShowOperationStatus, ElementName=Root}" TextTrimming="CharacterEllipsis" />
      </StackPanel>
      <Border Grid.Column="2" Classes="package-row-badge update" VerticalAlignment="Center"
              IsVisible="{Binding ShowActionBadge, ElementName=Root}">
        <TextBlock Text="{Binding ActionBadge, ElementName=Root}" />
      </Border>
    </Grid>
  </Border>
</UserControl>
