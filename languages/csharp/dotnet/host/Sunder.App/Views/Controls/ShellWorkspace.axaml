<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Sunder.App.ViewModels"
              xmlns:controls="using:Sunder.App.Views.Controls"
              x:Class="Sunder.App.Views.Controls.ShellWorkspace"
              x:DataType="vm:MainWindowViewModel"
              mc:Ignorable="d">
  <Grid Margin="0,4,0,4"
        Background="{DynamicResource Sunder.Brush.Transparent}"
        ColumnDefinitions="58,0,*,0,58">
    <Border Grid.Column="0"
            Classes="side-rail-surface"
            Margin="8,0,4,0">
      <Grid RowDefinitions="*,8,*">
        <controls:PackageIconBar Grid.Row="0"
                                 Classes="side-top-lane"
                                 DataContext="{Binding LeftTopBar}" />
        <controls:PackageIconBar Grid.Row="2"
                                 Classes="side-bottom-lane"
                                 DataContext="{Binding LeftBottomBar}" />
      </Grid>
    </Border>

    <Grid Grid.Column="2"
          x:Name="ShellContentGrid"
          RowDefinitions="560,4,236">
      <Grid Grid.Row="0"
            x:Name="TopContentGrid"
            ColumnDefinitions="280,4,*,4,280">
        <Border Grid.Column="0"
                x:Name="LeftTopPanelBorder"
                Classes="side-shell-panel">
          <controls:ShellPanelHost DataContext="{Binding LeftTopPanel}" />
        </Border>

        <GridSplitter x:Name="LeftColumnGridSplitter"
                      Grid.Column="1"
                      Width="4"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False"
                      Background="{DynamicResource Sunder.Brush.Transparent}" />

        <Border Grid.Column="2"
                x:Name="MiddlePanelBorder"
                Classes="workspace-shell-panel">
          <Border Classes="shell-panel-content-clip">
            <Grid>
              <controls:ShellWelcomePanel IsVisible="{Binding MiddlePanel.ShowFallbackLines}" />
              <ItemsControl HorizontalAlignment="Stretch"
                            VerticalAlignment="Stretch"
                             IsVisible="{Binding MiddlePanel.HasLayoutHostedView}"
                            ItemsSource="{Binding MiddlePanel.HostedViews}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Grid />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:ShellHostedViewViewModel">
                    <ContentControl HorizontalAlignment="Stretch"
                                     VerticalAlignment="Stretch"
                                     HorizontalContentAlignment="Stretch"
                                     VerticalContentAlignment="Stretch"
                                      IsVisible="{Binding IsLayoutVisible}"
                                      Opacity="{Binding PresentationOpacity}"
                                      IsHitTestVisible="{Binding IsPresentationHitTestVisible}"
                                      Focusable="False"
                                     Content="{Binding View}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Grid>
          </Border>
        </Border>

        <GridSplitter x:Name="RightColumnGridSplitter"
                      Grid.Column="3"
                      Width="4"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False"
                      Background="{DynamicResource Sunder.Brush.Transparent}" />

        <Border Grid.Column="4"
                x:Name="RightTopPanelBorder"
                Classes="side-shell-panel">
          <controls:ShellPanelHost DataContext="{Binding RightTopPanel}" />
        </Border>
      </Grid>

      <GridSplitter x:Name="BottomRowGridSplitter"
                    Grid.Row="1"
                    Height="4"
                    ResizeDirection="Rows"
                    ResizeBehavior="PreviousAndNext"
                    ShowsPreview="False"
                    Background="{DynamicResource Sunder.Brush.Transparent}" />

      <Grid Grid.Row="2"
            x:Name="BottomContentGrid"
            ColumnDefinitions="*,4,*">
        <Border Grid.Column="0"
                x:Name="LeftBottomPanelBorder"
                Classes="bottom-shell-panel">
          <controls:ShellPanelHost DataContext="{Binding LeftBottomPanel}" />
        </Border>

        <GridSplitter x:Name="BottomColumnGridSplitter"
                      Grid.Column="1"
                      Width="4"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False"
                      Background="{DynamicResource Sunder.Brush.Transparent}" />

        <Border Grid.Column="2"
                x:Name="RightBottomPanelBorder"
                Classes="bottom-shell-panel">
          <controls:ShellPanelHost DataContext="{Binding RightBottomPanel}" />
        </Border>
      </Grid>
    </Grid>

    <Border Grid.Column="4"
            Classes="side-rail-surface"
            Margin="4,0,8,0">
      <Grid RowDefinitions="*,8,*">
        <controls:PackageIconBar Grid.Row="0"
                                 Classes="side-top-lane"
                                 DataContext="{Binding RightTopBar}" />
        <controls:PackageIconBar Grid.Row="2"
                                 Classes="side-bottom-lane"
                                 DataContext="{Binding RightBottomBar}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
