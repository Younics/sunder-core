<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:Sunder.App.Views.Controls"
             xmlns:vm="using:Sunder.App.ViewModels"
             x:Class="Sunder.App.Views.Controls.MarketplaceProfileCard"
             x:DataType="controls:MarketplaceProfileCard"
             x:Name="Root">
  <StackPanel Spacing="4">
    <ItemsControl ItemsSource="{Binding Tags, ElementName=Root}" IsVisible="{Binding HasTags, ElementName=Root}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      <ItemsControl.ItemTemplate>
        <DataTemplate x:DataType="x:String">
          <Border Classes="marketplace-tag-chip"><TextBlock Text="{Binding}" TextWrapping="Wrap" /></Border>
        </DataTemplate>
      </ItemsControl.ItemTemplate>
    </ItemsControl>
    <WrapPanel ItemSpacing="14" LineSpacing="4">
      <ItemsControl ItemsSource="{Binding Links, ElementName=Root}" IsVisible="{Binding HasLinks, ElementName=Root}">
        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel ItemSpacing="14" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RegistryPackageProfileLinkViewModel">
            <HyperlinkButton Classes="marketplace-profile-link" NavigateUri="{Binding NavigateUri}"
                             AutomationProperties.Name="{Binding Label}" ToolTip.Tip="{Binding DisplayUrl}">
              <StackPanel Orientation="Horizontal" Spacing="4">
                <TextBlock Text="{Binding Label}" />
                <Path Classes="icon-stroke" Width="10" Height="10" VerticalAlignment="Center"
                      Stroke="{Binding $parent[HyperlinkButton].Foreground}" Data="{StaticResource Sunder.Icon.ExternalLink}" />
              </StackPanel>
            </HyperlinkButton>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <ItemsControl ItemsSource="{Binding Metadata, ElementName=Root}" IsVisible="{Binding HasMetadata, ElementName=Root}">
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:RegistryPackageProfileMetadataItemViewModel">
            <TextBlock Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap">
              <Run Text="{Binding Label}" /> · <Run Text="{Binding Value}" />
            </TextBlock>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </WrapPanel>
  </StackPanel>
</UserControl>
