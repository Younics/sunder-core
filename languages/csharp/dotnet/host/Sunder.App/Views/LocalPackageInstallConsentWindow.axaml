<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Sunder.App.Views.Controls"
        xmlns:vm="using:Sunder.App.ViewModels"
        x:Class="Sunder.App.Views.LocalPackageInstallConsentWindow"
        x:DataType="vm:LocalPackageInstallConsentViewModel"
        mc:Ignorable="d"
         Width="720"
         Height="760"
         MinWidth="360"
         MinHeight="480"
         CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Install Sunder Package"
        Icon="avares://Sunder.App/Assets/Images/app.ico"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ShowInTaskbar="False"
        Classes="secondary-window management-window">
  <Grid RowDefinitions="52,*,Auto"
        Background="{DynamicResource Sunder.Brush.Surface.Workspace}">
    <controls:WindowTitleBar Grid.Row="0">
      <controls:WindowTitleBar.LeadingContent>
        <TextBlock Classes="section-title"
                   VerticalAlignment="Center"
                   Text="Review Local Package" />
      </controls:WindowTitleBar.LeadingContent>
    </controls:WindowTitleBar>

    <ScrollViewer Grid.Row="1"
                  Margin="20,12,20,8"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14">
        <StackPanel Spacing="4">
          <TextBlock Classes="page-title" Text="{Binding PackageName}" TextWrapping="Wrap" />
          <TextBlock Classes="code-value" Text="{Binding PackageIdentity}" IsVisible="{Binding IsValid}" />
          <TextBlock Classes="detail-intro" Text="{Binding Summary}" IsVisible="{Binding Summary, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        </StackPanel>
        <Border Classes="detail-row">
          <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto,Auto" RowSpacing="5" ColumnSpacing="12">
            <TextBlock Classes="section-label" Text="Archive" />
            <SelectableTextBlock Grid.Column="1" Classes="code-value" Text="{Binding FileName}" />
            <TextBlock Grid.Row="1" Classes="section-label" Text="Source" />
            <TextBlock Grid.Row="1" Grid.Column="1" Text="Local file" />
            <TextBlock Grid.Row="2" Classes="section-label" Text="Components" IsVisible="{Binding IsValid}" />
            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding TargetText}" IsVisible="{Binding IsValid}" TextWrapping="Wrap" />
          </Grid>
        </Border>
        <Border Classes="review-warning" IsVisible="{Binding IsValid}">
          <StackPanel Spacing="5">
            <TextBlock Classes="section-title" Text="Package trust" />
            <TextBlock Text="Package code runs with your user account’s access. Only install code from a source you trust." TextWrapping="Wrap" />
            <TextBlock Text="Approval allows the worker to receive your allowlisted Docker CLI connection variables."
                       IsVisible="{Binding HasDockerEnvironmentAccess}" TextWrapping="Wrap" />
            <TextBlock Classes="caption" Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <Border Classes="review-error" IsVisible="{Binding IsInvalid}">
          <StackPanel Spacing="5">
            <TextBlock Classes="section-title" Text="Validation failed" />
            <SelectableTextBlock Text="{Binding ValidationMessage}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <StackPanel Spacing="8" IsVisible="{Binding HasRuntimeDownloads}">
          <TextBlock Classes="section-title" Text="Package runtimes" />
          <ItemsControl ItemsSource="{Binding RuntimeDownloads}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ExecutionRuntimeDownloadItemViewModel">
              <Border Classes="card-surface" Margin="0,0,0,8"><StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="{Binding IdentityText}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding DownloadText}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding SourceText}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding TargetText}" TextWrapping="Wrap" />
                <TextBlock Classes="caption" Text="{Binding DetailText}" TextWrapping="Wrap" />
              </StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <StackPanel IsVisible="{Binding IsValid}" Spacing="10">
          <controls:PackageInformationView DataContext="{Binding Information}" OverviewOnly="True" />
          <Expander Header="Declared features and package identity">
            <StackPanel Spacing="8"><SelectableTextBlock Classes="code-value" Text="{Binding ArchiveDetails}" />
              <controls:PackageInformationView DataContext="{Binding Information}" />
            </StackPanel>
          </Expander>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="window-footer">
      <StackPanel Spacing="7">
        <TextBlock Classes="caption" Text="Installing grants this version’s declared service access, including internal package communication."
                   IsVisible="{Binding IsValid}" TextWrapping="Wrap" />
        <WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="4">
          <Button Classes="secondary-action" Content="{Binding DismissButtonText}" Click="CancelButton_OnClick" />
          <Button Classes="primary-action" Content="Approve &amp; Install" IsVisible="{Binding IsValid}" Click="InstallButton_OnClick" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
