<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Sunder.App.Views.Controls"
        xmlns:vm="using:Sunder.App.ViewModels"
        x:Class="Sunder.App.Views.LocalPackageInstallConsentWindow"
        x:DataType="vm:LocalPackageInstallConsentViewModel"
        mc:Ignorable="d"
         Width="720"
         Height="760"
         MinWidth="440"
         MinHeight="480"
         CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Install Sunder Package"
        Icon="avares://Sunder.App/Assets/Images/app.ico"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ShowInTaskbar="False"
        Classes="secondary-window">
  <Grid RowDefinitions="52,*,Auto"
        Background="{DynamicResource Sunder.Brush.Background.App}">
    <controls:WindowTitleBar Grid.Row="0">
      <controls:WindowTitleBar.LeadingContent>
        <TextBlock Classes="section-title"
                   VerticalAlignment="Center"
                   Text="Review Local Package" />
      </controls:WindowTitleBar.LeadingContent>
    </controls:WindowTitleBar>

    <ScrollViewer Grid.Row="1"
                  Margin="20,12,20,8"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14">
        <Border Classes="card-surface">
          <StackPanel Spacing="8">
            <TextBlock FontSize="26"
                       FontWeight="SemiBold"
                       Text="{Binding PackageName}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="caption"
                       Text="{Binding PackageIdentity}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="muted"
                       Text="{Binding Summary}"
                       TextWrapping="Wrap" />
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <TextBlock Classes="caption" Text="Targets" />
              <TextBlock Grid.Column="1" Text="{Binding TargetText}" TextWrapping="Wrap" />
            </Grid>
            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
              <TextBlock Classes="caption" Text="Archive" />
              <TextBlock Grid.Column="1" Text="{Binding FileName}" TextWrapping="Wrap" />
            </Grid>
          </StackPanel>
        </Border>

        <StackPanel Spacing="8" IsVisible="{Binding HasRuntimeDownloads}">
          <TextBlock Classes="section-title" Text="Package runtimes" />
          <TextBlock Classes="caption" Text="Approved runtimes install first. This package waits in the queue and installs next." TextWrapping="Wrap" />
          <ItemsControl ItemsSource="{Binding RuntimeDownloads}">
            <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:ExecutionRuntimeDownloadItemViewModel">
              <Border Classes="card-surface" Margin="0,0,0,8"><StackPanel Spacing="4">
                <TextBlock FontWeight="SemiBold" Text="{Binding IdentityText}" />
                <TextBlock Classes="caption" Text="{Binding DownloadText}" />
                <TextBlock Classes="caption" Text="{Binding SourceText}" />
                <TextBlock Classes="caption" Text="{Binding TargetText}" />
              </StackPanel></Border>
            </DataTemplate></ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>

        <Border Classes="settings-note-card">
          <StackPanel Spacing="5">
            <TextBlock FontWeight="SemiBold"
                       Text="Package trust"
                       IsVisible="{Binding IsValid}" />
            <TextBlock Classes="muted"
                       Text="Installing runs package code with your user account's operating-system access. Install only packages and sources you trust."
                       IsVisible="{Binding IsValid}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="muted"
                       Text="This package requests your allowlisted Docker CLI connection environment. Installing consents to passing it to the Runtime worker."
                       IsVisible="{Binding HasDockerEnvironmentAccess}"
                       TextWrapping="Wrap" />
            <TextBlock Classes="caption"
                       Text="Manifest fence"
                       IsVisible="{Binding HasDockerEnvironmentAccess}" />
            <TextBlock Classes="caption"
                       FontFamily="monospace"
                       Text="{Binding SensitiveCapabilityManifestSha256}"
                       IsVisible="{Binding HasDockerEnvironmentAccess}"
                       TextWrapping="Wrap" />
            <TextBlock FontWeight="SemiBold"
                       Foreground="{DynamicResource Sunder.Brush.Danger}"
                       Text="Validation failed"
                       IsVisible="{Binding IsInvalid}" />
            <TextBlock Classes="muted"
                       Text="{Binding ValidationMessage}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Border>

        <Border IsVisible="{Binding IsValid}"><controls:PackageInformationView DataContext="{Binding Information}" /></Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2"
            Padding="20,14"
            BorderThickness="0,1,0,0"
            BorderBrush="{DynamicResource Sunder.Brush.Border.Subtle}">
      <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
        <TextBlock Classes="caption"
                   VerticalAlignment="Center"
                    Text="Installing grants this version’s declared service access, including internal package communication."
                   IsVisible="{Binding IsValid}"
                   TextWrapping="Wrap" />
        <Button Grid.Column="1"
                Classes="secondary-action"
                Content="{Binding DismissButtonText}"
                Click="CancelButton_OnClick" />
        <Button Grid.Column="2"
                Classes="primary-action"
                Content="Approve &amp; Install"
                IsVisible="{Binding IsValid}"
                Click="InstallButton_OnClick" />
      </Grid>
    </Border>
  </Grid>
</Window>
