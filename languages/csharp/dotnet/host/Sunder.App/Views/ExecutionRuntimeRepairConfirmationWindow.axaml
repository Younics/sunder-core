<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:controls="using:Sunder.App.Views.Controls"
        xmlns:vm="using:Sunder.App.ViewModels"
        x:Class="Sunder.App.Views.ExecutionRuntimeRepairConfirmationWindow"
        x:DataType="vm:ExecutionRuntimeRepairConfirmationViewModel"
        mc:Ignorable="d"
        Width="560"
        Height="460"
        MinWidth="360"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Title="Confirm Shared Runtime Repair"
        Icon="avares://Sunder.App/Assets/Images/app.ico"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        ShowInTaskbar="False"
        Classes="secondary-window management-window">
  <Grid RowDefinitions="52,*,Auto"
        Background="{DynamicResource Sunder.Brush.Surface.Workspace}">
    <controls:WindowTitleBar Grid.Row="0">
      <controls:WindowTitleBar.LeadingContent>
        <TextBlock Classes="section-title"
                   VerticalAlignment="Center"
                   Text="Shared runtime repair" />
      </controls:WindowTitleBar.LeadingContent>
    </controls:WindowTitleBar>

    <ScrollViewer Grid.Row="1"
                  Margin="20,16,20,10"
                  HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="14">
        <StackPanel Spacing="5">
          <TextBlock Classes="page-title" Text="{Binding Title}" TextWrapping="Wrap" />
          <TextBlock Classes="detail-intro" Text="Restore the exact runtime bound to these packages." />
          <Border Classes="package-row-badge" HorizontalAlignment="Left"><TextBlock Text="{Binding Status}" /></Border>
        </StackPanel>
        <Border Classes="detail-row">
          <StackPanel Spacing="3">
            <TextBlock Classes="code-value" Text="{Binding RuntimeId}" />
            <TextBlock Classes="caption" Text="{Binding Target}" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
        <TextBlock Classes="section-title" Text="Packages that will reload" />
        <ItemsControl ItemsSource="{Binding ImpactedPackageIds}">
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Classes="detail-row" Margin="0,0,0,4">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                  <TextBlock FontWeight="SemiBold" Text="{Binding}" TextWrapping="Wrap" />
                  <Border Grid.Column="1" Classes="package-row-badge"><TextBlock Text="Reload" /></Border>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
        <Border Classes="review-warning">
          <StackPanel Spacing="4">
            <TextBlock Classes="section-label" Text="Reload together" />
            <TextBlock Text="Affected workers reload together after repair. Package and runtime versions stay the same." TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.Row="2" Classes="window-footer">
      <WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="4">
        <Button Classes="secondary-action" Content="Cancel" Click="CancelButton_OnClick" />
        <Button Classes="primary-action" Content="Repair and Reload" Click="ApproveButton_OnClick" />
      </WrapPanel>
    </Border>
  </Grid>
</Window>
