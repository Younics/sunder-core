<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Sunder.App.ViewModels"
        xmlns:controls="using:Sunder.App.Views.Controls"
        xmlns:themes="using:Sunder.App.Themes"
        x:Class="Sunder.App.Views.SettingsWindow"
        x:DataType="vm:SettingsWindowViewModel"
        mc:Ignorable="d"
        Width="980"
        Height="800"
        MinWidth="360"
        MinHeight="480"
        CanResize="True"
        Title="Settings"
        Icon="avares://Sunder.App/Assets/Images/app.ico"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Classes="secondary-window management-window">
  <Window.DataTemplates>
    <DataTemplate DataType="vm:TextSettingsFieldViewModel" x:DataType="vm:TextSettingsFieldViewModel">
      <StackPanel Spacing="8"
                  IsVisible="{Binding IsVisible}">
        <controls:SettingsFieldHeader Title="{Binding Label}" HelpText="{Binding Description}" />
        <TextBox Text="{Binding Value}"
                 PlaceholderText="{Binding Placeholder}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:SecretSettingsFieldViewModel" x:DataType="vm:SecretSettingsFieldViewModel">
      <StackPanel Spacing="8"
                  IsVisible="{Binding IsVisible}">
        <controls:SettingsFieldHeader Title="{Binding Label}" HelpText="{Binding Description}" />
        <TextBox Text="{Binding Value}"
                 PasswordChar="*"
                 PlaceholderText="{Binding Placeholder}" />
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:BooleanSettingsFieldViewModel" x:DataType="vm:BooleanSettingsFieldViewModel">
      <StackPanel Spacing="8"
                  IsVisible="{Binding IsVisible}">
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="{DynamicResource Sunder.Spacing.XSmall}" HorizontalAlignment="Left">
          <CheckBox IsChecked="{Binding Value}"><TextBlock Text="{Binding Label}" TextWrapping="Wrap" /></CheckBox>
          <controls:SettingsHelpButton Grid.Column="1" HelpText="{Binding Description}" />
        </Grid>
      </StackPanel>
    </DataTemplate>
    <DataTemplate DataType="vm:SelectSettingsFieldViewModel" x:DataType="vm:SelectSettingsFieldViewModel">
      <StackPanel Spacing="8"
                  IsVisible="{Binding IsVisible}">
        <controls:SettingsFieldHeader Title="{Binding Label}" HelpText="{Binding Description}" />
        <controls:SunderComboBox ItemsSource="{Binding Options}"
                                 SelectedItem="{Binding SelectedOption}">
          <controls:SunderComboBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SettingsOptionItem">
              <TextBlock Text="{Binding Label}" />
            </DataTemplate>
          </controls:SunderComboBox.ItemTemplate>
        </controls:SunderComboBox>
      </StackPanel>
    </DataTemplate>
  </Window.DataTemplates>

  <Window.Styles>
    <Style Selector="Button.settings-info">
      <Setter Property="Width" Value="28" /><Setter Property="Height" Value="28" />
      <Setter Property="MinWidth" Value="28" /><Setter Property="MinHeight" Value="28" />
      <Setter Property="Padding" Value="0" /><Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Full}" />
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Transparent}" />
      <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
    </Style>
    <Style Selector="Button.settings-info:pointerover"><Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" /></Style>
    <Style Selector="FlyoutPresenter.settings-help-popover">
      <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
      <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Padding" Value="{DynamicResource Sunder.Padding.Card}" />
      <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
    </Style>
    <Style Selector="FlyoutPresenter.settings-help-popover /template/ Border">
      <Setter Property="BoxShadow" Value="{DynamicResource Sunder.Shadow.Toast}" />
    </Style>
  </Window.Styles>

  <Grid RowDefinitions="52,*,Auto"
        Background="{DynamicResource Sunder.Brush.Background.App}">
    <controls:WindowTitleBar Grid.Row="0">
      <controls:WindowTitleBar.LeadingContent>
        <TextBlock Classes="section-title"
                   VerticalAlignment="Center"
                   Text="Settings" />
      </controls:WindowTitleBar.LeadingContent>
    </controls:WindowTitleBar>

    <Grid Grid.Row="1" x:Name="SettingsContentGrid">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="250" MinWidth="180" MaxWidth="900" />
          <ColumnDefinition Width="4" />
          <ColumnDefinition Width="*" MinWidth="360" />
        </Grid.ColumnDefinitions>
        <Border Grid.Column="0"
                x:Name="SettingsSidebarPane"
                Background="{DynamicResource Sunder.Brush.Surface.Base}"
                Padding="0">
          <ScrollViewer x:Name="SettingsSidebarScrollViewer"
                        AllowAutoHide="False"
                        VerticalScrollBarVisibility="Visible"
                        HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="10" Margin="16,16,8,16">
              <TextBlock Classes="section-label" Text="Categories" />
              <ItemsControl ItemsSource="{Binding CoreSections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingsSectionItemViewModel">
                    <Button Classes="settings-nav-button"
                            Classes.selected="{Binding IsSelected}"
                            Click="SectionButton_OnClick"
                            CommandParameter="{Binding}"
                            HorizontalAlignment="Stretch"
                            Content="{Binding Title}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <StackPanel IsVisible="{Binding PackageSettings.HasPackageSections}">
                <Border Height="1"
                        Margin="0,8,0,8"
                        Background="{DynamicResource Sunder.Brush.Border.Subtle}" />
                <TextBlock Classes="section-label" Text="Packages" />
              </StackPanel>

              <ItemsControl ItemsSource="{Binding PackageSettings.NavigationGroups}"
                             IsVisible="{Binding PackageSettings.HasPackageSections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:SettingsPackageNavigationGroup">
                    <StackPanel>
                      <Border Classes="settings-package-row" Classes.selected="{Binding Root.IsSelected}">
                        <Grid ColumnDefinitions="*,Auto">
                          <Button Classes="settings-nav-button group-root"
                                  CommandParameter="{Binding Root}"
                                  Click="SectionButton_OnClick" HorizontalAlignment="Stretch"
                                  ToolTip.Tip="{Binding Root.Title}">
                            <TextBlock Text="{Binding Root.Title}" TextTrimming="CharacterEllipsis" />
                          </Button>
                          <ToggleButton Grid.Column="1" Classes="settings-group-toggle"
                                        IsVisible="{Binding HasChildren}"
                                        IsChecked="{Binding IsExpanded}"
                                        ToolTip.Tip="{Binding ToggleDescription}"
                                        AutomationProperties.Name="{Binding ToggleDescription}">
                            <Path Width="5" Height="9" Data="M 1 1 L 5 5 L 1 9"
                                  Stroke="{Binding $parent[ToggleButton].Foreground}" StrokeThickness="1.5"
                                  StrokeLineCap="Round" StrokeJoin="Round" Stretch="Uniform"
                                  RenderTransformOrigin="50%,50%">
                              <Path.RenderTransform>
                                <RotateTransform Angle="{Binding ChevronAngle}" />
                              </Path.RenderTransform>
                            </Path>
                          </ToggleButton>
                        </Grid>
                      </Border>
                      <Border Classes="settings-package-children" IsVisible="{Binding IsExpanded}">
                        <ItemsControl ItemsSource="{Binding Children}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="vm:SettingsSectionItemViewModel">
                              <Button Classes="settings-nav-button" Classes.selected="{Binding IsSelected}"
                                      Click="SectionButton_OnClick" HorizontalAlignment="Stretch" ToolTip.Tip="{Binding Title}">
                                <TextBlock Text="{Binding NavigationTitle}" TextTrimming="CharacterEllipsis" />
                              </Button>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </Border>
                    </StackPanel>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
        </Border>

        <GridSplitter Grid.Column="1" x:Name="SettingsSplitter"
                      Width="4"
                      ResizeDirection="Columns"
                      ResizeBehavior="PreviousAndNext"
                      ShowsPreview="False"
                      Background="{DynamicResource Sunder.Brush.Border.Subtle}"
                      DragCompleted="SettingsSplitter_OnDragCompleted" />

        <Grid Grid.Column="2" x:Name="SettingsDetailPane" RowDefinitions="Auto,*">
          <Button x:Name="CompactSettingsBackButton" Classes="secondary-action compact-action" Margin="12,6"
                  HorizontalAlignment="Left" Content="‹ Categories" IsVisible="False" />
        <Border Grid.Row="1" x:Name="SettingsSelectionPane"
                Classes.detail-surface="{Binding IsCoreSelection}"
                AutomationProperties.Name="{Binding SelectedTitle}">
          <Grid RowDefinitions="Auto,*">
            <StackPanel x:Name="SettingsSelectionHeader" Spacing="6" Margin="20,20,20,0"
                        IsVisible="{Binding IsCoreSelection}">
              <TextBlock Classes="page-title" Text="{Binding SelectedTitle}" />
              <TextBlock Classes="caption" Text="{Binding SelectedDescription}" TextWrapping="Wrap" />
            </StackPanel>

            <ScrollViewer x:Name="SettingsSelectionScroll" Grid.Row="1" HorizontalScrollBarVisibility="Disabled"
                          IsVisible="{Binding ShowScrollableSelectionContent}">
              <StackPanel Spacing="{DynamicResource Sunder.Spacing.Large}" Margin="{DynamicResource Sunder.Padding.Panel}">
                <Border IsVisible="{Binding IsPackageRuntimesSelection}">
                  <controls:PackageRuntimesSettings DataContext="{Binding PackageRuntimes}" />
                </Border>
                <Border Classes="card-surface" IsVisible="{Binding ShowAppearanceSettings}">
                  <StackPanel Spacing="14">
                    <TextBlock Classes="section-title" Text="Theme" />
                    <ListBox x:Name="ThemeSelector" Classes="theme-choices" ItemsSource="{Binding Appearance.Themes}"
                             SelectedItem="{Binding Appearance.SelectedTheme, Mode=TwoWay}" AutomationProperties.Name="Theme"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                      <ListBox.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ListBox.ItemsPanel>
                      <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="themes:SunderThemeDefinition">
                          <StackPanel Spacing="6" Width="164">
                            <Border Padding="10" CornerRadius="6">
                              <Border.Background><SolidColorBrush Color="{Binding SurfaceBase}" /></Border.Background>
                              <StackPanel Orientation="Horizontal" Spacing="4">
                                <Border Width="32" Height="12" CornerRadius="3"><Border.Background><SolidColorBrush Color="{Binding Accent}" /></Border.Background></Border>
                                <Border Width="24" Height="12" CornerRadius="3"><Border.Background><SolidColorBrush Color="{Binding ForegroundMuted}" /></Border.Background></Border>
                                <Border Width="24" Height="12" CornerRadius="3"><Border.Background><SolidColorBrush Color="{Binding BorderStrong}" /></Border.Background></Border>
                              </StackPanel>
                            </Border>
                            <TextBlock FontWeight="SemiBold" Text="{Binding DisplayName}" />
                          </StackPanel>
                        </DataTemplate>
                      </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Classes="caption" Text="Preview in all open windows. Apply or Save to keep this theme." TextWrapping="Wrap" />
                  </StackPanel>
                </Border>
                <Border Classes="card-surface" IsVisible="{Binding ShowNotificationSettings}">
                  <StackPanel Spacing="14">
                    <CheckBox Content="Show notification pop-ups" IsChecked="{Binding Notifications.ShowToasts}" />
                    <StackPanel Spacing="10" IsEnabled="{Binding Notifications.ShowToasts}">
                      <CheckBox Content="Informational messages" IsChecked="{Binding Notifications.ShowInformation}" />
                      <CheckBox Content="Successful operations and task completion" IsChecked="{Binding Notifications.ShowSuccess}" />
                      <CheckBox Content="Warnings" IsChecked="{Binding Notifications.ShowWarnings}" />
                    </StackPanel>
                    <Border Classes="settings-note-card">
                       <TextBlock Classes="muted" Text="Errors always appear. All notifications remain in the Sunder tray." TextWrapping="Wrap" />
                    </Border>
                  </StackPanel>
                </Border>
                <Border Classes="card-surface"
                        IsVisible="{Binding ShowPlainCoreSelection}">
                  <ItemsControl ItemsSource="{Binding SelectedCoreLines}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="x:String">
                        <TextBlock Classes="muted"
                                   Margin="0,0,0,8"
                                   Text="{Binding}"
                                   TextWrapping="Wrap" />
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </Border>

                <StackPanel Spacing="16"
                            IsVisible="{Binding ShowCliSettings}">
                  <Border Classes="card-surface">
                    <StackPanel Spacing="14">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="section-title" Text="Command Status" />
                        <TextBlock Classes="page-title" Text="{Binding Cli.StatusText}" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{Binding Cli.StatusDescription}" TextWrapping="Wrap" />
                      </StackPanel>

                      <Border IsVisible="{Binding Cli.HasWarning}"
                              Padding="12"
                              CornerRadius="10"
                              Background="{DynamicResource Sunder.Brush.Surface.Raised}">
                        <TextBlock Classes="muted"
                                   Text="{Binding Cli.WarningText}"
                                   TextWrapping="Wrap" />
                      </Border>

                      <WrapPanel ItemSpacing="8" LineSpacing="6">
                        <Button Classes="primary-action"
                                Content="Install or Repair CLI"
                                IsEnabled="{Binding Cli.CanInstallOrRepair}"
                                Command="{Binding InstallOrRepairCliFromUiCommand}" />
                        <Button Classes="secondary-action"
                                Content="Refresh Status"
                                Command="{Binding RefreshCliStatusFromUiCommand}" />
                        <Button Classes="secondary-action danger-action"
                                Content="Uninstall CLI"
                                IsEnabled="{Binding Cli.CanUninstall}"
                                Command="{Binding UninstallCliFromUiCommand}" />
                      </WrapPanel>
                    </StackPanel>
                  </Border>

                  <Border Classes="card-surface">
                    <Grid ColumnDefinitions="96,*"
                          RowDefinitions="Auto,Auto,Auto,Auto"
                          RowSpacing="10"
                          ColumnSpacing="16">
                      <TextBlock Grid.Row="0" Grid.Column="0" Classes="section-title" Text="Platform" />
                      <TextBlock Grid.Row="0" Grid.Column="1" Classes="muted" Text="{Binding Cli.PlatformText}" TextWrapping="Wrap" />

                      <TextBlock Grid.Row="1" Grid.Column="0" Classes="section-title" Text="Bundled CLI" />
                      <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" Text="{Binding Cli.BundledPath}" TextWrapping="Wrap" />

                      <TextBlock Grid.Row="2" Grid.Column="0" Classes="section-title" Text="Installed CLI" />
                      <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted" Text="{Binding Cli.InstalledPath}" TextWrapping="Wrap" />

                      <TextBlock Grid.Row="3" Grid.Column="0" Classes="section-title" Text="Command Shim" />
                      <TextBlock Grid.Row="3" Grid.Column="1" Classes="muted" Text="{Binding Cli.ShimPath}" TextWrapping="Wrap" />
                    </Grid>
                  </Border>

                  <Border Classes="card-surface"
                          IsVisible="{Binding Cli.HasPathInstructions}">
                    <StackPanel Spacing="8">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                        <TextBlock Classes="section-title"
                                   Text="PATH Instructions"
                                   VerticalAlignment="Center" />
                        <Button Grid.Column="1"
                                Classes="toolbar-icon"
                                Width="28"
                                Height="28"
                                IsEnabled="{Binding Cli.HasPathInstructions}"
                                Click="CopyCliPathInstructionsButton_OnClick"
                                ToolTip.Tip="Copy PATH instructions">
                          <Path Width="14"
                                Height="14"
                                Data="M5.25 4.75 L11 4.75 L11 12.75 L5.25 12.75 Z M7 3.25 L9.25 3.25 L10 4.75 M7 6.75 L9.25 6.75 M7 8.75 L9.25 8.75 M4 6.25 L3.25 6.25 L3.25 10.75 L4 10.75"
                                Fill="{DynamicResource Sunder.Brush.Transparent}"
                                Stretch="Uniform"
                                Stroke="{DynamicResource Sunder.Brush.Foreground.Secondary}"
                                StrokeLineCap="Round"
                                StrokeThickness="1.35" />
                        </Button>
                      </Grid>
                      <TextBox Text="{Binding Cli.PathInstructions}"
                               IsReadOnly="True"
                               AcceptsReturn="True"
                               TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>

                <StackPanel Spacing="16"
                             IsVisible="{Binding ShowUpdateSettings}">
                  <Border Classes="card-surface">
                    <StackPanel Spacing="14">
                      <StackPanel Spacing="4">
                        <TextBlock Classes="section-title" Text="Automatic Updates" />
                        <TextBlock Classes="caption"
                                   Text="Sunder can download new app versions in the background and apply them the next time the app starts."
                                   TextWrapping="Wrap" />
                      </StackPanel>

                      <CheckBox Content="Download updates automatically"
                                IsChecked="{Binding Updates.DownloadUpdatesAutomatically}" />

                      <Border Classes="settings-note-card">
                        <TextBlock Classes="muted"
                                   Text="Automatic downloads never restart the app while you are working. Manual updates can still be installed immediately from the update prompt."
                                   TextWrapping="Wrap" />
                      </Border>
                    </StackPanel>
                  </Border>

                  <Border Classes="card-surface">
                    <StackPanel Spacing="14">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="12">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="section-title" Text="App Version" />
                          <TextBlock Classes="caption" Text="Check the configured GitHub Releases feed for a newer Sunder build." TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="secondary-action"
                                Content="Check Now"
                                IsEnabled="{Binding Updates.CanCheckForAppUpdates}"
                                Command="{Binding CheckForUpdatesFromUiCommand}" />
                      </Grid>

                      <Grid ColumnDefinitions="96,*"
                            RowDefinitions="Auto,Auto,Auto"
                            RowSpacing="10"
                            ColumnSpacing="16">
                        <TextBlock Grid.Row="0" Grid.Column="0" Classes="section-title" Text="Current Version" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Classes="muted" Text="{Binding Updates.CurrentVersionText}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Classes="section-title" Text="Source" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Classes="muted" Text="{Binding Updates.SourceText}" TextWrapping="Wrap" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Classes="section-title" Text="Status" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Classes="muted" Text="{Binding Updates.StatusText}" TextWrapping="Wrap" />
                      </Grid>
                    </StackPanel>
                  </Border>
                </StackPanel>

                <StackPanel Spacing="16"
                            IsVisible="{Binding ShowAdvancedSettings}">
                  <Border Classes="card-surface">
                    <StackPanel Spacing="14">
                      <Grid ColumnDefinitions="*,Auto"
                            ColumnSpacing="16">
                        <StackPanel Spacing="4">
                          <TextBlock Classes="section-title" Text="Runtime Resource Policy" />
                          <TextBlock Classes="caption"
                                     Text="Choose the resource profile the Supervisor applies whenever it starts a Runtime worker."
                                     TextWrapping="Wrap" />
                        </StackPanel>
                        <Button Grid.Column="1"
                                Classes="secondary-action"
                                Content="Reset to Defaults"
                                Command="{Binding RuntimeResources.ResetToDefaultsCommand}" />
                      </Grid>

                      <controls:SunderComboBox ItemsSource="{Binding RuntimeResources.PresetOptions}"
                                               SelectedItem="{Binding RuntimeResources.SelectedPresetOption}"
                                               HorizontalAlignment="Stretch">
                        <controls:SunderComboBox.ItemTemplate>
                          <DataTemplate x:DataType="vm:SettingsRuntimeResourcePresetOption">
                            <StackPanel Spacing="2">
                              <TextBlock Text="{Binding Label}" />
                              <TextBlock Classes="caption" Text="{Binding Description}" />
                            </StackPanel>
                          </DataTemplate>
                        </controls:SunderComboBox.ItemTemplate>
                      </controls:SunderComboBox>
                    </StackPanel>
                  </Border>

                  <Border Classes="card-surface">
                      <StackPanel Spacing="14">
                        <TextBlock Classes="section-title" Text="Resource limits" />
                        <TextBlock Classes="caption"
                                   Text="Choose Custom to edit. Limits apply to each message or content item, not the whole session."
                                   TextWrapping="Wrap" />

                         <Grid ColumnDefinitions="*,104,Auto"
                               RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto"
                               ColumnSpacing="10"
                               RowSpacing="14">
                           <Grid.Styles>
                             <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                             <Style Selector="TextBox"><Setter Property="VerticalAlignment" Value="Center" /></Style>
                           </Grid.Styles>
                           <StackPanel Grid.Row="0" Spacing="3">
                             <TextBlock Classes="section-title" Text="RPC value limit" />
                             <TextBlock Classes="caption" Text="{Binding RuntimeResources.RpcValueRange}" />
                           </StackPanel>
                           <TextBox Grid.Row="0" Grid.Column="1" Text="{Binding RuntimeResources.CustomRpcValueMiBText}" IsReadOnly="{Binding RuntimeResources.AreLimitsReadOnly}" />
                           <TextBlock Grid.Row="0" Grid.Column="2" Classes="muted" VerticalAlignment="Center" Text="MiB" />

                          <StackPanel Grid.Row="1" Spacing="3">
                            <TextBlock Classes="section-title" Text="Value depth" />
                            <TextBlock Classes="caption" Text="{Binding RuntimeResources.ValueDepthRange}" />
                          </StackPanel>
                           <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding RuntimeResources.CustomValueDepthText}" IsReadOnly="{Binding RuntimeResources.AreLimitsReadOnly}" />
                           <TextBlock Grid.Row="1" Grid.Column="2" Classes="muted" VerticalAlignment="Center" Text="levels" />

                          <StackPanel Grid.Row="2" Spacing="3">
                            <TextBlock Classes="section-title" Text="Value nodes" />
                            <TextBlock Classes="caption" Text="{Binding RuntimeResources.ValueNodesRange}" />
                          </StackPanel>
                           <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding RuntimeResources.CustomValueNodesText}" IsReadOnly="{Binding RuntimeResources.AreLimitsReadOnly}" />
                           <TextBlock Grid.Row="2" Grid.Column="2" Classes="muted" VerticalAlignment="Center" Text="nodes" />

                          <StackPanel Grid.Row="3" Spacing="3">
                            <TextBlock Classes="section-title" Text="Object members" />
                            <TextBlock Classes="caption" Text="{Binding RuntimeResources.ObjectMembersRange}" />
                          </StackPanel>
                           <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding RuntimeResources.CustomObjectMembersText}" IsReadOnly="{Binding RuntimeResources.AreLimitsReadOnly}" />
                           <TextBlock Grid.Row="3" Grid.Column="2" Classes="muted" VerticalAlignment="Center" Text="members" />

                          <StackPanel Grid.Row="4" Spacing="3">
                            <TextBlock Classes="section-title" Text="Inline decoded data" />
                            <TextBlock Classes="caption" Text="{Binding RuntimeResources.InlineDecodedRange}" />
                          </StackPanel>
                           <TextBox Grid.Row="4" Grid.Column="1" Text="{Binding RuntimeResources.CustomInlineDecodedKiBText}" IsReadOnly="{Binding RuntimeResources.AreLimitsReadOnly}" />
                           <TextBlock Grid.Row="4" Grid.Column="2" Classes="muted" VerticalAlignment="Center" Text="KiB" />

                          <StackPanel Grid.Row="5" Spacing="3">
                            <TextBlock Classes="section-title" Text="Content reference" />
                            <TextBlock Classes="caption" Text="{Binding RuntimeResources.ContentReferenceRange}" />
                          </StackPanel>
                           <TextBox Grid.Row="5" Grid.Column="1" Text="{Binding RuntimeResources.CustomContentReferenceMiBText}" IsReadOnly="{Binding RuntimeResources.AreLimitsReadOnly}" />
                           <TextBlock Grid.Row="5" Grid.Column="2" Classes="muted" VerticalAlignment="Center" Text="MiB" />
                        </Grid>

                        <Border Classes="settings-note-card"
                                IsVisible="{Binding RuntimeResources.HasValidationError}"
                                BorderBrush="{DynamicResource Sunder.Brush.Warning}">
                          <TextBlock Foreground="{DynamicResource Sunder.Brush.Warning}"
                                     Text="{Binding RuntimeResources.ValidationMessage}"
                                     TextWrapping="Wrap" />
                        </Border>
                      </StackPanel>
                  </Border>

                  <Border Padding="14"
                          CornerRadius="10"
                          Background="{DynamicResource Sunder.Brush.Accent.Overlay}"
                          BorderBrush="{DynamicResource Sunder.Brush.Accent}"
                          BorderThickness="1"
                          IsVisible="{Binding RuntimeResources.ShowPendingNotice}">
                    <StackPanel Spacing="4">
                      <TextBlock Classes="section-title"
                                 Foreground="{DynamicResource Sunder.Brush.Accent}"
                                  Text="Applies on next Runtime start" />
                      <TextBlock Classes="muted"
                                 Text="{Binding RuntimeResources.PendingDetailText}"
                                 TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </StackPanel>

                <ItemsControl ItemsSource="{Binding PackageSettings.SelectedPackageSections}"
                               IsVisible="{Binding ShowGenericPackageSettings}">
                  <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="{DynamicResource Sunder.Spacing.Large}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SettingsFieldSectionViewModel">
                      <Border Classes="card-surface">
                        <StackPanel Spacing="12">
                          <controls:SettingsFieldHeader Title="{Binding Title}" HelpText="{Binding Description}" />
                          <ItemsControl ItemsSource="{Binding Fields}">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Spacing="{DynamicResource Sunder.Spacing.Large}" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                              <DataTemplate x:DataType="vm:SettingsFieldViewModel">
                                <ContentControl Content="{Binding}" />
                              </DataTemplate>
                            </ItemsControl.ItemTemplate>
                          </ItemsControl>
                        </StackPanel>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>

              </StackPanel>
            </ScrollViewer>

            <Grid Grid.Row="1">
              <ContentControl Content="{Binding StagedHostedSettingsView}"
                              IsVisible="{Binding HasStagedHostedSettingsView}"
                              Opacity="0"
                              IsHitTestVisible="False"
                              Focusable="False"
                              IsTabStop="False" />
              <ContentControl Content="{Binding HostedSettingsView}"
                              IsVisible="{Binding HasHostedSettingsView}" />
            </Grid>
          </Grid>
        </Border>
        </Grid>
    </Grid>

    <Border Grid.Row="2" Classes="window-footer">
      <StackPanel Spacing="4">
        <TextBlock Classes="caption" Text="{Binding StatusText}" TextWrapping="Wrap" MaxLines="2"
                   TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding StatusText}"
                   IsVisible="{Binding StatusText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
        <WrapPanel HorizontalAlignment="Right" ItemSpacing="8" LineSpacing="5">
          <controls:BackgroundTaskMonitor DataContext="{Binding BackgroundTasks}" />
          <Button Classes="secondary-action" Content="Cancel" Click="CancelButton_OnClick" />
          <Button Classes="secondary-action" Content="Apply" IsVisible="{Binding ShowApplySaveButtons}" Command="{Binding ApplyFromUiCommand}" />
          <Button Classes="primary-action" Content="Save" IsVisible="{Binding ShowApplySaveButtons}" Click="SaveButton_OnClick" />
        </WrapPanel>
      </StackPanel>
    </Border>
  </Grid>
</Window>
