{
  "descriptorVersion": 2,
  "contractId": "example.messages",
  "version": "2.0.0",
  "errors": {
    "example.rejected": {
      "description": "The conformance request was rejected."
    }
  },
  "services": {
    "messages": {
      "methods": {
        "send": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": { "$ref": "#/$defs/Request" },
          "responseSchema": { "$ref": "#/$defs/Response" }
        },
        "data": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": { "$ref": "#/$defs/Request" },
          "responseSchema": { "$ref": "#/$defs/Response" }
        },
        "fault": {
          "kind": "unary",
          "idempotency": "none",
          "errors": ["example.rejected"],
          "requestSchema": { "$ref": "#/$defs/Request" },
          "responseSchema": { "$ref": "#/$defs/Response" }
        },
        "watch": {
          "kind": "server-stream",
          "idempotency": "none",
          "errors": [],
          "requestSchema": { "$ref": "#/$defs/Request" },
          "eventSchema": { "$ref": "#/$defs/Response" }
        }
      }
    }
  },
  "$defs": {
    "Request": {
      "type": "object",
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 256 }
      },
      "required": ["message"],
      "additionalProperties": false
    },
    "Response": {
      "type": "object",
      "properties": {
        "message": { "type": "string", "minLength": 1, "maxLength": 1024 }
      },
      "required": ["message"],
      "additionalProperties": false
    }
  }
}
