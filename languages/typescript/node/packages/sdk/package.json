{
  "name": "@sunder/sdk",
  "version": "1.1.0",
  "description": "Zero-dependency TypeScript SDK for Sunder RPC V1 contracts and Worker V1 Runtime packages.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Younics/sunder-core.git",
    "directory": "languages/typescript/node/packages/sdk"
  },
  "homepage": "https://github.com/Younics/sunder-core/tree/main/languages/typescript/node/packages/sdk#readme",
  "bugs": "https://github.com/Younics/sunder-core/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "!dist/authoring.*",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "require": "./dist/browser.js",
      "default": "./dist/browser.js"
    },
    "./core": {
      "types": "./dist/core.d.ts",
      "require": "./dist/core.js",
      "default": "./dist/core.js"
    },
    "./generated": {
      "types": "./dist/generated.d.ts",
      "require": "./dist/generated.js",
      "default": "./dist/generated.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "require": "./dist/react.js",
      "default": "./dist/react.js"
    }
  },
  "engines": {
    "node": ">=24.18.1 <25.0.0"
  },
  "peerDependencies": { "react": ">=19.2.0 <20.0.0" },
  "peerDependenciesMeta": { "react": { "optional": true } },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\" && tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run build && node -e \"require('node:fs').rmSync('dist-test', { recursive: true, force: true })\" && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  }
}
