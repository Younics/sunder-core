{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunder.dev/specs/rpc/v1/authoring/platform-catalog.schema.json",
  "title": "Sunder Registry Platform Contract Catalog V1",
  "description": "Immutable platform API definitions published by an administrator of the explicitly selected Registry.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 6,
  "required": [
    "schemaVersion",
    "authorityKind",
    "authorityId",
    "releaseVersion",
    "contractCount",
    "contracts"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "authorityKind": {
      "const": "platform"
    },
    "authorityId": {
      "const": "sunder.core"
    },
    "releaseVersion": {
      "$ref": "#/$defs/stableVersion"
    },
    "contractCount": {
      "type": "integer",
      "minimum": 1,
      "maximum": 128
    },
    "contracts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/catalogContract"
      },
      "contains": {
        "type": "object",
        "required": [
          "contractId"
        ],
        "properties": {
          "contractId": {
            "const": "sunder.stack.contributor"
          }
        }
      },
      "minContains": 1,
      "maxContains": 1
    }
  },
  "$defs": {
    "packageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)*$"
    },
    "stableVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 256,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "semanticVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 256,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "canonicalDescriptor": {
      "type": "string",
      "minLength": 2,
      "maxLength": 4194304,
      "pattern": "^(?![\\s\\S]*[\\u0000-\\u001f])\\{[\\s\\S]*\\}$"
    },
    "catalogContract": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 6,
      "required": [
        "contractId",
        "contractVersion",
        "descriptorBytes",
        "descriptorSha256",
        "abiSha256",
        "canonicalDescriptor"
      ],
      "properties": {
        "contractId": {
          "$ref": "#/$defs/packageId"
        },
        "contractVersion": {
          "$ref": "#/$defs/semanticVersion"
        },
        "descriptorBytes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4194304
        },
        "descriptorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "abiSha256": {
          "$ref": "#/$defs/sha256"
        },
        "canonicalDescriptor": {
          "$ref": "#/$defs/canonicalDescriptor"
        }
      }
    }
  }
}
