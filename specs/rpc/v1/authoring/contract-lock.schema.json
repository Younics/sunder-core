{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunder.dev/specs/rpc/v1/authoring/contract-lock.schema.json",
  "title": "Sunder Contract Lock V1",
  "description": "The closed schema for the tracked package-root sunder-contracts.lock.json file.",
  "type": "object",
  "additionalProperties": false,
  "maxProperties": 5,
  "required": [
    "lockVersion",
    "packageArtifacts",
    "packageImports",
    "providerImports",
    "platformImports"
  ],
  "properties": {
    "lockVersion": {
      "const": 1
    },
    "packageArtifacts": {
      "$ref": "#/$defs/packageArtifactMap"
    },
    "packageImports": {
      "$ref": "#/$defs/packageImportMap"
    },
    "providerImports": {
      "$ref": "#/$defs/providerImportMap"
    },
    "platformImports": {
      "$ref": "#/$defs/platformImportMap"
    }
  },
  "$defs": {
    "packageId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "minLength": 5,
      "maxLength": 256,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "versionRange": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1024,
      "oneOf": [
        {
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        {
          "pattern": "^(?:<=|>=|<|>|=)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?: (?:<=|>=|<|>|=)(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-(?:(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?)*$"
        }
      ]
    },
    "sha256": {
      "type": "string",
      "minLength": 64,
      "maxLength": 64,
      "pattern": "^[0-9a-f]{64}$"
    },
    "strongDescriptorEtag": {
      "type": "string",
      "minLength": 66,
      "maxLength": 66,
      "pattern": "^\"[0-9a-f]{64}\"$"
    },
    "localName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z][A-Za-z0-9]{0,127}$"
    },
    "registryOrigin": {
      "type": "string",
      "minLength": 10,
      "maxLength": 268,
      "anyOf": [
        {
          "pattern": "^https://(?=[^:/]{1,253}(?::[0-9]{1,5})?/$)(?![0-9]+(?:\\.[0-9]+)*(?::[0-9]+)?/)(?:[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)(?:\\.[a-z0-9](?:[a-z0-9-]{0,61}[a-z0-9])?)*(?::(?!443/)(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/$"
        },
        {
          "pattern": "^http://localhost(?::(?!80/)(?:[1-9]|[1-9][0-9]{1,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?/$"
        }
      ]
    },
    "packageArtifactMap": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/packageId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/packageArtifact"
      }
    },
    "packageArtifact": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 10,
      "required": [
        "requestedVersionRange",
        "includePrerelease",
        "selectedPackageVersion",
        "selectedPackageContentIdentity",
        "publicContractCount",
        "publicInventorySha256",
        "modelProjectionBytes",
        "modelProjectionSha256",
        "contracts"
      ],
      "properties": {
        "requestedVersionRange": {
          "$ref": "#/$defs/versionRange"
        },
        "includePrerelease": {
          "type": "boolean"
        },
        "selectedPackageVersion": {
          "$ref": "#/$defs/semanticVersion"
        },
        "selectedPackageContentIdentity": {
          "$ref": "#/$defs/sha256"
        },
        "registryOrigin": {
          "$ref": "#/$defs/registryOrigin"
        },
        "publicContractCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 128
        },
        "publicInventorySha256": {
          "$ref": "#/$defs/sha256"
        },
        "modelProjectionBytes": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4194304
        },
        "modelProjectionSha256": {
          "$ref": "#/$defs/sha256"
        },
        "contracts": {
          "$ref": "#/$defs/artifactContractMap"
        }
      }
    },
    "artifactContractMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/packageId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/artifactContract"
      }
    },
    "artifactContract": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 10,
      "required": [
        "artifactSource",
        "authorityKind",
        "authorityId",
        "selectedAuthorityRelease",
        "selectedAuthorityContentIdentity",
        "resolvedContractVersion",
        "descriptorBytes",
        "descriptorSha256",
        "abiSha256",
        "etag"
      ],
      "properties": {
        "artifactSource": {
          "enum": [
            "owned",
            "imported"
          ]
        },
        "authorityKind": {
          "enum": [
            "package",
            "platform"
          ]
        },
        "authorityId": {
          "$ref": "#/$defs/packageId"
        },
        "selectedAuthorityRelease": {
          "$ref": "#/$defs/semanticVersion"
        },
        "selectedAuthorityContentIdentity": {
          "$ref": "#/$defs/sha256"
        },
        "resolvedContractVersion": {
          "$ref": "#/$defs/semanticVersion"
        },
        "descriptorBytes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4194304
        },
        "descriptorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "abiSha256": {
          "$ref": "#/$defs/sha256"
        },
        "etag": {
          "$ref": "#/$defs/strongDescriptorEtag"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "artifactSource": {
                "const": "owned"
              }
            },
            "required": [
              "artifactSource"
            ]
          },
          "then": {
            "properties": {
              "authorityKind": {
                "const": "package"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "authorityKind": {
                "const": "platform"
              }
            },
            "required": [
              "authorityKind"
            ]
          },
          "then": {
            "type": "object",
            "properties": {
              "authorityId": {
                "const": "sunder.core"
              }
            }
          }
        }
      ]
    },
    "packageImportMap": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/packageId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/packageImport"
      }
    },
    "packageImport": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 4,
      "required": [
        "localName",
        "presence",
        "requiredContracts",
        "consumerRoles"
      ],
      "properties": {
        "localName": {
          "$ref": "#/$defs/localName"
        },
        "presence": {
          "enum": [
            "required",
            "optional"
          ]
        },
        "requiredContracts": {
          "type": "array",
          "minItems": 0,
          "maxItems": 128,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/packageId"
          }
        },
        "consumerRoles": {
          "description": "Reviewed role intent, intersected with present package roles. Missing legacy intent requires explicit migration and never defaults to both roles.",
          "enum": [
            [
              "app"
            ],
            [
              "runtime"
            ],
            [
              "app",
              "runtime"
            ]
          ]
        }
      }
    },
    "providerImportMap": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/localName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/providerImport"
      }
    },
    "providerImport": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 3,
      "required": [
        "packageId",
        "contractId"
      ],
      "properties": {
        "packageId": {
          "$ref": "#/$defs/packageId"
        },
        "contractId": {
          "$ref": "#/$defs/packageId"
        },
        "presence": {
          "enum": [
            "required",
            "optional"
          ]
        }
      }
    },
    "platformImportMap": {
      "type": "object",
      "minProperties": 0,
      "maxProperties": 128,
      "propertyNames": {
        "$ref": "#/$defs/localName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/platformImport"
      }
    },
    "platformImport": {
      "type": "object",
      "additionalProperties": false,
      "maxProperties": 13,
      "required": [
        "authorityKind",
        "authorityId",
        "authorityReleaseRange",
        "includePrerelease",
        "selectedAuthorityRelease",
        "selectedAuthorityContentIdentity",
        "contractId",
        "resolvedContractVersion",
        "descriptorBytes",
        "descriptorSha256",
        "abiSha256",
        "etag"
      ],
      "properties": {
        "authorityKind": {
          "const": "platform"
        },
        "authorityId": {
          "const": "sunder.core"
        },
        "authorityReleaseRange": {
          "$ref": "#/$defs/versionRange"
        },
        "includePrerelease": {
          "const": false
        },
        "selectedAuthorityRelease": {
          "$ref": "#/$defs/semanticVersion"
        },
        "selectedAuthorityContentIdentity": {
          "$ref": "#/$defs/sha256"
        },
        "contractId": {
          "$ref": "#/$defs/packageId"
        },
        "resolvedContractVersion": {
          "$ref": "#/$defs/semanticVersion"
        },
        "registryOrigin": {
          "$ref": "#/$defs/registryOrigin"
        },
        "descriptorBytes": {
          "type": "integer",
          "minimum": 2,
          "maximum": 4194304
        },
        "descriptorSha256": {
          "$ref": "#/$defs/sha256"
        },
        "abiSha256": {
          "$ref": "#/$defs/sha256"
        },
        "etag": {
          "$ref": "#/$defs/strongDescriptorEtag"
        }
      }
    }
  }
}
