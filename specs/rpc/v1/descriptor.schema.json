{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sunder.dev/specs/rpc/v1/descriptor.schema.json",
  "title": "Sunder RPC V1 contract descriptor",
  "description": "Structural schema for descriptorVersion 1 and sunder.rpc.values.v1. README.md defines additional lexical, graph, format, ordering, and hashing requirements.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "descriptorVersion",
    "schemaProfile",
    "contractId",
    "version",
    "errors",
    "services",
    "$defs"
  ],
  "properties": {
    "$schema": {
      "const": "https://json-schema.org/draft/2020-12/schema"
    },
    "descriptorVersion": {
      "const": 1
    },
    "schemaProfile": {
      "const": "sunder.rpc.values.v1"
    },
    "contractId": {
      "$ref": "#/$defs/contractId"
    },
    "version": {
      "$ref": "#/$defs/semanticVersion"
    },
    "errors": {
      "type": "object",
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/memberId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/errorDeclaration"
      }
    },
    "services": {
      "$ref": "#/$defs/serviceCollection"
    },
    "$defs": {
      "$ref": "#/$defs/definitionsMap"
    }
  },
  "$defs": {
    "contractId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:\\.[a-z0-9]+)*$"
    },
    "semanticVersion": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-((?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(?:\\.(?:0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(?:\\+([0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*))?$"
    },
    "memberId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[a-z0-9](?:[a-z0-9._-]*[a-z0-9])?$"
    },
    "definitionName": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9._-]+$"
    },
    "annotation": {
      "type": "string",
      "maxLength": 2048
    },
    "safeInteger": {
      "type": "integer",
      "minimum": -9007199254740991,
      "maximum": 9007199254740991
    },
    "collectionBound": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "positiveCollectionBound": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "localReferenceString": {
      "type": "string",
      "minLength": 9,
      "maxLength": 136,
      "pattern": "^#/\\$defs/[A-Za-z0-9._-]{1,128}$"
    },
    "errorDeclaration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "$ref": "#/$defs/annotation"
        },
        "detailsSchema": {
          "$ref": "#/$defs/referenceSchema"
        }
      }
    },
    "errorReferenceList": {
      "type": "array",
      "maxItems": 256,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/memberId"
      }
    },
    "serviceCollection": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 64,
      "propertyNames": {
        "$ref": "#/$defs/memberId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/service"
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["methods"],
      "properties": {
        "methods": {
          "$ref": "#/$defs/methodCollection"
        }
      }
    },
    "methodCollection": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 512,
      "propertyNames": {
        "$ref": "#/$defs/memberId"
      },
      "additionalProperties": {
        "$ref": "#/$defs/method"
      }
    },
    "method": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "idempotency",
        "errors",
        "requestSchema"
      ],
      "properties": {
        "kind": {
          "enum": ["unary", "server-stream"]
        },
        "idempotency": {
          "enum": ["none", "idempotent"]
        },
        "errors": {
          "$ref": "#/$defs/errorReferenceList"
        },
        "requestSchema": {
          "$ref": "#/$defs/referenceSchema"
        },
        "responseSchema": {
          "$ref": "#/$defs/referenceSchema"
        },
        "eventSchema": {
          "$ref": "#/$defs/referenceSchema"
        }
      },
      "allOf": [
        {
          "if": {
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "unary"
              }
            }
          },
          "then": {
            "required": ["responseSchema"],
            "properties": {
              "eventSchema": false
            }
          }
        },
        {
          "if": {
            "required": ["kind"],
            "properties": {
              "kind": {
                "const": "server-stream"
              }
            }
          },
          "then": {
            "required": ["eventSchema"],
            "properties": {
              "responseSchema": false
            }
          }
        }
      ]
    },
    "definitionsMap": {
      "type": "object",
      "minProperties": 1,
      "maxProperties": 256,
      "propertyNames": {
        "$ref": "#/$defs/definitionName"
      },
      "additionalProperties": {
        "$ref": "#/$defs/schema"
      }
    },
    "schema": {
      "oneOf": [
        {
          "$ref": "#/$defs/referenceSchema"
        },
        {
          "$ref": "#/$defs/unionSchema"
        },
        {
          "$ref": "#/$defs/unconstrainedSchema"
        },
        {
          "$ref": "#/$defs/dynamicObjectSchema"
        },
        {
          "$ref": "#/$defs/recordSchema"
        },
        {
          "$ref": "#/$defs/mapSchema"
        },
        {
          "$ref": "#/$defs/arraySchema"
        },
        {
          "$ref": "#/$defs/stringSchema"
        },
        {
          "$ref": "#/$defs/standardFormatSchema"
        },
        {
          "$ref": "#/$defs/bigIntegerSchema"
        },
        {
          "$ref": "#/$defs/decimalSchema"
        },
        {
          "$ref": "#/$defs/base64Schema"
        },
        {
          "$ref": "#/$defs/integerSchema"
        },
        {
          "$ref": "#/$defs/floatingPointSchema"
        },
        {
          "$ref": "#/$defs/booleanSchema"
        },
        {
          "$ref": "#/$defs/nullSchema"
        },
        {
          "$ref": "#/$defs/contentReferenceSchema"
        }
      ]
    },
    "referenceSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["$ref"],
      "properties": {
        "$ref": {
          "$ref": "#/$defs/localReferenceString"
        }
      }
    },
    "unionSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["oneOf"],
      "properties": {
        "oneOf": {
          "type": "array",
          "minItems": 2,
          "maxItems": 16,
          "items": {
            "$ref": "#/$defs/schema"
          }
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      }
    },
    "unconstrainedSchema": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      }
    },
    "dynamicObjectSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "object"
        },
        "maxProperties": {
          "$ref": "#/$defs/collectionBound"
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      }
    },
    "recordSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "properties",
        "required",
        "additionalProperties"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "maxProperties": 256,
          "propertyNames": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          },
          "additionalProperties": {
            "$ref": "#/$defs/schema"
          }
        },
        "required": {
          "type": "array",
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128
          }
        },
        "additionalProperties": {
          "const": false
        },
        "minProperties": {
          "$ref": "#/$defs/collectionBound"
        },
        "maxProperties": {
          "$ref": "#/$defs/collectionBound"
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      }
    },
    "mapSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "additionalProperties",
        "propertyNames"
      ],
      "properties": {
        "type": {
          "const": "object"
        },
        "properties": {
          "type": "object",
          "maxProperties": 0
        },
        "required": {
          "type": "array",
          "maxItems": 0
        },
        "additionalProperties": {
          "$ref": "#/$defs/schema"
        },
        "propertyNames": {
          "$ref": "#/$defs/stringSchema"
        },
        "minProperties": {
          "$ref": "#/$defs/collectionBound"
        },
        "maxProperties": {
          "$ref": "#/$defs/collectionBound"
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      }
    },
    "arraySchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "items"],
      "properties": {
        "type": {
          "const": "array"
        },
        "items": {
          "$ref": "#/$defs/schema"
        },
        "minItems": {
          "$ref": "#/$defs/collectionBound"
        },
        "maxItems": {
          "$ref": "#/$defs/collectionBound"
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      }
    },
    "stringSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "string"
        },
        "minLength": {
          "$ref": "#/$defs/collectionBound"
        },
        "maxLength": {
          "$ref": "#/$defs/collectionBound"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "string"
          }
        },
        "const": {
          "type": "string"
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      },
      "not": {
        "required": ["enum", "const"]
      }
    },
    "standardFormatSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "format"],
      "properties": {
        "type": {
          "const": "string"
        },
        "format": {
          "enum": ["uuid", "date", "date-time", "duration", "uri"]
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      }
    },
    "canonicalBigInteger": {
      "type": "string",
      "pattern": "^(?:0|-?[1-9][0-9]*)$"
    },
    "canonicalDecimal": {
      "type": "string",
      "pattern": "^(?:0|[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]|-(?:[1-9][0-9]*(?:\\.[0-9]*[1-9])?|0\\.[0-9]*[1-9]))$"
    },
    "bigIntegerSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "format"],
      "properties": {
        "type": {
          "const": "string"
        },
        "format": {
          "const": "big-integer"
        },
        "maxDigits": {
          "$ref": "#/$defs/positiveCollectionBound"
        },
        "valueMinimum": {
          "$ref": "#/$defs/canonicalBigInteger"
        },
        "valueExclusiveMinimum": {
          "$ref": "#/$defs/canonicalBigInteger"
        },
        "valueMaximum": {
          "$ref": "#/$defs/canonicalBigInteger"
        },
        "valueExclusiveMaximum": {
          "$ref": "#/$defs/canonicalBigInteger"
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["valueMinimum", "valueExclusiveMinimum"]
          }
        },
        {
          "not": {
            "required": ["valueMaximum", "valueExclusiveMaximum"]
          }
        }
      ]
    },
    "decimalSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "format"],
      "properties": {
        "type": {
          "const": "string"
        },
        "format": {
          "const": "decimal"
        },
        "maxPrecision": {
          "$ref": "#/$defs/positiveCollectionBound"
        },
        "maxScale": {
          "$ref": "#/$defs/collectionBound"
        },
        "valueMinimum": {
          "$ref": "#/$defs/canonicalDecimal"
        },
        "valueExclusiveMinimum": {
          "$ref": "#/$defs/canonicalDecimal"
        },
        "valueMaximum": {
          "$ref": "#/$defs/canonicalDecimal"
        },
        "valueExclusiveMaximum": {
          "$ref": "#/$defs/canonicalDecimal"
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["valueMinimum", "valueExclusiveMinimum"]
          }
        },
        {
          "not": {
            "required": ["valueMaximum", "valueExclusiveMaximum"]
          }
        }
      ]
    },
    "base64Schema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "contentEncoding"],
      "properties": {
        "type": {
          "const": "string"
        },
        "contentEncoding": {
          "const": "base64"
        },
        "maxDecodedBytes": {
          "$ref": "#/$defs/collectionBound"
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      }
    },
    "integerSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "integer"
        },
        "minimum": {
          "$ref": "#/$defs/safeInteger"
        },
        "maximum": {
          "$ref": "#/$defs/safeInteger"
        },
        "exclusiveMinimum": {
          "$ref": "#/$defs/safeInteger"
        },
        "exclusiveMaximum": {
          "$ref": "#/$defs/safeInteger"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/safeInteger"
          }
        },
        "const": {
          "$ref": "#/$defs/safeInteger"
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["minimum", "exclusiveMinimum"]
          }
        },
        {
          "not": {
            "required": ["maximum", "exclusiveMaximum"]
          }
        },
        {
          "not": {
            "required": ["enum", "const"]
          }
        }
      ]
    },
    "floatingPointSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "format"],
      "properties": {
        "type": {
          "const": "number"
        },
        "format": {
          "enum": ["float32", "float64"]
        },
        "minimum": {
          "type": "number"
        },
        "maximum": {
          "type": "number"
        },
        "exclusiveMinimum": {
          "type": "number"
        },
        "exclusiveMaximum": {
          "type": "number"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 256,
          "uniqueItems": true,
          "items": {
            "type": "number"
          }
        },
        "const": {
          "type": "number"
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      },
      "allOf": [
        {
          "not": {
            "required": ["minimum", "exclusiveMinimum"]
          }
        },
        {
          "not": {
            "required": ["maximum", "exclusiveMaximum"]
          }
        },
        {
          "not": {
            "required": ["enum", "const"]
          }
        }
      ]
    },
    "booleanSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "boolean"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {
            "type": "boolean"
          }
        },
        "const": {
          "type": "boolean"
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      },
      "not": {
        "required": ["enum", "const"]
      }
    },
    "nullSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "const": "null"
        },
        "enum": {
          "type": "array",
          "minItems": 1,
          "maxItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "null"
          }
        },
        "const": {
          "type": "null"
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      },
      "not": {
        "required": ["enum", "const"]
      }
    },
    "contentReferenceSchema": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "logicalType"],
      "properties": {
        "type": {
          "const": "object"
        },
        "logicalType": {
          "const": "content-reference"
        },
        "title": {
          "$ref": "#/$defs/annotation"
        },
        "description": {
          "$ref": "#/$defs/annotation"
        }
      }
    }
  }
}
