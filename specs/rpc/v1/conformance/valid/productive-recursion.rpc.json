{
  "descriptorVersion": 1,
  "schemaProfile": "sunder.rpc.values.v1",
  "contractId": "example.rpc.v1.recursion",
  "version": "2.0.0",
  "errors": {},
  "services": {
    "trees": {
      "methods": {
        "echo": {
          "kind": "unary",
          "idempotency": "idempotent",
          "errors": [],
          "requestSchema": { "$ref": "#/$defs/Node" },
          "responseSchema": { "$ref": "#/$defs/NodeMap" }
        }
      }
    }
  },
  "$defs": {
    "Text": {
      "type": "string",
      "minLength": 0,
      "maxLength": 128
    },
    "Node": {
      "type": "object",
      "properties": {
        "value": { "$ref": "#/$defs/Text" },
        "next": { "$ref": "#/$defs/Node" },
        "children": { "$ref": "#/$defs/NodeList" }
      },
      "required": ["value", "children"],
      "additionalProperties": false
    },
    "NodeList": {
      "type": "array",
      "items": { "$ref": "#/$defs/Node" },
      "minItems": 0,
      "maxItems": 128
    },
    "NodeMap": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/Node" },
      "propertyNames": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64
      },
      "minProperties": 0,
      "maxProperties": 128
    }
  }
}
