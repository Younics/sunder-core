{
  "formatVersion": 2,
  "protocol": {
    "identity": "sunder.worker.v3",
    "version": 3
  },
  "categories": {
    "shutdown-order": {
      "requirements": [
        "cancel-and-drain-worker-originated-calls",
        "close-scopes-and-release-content-handles",
        "invoke-on-shutdown",
        "close-and-drain-logging-lane",
        "write-and-flush-shutdown-ack"
      ]
    },
    "framing": {
      "requirements": [
        "canonical-content-length-header",
        "crlf-header-terminator",
        "bounded-frame-body",
        "reject-trailing-or-conflicting-headers"
      ]
    },
    "json": {
      "requirements": [
        "strict-utf8",
        "single-json-object",
        "reject-ascii-case-insensitive-duplicate-properties",
        "preserve-non-ascii-property-identity"
      ]
    },
    "safe-integers": {
      "requirements": [
        "accept-zero-through-9007199254740991",
        "reject-negative-unsigned-fields",
        "reject-fractions-and-exponents",
        "reject-values-above-9007199254740991"
      ]
    },
    "data": {
      "requirements": [
        "host-authoritative-settings-state-files-and-secrets",
        "bounded-inline-or-payload-values",
        "generation-fenced-access"
      ]
    },
    "logging": {
      "requirements": [
        "isolated-bounded-logging-lane",
        "structured-safe-attributes",
        "shutdown-logs-drain-before-ack"
      ]
    },
    "migration": {
      "requirements": [
        "read-only-preparation",
        "exact-declared-plans",
        "host-authoritative-application",
        "completion-journal-after-activation"
      ]
    },
    "callback": {
      "requirements": [
        "exact-generation-session-identity",
        "bounded-start-complete-cancel",
        "terminal-response-once"
      ]
    },
    "auth": {
      "requirements": [
        "reserved-auth-handler",
        "host-owned-authorization-session",
        "bounded-status-connect-complete-disconnect"
      ]
    },
    "content": {
      "requirements": [
        "register-open-stream-release",
        "verify-length-and-sha256",
        "release-handles-before-shutdown"
      ]
    },
    "scope": {
      "requirements": [
        "caller-owned-authority",
        "deadline-and-generation-fence",
        "idempotent-close-before-shutdown"
      ]
    },
    "cancel": {
      "requirements": [
        "ordered-request-before-cancel",
        "await-host-terminal-after-worker-cancel",
        "reject-duplicate-or-unknown-cancel"
      ]
    }
  },
  "lifecycle": {
    "challenge": "worker-v3-conformance",
    "sessionGeneration": 1,
    "shutdownId": "worker-v3-conformance-shutdown",
    "shutdownReason": "conformance-complete"
  },
  "rpc": {
    "serviceId": "messages",
    "declaredErrors": {
      "domain": ["example.rejected"],
      "undeclared-domain": []
    },
    "unary": {
      "id": "worker-v3-conformance-unary",
      "methodId": "echo",
      "request": {
        "message": "shared Worker V3 corpus"
      },
      "result": {
        "accepted": true,
        "request": {
          "message": "shared Worker V3 corpus"
        }
      }
    },
    "stream": {
      "id": "worker-v3-conformance-stream",
      "methodId": "watch",
      "request": {
        "message": "shared Worker V3 stream"
      },
      "events": [
        {
          "sequence": 1,
          "request": {
            "message": "shared Worker V3 stream"
          }
        },
        {
          "sequence": 2,
          "request": {
            "message": "shared Worker V3 stream"
          }
        }
      ]
    },
    "domainFault": {
      "id": "worker-v3-conformance-domain-fault",
      "methodId": "domain",
      "request": {
        "message": "reject from shared corpus"
      },
      "error": {
        "kind": "domain",
        "code": "example.rejected",
        "message": "rejected"
      }
    },
    "undeclaredDomainFault": {
      "id": "worker-v3-conformance-undeclared-domain-fault",
      "methodId": "undeclared-domain",
      "request": {
        "message": "hide undeclared domain error"
      },
      "thrownError": {
        "code": "example.undeclared",
        "message": "must remain private"
      },
      "diagnosticRequired": true,
      "error": {
        "kind": "provider-fault",
        "code": "rpc.provider.handler-fault",
        "message": "The process provider handler failed."
      }
    }
  },
  "storageMigrations": {
    "capabilities": ["storage.key-migration.v1", "storage.v1"],
    "plans": [
      {
        "store": "state",
        "rules": [
          {
            "kind": "exact",
            "legacyKey": "legacy.state.v1",
            "destinationKey": "state.current.v1"
          },
          {
            "kind": "opaque-id",
            "legacyPrefix": "legacy.item:",
            "legacySuffix": ":value",
            "destinationPrefix": "items",
            "destinationVersion": 2
          },
          {
            "kind": "opaque-id-json",
            "legacyPrefix": "legacy.profile:",
            "legacySuffix": "",
            "destinationPrefix": "profiles",
            "destinationVersion": 3,
            "identityProperty": "profileId"
          },
          {
            "kind": "opaque-id-json-case-insensitive",
            "legacyPrefix": "legacy.account:",
            "legacySuffix": "",
            "destinationPrefix": "accounts",
            "destinationVersion": 4,
            "identityProperty": "accountId"
          },
          {
            "kind": "dynamic-cleanup"
          }
        ]
      },
      {
        "store": "secrets",
        "rules": [
          {
            "kind": "exact",
            "legacyKey": "legacy.secret.v1",
            "destinationKey": "secret.current.v1"
          }
        ]
      }
    ],
    "dynamicKeys": ["legacy.deleted", "legacy.keep", "legacy.rewrite"],
    "dynamicActions": [
      {
        "key": "legacy.deleted",
        "kind": "delete",
        "destinationKey": null,
        "precedence": 0
      },
      {
        "key": "legacy.keep",
        "kind": "no-match",
        "destinationKey": null,
        "precedence": 0
      },
      {
        "key": "legacy.rewrite",
        "kind": "rewrite",
        "destinationKey": "state.recovered.v1",
        "precedence": 2
      }
    ]
  },
  "packageData": {
    "key": "worker-v3.conformance.value",
    "value": "shared Worker V3 package data"
  },
  "interop": {
    "contractId": "example.messages",
    "contractVersion": "2.0.0",
    "serviceId": "messages",
    "nodeProviderPackageId": "sunder.sea.smoke",
    "dotnetProviderPackageId": "test.worker.interop",
    "nodeCallerPackageId": "sunder.interop.node.caller",
    "dotnetCallerPackageId": "sunder.interop.dotnet.caller",
    "dotnetToNodeStateKey": "interop.dotnet-to-node",
    "nodeToDotnetStateKey": "interop.node-to-dotnet"
  }
}
