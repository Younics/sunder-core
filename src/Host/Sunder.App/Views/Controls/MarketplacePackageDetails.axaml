<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Sunder.App.ViewModels"
             xmlns:controls="using:Sunder.App.Views.Controls"
             xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
             x:Class="Sunder.App.Views.Controls.MarketplacePackageDetails"
             x:DataType="vm:PackagesWindowViewModel"
             mc:Ignorable="d">
  <StackPanel Spacing="16">
    <Grid MinHeight="220"
          IsVisible="{Binding ShowMarketplacePackageDetailsLoading}">
      <Path Classes="marketplace-detail-spinner"
            Data="M 15,3 A 12,12 0 1 1 6.5,24.5"
            Fill="{x:Null}"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            RenderTransformOrigin="50%,50%">
        <Path.RenderTransform>
          <RotateTransform Angle="0" />
        </Path.RenderTransform>
      </Path>
    </Grid>

    <Border Classes="settings-note-card"
            IsVisible="{Binding ShowMarketplacePackageDetailsError}">
      <StackPanel Spacing="6">
        <TextBlock Text="Package details unavailable"
                   FontWeight="SemiBold" />
        <TextBlock Classes="muted"
                   Text="{Binding MarketplacePackageDetailsError}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <StackPanel Spacing="16"
                IsVisible="{Binding ShowMarketplacePackageDetailsContent}">
      <Grid ColumnDefinitions="*,*,*"
            ColumnSpacing="12">
      <Border Classes="card-surface">
        <StackPanel Spacing="4">
          <TextBlock Classes="caption" Text="Latest" />
          <TextBlock Classes="section-title" Text="{Binding MarketplaceLatestVersion}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Classes="card-surface">
        <StackPanel Spacing="4">
          <TextBlock Classes="caption" Text="Installed" />
          <TextBlock Classes="section-title" Text="{Binding MarketplaceInstalledVersion}" />
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Classes="card-surface">
        <StackPanel Spacing="4">
          <TextBlock Classes="caption" Text="Selected Version" />
          <TextBlock Classes="section-title" Text="{Binding MarketplaceSelectedVersion}" />
        </StackPanel>
      </Border>
    </Grid>

    <Border Classes="card-surface"
            IsVisible="{Binding HasMarketplaceProfileMedia}">
      <controls:MarketplaceMediaStrip Items="{Binding Marketplace.ProfileMedia}" />
    </Border>

    <Border Classes="card-surface"
            IsVisible="{Binding HasMarketplaceReadme}">
      <StackPanel Spacing="8">
        <TextBlock Classes="section-title" Text="Overview" />
        <md:MarkdownRenderer MarkdownBuilder="{Binding Marketplace.ReadmeMarkdownBuilder}" />
      </StackPanel>
    </Border>

    <controls:MarketplaceProfileCard Description="Project links and package metadata."
                                      Links="{Binding Marketplace.ProfileLinks}"
                                      Metadata="{Binding Marketplace.ProfileMetadata}"
                                      Tags="{Binding Marketplace.ProfileTags}"
                                     HasLinks="{Binding HasMarketplaceProfileLinks}"
                                     HasMetadata="{Binding HasMarketplaceProfileMetadata}"
                                     HasTags="{Binding HasMarketplaceProfileTags}"
                                     IsVisible="{Binding HasMarketplaceProfile}" />

    <Border Classes="card-surface marketplace-profile-card"
            IsVisible="{Binding HasMarketplaceAttributions}">
      <StackPanel Spacing="12">
        <StackPanel Spacing="2">
          <TextBlock Classes="section-title" Text="People" />
          <TextBlock Classes="caption" Text="Creator and maintainers shown by public profile name." />
        </StackPanel>
        <StackPanel Spacing="6"
                    IsVisible="{Binding HasMarketplaceCreators}">
          <TextBlock Classes="caption marketplace-people-heading" Text="Creator" />
          <ItemsControl ItemsSource="{Binding Marketplace.Creators}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RegistryUserAttributionViewModel">
                <Border Classes="marketplace-person-chip creator">
                  <TextBlock Classes="marketplace-person-chip-text"
                             Text="{Binding DisplayName}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
        <StackPanel Spacing="6"
                    IsVisible="{Binding HasMarketplaceMaintainers}">
          <TextBlock Classes="caption marketplace-people-heading" Text="Maintainers" />
          <ItemsControl ItemsSource="{Binding Marketplace.Maintainers}">
            <ItemsControl.ItemsPanel>
              <ItemsPanelTemplate>
                <WrapPanel />
              </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:RegistryUserAttributionViewModel">
                <Border Classes="marketplace-person-chip">
                  <TextBlock Classes="marketplace-person-chip-text"
                             Text="{Binding DisplayName}" />
                </Border>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </StackPanel>
    </Border>

    <Border Classes="card-surface">
      <StackPanel Spacing="8">
        <TextBlock Classes="section-title" Text="Versions" />
        <ListBox Classes="package-list"
                 MaxHeight="280"
                 ItemsSource="{Binding Marketplace.Versions}"
                 SelectedItem="{Binding SelectedMarketplaceVersion, Mode=TwoWay}"
                 IsVisible="{Binding HasMarketplaceVersions}">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:RegistryPackageVersionItemViewModel">
              <Border Classes="package-list-row"
                      Classes.selected="{Binding IsSelected}">
                <Grid ColumnDefinitions="*,Auto,Auto"
                      ColumnSpacing="10">
                  <TextBlock Classes="section-title" Text="{Binding Version}" />
                  <Border Grid.Column="1" Classes="package-row-badge">
                    <TextBlock Text="{Binding StatusText}" />
                  </Border>
                  <TextBlock Grid.Column="2" Classes="caption" Text="{Binding PublishedAtText}" VerticalAlignment="Center" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
        <TextBlock Classes="muted"
                   IsVisible="{Binding ShowNoMarketplaceVersions}"
                   Text="No versions loaded for the selected package."
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>
    </StackPanel>
  </StackPanel>
</UserControl>
