<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Sunder.App.ViewModels"
             xmlns:controls="using:Sunder.App.Views.Controls"
             x:Class="Sunder.App.Views.Controls.ShellToolbar"
             x:DataType="vm:MainWindowViewModel"
             mc:Ignorable="d">
  <controls:WindowTitleBar IsLogoLarge="True"
                             UseDefaultLogo="False"
                             PreferRightLogo="True">
    <controls:WindowTitleBar.LogoContent>
      <Button Classes="toolbar-icon registry-account-button"
              VerticalAlignment="Center"
              ToolTip.Tip="{Binding RegistryAccountButtonToolTip}">
        <Button.Content>
          <Border Classes="registry-avatar"
                  Background="{Binding RegistryAccountAvatarBrush}">
            <TextBlock Classes="registry-avatar-text"
                       Text="{Binding RegistryAccountAvatarText}" />
          </Border>
        </Button.Content>
        <Button.Flyout>
          <Flyout FlyoutPresenterClasses="runtime-flyout-surface">
            <StackPanel x:DataType="vm:MainWindowViewModel"
                        Width="280"
                        Spacing="12">
              <StackPanel Spacing="4">
                <TextBlock Classes="section-title" Text="Sunder Account" />
              </StackPanel>

              <Border Height="1"
                      Background="{DynamicResource Sunder.Brush.Border.Subtle}" />

              <Grid ColumnDefinitions="Auto,*"
                    ColumnSpacing="12">
                <Border Classes="registry-avatar large"
                        Background="{Binding RegistryAccountAvatarBrush}">
                  <TextBlock Classes="registry-avatar-text large"
                             Text="{Binding RegistryAccountAvatarText}" />
                </Border>
                <StackPanel Grid.Column="1"
                            Spacing="3"
                            VerticalAlignment="Center">
                  <TextBlock Classes="status-text"
                             Text="{Binding RegistryAccountDisplayName}"
                             TextWrapping="Wrap" />
                  <TextBlock Classes="caption"
                             Text="{Binding RegistryAccountSubtitle}"
                             TextWrapping="Wrap" />
                </StackPanel>
              </Grid>

              <Grid ColumnDefinitions="*,Auto,Auto"
                    ColumnSpacing="8">
                <Button Grid.Column="1"
                        Classes="primary-action compact-action"
                        Content="Sign in"
                        Command="{Binding LoginRegistryCommand}"
                        IsVisible="{Binding ShowRegistrySignInButton}"
                        IsEnabled="{Binding CanManageRegistryAccount}" />
                <Button Grid.Column="2"
                        Classes="secondary-action compact-action danger-action"
                        Content="Sign out"
                        Command="{Binding LogoutRegistryCommand}"
                        IsVisible="{Binding ShowRegistrySignOutButton}"
                        IsEnabled="{Binding CanManageRegistryAccount}" />
              </Grid>
            </StackPanel>
          </Flyout>
        </Button.Flyout>
      </Button>
    </controls:WindowTitleBar.LogoContent>

    <controls:WindowTitleBar.LeadingContent>
      <StackPanel x:Name="ToolbarLeftMenuHost"
                  Orientation="Horizontal"
                  Spacing="14"
                  Height="40"
                  VerticalAlignment="Center">
        <Grid x:Name="ToolbarLeftActionHost"
              Height="40"
              VerticalAlignment="Center">
          <StackPanel x:Name="ToolbarDefaultActions"
                      Orientation="Horizontal"
                      Spacing="14"
                      Height="40"
                      VerticalAlignment="Center">
            <Button Classes="toolbar-icon"
                    Command="{Binding OpenStacksCommand}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Stacks">
              <Path Width="15"
                    Height="15"
                    Classes="icon-stroke"
                    Data="{StaticResource Sunder.Icon.Stacks}" />
            </Button>

            <Button Classes="toolbar-icon"
                    Command="{Binding OpenPackagesCommand}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Packages">
              <Path Width="15"
                    Height="15"
                    Classes="icon-stroke"
                    Data="{StaticResource Sunder.Icon.Packages}" />
            </Button>

            <Button Classes="toolbar-icon"
                    Command="{Binding OpenSettingsCommand}"
                    VerticalAlignment="Center"
                    ToolTip.Tip="Settings">
              <Path Width="16"
                    Height="16"
                    Classes="icon-stroke"
                    Data="{StaticResource Sunder.Icon.Settings}" />
            </Button>

            <Button x:Name="MoreActionsButton"
                    Classes="toolbar-icon"
                    VerticalAlignment="Center"
                    ToolTip.Tip="View and package actions"
                    Click="MoreActionsButton_OnClick">
              <Grid Width="16"
                    Height="16"
                    ColumnDefinitions="*,*,*"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Ellipse Grid.Column="0"
                         Width="3"
                         Height="3"
                         Classes="toolbar-dot"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                <Ellipse Grid.Column="1"
                         Width="3"
                         Height="3"
                         Classes="toolbar-dot"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
                <Ellipse Grid.Column="2"
                         Width="3"
                         Height="3"
                         Classes="toolbar-dot"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center" />
              </Grid>
            </Button>
          </StackPanel>

          <Menu x:Name="ToolbarMainMenu"
                Classes="toolbar-main-menu"
                IsVisible="False"
                Height="40"
                VerticalAlignment="Center" />
        </Grid>
      </StackPanel>
    </controls:WindowTitleBar.LeadingContent>

    <controls:WindowTitleBar.CenterContent>
      <controls:PackageIconBar x:Name="MiddlePackageIconBar"
                               HorizontalAlignment="Stretch"
                               VerticalAlignment="Stretch"
                               DataContext="{Binding MiddleBar}" />
    </controls:WindowTitleBar.CenterContent>

    <controls:WindowTitleBar.TrailingContent>
      <StackPanel Orientation="Horizontal"
                  Spacing="8"
                  VerticalAlignment="Center">
        <controls:RuntimeStatusButton />
        <controls:NotificationToolbarButton />
      </StackPanel>
    </controls:WindowTitleBar.TrailingContent>
  </controls:WindowTitleBar>
</UserControl>
