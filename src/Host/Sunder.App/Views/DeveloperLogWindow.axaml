<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Sunder.App.ViewModels"
        xmlns:controls="using:Sunder.App.Views.Controls"
        x:Class="Sunder.App.Views.DeveloperLogWindow"
        x:DataType="vm:DeveloperLogWindowViewModel"
        mc:Ignorable="d"
        Width="1100"
        Height="680"
        MinWidth="820"
        MinHeight="480"
        CanResize="True"
        Title="Developer Logs"
        Icon="avares://Sunder.App/Assets/Images/app.ico"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Classes="secondary-window">
  <Grid RowDefinitions="52,*"
        Background="{DynamicResource Sunder.Brush.Background.App}">
    <controls:WindowTitleBar Grid.Row="0">
      <controls:WindowTitleBar.LeadingContent>
        <TextBlock Classes="section-title"
                   VerticalAlignment="Center"
                   Text="Developer Logs" />
      </controls:WindowTitleBar.LeadingContent>
    </controls:WindowTitleBar>

    <Border Grid.Row="1"
            Margin="20,12,20,20"
            Classes="panel-surface"
            Padding="0">
      <Border Classes="secondary-panel-content-clip"
              Padding="14">
        <Grid RowDefinitions="Auto,Auto,*" RowSpacing="8">
          <Grid ColumnDefinitions="220,*,Auto" ColumnSpacing="10">
            <ComboBox ItemsSource="{Binding FilterOptions}"
                      SelectedItem="{Binding SelectedFilter}"
                      HorizontalAlignment="Stretch">
              <ComboBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DeveloperLogFilterOptionViewModel">
                  <TextBlock Text="{Binding Label}" />
                </DataTemplate>
              </ComboBox.ItemTemplate>
            </ComboBox>
            <TextBox Grid.Column="1"
                     PlaceholderText="Search logs"
                     Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock Grid.Column="2"
                       Classes="caption"
                       VerticalAlignment="Center"
                       Text="{Binding StatusText}" />
          </Grid>

          <Grid Grid.Row="1" ColumnDefinitions="110,95,90,190,*" ColumnSpacing="10">
            <TextBlock Classes="caption" Text="Time" />
            <TextBlock Grid.Column="1" Classes="caption" Text="Level" />
            <TextBlock Grid.Column="2" Classes="caption" Text="Scope" />
            <TextBlock Grid.Column="3" Classes="caption" Text="Source" />
            <TextBlock Grid.Column="4" Classes="caption" Text="Message" />
          </Grid>

          <ListBox Grid.Row="2"
                   ItemsSource="{Binding FilteredEntries}"
                   ScrollViewer.HorizontalScrollBarVisibility="Auto"
                   ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemsPanel>
              <ItemsPanelTemplate>
                <VirtualizingStackPanel />
              </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:DeveloperLogEntryViewModel">
                  <Grid ColumnDefinitions="110,95,90,190,*" ColumnSpacing="10" Margin="0,0,0,4">
                    <TextBlock Classes="caption" Text="{Binding TimestampText}" />
                    <TextBlock Grid.Column="1" Classes="caption" Text="{Binding LevelText}" />
                    <TextBlock Grid.Column="2" Classes="caption" Text="{Binding ScopeText}" />
                    <TextBlock Grid.Column="3" Classes="caption" Text="{Binding Source}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="4"
                               FontFamily="Menlo,Consolas,monospace"
                               Text="{Binding Message}"
                               TextTrimming="CharacterEllipsis" />
                  </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Grid>
      </Border>
    </Border>
  </Grid>
</Window>
