<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Sunder.App.ViewModels"
        xmlns:controls="using:Sunder.App.Views.Controls"
        xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia"
        x:Class="Sunder.App.Views.UseStackWizardWindow"
        x:DataType="vm:UseStackWizardViewModel"
        mc:Ignorable="d"
        Width="980"
        Height="720"
        MinWidth="820"
        MinHeight="620"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        Title="Use Stack"
        Icon="avares://Sunder.App/Assets/Images/app.ico"
        WindowDecorations="BorderOnly"
        ExtendClientAreaToDecorationsHint="True"
        Classes="secondary-window">
  <Window.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://LiveMarkdown.Avalonia/Defaults.axaml" />
      </ResourceDictionary.MergedDictionaries>
    </ResourceDictionary>
  </Window.Resources>

  <Window.Styles>
    <StyleInclude Source="avares://LiveMarkdown.Avalonia/Styles.axaml" />
    <StyleInclude Source="avares://Sunder.App/Styles/MarketplaceMarkdownStyles.axaml" />
  </Window.Styles>

  <Grid RowDefinitions="52,*,Auto"
        Background="{DynamicResource Sunder.Brush.Background.App}">
    <controls:WindowTitleBar Grid.Row="0">
      <controls:WindowTitleBar.LeadingContent>
        <TextBlock Classes="section-title"
                   VerticalAlignment="Center"
                   Text="Use Stack" />
      </controls:WindowTitleBar.LeadingContent>
    </controls:WindowTitleBar>

    <Border Grid.Row="1"
            Classes="workspace-surface"
            Margin="20,12,20,0">
          <ScrollViewer>
            <StackPanel Margin="22"
                        Spacing="18">
              <StackPanel Spacing="6">
                <TextBlock Text="{Binding StackTitle}"
                           FontSize="26"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap" />
                <TextBlock Classes="caption"
                           Text="{Binding StackSubtitle}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="muted"
                           Text="{Binding StackSummary}"
                           TextWrapping="Wrap" />
                <TextBlock Classes="caption"
                           Text="{Binding StackMetadata}"
                           TextWrapping="Wrap" />
              </StackPanel>

              <Border Classes="card-surface"
                      IsVisible="{Binding HasStackProfileMedia}">
                <controls:MarketplaceMediaStrip Items="{Binding StackProfileMedia}" />
              </Border>

              <Border Classes="card-surface"
                      IsVisible="{Binding HasStackReadme}">
                <StackPanel Spacing="8">
                  <TextBlock Classes="section-title" Text="Overview" />
                  <md:MarkdownRenderer MarkdownBuilder="{Binding StackReadmeMarkdownBuilder}" />
                </StackPanel>
              </Border>

              <controls:StackInstallPlan Items="{Binding PackageRows}"
                                         Warnings="{Binding InstallPlanWarnings}"
                                         Errors="{Binding InstallPlanErrors}"
                                         HasItems="{Binding HasPackages}"
                                         HasWarnings="{Binding HasInstallPlanWarnings}"
                                         HasErrors="{Binding HasInstallPlanErrors}"
                                         ShowNoChanges="{Binding ShowNoInstallPlanChanges}"
                                         IsVisible="{Binding HasPackageRequirements}">
                <controls:StackInstallPlan.ItemTemplate>
                    <DataTemplate x:DataType="vm:UseStackPackageReviewViewModel">
                      <Border Classes="stack-wizard-card package"
                              Margin="0,0,0,8">
                        <Grid ColumnDefinitions="Auto,*,Auto"
                              ColumnSpacing="12">
                          <controls:PackageIconView Width="34"
                                                    Height="34"
                                                    IconImage="{Binding IconImage}"
                                                    HasIconImage="{Binding HasIconImage}"
                                                    Glyph="{Binding Glyph}"
                                                    ShowFallbackContainer="{Binding ShowGlyphFallback}"
                                                    GlyphFontSize="14"
                                                    GlyphForeground="{DynamicResource Sunder.Brush.Accent}" />
                          <StackPanel Grid.Column="1"
                                      Spacing="2">
                            <TextBlock Text="{Binding DisplayName}"
                                       FontWeight="SemiBold"
                                       TextWrapping="Wrap" />
                            <TextBlock Classes="caption"
                                       Text="{Binding PackageId}"
                                       TextWrapping="Wrap" />
                            <TextBlock Classes="muted"
                                       Text="{Binding RequirementText}"
                                       TextWrapping="Wrap" />
                          </StackPanel>
                          <Border Grid.Column="2"
                                  Classes="stack-chip"
                                  VerticalAlignment="Center">
                            <TextBlock Text="{Binding StatusText}" />
                          </Border>
                        </Grid>
                      </Border>
                    </DataTemplate>
                </controls:StackInstallPlan.ItemTemplate>
              </controls:StackInstallPlan>

              <StackPanel Spacing="8"
                          IsVisible="{Binding HasSetupPackageGroups}">
                <TextBlock Text="Content"
                           FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding SetupPackageGroups}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:UseStackSetupPackageGroupViewModel">
                      <Border Classes="stack-wizard-card package"
                              Margin="0,0,0,10">
                        <Grid RowDefinitions="Auto,Auto"
                              RowSpacing="10">
                           <Grid ColumnDefinitions="Auto,*,Auto"
                                 ColumnSpacing="12">
                            <controls:PackageIconView Width="34"
                                                      Height="34"
                                                      IconImage="{Binding IconImage}"
                                                      HasIconImage="{Binding HasIconImage}"
                                                      Glyph="{Binding Glyph}"
                                                      ShowFallbackContainer="{Binding ShowGlyphFallback}"
                                                      GlyphFontSize="14"
                                                      GlyphForeground="{DynamicResource Sunder.Brush.Accent}" />
                            <StackPanel Grid.Column="1"
                                        Spacing="2"
                                        VerticalAlignment="Center">
                              <TextBlock Text="{Binding DisplayName}"
                                         FontWeight="SemiBold"
                                         TextWrapping="Wrap" />
                              <TextBlock Classes="caption"
                                         Text="{Binding PackageId}"
                                         TextWrapping="Wrap" />
                            </StackPanel>
                            <Button Grid.Column="2"
                                    Classes="stack-card-toggle"
                                    Command="{Binding ToggleExpandedCommand}"
                                    Content="{Binding ExpandActionText}" />
                          </Grid>

                          <StackPanel Grid.Row="1"
                                      Spacing="8"
                                      IsVisible="{Binding IsExpanded}">
                            <ItemsControl ItemsSource="{Binding ItemGroups}">
                              <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:UseStackSetupKindGroupViewModel">
                                  <StackPanel Spacing="8"
                                              Margin="0,0,0,8">
                                    <Grid ColumnDefinitions="*,Auto"
                                          ColumnSpacing="10">
                                      <TextBlock Text="{Binding DisplayName}"
                                                 FontWeight="SemiBold"
                                                 TextWrapping="Wrap" />
                                      <Border Grid.Column="1"
                                              Classes="stack-chip">
                                        <TextBlock Text="{Binding CountText}" />
                                      </Border>
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding Items}">
                                      <ItemsControl.ItemTemplate>
                                        <DataTemplate x:DataType="vm:UseStackSetupItemViewModel">
                                          <Border Classes="stack-wizard-item-card"
                                                  Classes.selected="{Binding IsSelected}"
                                                  Margin="0,0,0,8">
                                            <StackPanel Spacing="8">
                                              <Grid ColumnDefinitions="Auto,*,Auto"
                                                    ColumnSpacing="12">
                                                <CheckBox IsChecked="{Binding IsSelected}"
                                                          VerticalAlignment="Center" />
                                                <StackPanel Grid.Column="1"
                                                            Spacing="4">
                                                  <TextBlock Text="{Binding DisplayName}"
                                                             FontWeight="SemiBold"
                                                             TextWrapping="Wrap" />
                                                  <TextBlock Classes="caption"
                                                             Text="{Binding Summary}"
                                                             TextWrapping="Wrap" />
                                                  <TextBlock Classes="muted"
                                                             Text="{Binding Description}"
                                                             TextWrapping="Wrap"
                                                             MaxLines="2"
                                                             IsVisible="{Binding HasDescription}" />
                                                </StackPanel>
                                                <Border Grid.Column="2"
                                                        Classes="stack-chip"
                                                        VerticalAlignment="Center"
                                                        IsVisible="{Binding HasDetails}">
                                                  <TextBlock Text="{Binding DetailCountText}" />
                                                </Border>
                                              </Grid>

                                              <ItemsControl ItemsSource="{Binding Details}"
                                                            IsVisible="{Binding HasDetails}">
                                                <ItemsControl.ItemTemplate>
                                                  <DataTemplate x:DataType="vm:LocalStackDetailValueViewModel">
                                                    <Border Classes="stack-export-detail-row"
                                                            Margin="0,0,0,6">
                                                      <Grid ColumnDefinitions="*,Auto"
                                                            RowDefinitions="Auto,Auto,Auto"
                                                            ColumnSpacing="10"
                                                            RowSpacing="4">
                                                        <StackPanel Orientation="Horizontal"
                                                                    Spacing="8">
                                                          <TextBlock Text="{Binding Label}"
                                                                     FontWeight="SemiBold"
                                                                     TextWrapping="Wrap" />
                                                          <Border Classes="stack-chip safety"
                                                                  IsVisible="{Binding HasBehavior}">
                                                            <TextBlock Text="{Binding Behavior}" />
                                                          </Border>
                                                        </StackPanel>
                                                        <Button Grid.Column="1"
                                                                Classes="stack-card-toggle"
                                                                Command="{Binding ToggleExpandedCommand}"
                                                                Content="{Binding ExpandActionText}" />
                                                        <TextBlock Grid.Row="1"
                                                                   Grid.ColumnSpan="2"
                                                                   Classes="muted"
                                                                   Text="{Binding ValuePreview}"
                                                                   TextWrapping="Wrap"
                                                                   IsVisible="{Binding IsCollapsed}" />
                                                        <TextBlock Grid.Row="2"
                                                                   Grid.ColumnSpan="2"
                                                                   Classes="muted"
                                                                   Text="{Binding Value}"
                                                                   TextWrapping="Wrap"
                                                                   IsVisible="{Binding IsExpanded}" />
                                                      </Grid>
                                                    </Border>
                                                  </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                              </ItemsControl>
                                            </StackPanel>
                                          </Border>
                                        </DataTemplate>
                                      </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                  </StackPanel>
                                </DataTemplate>
                              </ItemsControl.ItemTemplate>
                            </ItemsControl>
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>

              <controls:StackImportPreview Actions="{Binding ImportActions}"
                                           RequiredInputs="{Binding RequiredInputs}"
                                           Warnings="{Binding ImportWarnings}"
                                           Errors="{Binding ImportErrors}"
                                           HasActions="{Binding HasImportActions}"
                                           HasRequiredInputs="{Binding HasRequiredInputs}"
                                           HasWarnings="{Binding HasImportWarnings}"
                                           HasErrors="{Binding HasImportErrors}"
                                           IsVisible="{Binding HasSetupPackageGroups}">
                <controls:StackImportPreview.ActionTemplate>
                  <DataTemplate x:DataType="vm:UseStackImportActionViewModel">
                    <Border Classes="marketplace-profile-row" Margin="0,0,0,6">
                      <StackPanel Spacing="4">
                        <TextBlock Text="{Binding DisplayName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Classes="caption" Text="{Binding Subtitle}" TextWrapping="Wrap" />
                        <TextBlock Classes="muted" Text="{Binding Description}" TextWrapping="Wrap" />
                      </StackPanel>
                    </Border>
                  </DataTemplate>
                </controls:StackImportPreview.ActionTemplate>
                <controls:StackImportPreview.RequiredInputTemplate>
                    <DataTemplate x:DataType="vm:UseStackRequiredInputValueViewModel">
                      <Border Classes="marketplace-profile-row">
                        <Grid RowDefinitions="Auto,Auto,Auto"
                              RowSpacing="6">
                          <Grid>
                            <TextBlock Text="{Binding Label}"
                                       FontWeight="SemiBold" />
                          </Grid>
                          <TextBlock Grid.Row="1"
                                     Classes="caption"
                                     Text="{Binding Description}"
                                     TextWrapping="Wrap" />
                          <TextBox Grid.Row="2"
                                   Text="{Binding Value}"
                                   PlaceholderText="{Binding Placeholder}"
                                   PasswordChar="*" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                </controls:StackImportPreview.RequiredInputTemplate>
              </controls:StackImportPreview>
            </StackPanel>
          </ScrollViewer>
    </Border>

    <Grid Grid.Row="2"
          ColumnDefinitions="Auto,*,Auto"
          Margin="20,16"
          ColumnSpacing="12">
      <Button Classes="secondary-action"
              Command="{Binding CancelCommand}"
              Content="Cancel" />
      <TextBlock Grid.Column="1"
                 Classes="status-text"
                 Text="{Binding StatusText}"
                 TextWrapping="Wrap"
                 VerticalAlignment="Center" />
      <Button Grid.Column="2"
              Classes="primary-action"
              Command="{Binding ApplyCommand}"
              Content="Use Stack"
              IsEnabled="{Binding CanApply}" />
    </Grid>
  </Grid>
</Window>
