<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Sunder.App.App"
             Name="Sunder"
             RequestedThemeVariant="Dark">
  <NativeMenu.Menu>
    <NativeMenu>
      <NativeMenuItem Header="About Sunder" Click="AboutSunderMenuItem_OnClick" />
      <NativeMenuItemSeparator />
      <NativeMenuItem Header="Settings" Gesture="Meta+," Click="SettingsMenuItem_OnClick" />
      <NativeMenuItem Header="Stacks" Click="StacksMenuItem_OnClick" />
      <NativeMenuItem Header="Packages" Click="PackagesMenuItem_OnClick" />
    </NativeMenu>
  </NativeMenu.Menu>

  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <ResourceInclude Source="avares://Sunder.Sdk/Themes/SunderThemeResources.axaml" />
        <ResourceInclude Source="avares://Sunder.App/Styles/IconResources.axaml" />
      </ResourceDictionary.MergedDictionaries>
      <x:Double x:Key="Sunder.Layout.RailWidth">72</x:Double>
      <x:Double x:Key="Sunder.Layout.SideRailWidth">60</x:Double>
      <x:Double x:Key="Sunder.Layout.ToolbarHeight">56</x:Double>
      <SolidColorBrush x:Key="Sunder.Brush.Shell.Glass.Tint" Color="#B8161616" />
      <SolidColorBrush x:Key="Sunder.Brush.Shell.Glass.Tint.Inactive" Color="#D0171717" />
      <SolidColorBrush x:Key="Sunder.Brush.Shell.Glass.Surface" Color="#781B1B1B" />
      <SolidColorBrush x:Key="Sunder.Brush.Shell.Glass.Surface.Strong" Color="#B41C1C1C" />
      <SolidColorBrush x:Key="Sunder.Brush.Shell.Glass.Panel" Color="#CD1F1F1F" />
      <SolidColorBrush x:Key="Sunder.Brush.Shell.Glass.Rail" Color="#78181818" />
      <SolidColorBrush x:Key="Sunder.Brush.Shell.Glass.Hover" Color="#33FFFFFF" />
      <SolidColorBrush x:Key="Sunder.Brush.Shell.Glass.Border" Color="#26FFFFFF" />
      <SolidColorBrush x:Key="Sunder.Brush.Shell.Glass.Border.Strong" Color="#3AFFFFFF" />
      <SolidColorBrush x:Key="Sunder.Brush.Shell.Glass.Highlight" Color="#32FFFFFF" />
      <SolidColorBrush x:Key="Sunder.Brush.Shell.Glass.Highlight.Inactive" Color="#24FFFFFF" />
      <SolidColorBrush x:Key="Sunder.Brush.Star" Color="#F6C343" />
      <SolidColorBrush x:Key="Sunder.Brush.Star.Hover" Color="#FFD36A" />
      <SolidColorBrush x:Key="Sunder.Brush.Foreground.OnStar" Color="#211704" />
    </ResourceDictionary>
  </Application.Resources>

  <Application.Styles>
    <FluentTheme />
    <StyleInclude Source="avares://AvaloniaEdit/Themes/Fluent/AvaloniaEdit.xaml" />
    <StyleInclude Source="avares://Sunder.Sdk/Themes/SunderPackageStyles.axaml" />
    <StyleInclude Source="avares://Sunder.App/Styles/SunderShellStyles.axaml" />
    <StyleInclude Source="avares://Sunder.App/Styles/NotificationStyles.axaml" />
    <StyleInclude Source="avares://Sunder.App/Styles/PackageWindowStyles.axaml" />
    <StyleInclude Source="avares://Sunder.App/Styles/ProcessMonitorStyles.axaml" />
    <StyleInclude Source="avares://Sunder.App/Styles/LoadingWindowStyles.axaml" />
    <StyleInclude Source="avares://Sunder.App/Styles/PackageIconBarStyles.axaml" />
  </Application.Styles>
</Application>
