<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:md="clr-namespace:LiveMarkdown.Avalonia;assembly=LiveMarkdown.Avalonia">

  <Style Selector="md|MarkdownRenderer">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="CodeBlockColorTheme" Value="AtomOneDark" />
  </Style>

  <Style Selector="md|MarkdownTextBlock">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Sunder.Brush.Selection}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
  </Style>

  <Style Selector="md|MarkdownTextBlock.ParagraphBlock">
    <Setter Property="Margin" Value="0,1,0,8" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
  </Style>

  <Style Selector="Border.Heading1Block, Border.Heading2Block, Border.Heading3Block, Border.Heading4Block, Border.Heading5Block, Border.Heading6Block">
    <Setter Property="Margin" Value="0,14,0,7" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Border.Heading1Block md|MarkdownTextBlock, Border.Heading2Block md|MarkdownTextBlock, Border.Heading3Block md|MarkdownTextBlock, Border.Heading4Block md|MarkdownTextBlock, Border.Heading5Block md|MarkdownTextBlock, Border.Heading6Block md|MarkdownTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="Border.Heading1Block">
    <Setter Property="Margin" Value="0,2,0,12" />
  </Style>

  <Style Selector="Border.Heading1Block md|MarkdownTextBlock">
    <Setter Property="FontSize" Value="25" />
    <Setter Property="LineHeight" Value="32" />
  </Style>

  <Style Selector="Border.Heading2Block md|MarkdownTextBlock">
    <Setter Property="FontSize" Value="21" />
    <Setter Property="LineHeight" Value="28" />
  </Style>

  <Style Selector="Border.Heading3Block md|MarkdownTextBlock">
    <Setter Property="FontSize" Value="17" />
    <Setter Property="LineHeight" Value="24" />
  </Style>

  <Style Selector="Border.Heading4Block md|MarkdownTextBlock, Border.Heading5Block md|MarkdownTextBlock, Border.Heading6Block md|MarkdownTextBlock">
    <Setter Property="FontSize" Value="15" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
  </Style>

  <Style Selector="md|MarkdownListGrid.ListBlock">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="ColumnSpacing" Value="9" />
    <Setter Property="RowSpacing" Value="5" />
    <Setter Property="Margin" Value="0,4,0,10" />
  </Style>

  <Style Selector="TextBlock.ListBlockNumber, TextBlock.ListBlockBullet">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
    <Setter Property="FontSize" Value="14" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="HorizontalAlignment" Value="Right" />
    <Setter Property="LineHeight" Value="22" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="VerticalAlignment" Value="Top" />
  </Style>

  <Style Selector="md|MarkdownTableGrid">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="ColumnSpacing" Value="0" />
    <Setter Property="RowSpacing" Value="0" />
  </Style>

  <Style Selector="ScrollViewer.Table">
    <Setter Property="Margin" Value="0,12,0,14" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style Selector="Border.Table">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Code}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <Style Selector="Border.TableCell">
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="0,0,1,1" />
    <Setter Property="Padding" Value="12,9" />
    <Setter Property="MinWidth" Value="0" />
  </Style>

  <Style Selector="Border.TableCell.Header">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
  </Style>

  <Style Selector="Border.TableCell.Header md|MarkdownTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="Border.QuoteBlock">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Raised}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Accent}" />
    <Setter Property="BorderThickness" Value="3,0,0,0" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
    <Setter Property="Padding" Value="14,10" />
    <Setter Property="Margin" Value="0,10,0,14" />
  </Style>

  <Style Selector="Border.QuoteBlock md|MarkdownTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
  </Style>

  <Style Selector="Border.ThematicBreak">
    <Setter Property="Height" Value="1" />
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="Margin" Value="0,16,0,16" />
  </Style>

  <Style Selector="md|Link">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Accent}" />
    <Setter Property="TextDecorations" Value="Underline" />
  </Style>

  <Style Selector="md|Link:clicked">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
  </Style>

  <Style Selector="InlineUIContainer.Code">
    <Setter Property="BaselineAlignment" Value="TextBottom" />
  </Style>

  <Style Selector="InlineUIContainer.Code Border">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
    <Setter Property="TextBlock.BaselineOffset" Value="15" />
    <Setter Property="Padding" Value="6,2" />
    <Setter Property="Margin" Value="2,0" />
  </Style>

  <Style Selector="InlineUIContainer.Code md|MarkdownTextBlock">
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Warning}" />
    <Setter Property="FontFamily" Value="Menlo,Consolas,monospace" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="LineHeight" Value="17" />
    <Setter Property="Margin" Value="0" />
  </Style>

  <Style Selector="CheckBox.TaskList">
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="IsHitTestVisible" Value="False" />
  </Style>

  <Style Selector="md|CodeBlock">
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
    <Setter Property="Margin" Value="0,12,0,14" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    <Setter Property="ClipToBounds" Value="True" />
    <Setter Property="IsCodeWrapped" Value="True" />
    <Setter Property="AutoSyntaxHighlight" Value="True" />
    <Setter Property="ColorTheme" Value="AtomOneDark" />
    <Setter Property="FontFamily" Value="Menlo,Consolas,monospace" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="md:CodeBlock">
          <Border Background="{DynamicResource Sunder.Brush.Surface.Workspace}"
                  BorderBrush="{DynamicResource Sunder.Brush.Border.Subtle}"
                  BorderThickness="1"
                  CornerRadius="{DynamicResource Sunder.Radius.Small}"
                  ClipToBounds="True">
            <Grid RowDefinitions="Auto,*">
              <Border Grid.Row="0"
                      Background="{DynamicResource Sunder.Brush.Surface.Raised}"
                      BorderBrush="{DynamicResource Sunder.Brush.Border.Subtle}"
                      BorderThickness="0,0,0,1"
                      CornerRadius="7,7,0,0"
                      Padding="12,8">
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">
                  <TextBlock x:Name="PART_LanguageTextBlock"
                             Text="{TemplateBinding Language}"
                             Foreground="{DynamicResource Sunder.Brush.Foreground.Muted}"
                             FontFamily="Menlo,Consolas,monospace"
                             FontSize="11"
                             FontWeight="SemiBold"
                             VerticalAlignment="Center" />
                  <StackPanel Grid.Column="1"
                              Orientation="Horizontal"
                              Spacing="6"
                              HorizontalAlignment="Right">
                    <ToggleButton x:Name="PART_ToggleTextWrapButton"
                                  Content="Wrap"
                                  IsChecked="{TemplateBinding IsCodeWrapped, Mode=TwoWay}"
                                  Focusable="False" />
                    <Button x:Name="PART_CopyButton"
                            Content="Copy"
                            Focusable="False" />
                  </StackPanel>
                </Grid>
              </Border>

              <ScrollViewer x:Name="PART_ScrollViewer"
                            Grid.Row="1"
                            Background="{DynamicResource Sunder.Brush.Transparent}"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                <md:MarkdownTextBlock x:Name="PART_CodeTextBlock"
                                      Margin="14,12"
                                      FontFamily="{TemplateBinding FontFamily}"
                                      TextWrapping="{TemplateBinding TextWrapping}"
                                      SelectionBrush="{DynamicResource Sunder.Brush.Selection}"
                                      SelectionForegroundBrush="{DynamicResource Sunder.Brush.Foreground.Primary}" />
              </ScrollViewer>
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style Selector="md|CodeBlock /template/ ScrollViewer#PART_ScrollViewer">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
  </Style>

  <Style Selector="md|CodeBlock /template/ md|MarkdownTextBlock#PART_CodeTextBlock">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Transparent}" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
    <Setter Property="FontFamily" Value="Menlo,Consolas,monospace" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="LineHeight" Value="21" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="SelectionBrush" Value="{DynamicResource Sunder.Brush.Selection}" />
    <Setter Property="SelectionForegroundBrush" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
  </Style>

  <Style Selector="md|CodeBlock /template/ Button#PART_CopyButton, md|CodeBlock /template/ ToggleButton#PART_ToggleTextWrapButton">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Popover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Subtle}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource Sunder.Radius.Small}" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Secondary}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="md|CodeBlock /template/ Button#PART_CopyButton:pointerover, md|CodeBlock /template/ ToggleButton#PART_ToggleTextWrapButton:pointerover">
    <Setter Property="Background" Value="{DynamicResource Sunder.Brush.Surface.Hover}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Sunder.Brush.Border.Strong}" />
    <Setter Property="Foreground" Value="{DynamicResource Sunder.Brush.Foreground.Primary}" />
  </Style>
</Styles>
