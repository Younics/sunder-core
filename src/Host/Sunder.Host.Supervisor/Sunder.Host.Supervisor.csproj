<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Sunder.Host.Contracts\Sunder.Host.Contracts.csproj" />
    <ProjectReference Include="..\Sunder.Runtime.Client\Sunder.Runtime.Client.csproj" />
    <ProjectReference Include="..\Sunder.Runtime.Contracts\Sunder.Runtime.Contracts.csproj" />
    <ProjectReference Include="..\Sunder.Runtime.LocalState\Sunder.Runtime.LocalState.csproj" />
    <ProjectReference Include="..\Sunder.Runtime.Host\Sunder.Runtime.Host.csproj" ReferenceOutputAssembly="false" PrivateAssets="all" Private="false" />
  </ItemGroup>

  <Target Name="BundleRuntimeWorkerForBuild"
          AfterTargets="Build"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <PropertyGroup>
      <BundledRuntimeWorkerSourceDir>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\Sunder.Runtime.Host\bin\$(Configuration)\$(TargetFramework)\'))</BundledRuntimeWorkerSourceDir>
      <BundledRuntimeWorkerOutputDir>$([System.IO.Path]::Combine('$(OutDir)', 'RuntimeHost'))\</BundledRuntimeWorkerOutputDir>
    </PropertyGroup>

    <ItemGroup>
      <_BundledRuntimeWorkerFiles Include="$(BundledRuntimeWorkerSourceDir)**\*"
                                  Condition="Exists('$(BundledRuntimeWorkerSourceDir)')" />
    </ItemGroup>

    <MakeDir Directories="$(BundledRuntimeWorkerOutputDir)"
             Condition="Exists('$(BundledRuntimeWorkerSourceDir)')" />

    <Copy SourceFiles="@(_BundledRuntimeWorkerFiles)"
          DestinationFiles="@(_BundledRuntimeWorkerFiles->'$(BundledRuntimeWorkerOutputDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'@(_BundledRuntimeWorkerFiles)' != ''" />
  </Target>

  <Target Name="BundleRuntimeWorkerForPublish"
          AfterTargets="Publish"
          Condition="'$(DesignTimeBuild)' != 'true'">
    <MSBuild Projects="..\Sunder.Runtime.Host\Sunder.Runtime.Host.csproj"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);TargetFramework=$(TargetFramework);RuntimeIdentifier=$(RuntimeIdentifier);SelfContained=$(SelfContained);Version=$(Version);InformationalVersion=$(InformationalVersion);IncludeSourceRevisionInInformationalVersion=false;ContinuousIntegrationBuild=$(ContinuousIntegrationBuild);PublishDir=$(PublishDir)RuntimeHost\"
             RemoveProperties="OutputPath;OutDir;IntermediateOutputPath;BaseIntermediateOutputPath" />
  </Target>
</Project>
