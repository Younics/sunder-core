<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:Sunder.Package.Template.App.PackageViews"
             x:Class="Sunder.Package.Template.App.PackageViews.DefaultPackageView"
             x:DataType="vm:DefaultPackageViewModel"
             mc:Ignorable="d">
  <Border Padding="24">
    <StackPanel Spacing="12">
      <TextBlock Text="SUNDER_PACKAGE_NAME_XML"
                 FontSize="24"
                 FontWeight="SemiBold" />
      <TextBlock Text="Start replacing this view with your package UI."
                 TextWrapping="Wrap" />
      <TextBlock Text="{Binding PackageId, StringFormat='Package id: {0}'}" />
    </StackPanel>
  </Border>
</UserControl>
