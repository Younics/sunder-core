{
  "$schema": "http://json.schemastore.org/template",
  "author": "Sunder",
  "classifications": ["Sunder", "Package", "Avalonia"],
  "identity": "Sunder.Package",
  "name": "Sunder Package",
  "shortName": "sunder-package",
  "sourceName": "Sunder.Package.Template",
  "preferNameDirectory": true,
  "symbols": {
    "packageId": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "The lowercase dot-separated runtime package id written into generated package metadata."
    },
    "packageName": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": true,
      "description": "The package name shown in Sunder.",
      "replaces": "SUNDER_PACKAGE_NAME_TEXT"
    },
    "coordinatedPackageVersion": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "__SUNDER_COORDINATED_PACKAGE_VERSION__"
      },
      "replaces": "SUNDER_TEMPLATE_PACKAGE_VERSION"
    },
    "coordinatedPackageVersionRange": {
      "type": "generated",
      "generator": "constant",
      "parameters": {
        "value": "__SUNDER_COORDINATED_PACKAGE_VERSION_RANGE__"
      },
      "replaces": "SUNDER_TEMPLATE_PACKAGE_VERSION_RANGE"
    },
    "packageIdCSharp": {
      "type": "derived",
      "valueSource": "packageId",
      "valueTransform": "csharpString",
      "replaces": "SUNDER_PACKAGE_ID_CSHARP"
    },
    "packageNameCSharp": {
      "type": "derived",
      "valueSource": "packageName",
      "valueTransform": "csharpString",
      "replaces": "SUNDER_PACKAGE_NAME_CSHARP"
    },
    "packageNameXml": {
      "type": "derived",
      "valueSource": "packageName",
      "valueTransform": "xmlAttribute",
      "replaces": "SUNDER_PACKAGE_NAME_XML"
    },
    "withAvalonia": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "Add the Avalonia SDK and a default App package view.",
      "replaces": "SUNDER_WITH_AVALONIA"
    },
    "withStacks": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "Add the Stack SDK and a runtime Stack contributor example.",
      "replaces": "SUNDER_WITH_STACKS"
    },
    "withContracts": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "Generate a sibling *.Contracts project for public extension points."
    },
    "withHostDependency": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "Scaffold package dependency metadata and integration notes for extending another package."
    },
    "withHostContracts": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "Add a PackageReference to the host package's published *.Contracts package, host dependency metadata, and a compile-safe extension stub."
    },
    "hostPackageId": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": "withHostDependency || withHostContracts == true",
      "isEnabled": "withHostDependency || withHostContracts == true",
      "description": "The package id of the host package this package extends.",
      "replaces": "SUNDER_HOST_PACKAGE_ID_TEXT"
    },
    "hostPackageIdCSharp": {
      "type": "derived",
      "valueSource": "hostPackageId",
      "valueTransform": "csharpString",
      "replaces": "SUNDER_HOST_PACKAGE_ID_CSHARP"
    },
    "hostContractsPackageId": {
      "type": "parameter",
      "datatype": "text",
      "isRequired": "withHostContracts == true",
      "isEnabled": "withHostContracts == true",
      "description": "The NuGet package id of the host package's published contracts package."
    },
    "hostContractsPackageIdXml": {
      "type": "derived",
      "valueSource": "hostContractsPackageId",
      "valueTransform": "xmlAttribute",
      "replaces": "SUNDER_HOST_CONTRACTS_PACKAGE_ID_XML"
    },
    "hostPackageVersionRange": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": ">=1.1.0 <1.2.0",
      "isEnabled": "withHostDependency || withHostContracts == true",
      "description": "The runtime SemVer range accepted for the host package."
    },
    "hostPackageVersionRangeCSharp": {
      "type": "derived",
      "valueSource": "hostPackageVersionRange",
      "valueTransform": "csharpString",
      "replaces": "SUNDER_HOST_PACKAGE_VERSION_RANGE_CSHARP"
    },
    "hostContractsVersionRange": {
      "type": "parameter",
      "datatype": "text",
      "defaultValue": "__SUNDER_DEFAULT_HOST_CONTRACTS_VERSION_RANGE__",
      "isEnabled": "withHostContracts == true",
      "description": "The bounded NuGet version range for the host package's published contracts package."
    },
    "hostContractsVersionRangeXml": {
      "type": "derived",
      "valueSource": "hostContractsVersionRange",
      "valueTransform": "xmlAttribute",
      "replaces": "SUNDER_HOST_CONTRACTS_VERSION_RANGE_XML"
    },
    "createInPlace": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "Create the package project directly in the specified output folder instead of a child project folder."
    },
    "noDefaultView": {
      "type": "parameter",
      "datatype": "bool",
      "defaultValue": false,
      "description": "With --withAvalonia, omit the default shell-visible view while retaining Avalonia SDK references."
    }
  },
  "forms": {
    "csharpBackslash": {
      "identifier": "replace",
      "pattern": "\\\\",
      "replacement": "\\\\"
    },
    "csharpQuote": {
      "identifier": "replace",
      "pattern": "\"",
      "replacement": "\\\""
    },
    "csharpCarriageReturn": {
      "identifier": "replace",
      "pattern": "\\r",
      "replacement": "\\r"
    },
    "csharpLineFeed": {
      "identifier": "replace",
      "pattern": "\\n",
      "replacement": "\\n"
    },
    "csharpTab": {
      "identifier": "replace",
      "pattern": "\\t",
      "replacement": "\\t"
    },
    "csharpString": {
      "identifier": "chain",
      "steps": [
        "csharpBackslash",
        "csharpQuote",
        "csharpCarriageReturn",
        "csharpLineFeed",
        "csharpTab"
      ]
    },
    "xml": {
      "identifier": "xmlEncode"
    },
    "xmlQuote": {
      "identifier": "replace",
      "pattern": "\"",
      "replacement": "&quot;"
    },
    "xmlAttribute": {
      "identifier": "chain",
      "steps": [
        "xml",
        "xmlQuote"
      ]
    }
  },
  "primaryOutputs": [
    {
      "condition": "(!createInPlace)",
      "path": "Sunder.Package.Template/Sunder.Package.Template.csproj"
    },
    {
      "condition": "(createInPlace)",
      "path": "Sunder.Package.Template.csproj"
    }
  ],
  "sources": [
    {
      "condition": "(!createInPlace)",
      "modifiers": [
        {
          "condition": "(!withAvalonia)",
          "exclude": [
            "Sunder.Package.Template/Avalonia.PackageReferences.props"
          ]
        },
        {
          "condition": "(!withStacks)",
          "exclude": [
            "Sunder.Package.Template/StackSupport.cs",
            "Sunder.Package.Template/Stacks.PackageReferences.props"
          ]
        },
        {
          "condition": "(!withContracts)",
          "exclude": [
            "Sunder.Package.Template.Contracts/**/*"
          ]
        },
        {
          "condition": "(!withHostDependency && withHostContracts != true)",
          "exclude": [
            "Sunder.Package.Template/Extensions/**/*",
            "Sunder.Package.Template/PackageMetadata.host.cs"
          ],
          "rename": {
            "Sunder.Package.Template/PackageMetadata.no-host.cs": "Sunder.Package.Template/PackageMetadata.cs"
          }
        },
        {
          "condition": "(withHostDependency || withHostContracts == true)",
          "exclude": [
            "Sunder.Package.Template/PackageMetadata.no-host.cs"
          ],
          "rename": {
            "Sunder.Package.Template/PackageMetadata.host.cs": "Sunder.Package.Template/PackageMetadata.cs"
          }
        },
        {
          "condition": "(withHostContracts != true)",
          "exclude": [
            "Sunder.Package.Template/Sunder.Package.Template.with-host-contracts.csproj",
            "Sunder.Package.Template/HostContracts.PackageReferences.props",
            "Sunder.Package.Template/Extensions/HostContractContributionStub.cs"
          ]
        },
        {
          "condition": "(withHostContracts == true)",
          "exclude": [
            "Sunder.Package.Template/Sunder.Package.Template.csproj"
          ],
          "rename": {
            "Sunder.Package.Template/Sunder.Package.Template.with-host-contracts.csproj": "Sunder.Package.Template/Sunder.Package.Template.csproj"
          }
        },
        {
          "condition": "((noDefaultView || !withAvalonia) && !withHostDependency && withHostContracts != true)",
          "exclude": [
            "Sunder.Package.Template/PackageViews/**/*",
            "Sunder.Package.Template/PackageModule.with-view.cs"
          ],
          "rename": {
            "Sunder.Package.Template/PackageModule.no-view.cs": "Sunder.Package.Template/PackageModule.cs"
          }
        },
        {
          "condition": "(!noDefaultView && withAvalonia && !withHostDependency && withHostContracts != true)",
          "exclude": [
            "Sunder.Package.Template/PackageModule.no-view.cs"
          ],
          "rename": {
            "Sunder.Package.Template/PackageModule.with-view.cs": "Sunder.Package.Template/PackageModule.cs"
          }
        },
        {
          "condition": "((noDefaultView || !withAvalonia) && (withHostDependency || withHostContracts == true))",
          "exclude": [
            "Sunder.Package.Template/PackageViews/**/*",
            "Sunder.Package.Template/PackageModule.with-view.cs"
          ],
          "rename": {
            "Sunder.Package.Template/PackageModule.no-view.cs": "Sunder.Package.Template/PackageModule.cs"
          }
        },
        {
          "condition": "(!noDefaultView && withAvalonia && (withHostDependency || withHostContracts == true))",
          "exclude": [
            "Sunder.Package.Template/PackageModule.no-view.cs"
          ],
          "rename": {
            "Sunder.Package.Template/PackageModule.with-view.cs": "Sunder.Package.Template/PackageModule.cs"
          }
        }
      ]
    },
    {
      "condition": "(createInPlace)",
      "source": "Sunder.Package.Template/",
      "target": "./",
      "modifiers": [
        {
          "condition": "(!withAvalonia)",
          "exclude": [
            "Avalonia.PackageReferences.props"
          ]
        },
        {
          "condition": "(!withStacks)",
          "exclude": [
            "StackSupport.cs",
            "Stacks.PackageReferences.props"
          ]
        },
        {
          "condition": "(!withHostDependency && withHostContracts != true)",
          "exclude": [
            "Extensions/**/*",
            "PackageMetadata.host.cs"
          ],
          "rename": {
            "PackageMetadata.no-host.cs": "PackageMetadata.cs"
          }
        },
        {
          "condition": "(withHostDependency || withHostContracts == true)",
          "exclude": [
            "PackageMetadata.no-host.cs"
          ],
          "rename": {
            "PackageMetadata.host.cs": "PackageMetadata.cs"
          }
        },
        {
          "condition": "(withHostContracts != true)",
          "exclude": [
            "Sunder.Package.Template.with-host-contracts.csproj",
            "HostContracts.PackageReferences.props",
            "Extensions/HostContractContributionStub.cs"
          ]
        },
        {
          "condition": "(withHostContracts == true)",
          "exclude": [
            "Sunder.Package.Template.csproj"
          ],
          "rename": {
            "Sunder.Package.Template.with-host-contracts.csproj": "Sunder.Package.Template.csproj"
          }
        },
        {
          "condition": "((noDefaultView || !withAvalonia) && !withHostDependency && withHostContracts != true)",
          "exclude": [
            "PackageViews/**/*",
            "PackageModule.with-view.cs"
          ],
          "rename": {
            "PackageModule.no-view.cs": "PackageModule.cs"
          }
        },
        {
          "condition": "(!noDefaultView && withAvalonia && !withHostDependency && withHostContracts != true)",
          "exclude": [
            "PackageModule.no-view.cs"
          ],
          "rename": {
            "PackageModule.with-view.cs": "PackageModule.cs"
          }
        },
        {
          "condition": "((noDefaultView || !withAvalonia) && (withHostDependency || withHostContracts == true))",
          "exclude": [
            "PackageViews/**/*",
            "PackageModule.with-view.cs"
          ],
          "rename": {
            "PackageModule.no-view.cs": "PackageModule.cs"
          }
        },
        {
          "condition": "(!noDefaultView && withAvalonia && (withHostDependency || withHostContracts == true))",
          "exclude": [
            "PackageModule.no-view.cs"
          ],
          "rename": {
            "PackageModule.with-view.cs": "PackageModule.cs"
          }
        }
      ]
    },
    {
      "condition": "(createInPlace && withContracts)",
      "include": [
        "Sunder.Package.Template.Contracts/**/*"
      ]
    },
    {
      "condition": "(createInPlace)",
      "include": [
        "README.md"
      ]
    }
  ]
}
