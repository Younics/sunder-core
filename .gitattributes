# These documents are byte-verified inputs. Preserve repository bytes even when
# a developer or Windows runner enables core.autocrlf; never renormalize evidence.
*.json -text
specs/** -text
compatibility/** -text

# Shell entry points must also run from Windows checkouts.
*.sh text eol=lf

# The generated worker's embedded manifest must have identical compiler bytes.
languages/csharp/dotnet/packages/Sunder.Package.Build/build/Sunder.Package.Build.Worker.manifest text eol=lf
