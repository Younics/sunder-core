{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sunder retained supported-release compatibility references",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "baselineId", "status", "releaseStatus", "releases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "baselineId": { "const": "sunder-v1" },
    "status": { "enum": ["UNFROZEN", "FROZEN"] },
    "releaseStatus": { "enum": ["UNRELEASED", "RELEASED"] },
    "releases": { "type": "array", "maxItems": 64, "items": { "$ref": "#/$defs/release" } }
  },
  "$defs": {
    "id": { "type": "string", "minLength": 1, "maxLength": 160, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$" },
    "path": { "type": "string", "minLength": 1, "maxLength": 512, "pattern": "^[A-Za-z0-9_@.-]+(?:/[A-Za-z0-9_@.-]+)*$" },
    "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$", "minLength": 64, "maxLength": 64 },
    "source": {
      "type": "object", "additionalProperties": false, "required": ["repository", "commit"],
      "properties": {
        "repository": { "type": "string", "minLength": 9, "maxLength": 512, "pattern": "^https://[^?#\\s]+$" },
        "commit": { "type": "string", "pattern": "^(?:[a-f0-9]{40}|[a-f0-9]{64})$", "maxLength": 64 }
      }
    },
    "file": {
      "type": "object", "additionalProperties": false, "required": ["path", "sha256", "size"],
      "properties": {
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1, "maximum": 8388608 }
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "path", "sha256", "size", "source", "retainedIdentity"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["nuget", "npm", "package", "host", "source", "other"] },
        "path": { "$ref": "#/$defs/path" },
        "sha256": { "$ref": "#/$defs/sha256" },
        "size": { "type": "integer", "minimum": 1, "maximum": 8589934592 },
        "source": { "$ref": "#/$defs/source" },
        "retainedIdentity": { "type": "string", "minLength": 9, "maxLength": 1024, "pattern": "^https://[^?#\\s]+$" }
      }
    },
    "surface": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "format", "artifactId", "snapshot", "currentPath"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "format": { "enum": ["dotnet-public-api-v2", "exact-bytes-v1"] },
        "artifactId": { "$ref": "#/$defs/id" },
        "snapshot": { "$ref": "#/$defs/file" },
        "currentPath": { "$ref": "#/$defs/path" }
      }
    },
    "corpus": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "kind", "artifactIds", "owner", "recipe"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "kind": { "enum": ["old-package-new-host", "old-source-new-sdk", "new-feature-old-host"] },
        "artifactIds": { "type": "array", "minItems": 1, "maxItems": 64, "uniqueItems": true, "items": { "$ref": "#/$defs/id" } },
        "owner": { "type": "string", "minLength": 1, "maxLength": 512 },
        "recipe": { "$ref": "#/$defs/file" }
      }
    },
    "release": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "version", "source", "artifacts", "surfaces", "corpus"],
      "properties": {
        "id": { "$ref": "#/$defs/id" },
        "version": { "type": "string", "minLength": 5, "maxLength": 128, "pattern": "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$" },
        "source": { "$ref": "#/$defs/source" },
        "artifacts": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/artifact" } },
        "surfaces": { "type": "array", "minItems": 1, "maxItems": 256, "items": { "$ref": "#/$defs/surface" } },
        "corpus": { "type": "array", "minItems": 3, "maxItems": 128, "items": { "$ref": "#/$defs/corpus" } }
      }
    }
  }
}
