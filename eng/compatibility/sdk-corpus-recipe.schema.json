{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Immutable reviewed SDK corpus execution recipe",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "referenceId", "corpusId", "kind", "owner", "command", "reportFormat", "requiredTests", "timeoutSeconds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "referenceId": { "$ref": "supported-releases.schema.json#/$defs/id" },
    "corpusId": { "$ref": "supported-releases.schema.json#/$defs/id" },
    "kind": { "enum": ["old-package-new-host", "old-source-new-sdk", "new-feature-old-host"] },
    "owner": { "type": "string", "minLength": 1, "maxLength": 512 },
    "command": {
      "type": "object", "additionalProperties": false, "required": ["runner", "entryPoint", "arguments"],
      "properties": {
        "runner": { "enum": ["python3", "node", "dotnet-test"] },
        "entryPoint": { "$ref": "supported-releases.schema.json#/$defs/path" },
        "arguments": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 256, "pattern": "^[A-Za-z0-9_=.,@+-]+$" } }
      }
    },
    "reportFormat": { "enum": ["trx", "junit"] },
    "requiredTests": { "type": "array", "minItems": 1, "maxItems": 256, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 1024 } },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 1800 }
  }
}
