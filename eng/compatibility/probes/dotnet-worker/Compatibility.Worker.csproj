<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <Version>1.0.0</Version>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <CorpusSdkVersion Condition="'$(CorpusSdkVersion)' == ''">1.1.0</CorpusSdkVersion>
    <RuntimeIdentifier>$(NETCoreSdkRuntimeIdentifier)</RuntimeIdentifier>
    <SunderSdkPackageVersion>$(CorpusSdkVersion)</SunderSdkPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Sunder.Sdk.Worker" Version="[$(CorpusSdkVersion)]" />
    <PackageReference Include="Sunder.Package.Build" Version="[$(CorpusSdkVersion)]" PrivateAssets="all" />
    <SunderContractBundle Include="probe.rpc.json" ContractId="compatibility.probe" Version="1.0.0" DescriptorPath="contracts/probe.rpc.json" Exposure="package" />
    <SunderUsesContract Include="compatibility.probe" Role="runtime" ContractVersion="1.0.0" Required="true" Actions="discover;invoke;subscribe" />
    <SunderRpcProvider Include="compatibility.probe.provider" ContractId="compatibility.probe" ContractVersion="1.0.0" Role="runtime" Audience="owner" />
    <SunderPackageTarget Include="runtime/$(RuntimeIdentifier)" Role="runtime" Rid="$(RuntimeIdentifier)" Kind="worker" />
  </ItemGroup>
</Project>
