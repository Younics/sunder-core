{
  "name": "@sunder/sdk",
  "version": "1.1.0",
  "description": "Zero-dependency TypeScript SDK for Sunder RPC contracts and process Runtime workers.",
  "license": "MIT",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "bin": {
    "sunder-rpc-gen": "dist/generator-cli.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "require": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./browser": {
      "types": "./dist/browser.d.ts",
      "require": "./dist/browser.js",
      "default": "./dist/browser.js"
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  }
}
