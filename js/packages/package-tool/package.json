{
  "name": "@sunder/package-tool",
  "version": "1.1.0",
  "description": "Build tooling for Sunder TypeScript process packages and pinned Node SEA targets.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Younics/sunder-core.git",
    "directory": "js/packages/package-tool"
  },
  "homepage": "https://github.com/Younics/sunder-core/tree/main/js/packages/package-tool#readme",
  "bugs": "https://github.com/Younics/sunder-core/issues",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "node-distributions.json",
    "README.md",
    "LICENSE",
    "NOTICE"
  ],
  "bin": {
    "sunder-package": "dist/cli.js"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck && npm run build && tsc -p tsconfig.test.json && node --test dist-test/test/*.test.js"
  },
  "dependencies": {
    "@sunder/sdk": ">=1.1.0 <1.2.0",
    "esbuild": "0.28.1",
    "postject": "1.0.0-alpha.6",
    "vite": "8.2.0"
  }
}
